+"""Generic provider metadata through actual validation, CLI and warm cache.
+
+No compile, device transfer, or network I/O is performed. Only mDNS discovery
+is mocked at the external-I/O boundary; CORE and the CLI are real modules.
+"""
+
+from itertools import combinations
+import json
+import os
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+
+import yaml
+
+from esphome import __main__ as cli
+from esphome.compiled_config import (
+    compiled_config_path,
+    load_compiled_config,
+    save_compiled_config,
+)
+from esphome.components.network import register_connection_provider
+from esphome.config import read_config
+from esphome.const import (
+    KEY_CONNECTION_PROVIDER_ADDRESS,
+    KEY_CORE,
+    KEY_TARGET_FRAMEWORK,
+    KEY_TARGET_PLATFORM,
+)
+from esphome.core import CORE, EsphomeError
+from esphome.storage_json import StorageJSON, storage_path
+from esphome.types import ConfigType
+
+EXAMPLE = Path(
+    os.environ.get(
+        "PROVIDER_TEST_EXAMPLE", Path(__file__).parent / "fixtures/components"
+    )
+).resolve()
+
+
+class ConnectionProviderTests(unittest.TestCase):
+    def setUp(self) -> None:
+        CORE.reset()
+        self.directory = tempfile.TemporaryDirectory(prefix="connection-provider-")
+        self.addCleanup(self.directory.cleanup)
+        self.config_path = Path(self.directory.name) / "provider.yaml"
+        self.config_path.write_text("# Synthetic, no secrets\n", encoding="utf-8")
+        self.base_core()
+
+    def tearDown(self) -> None:
+        CORE.reset()
+
+    def base_core(self, *, suffix: bool = False) -> None:
+        CORE.config_path = self.config_path
+        CORE.name = "provider-node"
+        CORE.build_path = Path(self.directory.name) / "build"
+        CORE.data[KEY_CORE] = {
+            KEY_TARGET_PLATFORM: "host",
+            KEY_TARGET_FRAMEWORK: "host",
+        }
+        CORE.config = {
+            "esphome": {"name": CORE.name, "name_add_mac_suffix": suffix},
+            "api": {},
+            "ota": [{"platform": "esphome"}],
+        }
+
+    def validated(self, *, suffix: bool = False) -> ConfigType:
+        CORE.reset()
+        config = {
+            "esphome": {"name": "provider-node", "name_add_mac_suffix": suffix},
+            "esp32": {
+                "board": "esp32-s3-devkitc-1",
+                "variant": "esp32s3",
+                "framework": {"type": "esp-idf", "version": "5.5.5"},
+            },
+            "external_components": [
+                {
+                    "source": {"type": "local", "path": str(EXAMPLE)},
+                    "components": ["generic_provider"],
+                }
+            ],
+            "generic_provider": {},
+            "logger": {},
+            "api": {},
+            "ota": [{"platform": "esphome"}],
+        }
+        self.config_path.write_text(
+            yaml.safe_dump(config, sort_keys=False), encoding="utf-8"
+        )
+        CORE.config_path = self.config_path
+        validated = read_config({})
+        self.assertIsNotNone(validated)
+        CORE.config = validated
+        return validated
+
+    def assert_default_cli(self, expected: str = "provider-node.local") -> None:
+        for purpose in (cli.Purpose.UPLOADING, cli.Purpose.LOGGING):
+            with self.subTest(purpose=purpose):
+                self.assertEqual(
+                    cli.choose_upload_log_host("OTA", None, purpose), [expected]
+                )
+
+    def cache_and_reset(self) -> Path:
+        config = CORE.config
+        sidecar = StorageJSON.from_esphome_core(CORE, None, claim_build=False)
+        sidecar.save(storage_path())
+        save_compiled_config(config)
+        cache_path = compiled_config_path(self.config_path.name)
+        CORE.reset()
+        CORE.config_path = self.config_path
+        return cache_path
+
+    def test_unregistered_network_component_is_not_connectivity(self) -> None:
+        CORE.config["network"] = {}
+        self.assertIsNone(CORE.address)
+        self.assertFalse(CORE.has_networking)
+        with self.assertRaises(EsphomeError):
+            cli.choose_upload_log_host("OTA", None, cli.Purpose.UPLOADING)
+        self.assertEqual(
+            cli.choose_upload_log_host("known-node.local", None, cli.Purpose.UPLOADING),
+            ["known-node.local"],
+        )
+
+    def test_native_interfaces_retain_every_existing_priority(self) -> None:
+        interfaces = ("wifi", "ethernet", "openthread")
+        for count in range(1, 4):
+            for selected in combinations(interfaces, count):
+                for provider in (False, True):
+                    with self.subTest(selected=selected, provider=provider):
+                        CORE.reset()
+                        self.base_core()
+                        for native in selected:
+                            CORE.config[native] = {"use_address": f"{native}.example"}
+                        if provider:
+                            register_connection_provider()
+                        self.assertEqual(CORE.address, f"{selected[0]}.example")
+                        self.assertTrue(CORE.has_networking)
+                        self.assert_default_cli(f"{selected[0]}.example")
+
+    def test_registration_is_idempotent_and_core_reset_clears_it(self) -> None:
+        register_connection_provider()
+        register_connection_provider()
+        self.assertEqual(CORE.address, "provider-node.local")
+        self.assertTrue(CORE.has_networking)
+        self.assertEqual(CORE.data[KEY_CONNECTION_PROVIDER_ADDRESS], CORE.address)
+        CORE.reset()
+        self.base_core()
+        self.assertIsNone(CORE.address)
+        self.assertFalse(CORE.has_networking)
+
+    def test_real_cold_validation_cli_and_storage_without_native_interfaces(
+        self,
+    ) -> None:
+        config = self.validated()
+        self.assertFalse(any(n in config for n in ("wifi", "ethernet", "openthread")))
+        self.assertEqual(CORE.address, "provider-node.local")
+        self.assertTrue(CORE.has_networking)
+        self.assert_default_cli()
+        sidecar = StorageJSON.from_esphome_core(CORE, None, claim_build=False)
+        self.assertEqual(json.loads(sidecar.to_json())["address"], CORE.address)
+        sidecar.save(storage_path())
+        self.assertEqual(StorageJSON.load(storage_path()).address, CORE.address)
+
+    def test_warm_cache_restores_provider_without_importing_validator(self) -> None:
+        self.validated()
+        cache_path = self.cache_and_reset()
+        envelope = json.loads(cache_path.read_text())
+        self.assertEqual(
+            envelope[KEY_CONNECTION_PROVIDER_ADDRESS], "provider-node.local"
+        )
+        config = load_compiled_config(self.config_path)
+        self.assertIsNotNone(config)
+        CORE.config = config
+        self.assertEqual(CORE.address, "provider-node.local")
+        self.assertTrue(CORE.has_networking)
+        self.assert_default_cli()
+
+    def test_non_provider_cache_does_not_inherit_provider_metadata(self) -> None:
+        cache_path = self.cache_and_reset()
+        self.assertIsNone(
+            json.loads(cache_path.read_text())[KEY_CONNECTION_PROVIDER_ADDRESS]
+        )
+        CORE.data[KEY_CONNECTION_PROVIDER_ADDRESS] = "stale.local"
+        CORE.config = load_compiled_config(self.config_path)
+        self.assertIsNotNone(CORE.config)
+        self.assertIsNone(CORE.address)
+        self.assertFalse(CORE.has_networking)
+
+    def test_old_cache_and_malformed_provider_metadata_fall_back_to_validation(
+        self,
+    ) -> None:
+        register_connection_provider()
+        cache_path = self.cache_and_reset()
+        original = json.loads(cache_path.read_text())
+        for value in ([], {}, "", 42):
+            with self.subTest(value=value):
+                modified = dict(original, **{KEY_CONNECTION_PROVIDER_ADDRESS: value})
+                cache_path.write_text(json.dumps(modified), encoding="utf-8")
+                self.assertIsNone(load_compiled_config(self.config_path))
+        original["v"] = 1
+        cache_path.write_text(json.dumps(original), encoding="utf-8")
+        self.assertIsNone(load_compiled_config(self.config_path))
+
+    def test_name_mac_suffix_uses_existing_cli_discovery_cold_and_warm(self) -> None:
+        self.validated(suffix=True)
+        for warm in (False, True):
+            with self.subTest(warm=warm):
+                if warm:
+                    self.cache_and_reset()
+                    CORE.config = load_compiled_config(self.config_path)
+                    self.assertIsNotNone(CORE.config)
+                discovered = {"provider-node-aabbcc.local": ["2001:db8::123"]}
+                with patch(
+                    "esphome.zeroconf.discover_mdns_devices", return_value=discovered
+                ) as lookup:
+                    self.assert_default_cli("provider-node-aabbcc.local")
+                self.assertEqual(lookup.call_count, 2)
+                self.assertEqual(
+                    CORE.address_cache.get_addresses("provider-node-aabbcc.local"),
+                    ["2001:db8::123"],
+                )
+
+    def test_mac_suffix_no_match_does_not_fall_back_to_nonexistent_base(self) -> None:
+        self.base_core(suffix=True)
+        register_connection_provider()
+        with (
+            patch("esphome.zeroconf.discover_mdns_devices", return_value={}),
+            self.assertRaises(EsphomeError),
+        ):
+            cli.choose_upload_log_host("OTA", None, cli.Purpose.UPLOADING)
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
