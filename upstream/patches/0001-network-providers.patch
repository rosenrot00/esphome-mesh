diff --git a/esphome/components/network/connection_provider.cpp b/esphome/components/network/connection_provider.cpp
new file mode 100644
index 000000000..7607a59a0
--- /dev/null
+++ b/esphome/components/network/connection_provider.cpp
@@ -0,0 +1,65 @@
+#include "connection_provider.h"
+#if defined(USE_NETWORK) && defined(USE_NETWORK_PROVIDERS)
+
+namespace esphome::network {
+
+bool ConnectionProviderRegistry::register_provider(ConnectionProvider *provider, uint8_t priority) {
+  if (provider == nullptr || this->size_ == CAPACITY)
+    return false;
+  for (size_t i = 0; i < this->size_; ++i) {
+    if (this->entries_[i].provider == provider)
+      return false;
+  }
+  size_t position = this->size_;
+  while (position != 0 && this->entries_[position - 1].priority > priority) {
+    this->entries_[position] = this->entries_[position - 1];
+    --position;
+  }
+  this->entries_[position] = {provider, priority};
+  ++this->size_;
+  return true;
+}
+
+bool ConnectionProviderRegistry::unregister_provider(ConnectionProvider *provider) {
+  for (size_t i = 0; i < this->size_; ++i) {
+    if (this->entries_[i].provider != provider)
+      continue;
+    for (size_t j = i + 1; j < this->size_; ++j)
+      this->entries_[j - 1] = this->entries_[j];
+    this->entries_[--this->size_] = {};
+    return true;
+  }
+  return false;
+}
+
+bool ConnectionProviderRegistry::has_enabled_provider() const {
+  for (size_t i = 0; i < this->size_; ++i) {
+    if (this->entries_[i].provider->network_state().enabled)
+      return true;
+  }
+  return false;
+}
+
+bool ConnectionProviderRegistry::connected_addresses(IPAddresses &addresses) const {
+  for (size_t i = 0; i < this->size_; ++i) {
+    const auto state = this->entries_[i].provider->network_state();
+    if (!state.enabled || !state.connected)
+      continue;
+    for (const auto &address : state.addresses) {
+      if (!address.is_set())
+        continue;
+      addresses = state.addresses;
+      return true;
+    }
+  }
+  addresses = {};
+  return false;
+}
+
+ConnectionProviderRegistry &connection_provider_registry() {
+  static ConnectionProviderRegistry registry;
+  return registry;
+}
+
+}  // namespace esphome::network
+#endif
diff --git a/esphome/components/network/connection_provider.h b/esphome/components/network/connection_provider.h
new file mode 100644
index 000000000..d68209c62
--- /dev/null
+++ b/esphome/components/network/connection_provider.h
@@ -0,0 +1,56 @@
+#pragma once
+
+#include "esphome/core/defines.h"
+#if defined(USE_NETWORK) && defined(USE_NETWORK_PROVIDERS)
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include "ip_address.h"
+
+namespace esphome::network {
+
+// Proposed generic extension boundary for additional ESPHome network interfaces.
+// Providers are independent of mesh and of any specific network SDK. Providers own their platform
+// routing/netif work; this contract only reports lifecycle and usable addresses.
+struct ConnectionProviderState {
+  // Enabled means the interface is allowed to establish a connection. It may be
+  // enabled while disconnected, just like an enabled Wi-Fi interface.
+  bool enabled{false};
+  bool connected{false};
+  IPAddresses addresses{};
+};
+
+class ConnectionProvider {
+ public:
+  virtual ~ConnectionProvider() = default;
+  virtual ConnectionProviderState network_state() const = 0;
+};
+
+// Bounded, allocation-free registration. Mutations and network utility queries
+// belong to ESPHome's application context; registration is not an ISR API.
+// Providers must unregister before destruction. A snapshot callback must not
+// mutate this registry. Priority 0 wins; equal priorities retain registration
+// order. Providers are fallback paths after native interfaces; priorities order only
+// registered providers. The network utility layer owns native precedence.
+class ConnectionProviderRegistry {
+ public:
+  static constexpr size_t CAPACITY = 4;
+  bool register_provider(ConnectionProvider *provider, uint8_t priority);
+  bool unregister_provider(ConnectionProvider *provider);
+  bool has_providers() const { return this->size_ != 0; }
+  bool has_enabled_provider() const;
+  bool connected_addresses(IPAddresses &addresses) const;
+
+ private:
+  struct Entry {
+    ConnectionProvider *provider{nullptr};
+    uint8_t priority{0};
+  };
+  std::array<Entry, CAPACITY> entries_{};
+  size_t size_{0};
+};
+
+ConnectionProviderRegistry &connection_provider_registry();
+
+}  // namespace esphome::network
+#endif
