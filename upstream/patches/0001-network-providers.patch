+#include <gtest/gtest.h>
+
+#include <array>
+
+#include "esphome/components/network/connection_provider.h"
+#include "esphome/components/network/util.h"
+
+#if defined(USE_NETWORK) && defined(USE_NETWORK_PROVIDERS)
+namespace esphome::network::testing {
+
+class TestConnectionProvider : public ConnectionProvider {
+ public:
+  ConnectionProviderState state{};
+
+  ConnectionProviderState network_state() const override { return this->state; }
+};
+
+class ConnectionProviderRegistryTest : public ::testing::Test {
+ protected:
+  void TearDown() override {
+    for (auto &provider : this->providers_)
+      this->registry_.unregister_provider(&provider);
+  }
+
+  void connect(size_t index, const char *address) {
+    auto &state = this->providers_[index].state;
+    state.enabled = true;
+    state.connected = true;
+    state.addresses[0] = IPAddress(address);
+  }
+
+  std::array<TestConnectionProvider, ConnectionProviderRegistry::CAPACITY + 1> providers_{};
+  ConnectionProviderRegistry registry_{};
+};
+
+TEST_F(ConnectionProviderRegistryTest, EmptyRegistryClearsPreviousAddresses) {
+  IPAddresses addresses{};
+  addresses[0] = IPAddress("192.0.2.1");
+
+  EXPECT_FALSE(this->registry_.has_providers());
+  EXPECT_FALSE(this->registry_.has_enabled_provider());
+  EXPECT_FALSE(this->registry_.connected_addresses(addresses));
+  for (const auto &address : addresses)
+    EXPECT_FALSE(address.is_set());
+}
+
+TEST_F(ConnectionProviderRegistryTest, RejectsNullAndDuplicateWithoutChangingPriority) {
+  this->connect(0, "192.0.2.1");
+  this->connect(1, "192.0.2.2");
+  EXPECT_FALSE(this->registry_.register_provider(nullptr, 0));
+  ASSERT_TRUE(this->registry_.register_provider(&this->providers_[0], 100));
+  EXPECT_FALSE(this->registry_.register_provider(&this->providers_[0], 0));
+  ASSERT_TRUE(this->registry_.register_provider(&this->providers_[1], 50));
+
+  IPAddresses addresses{};
+  ASSERT_TRUE(this->registry_.connected_addresses(addresses));
+  EXPECT_EQ(addresses[0], IPAddress("192.0.2.2"));
+}
+
+TEST_F(ConnectionProviderRegistryTest, CapacityCanBeReusedAfterUnregister) {
+  for (size_t i = 0; i < ConnectionProviderRegistry::CAPACITY; ++i)
+    ASSERT_TRUE(this->registry_.register_provider(&this->providers_[i], 100));
+  auto &replacement = this->providers_.back();
+  replacement.state.enabled = true;
+  replacement.state.connected = true;
+  replacement.state.addresses[0] = IPAddress("192.0.2.9");
+  EXPECT_FALSE(this->registry_.register_provider(&replacement, 0));
+  ASSERT_TRUE(this->registry_.unregister_provider(&this->providers_[1]));
+  ASSERT_TRUE(this->registry_.register_provider(&replacement, 0));
+
+  IPAddresses addresses{};
+  ASSERT_TRUE(this->registry_.connected_addresses(addresses));
+  EXPECT_EQ(addresses[0], IPAddress("192.0.2.9"));
+}
+
+TEST_F(ConnectionProviderRegistryTest, UnregisterPreservesOtherProviders) {
+  this->connect(0, "192.0.2.1");
+  this->connect(1, "192.0.2.2");
+  ASSERT_TRUE(this->registry_.register_provider(&this->providers_[0], 0));
+  ASSERT_TRUE(this->registry_.register_provider(&this->providers_[1], 1));
+  EXPECT_FALSE(this->registry_.unregister_provider(nullptr));
+  EXPECT_FALSE(this->registry_.unregister_provider(&this->providers_[2]));
+  ASSERT_TRUE(this->registry_.unregister_provider(&this->providers_[0]));
+  EXPECT_FALSE(this->registry_.unregister_provider(&this->providers_[0]));
+
+  IPAddresses addresses{};
+  ASSERT_TRUE(this->registry_.connected_addresses(addresses));
+  EXPECT_EQ(addresses[0], IPAddress("192.0.2.2"));
+  ASSERT_TRUE(this->registry_.unregister_provider(&this->providers_[1]));
+  EXPECT_FALSE(this->registry_.has_providers());
+  EXPECT_FALSE(this->registry_.has_enabled_provider());
+  EXPECT_FALSE(this->registry_.connected_addresses(addresses));
+  EXPECT_FALSE(addresses[0].is_set());
+}
+
+TEST_F(ConnectionProviderRegistryTest, LowestPriorityWinsAndEqualPriorityIsStable) {
+  this->connect(0, "192.0.2.1");
+  this->connect(1, "192.0.2.2");
+  this->connect(2, "192.0.2.3");
+  ASSERT_TRUE(this->registry_.register_provider(&this->providers_[0], 20));
+  ASSERT_TRUE(this->registry_.register_provider(&this->providers_[1], 0));
+  ASSERT_TRUE(this->registry_.register_provider(&this->providers_[2], 0));
+
+  IPAddresses addresses{};
+  ASSERT_TRUE(this->registry_.connected_addresses(addresses));
+  EXPECT_EQ(addresses[0], IPAddress("192.0.2.2"));
+  ASSERT_TRUE(this->registry_.unregister_provider(&this->providers_[1]));
+  ASSERT_TRUE(this->registry_.connected_addresses(addresses));
+  EXPECT_EQ(addresses[0], IPAddress("192.0.2.3"));
+}
+
+TEST_F(ConnectionProviderRegistryTest, EnabledDoesNotImplyConnected) {
+  auto &state = this->providers_[0].state;
+  state.enabled = true;
+  state.addresses[0] = IPAddress("192.0.2.1");
+  ASSERT_TRUE(this->registry_.register_provider(&this->providers_[0], 0));
+
+  IPAddresses addresses{};
+  EXPECT_TRUE(this->registry_.has_enabled_provider());
+  EXPECT_FALSE(this->registry_.connected_addresses(addresses));
+  state.connected = true;
+  ASSERT_TRUE(this->registry_.connected_addresses(addresses));
+  EXPECT_EQ(addresses[0], IPAddress("192.0.2.1"));
+  state.enabled = false;
+  EXPECT_FALSE(this->registry_.has_enabled_provider());
+  EXPECT_FALSE(this->registry_.connected_addresses(addresses));
+  EXPECT_FALSE(addresses[0].is_set());
+}
+
+TEST_F(ConnectionProviderRegistryTest, MissingUsableAddressFallsBackToNextProvider) {
+  auto &preferred = this->providers_[0].state;
+  preferred.enabled = true;
+  preferred.connected = true;
+  this->connect(1, "192.0.2.2");
+  ASSERT_TRUE(this->registry_.register_provider(&this->providers_[0], 0));
+  ASSERT_TRUE(this->registry_.register_provider(&this->providers_[1], 10));
+
+  IPAddresses addresses{};
+  ASSERT_TRUE(this->registry_.connected_addresses(addresses));
+  EXPECT_EQ(addresses[0], IPAddress("192.0.2.2"));
+  preferred.addresses[0] = IPAddress("192.0.2.1");
+  ASSERT_TRUE(this->registry_.connected_addresses(addresses));
+  EXPECT_EQ(addresses[0], IPAddress("192.0.2.1"));
+}
+
+TEST_F(ConnectionProviderRegistryTest, DisconnectionDoesNotReturnStaleAddresses) {
+  this->connect(0, "192.0.2.1");
+  ASSERT_TRUE(this->registry_.register_provider(&this->providers_[0], 0));
+  IPAddresses addresses{};
+  ASSERT_TRUE(this->registry_.connected_addresses(addresses));
+  this->providers_[0].state.connected = false;
+
+  EXPECT_TRUE(this->registry_.has_enabled_provider());
+  EXPECT_FALSE(this->registry_.connected_addresses(addresses));
+  for (const auto &address : addresses)
+    EXPECT_FALSE(address.is_set());
+}
+
+#ifdef USE_HOST
+TEST_F(ConnectionProviderRegistryTest, DisabledProviderDoesNotDisableHostNetwork) {
+  auto &registry = connection_provider_registry();
+  auto &provider = this->providers_[0];
+  provider.state.enabled = false;
+  ASSERT_TRUE(registry.register_provider(&provider, 0));
+
+  EXPECT_FALSE(is_disabled());
+
+  EXPECT_TRUE(registry.unregister_provider(&provider));
+}
+#endif
+
+#if USE_NETWORK_IPV6
+TEST_F(ConnectionProviderRegistryTest, IPv6OnlyAddressInLastSlotIsUsable) {
+  auto &state = this->providers_[0].state;
+  state.enabled = true;
+  state.connected = true;
+  state.addresses.back() = IPAddress("2001:db8::1");
+  ASSERT_TRUE(this->registry_.register_provider(&this->providers_[0], 0));
+
+  IPAddresses addresses{};
+  ASSERT_TRUE(this->registry_.connected_addresses(addresses));
+  EXPECT_EQ(addresses, state.addresses);
+  EXPECT_TRUE(addresses.back().is_ip6());
+  EXPECT_FALSE(addresses[0].is_set());
+}
+
+TEST_F(ConnectionProviderRegistryTest, ReturnsCompleteDualStackSnapshot) {
+  this->connect(0, "192.0.2.1");
+  this->providers_[0].state.addresses[1] = IPAddress("2001:db8::1");
+  this->providers_[0].state.addresses[4] = IPAddress("fe80::1");
+  ASSERT_TRUE(this->registry_.register_provider(&this->providers_[0], 0));
+
+  IPAddresses addresses{};
+  ASSERT_TRUE(this->registry_.connected_addresses(addresses));
+  EXPECT_EQ(addresses, this->providers_[0].state.addresses);
+}
+#endif
+
+}  // namespace esphome::network::testing
+#endif
