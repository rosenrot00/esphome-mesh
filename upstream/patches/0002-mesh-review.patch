+TEST(MeshIpDelivery, ReplayLookaheadWrapsAndRetainsNewAcceptedOriginal) {
+  Network network;
+  const auto old_packet = bytes(1500, 81), expected = bytes(40, 93);
+  auto newer_packet = expected;
+  unsigned lost = 0;
+  const uint32_t old_id = UINT32_MAX - 30, new_id = 33;  // Modular distance 64.
+  network.drop = [&](const Message &message) {
+    return !message.ack && packet_id(message.payload) == old_id && message.payload[10] == 0 && lost++ < 2;
+  };
+  ASSERT_TRUE(network.a.delivery.begin(2, old_packet.data(), old_packet.size(), old_id, 0));
+  ASSERT_TRUE(network.a.delivery.begin(2, newer_packet.data(), newer_packet.size(), new_id, 0));
+  newer_packet.assign(newer_packet.size(), 0);
+  network.run(0, 500);
+  ASSERT_TRUE(network.a.delivery.pending_count() == 2 && network.b.delivered.empty());
+  ASSERT_TRUE(std::none_of(network.history.begin(), network.history.end(), [&](const Message &message) {
+    return !message.ack && packet_id(message.payload) == new_id;
+  }));
+  network.run(500, 1000);
+  ASSERT_TRUE(network.b.delivered.size() == 2 && network.b.delivered[0] == old_packet &&
+              network.b.delivered[1] == expected);
+  ASSERT_TRUE(network.a.delivery.counters().acknowledged == 2 && network.a.delivery.counters().window_stalls == 1);
+}
