+namespace {
+class MeshGuard {
+ public:
+  explicit MeshGuard(SemaphoreHandle_t mutex) : mutex_(mutex) {
+    if (mutex_ != nullptr)
+      xSemaphoreTakeRecursive(mutex_, portMAX_DELAY);
+  }
+  ~MeshGuard() {
+    if (mutex_ != nullptr)
+      xSemaphoreGiveRecursive(mutex_);
+  }
+
+ private:
+  SemaphoreHandle_t mutex_;
+};
