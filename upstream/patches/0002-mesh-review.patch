+EndpointAdvertisement mesh_advertisement() {
+  EndpointAdvertisement result;
+  result.nonce = 0x0807060504030201ULL;
+  result.session = 0x1817161514131211ULL;
+  result.lease_id = 0x24232221U;
+  result.mode = EndpointMode::MESH;
+  result.address = 0xc0a80179U;
+  result.netmask = 0xffffff00U;
+  result.router = 0xc0a80101U;
+  result.server = 0xc0a80102U;
+  result.remaining_seconds = 0x34333231U;
+  return result;
+}
+std::array<uint8_t, ENDPOINT_RESPONSE_SIZE> encode(const EndpointAdvertisement &advertisement) {
+  std::array<uint8_t, ENDPOINT_RESPONSE_SIZE> bytes{};
+  size_t written = 99;
+  assert(encode_endpoint_advertisement(advertisement, bytes.data(), bytes.size(), written));
+  assert(written == bytes.size());
+  return bytes;
+}
+void rejects(const EndpointAdvertisement &advertisement) {
+  std::array<uint8_t, ENDPOINT_RESPONSE_SIZE> bytes{};
+  bytes.fill(0xa5);
+  const auto original = bytes;
+  size_t written = 99;
+  assert(!encode_endpoint_advertisement(advertisement, bytes.data(), bytes.size(), written));
+  assert(written == 0 && bytes == original);
+}
+TEST(MeshEndpoint, ChallengeWireAndBounds) {
+  std::array<uint8_t, 11> bytes{};
+  bytes.fill(0xa5);
+  size_t written = 99;
+  ASSERT_TRUE(encode_endpoint_challenge(0x0807060504030201ULL, bytes.data(), bytes.size(), written));
+  ASSERT_TRUE(written == ENDPOINT_CHALLENGE_SIZE && bytes[10] == 0xa5);
+  ASSERT_TRUE(bytes[0] == 1 && bytes[1] == 10);
+  for (size_t i = 0; i < 8; i++)
+    ASSERT_TRUE(bytes[i + 2] == i + 1);
+  uint64_t nonce = 99;
+  ASSERT_TRUE(decode_endpoint_challenge(bytes.data(), 10, nonce));
+  ASSERT_TRUE(nonce == 0x0807060504030201ULL);
+  for (size_t length = 0; length <= bytes.size(); length++) {
+    if (length == 10)
+      continue;
+    nonce = 99;
+    ASSERT_TRUE(!decode_endpoint_challenge(bytes.data(), length, nonce) && nonce == 99);
+  }
+  ASSERT_TRUE(!decode_endpoint_challenge(nullptr, 10, nonce));
+  ASSERT_TRUE(!encode_endpoint_challenge(0, bytes.data(), bytes.size(), written) && written == 0);
+  ASSERT_TRUE(!encode_endpoint_challenge(1, nullptr, 10, written) && written == 0);
+  for (size_t capacity = 0; capacity < 10; capacity++)
+    ASSERT_TRUE(!encode_endpoint_challenge(1, bytes.data(), capacity, written) && written == 0);
+  bytes[0] = 2;
+  ASSERT_TRUE(!decode_endpoint_challenge(bytes.data(), 10, nonce));
+  bytes[0] = 1;
+  bytes[1] = 11;
+  ASSERT_TRUE(!decode_endpoint_challenge(bytes.data(), 10, nonce));
+  bytes[1] = 10;
+  for (size_t i = 2; i < 10; i++)
+    bytes[i] = 0;
+  ASSERT_TRUE(!decode_endpoint_challenge(bytes.data(), 10, nonce));
+}
+TEST(MeshEndpoint, ResponseWireAndRoundtrip) {
+  const auto advertisement = mesh_advertisement();
+  const auto bytes = encode(advertisement);
+  const std::array<uint8_t, ENDPOINT_RESPONSE_SIZE> expected{
+      1,    11,   1,    2,    3,    4,    5,    6, 7,   8,    0x11, 0x12, 0x13, 0x14, 0x15,
+      0x16, 0x17, 0x18, 0x21, 0x22, 0x23, 0x24, 1, 192, 168,  1,    121,  255,  255,  255,
+      0,    192,  168,  1,    1,    192,  168,  1, 2,   0x31, 0x32, 0x33, 0x34};
+  ASSERT_TRUE(bytes == expected);
+  EndpointAdvertisement decoded;
+  ASSERT_TRUE(decode_endpoint_advertisement(bytes.data(), bytes.size(), decoded));
+  ASSERT_TRUE(decoded.nonce == advertisement.nonce && decoded.session == advertisement.session);
+  ASSERT_TRUE(decoded.lease_id == advertisement.lease_id && decoded.mode == EndpointMode::MESH);
+  ASSERT_TRUE(decoded.address == advertisement.address && decoded.netmask == advertisement.netmask);
+  ASSERT_TRUE(decoded.router == advertisement.router && decoded.server == advertisement.server);
+  ASSERT_TRUE(decoded.remaining_seconds == advertisement.remaining_seconds);
+}
+TEST(MeshEndpoint, ResponseBoundsAndInvalidHeaders) {
+  const auto original = encode(mesh_advertisement());
+  std::array<uint8_t, ENDPOINT_RESPONSE_SIZE + 1> bytes{};
+  for (size_t i = 0; i < original.size(); i++)
+    bytes[i] = original[i];
+  EndpointAdvertisement decoded;
+  decoded.session = 99;
+  for (size_t length = 0; length <= bytes.size(); length++) {
+    if (length == ENDPOINT_RESPONSE_SIZE)
+      continue;
+    ASSERT_TRUE(!decode_endpoint_advertisement(bytes.data(), length, decoded) && decoded.session == 99);
+  }
+  ASSERT_TRUE(!decode_endpoint_advertisement(nullptr, ENDPOINT_RESPONSE_SIZE, decoded));
+  size_t written = 99;
+  ASSERT_TRUE(!encode_endpoint_advertisement(mesh_advertisement(), nullptr, 43, written) && written == 0);
+  for (size_t capacity = 0; capacity < ENDPOINT_RESPONSE_SIZE; capacity++)
+    ASSERT_TRUE(!encode_endpoint_advertisement(mesh_advertisement(), bytes.data(), capacity, written) && written == 0);
+  bytes[0] = 2;
+  ASSERT_TRUE(!decode_endpoint_advertisement(bytes.data(), 43, decoded));
+  bytes[0] = 1;
+  bytes[1] = 10;
+  ASSERT_TRUE(!decode_endpoint_advertisement(bytes.data(), 43, decoded));
+  bytes[1] = 11;
+  for (uint16_t mode = 4; mode <= 255; mode++) {
+    bytes[22] = uint8_t(mode);
+    ASSERT_TRUE(!decode_endpoint_advertisement(bytes.data(), 43, decoded));
+  }
+}
+TEST(MeshEndpoint, MeshRequiresIdentityAndLease) {
+  auto advertisement = mesh_advertisement();
+  advertisement.nonce = 0;
+  rejects(advertisement);
+  advertisement = mesh_advertisement();
+  advertisement.session = 0;
+  rejects(advertisement);
+  advertisement = mesh_advertisement();
+  advertisement.lease_id = 0;
+  rejects(advertisement);
+  advertisement = mesh_advertisement();
+  advertisement.remaining_seconds = 0;
+  rejects(advertisement);
+  const uint32_t invalid_unicast[]{0, 0x00010203U, 0x7f000001U, 0xe0000001U, 0xffffffffU};
+  for (const uint32_t address : invalid_unicast) {
+    advertisement = mesh_advertisement();
+    advertisement.address = address;
+    rejects(advertisement);
+    advertisement = mesh_advertisement();
+    advertisement.server = address;
+    rejects(advertisement);
+    advertisement = mesh_advertisement();
+    advertisement.router = address;
+    rejects(advertisement);
+  }
+  const uint32_t invalid_masks[]{0, 0xffffffffU, 0xfffffffeU, 0xff00ff00U, 0x7fffffffU};
+  for (const uint32_t mask : invalid_masks) {
+    advertisement = mesh_advertisement();
+    advertisement.netmask = mask;
+    rejects(advertisement);
+  }
+  advertisement = mesh_advertisement();
+  advertisement.address = 0xc0a80100U;
+  rejects(advertisement);
+  advertisement = mesh_advertisement();
+  advertisement.address = 0xc0a801ffU;
+  rejects(advertisement);
+  const uint32_t invalid_routers[]{0xc0a80201U, 0xc0a80100U, 0xc0a801ffU, 0xc0a80179U};
+  for (const uint32_t router : invalid_routers) {
+    advertisement = mesh_advertisement();
+    advertisement.router = router;
+    rejects(advertisement);
+  }
+  // A DHCP server need not itself be on-link; its identity is not the router.
+  advertisement = mesh_advertisement();
+  advertisement.server = 0x0a010203U;
+  encode(advertisement);
+  advertisement.address = 0x0a000001U;
+  advertisement.router = 0x0a000002U;
+  advertisement.netmask = 0xfffffffcU;
+  encode(advertisement);
+  advertisement.netmask = 0x80000000U;
+  encode(advertisement);
+}
+TEST(MeshEndpoint, DecodeValidatesMeshPayloadAndPreservesOutput) {
+  const auto original = encode(mesh_advertisement());
+  // Zero each identity and lease field on the wire; the decoder must enforce
+  // the same constraints as the encoder rather than trust remote metadata.
+  const std::array<std::array<size_t, 2>, 8> fields{
+      {{2, 8}, {10, 8}, {18, 4}, {23, 4}, {27, 4}, {31, 4}, {35, 4}, {39, 4}}};
+  for (const auto &field : fields) {
+    auto bytes = original;
+    for (size_t i = 0; i < field[1]; i++)
+      bytes[field[0] + i] = 0;
+    EndpointAdvertisement decoded;
+    decoded.session = 99;
+    ASSERT_TRUE(!decode_endpoint_advertisement(bytes.data(), bytes.size(), decoded));
+    ASSERT_TRUE(decoded.session == 99);
+  }
+  auto bytes = original;
+  bytes[28] = 0;  // Noncontiguous 255.0.255.0.
+  EndpointAdvertisement decoded;
+  ASSERT_TRUE(!decode_endpoint_advertisement(bytes.data(), bytes.size(), decoded));
+  bytes = original;
+  bytes[33] = 2;  // Router is outside the advertised /24.
+  ASSERT_TRUE(!decode_endpoint_advertisement(bytes.data(), bytes.size(), decoded));
+}
+TEST(MeshEndpoint, NonMeshModesAreWithdrawals) {
+  for (const EndpointMode mode : {EndpointMode::NONE, EndpointMode::NATIVE, EndpointMode::QUIET}) {
+    EndpointAdvertisement advertisement;
+    advertisement.mode = mode;
+    auto bytes = encode(advertisement);
+    EndpointAdvertisement decoded;
+    ASSERT_TRUE(decode_endpoint_advertisement(bytes.data(), bytes.size(), decoded) && decoded.mode == mode);
+    // Diagnostic old lease data may remain, but it can never grant freshness.
+    advertisement = mesh_advertisement();
+    advertisement.mode = mode;
+    advertisement.remaining_seconds = 0;
+    encode(advertisement);
+    advertisement.remaining_seconds = 1;
+    rejects(advertisement);
+    bytes[39] = 1;
+    ASSERT_TRUE(!decode_endpoint_advertisement(bytes.data(), bytes.size(), decoded));
+  }
+  auto advertisement = mesh_advertisement();
+  advertisement.mode = static_cast<EndpointMode>(4);
+  rejects(advertisement);
+}
+TEST(MeshEndpoint, RegistryIdentityOnceAndIndependentSlots) {
+  ChallengeRegistry registry;
+  uint32_t age = 99;
+  ASSERT_TRUE(!registry.begin(0, 1, 100) && !registry.begin(17, 1, 100) && !registry.begin(1, 0, 100));
+  ASSERT_TRUE(!registry.consume(0, 1, 100, age) && age == 0);
+  ASSERT_TRUE(!registry.consume(17, 1, 100, age));
+  ASSERT_TRUE(!registry.consume(1, 1, 100, age));
+  for (uint8_t node = 1; node <= 16; node++)
+    ASSERT_TRUE(registry.begin(node, 1000 + node, 100 + node));
+  ASSERT_TRUE(!registry.consume(3, 0, 200, age));
+  ASSERT_TRUE(!registry.consume(3, 1002, 200, age));
+  ASSERT_TRUE(registry.consume(3, 1003, 200, age) && age == 97);
+  ASSERT_TRUE(!registry.consume(3, 1003, 201, age) && age == 0);
+  for (uint8_t node = 1; node <= 16; node++) {
+    if (node == 3)
+      continue;
+    ASSERT_TRUE(registry.consume(node, 1000 + node, 200, age) && age == uint32_t(100 - node));
+  }
+  ASSERT_TRUE(registry.begin(3, 2003, 202));
+  ASSERT_TRUE(!registry.consume(3, 1003, 203, age));
+  ASSERT_TRUE(registry.consume(3, 2003, 204, age) && age == 2);
+}
+TEST(MeshEndpoint, RegistryNoReplacementOrDeadlineExtension) {
+  ChallengeRegistry registry;
+  uint32_t age = 0;
+  ASSERT_TRUE(registry.begin(1, 100, 1000));
+  ASSERT_TRUE(!registry.begin(1, 100, 1000));
+  ASSERT_TRUE(!registry.begin(1, 101, 2999));
+  ASSERT_TRUE(!registry.consume(1, 101, 2999, age));
+  ASSERT_TRUE(registry.consume(1, 100, 2999, age) && age == 1999);
+  ASSERT_TRUE(registry.begin(1, 102, 4000));
+  ASSERT_TRUE(!registry.begin(1, 103, 5999));
+  ASSERT_TRUE(registry.begin(1, 103, 6000));
+  ASSERT_TRUE(!registry.consume(1, 102, 6001, age));
+  ASSERT_TRUE(registry.consume(1, 103, 6001, age) && age == 1);
+}
+TEST(MeshEndpoint, RegistryExpiryAndClockWrap) {
+  ChallengeRegistry registry;
+  uint32_t age = 0;
+  ASSERT_TRUE(registry.begin(1, 100, 500));
+  ASSERT_TRUE(!registry.consume(1, 100, 2500, age) && age == 0);
+  ASSERT_TRUE(!registry.consume(1, 100, 2501, age));
+  ASSERT_TRUE(registry.begin(1, 101, 2501));
+  ASSERT_TRUE(registry.consume(1, 101, 2501, age) && age == 0);
+  constexpr uint32_t near_wrap = 0xfffffff0U;
+  ASSERT_TRUE(registry.begin(2, 200, near_wrap));
+  ASSERT_TRUE(!registry.begin(2, 201, near_wrap + 1999));
+  ASSERT_TRUE(registry.consume(2, 200, near_wrap + 1999, age) && age == 1999);
+  ASSERT_TRUE(registry.begin(2, 201, near_wrap));
+  ASSERT_TRUE(!registry.consume(2, 201, near_wrap + 2000, age));
+  ASSERT_TRUE(registry.begin(2, 202, near_wrap + 2000));
+  ASSERT_TRUE(registry.consume(2, 202, near_wrap + 2001, age) && age == 1);
+  // A backwards timestamp cannot create a negative age and pass validation.
+  ASSERT_TRUE(registry.begin(4, 400, 1000));
+  ASSERT_TRUE(!registry.consume(4, 400, 999, age));
