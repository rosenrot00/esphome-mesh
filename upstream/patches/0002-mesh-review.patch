+TEST(MeshCore, DiscoverySequenceDistanceFenceWrapAndExpiredRebootBaseline) {
+  for (const bool wrap : {false, true}) {
+    Harness h;
+    h.link(4, 2);
+    h.link(4, 3);
+    h.node(4).set_direct_uplink(true, 0);
+    h.run(0, 100);
+    const auto offer = [&](NodeId sender, uint16_t sequence, uint8_t ttl, uint32_t now) {
+      Frame frame;
+      frame.type = FrameType::ROUTE_REQUEST;
+      frame.source = 1;
+      frame.destination = 6;
+      frame.sequence = sequence;
+      frame.ttl = ttl;
+      h.node(4).receive(sender, frame, now);
+      h.packets.clear();
+    };
+    const auto expect = [&](NodeId hop, uint32_t now) {
+      const uint8_t command = 1;
+      ASSERT_TRUE(h.node(4).send_control(1, 901, &command, 1, now));
+      ASSERT_TRUE(h.offers.back().from == 4 && h.offers.back().to == hop);
+      h.packets.clear();
+    };
+    const uint16_t initial = wrap ? 65535 : 30000;
+    const uint16_t next = static_cast<uint16_t>(initial + 1), reboot = wrap ? 65535 : 1;
+    offer(2, initial, 5, 110);
+    expect(2, 110);
+    offer(3, initial, 6, 120);
+    expect(3, 120);  // Better duplicate updates, without a second flood.
+    offer(2, initial, 5, 125);
+    expect(3, 125);  // A longer same-generation path loses.
+    offer(2, next, 7, 130);
+    expect(2, 130);  // Source-owned counter wraps normally.
+    offer(3, reboot, 8, 140);
+    expect(2, 140);  // Even a shorter old generation loses.
+    Frame traffic;
+    traffic.source = 1;
+    traffic.destination = 4;
+    traffic.sequence = 800;
+    h.node(4).receive(3, traffic, 150);
+    expect(2, 150);
+    // Ordinary traffic must not extend the discovery fence indefinitely.
+    traffic.sequence++;
+    h.node(4).receive(2, advertisement(2, 0, 255, 0, 20), 2090);
+    h.node(4).receive(3, advertisement(3, 0, 255, 0, 20), 2090);
+    h.node(4).receive(2, traffic, 2100);
+    expect(2, 2100);
+    offer(3, reboot, 8, 2130);
+    expect(3, 2130);
+  }
+}
