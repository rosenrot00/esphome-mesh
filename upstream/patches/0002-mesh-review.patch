+TEST(MeshMembership, IncompatibleRelayedIdentityIsNotAdmittedOrFlooded) {
+  Fixture fixture;
+  Claim remote = claim(2, 2);
+  remote.protocol.provided &= ~mesh_protocol::IP_PACKET_ACK;
+  remote.protocol.required &= ~mesh_protocol::IP_PACKET_ACK;
+  const auto before = fixture.sent.size();
+  ASSERT_TRUE(!fixture.member.observe_verified(remote, 10));
+  ASSERT_TRUE(!deliver(fixture.member, announcement(remote), 20));
+  ASSERT_TRUE(fixture.member.find(remote.mac) == nullptr && fixture.sent.size() == before);
+  ASSERT_TRUE(fixture.member.counters().incompatible == 2);
+  remote.protocol = {};
+  ASSERT_TRUE(fixture.member.observe_verified(remote, 30));
+  ASSERT_TRUE(fixture.member.find(remote.mac) != nullptr);
+  // An incompatible claim must not evict an existing compatible owner.
+  Claim replacement = claim(3, 2);
+  replacement.protocol.endpoint_revision++;
+  ASSERT_TRUE(!deliver(fixture.member, announcement(replacement), 40));
+  ASSERT_TRUE(fixture.member.find(remote.mac) != nullptr && fixture.member.find(replacement.mac) == nullptr);
+}
