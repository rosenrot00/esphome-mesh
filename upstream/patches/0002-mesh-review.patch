+TEST(MeshMembership, InvalidWireAndFuzz) {
+  Message original = announcement(claim(7, 2));
+  auto bytes = wire(original);
+  Message decoded;
+  decoded.claim.sequence = 0x10203040;
+  for (size_t length = 0; length < bytes.size(); ++length)
+    ASSERT_TRUE(!decode_message(bytes.data(), length, decoded));
+  ASSERT_TRUE(decoded.claim.sequence == 0x10203040);
+  auto bad = bytes;
+  bad.push_back(0);
+  ASSERT_TRUE(!decode_message(bad.data(), bad.size(), decoded));
+  for (auto mutation : {std::pair<size_t, uint8_t>{0, 'X'},
+                        {1, 'X'},
+                        {2, 1},
+                        {3, 0x20},
+                        {3, 0x24},
+                        {4, 0},
+                        {4, 9},
+                        {5, 17},
+                        {6, 0x80},
+                        {6, kNativeUplink},
+                        {7, 3}}) {
+    bad = bytes;
+    bad[mutation.first] = mutation.second;
+    ASSERT_TRUE(!decode_message(bad.data(), bad.size(), decoded));
+  }
+  bad = bytes;
+  std::fill(bad.begin() + 13, bad.begin() + 29, 0);
+  ASSERT_TRUE(!decode_message(bad.data(), bad.size(), decoded));
+  original.type = MessageType::PROOF;
+  original.requester = mac(1);
+  original.challenge = 1;
+  bytes = wire(original);
+  bad = bytes;
+  std::fill(bad.begin() + 39, bad.end(), 0);
+  ASSERT_TRUE(!decode_message(bad.data(), bad.size(), decoded));
+  ASSERT_TRUE(!decode_message(nullptr, 47, decoded));
+
+  uint32_t state = 0xCAFEBABE;
+  for (size_t iteration = 0; iteration < 10000; ++iteration) {
+    bad = bytes;
+    state = state * 1664525U + 1013904223U;
+    bad[state % bad.size()] ^= static_cast<uint8_t>((state >> 16) | 1U);
+    const size_t length = iteration % 7 == 0 ? state % 49 : bad.size();
+    bad.resize(length);
+    if (decode_message(bad.data(), bad.size(), decoded))
+      ASSERT_TRUE(wire(decoded) == bad);
+  }
+}
