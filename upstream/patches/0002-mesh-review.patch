+TEST(MeshCore, DelayedDiscoveryGenerationsCannotCreateReverseRouteCycle) {
+  Harness h;
+  h.link(1, 6);
+  h.link(6, 2);
+  h.link(6, 5);
+  h.link(2, 3);
+  h.link(3, 5);
+  h.link(5, 2);
+  h.link(3, 4);
+  for (NodeId id : {1, 2, 3, 5})
+    h.node(id).set_direct_uplink(true, 0);
+  h.run(0, 100);
+  h.trace.clear();
+  const auto offer = [&](NodeId node, NodeId sender, uint16_t sequence, uint8_t ttl, uint32_t now) {
+    Frame frame;
+    frame.type = FrameType::ROUTE_REQUEST;
+    frame.source = 1;
+    frame.destination = 4;
+    frame.sequence = sequence;
+    frame.ttl = ttl;
+    h.node(node).receive(sender, frame, now);
+    h.packets.clear();
+  };
+  // Hold copies of earlier real flood generations, then deliver the newer
+  // path through the triangle before releasing the old copies out of order.
+  offer(2, 6, 1, 7, 110);
+  offer(5, 6, 2, 7, 120);
+  offer(5, 6, 3, 7, 130);
+  offer(3, 5, 3, 6, 131);
+  offer(2, 3, 3, 5, 132);
+  offer(3, 5, 2, 6, 133);
+  offer(5, 2, 1, 6, 134);
+  Frame old_traffic;
+  old_traffic.source = 1;
+  old_traffic.destination = 5;
+  old_traffic.sequence = 900;
+  h.node(5).receive(2, old_traffic, 135);
+  h.packets.clear();
+  const uint8_t command = 99;
+  ASSERT_TRUE(h.node(2).send_control(1, 999, &command, 1, 140));
+  h.pump(140);
+  ASSERT_TRUE(h.count_deliveries(1, FrameType::CONTROL, 999) == 1);
+  std::vector<std::pair<NodeId, NodeId>> path;
+  for (const auto &packet : h.trace)
+    if (packet.frame.type == FrameType::CONTROL && packet.frame.sequence == 999)
+      path.push_back({packet.from, packet.to});
+  const std::vector<std::pair<NodeId, NodeId>> expected{{2, 3}, {3, 5}, {5, 6}, {6, 1}};
+  ASSERT_TRUE(path == expected);  // The old code formed 2->3->5->2 instead.
+}
