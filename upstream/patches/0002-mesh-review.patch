+using Bytes = std::vector<uint8_t>;
+constexpr uint8_t kMac[6]{0xe0, 0x72, 0xa1, 0xd5, 0x9e, 0xb8};
+constexpr uint32_t kIp = 0xc0a80179;
+constexpr uint32_t kServer = 0xc0a80101;
+constexpr uint32_t kMask = 0xffffff00;
+constexpr uint32_t kSeed = 0xa1493857;
+uint16_t r16(const uint8_t *p) { return static_cast<uint16_t>((p[0] << 8) | p[1]); }
+void w16(uint8_t *p, uint16_t value) {
+  p[0] = value >> 8;
+  p[1] = value & 255;
+}
+void w32(uint8_t *p, uint32_t value) {
+  p[0] = value >> 24;
+  p[1] = value >> 16;
+  p[2] = value >> 8;
+  p[3] = value & 255;
+}
+uint32_t sum(const uint8_t *p, size_t len, uint32_t result = 0) {
+  while (len > 1) {
+    result += r16(p);
+    p += 2;
+    len -= 2;
+  }
+  if (len != 0)
+    result += static_cast<uint16_t>(*p) << 8;
+  return result;
+}
+uint16_t checksum(uint32_t value) {
+  while ((value >> 16) != 0)
+    value = (value & 65535) + (value >> 16);
+  return static_cast<uint16_t>(~value);
+}
+void recheck(Bytes &p, bool udp = true) {
+  w16(p.data() + 10, 0);
+  w16(p.data() + 10, checksum(sum(p.data(), (p[0] & 15) * 4)));
+  w16(p.data() + 26, 0);
+  if (udp) {
+    uint16_t value = checksum(sum(p.data() + 20, p.size() - 20, sum(p.data() + 12, 8) + 17 + p.size() - 20));
+    w16(p.data() + 26, value == 0 ? 65535 : value);
+  }
+}
+void option(Bytes &b, uint8_t code, uint32_t value) {
+  b.push_back(code);
+  b.push_back(4);
+  for (int shift = 24; shift >= 0; shift -= 8)
+    b.push_back(static_cast<uint8_t>(value >> shift));
+}
+Bytes reply(uint8_t type, uint32_t xid = kSeed, uint32_t lease = 80, uint32_t server = kServer, uint32_t ip = kIp,
+            uint32_t mask = kMask, uint32_t router = kServer, uint32_t t1 = 0, uint32_t t2 = 0) {
+  Bytes body(240);
+  body[0] = 2;
+  body[1] = 1;
+  body[2] = 6;
+  w32(body.data() + 4, xid);
+  w32(body.data() + 16, type == 6 ? 0 : ip);
+  std::memcpy(body.data() + 28, kMac, 6);
+  w32(body.data() + 236, 0x63825363);
+  body.insert(body.end(), {53, 1, type});
+  option(body, 54, server);
+  if (type != 6) {
+    option(body, 1, mask);
+    option(body, 3, router);
+    option(body, 6, 0x08080808);
+    option(body, 51, lease);
+    if (t1 != 0)
+      option(body, 58, t1);
+    if (t2 != 0)
+      option(body, 59, t2);
+  }
+  body.push_back(255);
+  if (body.size() < 300)
+    body.resize(300);
+  Bytes p(28 + body.size());
+  p[0] = 0x45;
+  w16(p.data() + 2, static_cast<uint16_t>(p.size()));
+  p[8] = 64;
+  p[9] = 17;
+  w32(p.data() + 12, server);
+  w32(p.data() + 16, 0xffffffff);
+  w16(p.data() + 20, 67);
+  w16(p.data() + 22, 68);
+  w16(p.data() + 24, static_cast<uint16_t>(p.size() - 20));
+  std::memcpy(p.data() + 28, body.data(), body.size());
+  recheck(p);
+  return p;
+}
+DhcpClient client(uint32_t now = 0) {
+  DhcpClient c;
+  assert(c.configure(kMac));
+  c.start(kSeed, now);
+  return c;
+}
+Bytes transmit(DhcpClient &c, uint32_t now) {
+  std::array<uint8_t, 1500> p{};
+  size_t written = 99;
+  const bool sent = c.poll(now, p.data(), p.size(), written);
+  if (!sent)
+    std::cerr << "No DHCP transmission at " << now << " in state " << static_cast<unsigned>(c.state()) << '\n';
+  assert(sent);
+  assert(written == 328);
+  return Bytes(p.begin(), p.begin() + written);
+}
+void bind(DhcpClient &c, uint32_t now = 0, uint32_t lease = 80) {
+  transmit(c, now);
+  auto offer = reply(2, c.xid(), lease);
+  assert(c.receive(offer.data(), offer.size(), now + 10) == DhcpResult::OFFER_ACCEPTED);
+  transmit(c, now + 10);
+  auto ack = reply(5, c.xid(), lease);
+  assert(c.receive(ack.data(), ack.size(), now + 20) == DhcpResult::LEASE_BOUND);
+}
+DhcpResult receive(DhcpClient &c, const Bytes &packet, uint32_t now = 0) {
+  return c.receive(packet.data(), packet.size(), now);
+}
+
+TEST(MeshIpDhcp, MeshOnlyBootFourWayAndNativeIdentity) {
+  auto c = client();
+  ASSERT_TRUE(!c.lease_valid(0) && c.lease().address == 0);
+  const auto discover = transmit(c, 0);
+  DhcpMessage m;
+  ASSERT_TRUE(parse_dhcp_request(discover.data(), discover.size(), m));
+  ASSERT_TRUE(m.type == 1 && m.xid == kSeed && m.client_address == 0 && m.source == 0 && m.broadcast);
+  ASSERT_TRUE(m.destination == 0xffffffff && std::memcmp(m.mac, kMac, 6) == 0);
+  ASSERT_TRUE(r16(discover.data() + 28 + 8) == 0);
+  ASSERT_TRUE(receive(c, reply(2), 10) == DhcpResult::OFFER_ACCEPTED);
+  ASSERT_TRUE(c.state() == DhcpState::REQUESTING && !c.lease_valid(10));
+  const auto request = transmit(c, 10);
+  ASSERT_TRUE(parse_dhcp_request(request.data(), request.size(), m));
+  ASSERT_TRUE(m.type == 3 && m.xid == kSeed && m.requested_address == kIp && m.server == kServer &&
+              m.client_address == 0);
+  ASSERT_TRUE(receive(c, reply(5), 20) == DhcpResult::LEASE_BOUND);
+  ASSERT_TRUE(c.state() == DhcpState::BOUND && c.lease_valid(20));
+  ASSERT_TRUE(c.lease().address == kIp && c.lease().netmask == kMask && c.lease().router == kServer);
+  ASSERT_TRUE(c.lease().dns == 0x08080808 && c.lease().lifetime_seconds == 80);
+  ASSERT_TRUE(c.lease().renewal_seconds == 40 && c.lease().rebind_seconds == 70);
+  size_t written = 55;
+  ASSERT_TRUE(!c.poll(20, nullptr, 0, written) && written == 0);
+}
+TEST(MeshIpDhcp, WrongIdentityTransactionAndServerIgnored) {
+  auto c = client();
+  transmit(c, 0);
+  ASSERT_TRUE(receive(c, reply(2, kSeed + 1)) == DhcpResult::IGNORED);
+  auto wrong = reply(2);
+  wrong[28 + 28 + 5] ^= 1;
+  recheck(wrong);
+  ASSERT_TRUE(receive(c, wrong) == DhcpResult::IGNORED);
+  ASSERT_TRUE(receive(c, reply(5)) == DhcpResult::IGNORED);
+  ASSERT_TRUE(receive(c, reply(6)) == DhcpResult::IGNORED);
+  ASSERT_TRUE(receive(c, reply(2)) == DhcpResult::OFFER_ACCEPTED);
+  ASSERT_TRUE(receive(c, reply(5, kSeed, 80, kServer + 1)) == DhcpResult::IGNORED);
+  ASSERT_TRUE(receive(c, reply(5, kSeed, 80, kServer, kIp + 1)) == DhcpResult::IGNORED);
+  ASSERT_TRUE(receive(c, reply(5)) == DhcpResult::LEASE_BOUND);
+  ASSERT_TRUE(receive(c, reply(6)) == DhcpResult::IGNORED);  // Unsolicited NAK never revokes a bound lease.
+}
+TEST(MeshIpDhcp, PacketBoundsChecksumsFragmentsAndReservedFlags) {
+  const auto good = reply(2);
+  DhcpMessage m;
+  ASSERT_TRUE(parse_dhcp_reply(good.data(), good.size(), m));
+  for (size_t length = 0; length < good.size(); ++length)
+    ASSERT_TRUE(!parse_dhcp_reply(good.data(), length, m));
+  ASSERT_TRUE(!parse_dhcp_reply(nullptr, good.size(), m));
+  auto p = good;
+  p[40] ^= 1;
+  ASSERT_TRUE(!parse_dhcp_reply(p.data(), p.size(), m));
+  p = good;
+  p[10] ^= 1;
+  ASSERT_TRUE(!parse_dhcp_reply(p.data(), p.size(), m));
+  p = good;
+  p[6] = 0x20;
+  recheck(p);
+  ASSERT_TRUE(!parse_dhcp_reply(p.data(), p.size(), m));
+  p = good;
+  p[7] = 1;
+  recheck(p);
+  ASSERT_TRUE(!parse_dhcp_reply(p.data(), p.size(), m));
+  p = good;
+  p[6] = 0x80;
+  recheck(p);
+  ASSERT_TRUE(!parse_dhcp_reply(p.data(), p.size(), m));
+  p = good;
+  p[28 + 10] = 1;
+  recheck(p);
+  ASSERT_TRUE(!parse_dhcp_reply(p.data(), p.size(), m));
+  p = good;
+  p[28 + 24] = 1;
+  recheck(p);
+  ASSERT_TRUE(!parse_dhcp_reply(p.data(), p.size(), m));
+  p = good;
+  p[28 + 236] = 0;
+  recheck(p);
+  ASSERT_TRUE(!parse_dhcp_reply(p.data(), p.size(), m));
+  p = good;
+  recheck(p, false);  // IPv4 UDP checksum zero is valid.
+  ASSERT_TRUE(parse_dhcp_reply(p.data(), p.size(), m));
+}
+TEST(MeshIpDhcp, MalformedAndDuplicateOptions) {
+  DhcpMessage m;
+  auto p = reply(2);
+  p[28 + 240 + 1] = 250;
+  recheck(p);
+  ASSERT_TRUE(!parse_dhcp_reply(p.data(), p.size(), m));
+  p = reply(2);
+  const size_t end = 28 + 240 + 3 + 6 * 5;
+  ASSERT_TRUE(p[end] == 255);
+  p[end] = 53;
+  p[end + 1] = 1;
+  p[end + 2] = 2;
+  p[end + 3] = 255;
+  recheck(p);
+  ASSERT_TRUE(!parse_dhcp_reply(p.data(), p.size(), m));
+  p = reply(2);
+  p[28 + 240 + 3] = 0;
+  recheck(p);  // Removes option54 and makes its payload malformed.
+  ASSERT_TRUE(!parse_dhcp_reply(p.data(), p.size(), m));
+  p = reply(2);
+  p[end] = 61;
+  p[end + 1] = 1;
+  p[end + 2] = 1;
+  p[end + 3] = 255;
+  recheck(p);
+  ASSERT_TRUE(!parse_dhcp_reply(p.data(), p.size(), m));
+  p = reply(2);
+  for (size_t i = end; i < p.size(); ++i)
+    p[i] = 0;
+  recheck(p);
+  ASSERT_TRUE(!parse_dhcp_reply(p.data(), p.size(), m));
+}
+TEST(MeshIpDhcp, LeaseValidationRejectsUnsafeConfiguration) {
+  for (const auto &p :
+       {reply(2, kSeed, 0), reply(2, kSeed, 3), reply(2, kSeed, 80, kServer, kIp, 0xff00ff00),
+        reply(2, kSeed, 80, kServer, kIp, 0xffffffff), reply(2, kSeed, 80, kServer, 0xc0a80100),
+        reply(2, kSeed, 80, kServer, 0xc0a801ff), reply(2, kSeed, 80, kServer, 0xe0000001),
+        reply(2, kSeed, 80, kServer, kIp, kMask, 0xc0a80201), reply(2, kSeed, 80, kServer, kIp, kMask, kIp),
+        reply(2, kSeed, 80, kServer, kIp, kMask, kServer, 75, 70),
+        reply(2, kSeed, 80, kServer, kIp, kMask, kServer, 40, 80)}) {
+    auto c = client();
+    transmit(c, 0);
+    ASSERT_TRUE(receive(c, p) == DhcpResult::IGNORED && c.state() == DhcpState::SELECTING);
+  }
+}
+TEST(MeshIpDhcp, RetryCapacityBackpressureAndRequestTimeout) {
+  auto c = client();
+  uint8_t tiny[20];
+  size_t written = 88;
+  ASSERT_TRUE(!c.poll(0, tiny, sizeof(tiny), written) && written == 0);
+  auto p = transmit(c, 0);  // Failed output buffer did not consume a send.
+  ASSERT_TRUE(!c.poll(1000, tiny, sizeof(tiny), written));
+  p = transmit(c, 1255);
+  ASSERT_TRUE(r16(p.data() + 36) == 1);
+  ASSERT_TRUE(receive(c, reply(2), 2000) == DhcpResult::OFFER_ACCEPTED);
+  for (uint32_t now : {2000U, 3300U, 5600U, 9900U, 18200U}) {
+    p = transmit(c, now);
+    DhcpMessage m;
+    ASSERT_TRUE(parse_dhcp_request(p.data(), p.size(), m) && m.type == 3);
+  }
+  c.tick(34500);
+  ASSERT_TRUE(c.state() == DhcpState::SELECTING && c.xid() != kSeed);
+  p = transmit(c, 34500);
+  DhcpMessage m;
+  ASSERT_TRUE(parse_dhcp_request(p.data(), p.size(), m) && m.type == 1);
+}
+TEST(MeshIpDhcp, RenewRebindExpireAndNoStaleAddress) {
+  auto c = client();
+  bind(c);
+  c.tick(40019);
+  ASSERT_TRUE(c.state() == DhcpState::BOUND);
+  c.tick(40020);
+  ASSERT_TRUE(c.state() == DhcpState::RENEWING && c.xid() != kSeed && c.lease_valid(40020));
+  auto p = transmit(c, 40020);
+  DhcpMessage m;
+  ASSERT_TRUE(parse_dhcp_request(p.data(), p.size(), m));
+  ASSERT_TRUE(m.type == 3 && m.client_address == kIp && m.source == kIp && m.destination == kServer && m.server == 0);
+  c.tick(70020);
+  ASSERT_TRUE(c.state() == DhcpState::REBINDING && c.lease_valid(70020));
+  p = transmit(c, 70020);
+  ASSERT_TRUE(parse_dhcp_request(p.data(), p.size(), m) && m.destination == 0xffffffff && m.client_address == kIp);
+  ASSERT_TRUE(!c.lease_valid(80020));  // valid() enforces expiry even before tick.
+  c.tick(80020);
+  ASSERT_TRUE(c.state() == DhcpState::SELECTING && c.lease().address == 0);
+  p = transmit(c, 80020);
+  ASSERT_TRUE(parse_dhcp_request(p.data(), p.size(), m) && m.type == 1 && m.source == 0);
+}
+TEST(MeshIpDhcp, RenewAckAndRebindOtherServer) {
+  auto c = client();
+  bind(c);
+  c.tick(40020);
+  transmit(c, 40020);
+  ASSERT_TRUE(receive(c, reply(5, c.xid(), 160), 40030) == DhcpResult::LEASE_BOUND);
+  ASSERT_TRUE(c.lease_valid(120029));
+  c.tick(120030);
+  ASSERT_TRUE(c.state() == DhcpState::RENEWING);
+  c.tick(180030);
+  ASSERT_TRUE(c.state() == DhcpState::REBINDING);
+  ASSERT_TRUE(receive(c, reply(5, c.xid(), 80, kServer + 1), 180040) == DhcpResult::LEASE_BOUND);
+  ASSERT_TRUE(c.lease().server == kServer + 1 && c.lease_valid(180040));
+}
+TEST(MeshIpDhcp, GatewayRevalidatePreservesAddressAndUsesFreshTransaction) {
+  auto c = client();
+  bind(c);
+  const uint32_t previous_xid = c.xid();
+  // An entropy collision must still distinguish the new gateway exchange.
+  c.force_revalidate(previous_xid, 30020);
+  ASSERT_TRUE(c.state() == DhcpState::RENEWING && c.xid() != previous_xid && c.lease_valid(30020));
+  auto p = transmit(c, 30020);
+  DhcpMessage m;
+  ASSERT_TRUE(parse_dhcp_request(p.data(), p.size(), m));
+  ASSERT_TRUE(m.type == 3 && m.xid == c.xid() && m.client_address == kIp && m.source == kIp);
+  ASSERT_TRUE(m.destination == kServer && m.server == 0 && m.requested_address == 0);
+  ASSERT_TRUE(r16(p.data() + 28 + 8) == 0);
+  ASSERT_TRUE(receive(c, reply(5, previous_xid), 30021) == DhcpResult::IGNORED);
+  ASSERT_TRUE(receive(c, reply(6, previous_xid), 30022) == DhcpResult::IGNORED);
+  ASSERT_TRUE(c.lease_valid(30022));
+  ASSERT_TRUE(receive(c, reply(5, c.xid(), 160), 30030) == DhcpResult::LEASE_BOUND);
+  ASSERT_TRUE(c.state() == DhcpState::BOUND && c.lease().address == kIp);
+  ASSERT_TRUE(c.lease().lifetime_seconds == 160 && c.lease_valid(190029));
+  ASSERT_TRUE(!c.lease_valid(190030));
+}
+TEST(MeshIpDhcp, GatewayRevalidateNeverExtendsUnacknowledgedLease) {
+  auto c = client();
+  bind(c, 0, 8);
+  c.force_revalidate(77, 4020);
+  ASSERT_TRUE(c.state() == DhcpState::RENEWING && c.lease_valid(4020));
+  transmit(c, 4020);
+  c.force_revalidate(88, 6020);
+  ASSERT_TRUE(c.state() == DhcpState::RENEWING && c.lease_valid(6020));
+  transmit(c, 6020);
+  c.tick(7020);
+  ASSERT_TRUE(c.state() == DhcpState::REBINDING && c.lease_valid(7020));
+  ASSERT_TRUE(!c.lease_valid(8020));
+  c.tick(8020);
+  ASSERT_TRUE(c.state() == DhcpState::SELECTING && c.lease().address == 0);
+}
+TEST(MeshIpDhcp, GatewayRevalidatePreservesRebindAndInfiniteLease) {
+  auto c = client();
+  bind(c);
+  c.force_revalidate(77, 71020);
+  ASSERT_TRUE(c.state() == DhcpState::REBINDING && c.lease_valid(71020));
+  auto p = transmit(c, 71020);
+  DhcpMessage m;
+  ASSERT_TRUE(parse_dhcp_request(p.data(), p.size(), m));
+  ASSERT_TRUE(m.xid == 77 && m.client_address == kIp && m.destination == 0xffffffff);
+  ASSERT_TRUE(receive(c, reply(5, 77, 80, kServer + 1), 71030) == DhcpResult::LEASE_BOUND);
+  ASSERT_TRUE(c.lease().server == kServer + 1 && c.lease().address == kIp);
+
+  auto infinite = client();
+  bind(infinite, 0, UINT32_MAX);
+  infinite.force_revalidate(88, 10000);
+  ASSERT_TRUE(infinite.state() == DhcpState::RENEWING && infinite.lease_valid(10000));
+  p = transmit(infinite, 10000);
+  ASSERT_TRUE(parse_dhcp_request(p.data(), p.size(), m) && m.client_address == kIp && m.xid == 88);
+  ASSERT_TRUE(receive(infinite, reply(5, 88, UINT32_MAX), 10001) == DhcpResult::LEASE_BOUND);
+  ASSERT_TRUE(infinite.lease().lifetime_seconds == UINT32_MAX);
+}
+TEST(MeshIpDhcp, GatewayRevalidateWithoutValidLeaseUsesColdDiscovery) {
+  DhcpClient unconfigured;
+  unconfigured.force_revalidate(99, 10);
+  ASSERT_TRUE(unconfigured.state() == DhcpState::STOPPED);
+  auto c = client();
+  transmit(c, 0);
+  ASSERT_TRUE(receive(c, reply(2), 10) == DhcpResult::OFFER_ACCEPTED);
+  c.force_revalidate(77, 20);
+  ASSERT_TRUE(c.state() == DhcpState::SELECTING && c.lease().address == 0 && c.xid() == 77);
+  auto p = transmit(c, 20);
+  DhcpMessage m;
+  ASSERT_TRUE(parse_dhcp_request(p.data(), p.size(), m));
+  ASSERT_TRUE(m.type == 1 && m.source == 0 && m.client_address == 0 && m.xid == 77);
+
+  bind(c, 2000, 4);
+  c.force_revalidate(88, 6020);
+  ASSERT_TRUE(c.state() == DhcpState::SELECTING && c.lease().address == 0);
+  p = transmit(c, 6020);
+  ASSERT_TRUE(parse_dhcp_request(p.data(), p.size(), m) && m.type == 1 && m.source == 0 && m.xid == 88);
+  c.stop();
+  c.force_revalidate(99, 6030);
+  p = transmit(c, 6030);
+  ASSERT_TRUE(parse_dhcp_request(p.data(), p.size(), m) && m.type == 1 && m.xid == 99);
+}
+TEST(MeshIpDhcp, GatewayRevalidatePreservesAgeAcrossClockWrap) {
+  constexpr uint32_t start = UINT32_MAX - 3000;
+  auto c = client(start);
+  bind(c, start, 8);
+  c.force_revalidate(77, 1019);
+  ASSERT_TRUE(c.lease_valid(1019) && c.state() == DhcpState::RENEWING);
+  const auto p = transmit(c, 1019);
+  DhcpMessage m;
+  ASSERT_TRUE(parse_dhcp_request(p.data(), p.size(), m) && m.client_address == kIp);
+  ASSERT_TRUE(c.lease_valid(5018));
+  ASSERT_TRUE(!c.lease_valid(5019));
+  c.tick(5019);
+  ASSERT_TRUE(c.state() == DhcpState::SELECTING && c.lease().address == 0);
+}
+TEST(MeshIpDhcp, AcknowledgedLeaseTransactionIsIndependentOfPendingRequest) {
+  auto c = client();
+  ASSERT_TRUE(c.lease_xid() == 0);
+  bind(c);
+  ASSERT_TRUE(c.lease_xid() == kSeed);
+  c.tick(40020);
+  ASSERT_TRUE(c.state() == DhcpState::RENEWING && c.xid() != kSeed && c.lease_xid() == kSeed);
+  c.force_revalidate(77, 40030);
+  ASSERT_TRUE(c.xid() == 77 && c.lease_xid() == kSeed);
+  ASSERT_TRUE(receive(c, reply(5, kSeed), 40031) == DhcpResult::IGNORED);
+  ASSERT_TRUE(c.lease_xid() == kSeed);
+  ASSERT_TRUE(receive(c, reply(5, 77), 40032) == DhcpResult::LEASE_BOUND);
+  ASSERT_TRUE(c.lease_xid() == 77);
+  c.force_revalidate(88, 40040);
+  ASSERT_TRUE(c.lease_xid() == 77);
+  ASSERT_TRUE(receive(c, reply(6, 88), 40041) == DhcpResult::LEASE_REJECTED);
+  ASSERT_TRUE(c.lease_xid() == 0);
+
+  c.tick(41041);
+  bind(c, 41041, 4);
+  ASSERT_TRUE(c.lease_xid() == c.xid());
+  c.tick(45061);
+  ASSERT_TRUE(c.state() == DhcpState::SELECTING && c.lease_xid() == 0);
+  bind(c, 45061);
+  c.stop();
+  ASSERT_TRUE(c.lease_xid() == 0);
+}
+TEST(MeshIpDhcp, NakInvalidatesAndDelaysRetry) {
+  auto c = client();
+  transmit(c, 0);
+  ASSERT_TRUE(receive(c, reply(2), 1) == DhcpResult::OFFER_ACCEPTED);
+  ASSERT_TRUE(receive(c, reply(6), 2) == DhcpResult::LEASE_REJECTED);
+  ASSERT_TRUE(!c.lease_valid(2) && c.lease().address == 0 && c.state() == DhcpState::BACKOFF);
+  c.tick(1001);
+  ASSERT_TRUE(c.state() == DhcpState::BACKOFF);
+  c.tick(1002);
+  ASSERT_TRUE(c.state() == DhcpState::SELECTING && c.xid() != kSeed);
+  bind(c, 2000);
+  c.tick(42020);
+  ASSERT_TRUE(c.state() == DhcpState::RENEWING);
+  ASSERT_TRUE(receive(c, reply(6, c.xid()), 42021) == DhcpResult::LEASE_REJECTED);
