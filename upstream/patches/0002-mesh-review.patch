+TEST(MeshCore, TransportCapabilitiesAndPhysicalFrameBudgets) {
+  using namespace mesh_transport;
+  LinkCapabilities link;
+  ASSERT_TRUE(valid_link_capabilities(link));
+  ASSERT_TRUE(validates_frame_budget(link, kMaxPayload));
+  ASSERT_TRUE(!validates_frame_budget(link, kMaxPayload + 1));
+  // Derive the application's current minimum from its actual control format.
+  constexpr size_t endpoint_payload = mesh_ip::ENDPOINT_RESPONSE_SIZE;
+  constexpr size_t endpoint_frame = kWireHeaderSize + endpoint_payload;
+  ASSERT_TRUE(payload_mtu_for_frame_budget(endpoint_frame - 1) == endpoint_payload - 1);
+  ASSERT_TRUE(payload_mtu_for_frame_budget(endpoint_frame) == endpoint_payload);
+  ASSERT_TRUE(validates_frame_budget(link, endpoint_payload, endpoint_frame));
+  ASSERT_TRUE(!validates_frame_budget(link, endpoint_payload, endpoint_frame - 1));
+  ASSERT_TRUE(validates_frame_budget(link, endpoint_payload, endpoint_frame + 4, 4));
+  ASSERT_TRUE(!validates_frame_budget(link, endpoint_payload, endpoint_frame + 3, 4));
+  ASSERT_TRUE(validates_frame_budget(link, 0, kWireHeaderSize + 4, 4));
+  ASSERT_TRUE(!validates_frame_budget(link, 0, kWireHeaderSize + 3, 4));
+  ASSERT_TRUE(payload_mtu_for_frame_budget(kWireHeaderSize - 1) == 0);
+  ASSERT_TRUE(payload_mtu_for_frame_budget(kWireHeaderSize) == 0);
+  ASSERT_TRUE(payload_mtu_for_frame_budget(57, 58) == 0);
+  ASSERT_TRUE(payload_mtu_for_frame_budget(SIZE_MAX) == kMaxPayload);
+  ASSERT_TRUE(payload_mtu_for_frame_budget(SIZE_MAX, SIZE_MAX) == 0);
+  ASSERT_TRUE(!validates_frame_budget(link, SIZE_MAX, SIZE_MAX));
+  ASSERT_TRUE(!validates_frame_budget(link, 1, SIZE_MAX, SIZE_MAX));
+
+  MeshCore core(2);
+  link.payload_mtu = 43;
+  link.reliable_unicast = true;
+  link.native_broadcast = link.reliable_broadcast = true;
+  link.security_provided = true;
+  link.sustainable_bitrate_bps = 1000;
+  link.airtime_budget_permille = 10;
+  link.channel_selection_supported = true;
+  link.first_channel = 0;  // Channel numbers belong to the adapter, not Wi-Fi.
+  link.last_channel = 3;
+  ASSERT_TRUE(core.set_link_capabilities(link));
+  const auto &stored = core.link_capabilities();
+  ASSERT_TRUE(stored.payload_mtu == 43 && stored.reliable_unicast && stored.native_broadcast &&
+              stored.reliable_broadcast && stored.security_provided && stored.sustainable_bitrate_bps == 1000 &&
+              stored.airtime_budget_permille == 10 && stored.channel_selection_supported && stored.first_channel == 0 &&
+              stored.last_channel == 3);
+  auto invalid = link;
+  invalid.payload_mtu = 0;
+  ASSERT_TRUE(!core.set_link_capabilities(invalid));
+  invalid = link;
+  invalid.airtime_budget_permille = 1001;
+  ASSERT_TRUE(!core.set_link_capabilities(invalid));
+  invalid = link;
+  invalid.native_broadcast = false;
+  ASSERT_TRUE(!core.set_link_capabilities(invalid));
+  invalid = link;
+  invalid.first_channel = 4;
+  ASSERT_TRUE(!core.set_link_capabilities(invalid));
+  invalid = link;
+  invalid.channel_selection_supported = false;
+  ASSERT_TRUE(!core.set_link_capabilities(invalid));
+  ASSERT_TRUE(core.link_capabilities().payload_mtu == 43);
+}
