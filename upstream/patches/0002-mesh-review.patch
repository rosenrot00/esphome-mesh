+TEST(MeshIpDelivery, ReservedOriginalsPublishExactBytesAndKeepTwoSlots) {
+  Network network;
+  auto original = bytes(1500, 91);
+  auto second = bytes(1499, 92);
+  PacketDelivery::TxReservation first, held, extra;
+  ASSERT_TRUE((network.a.delivery.reserve(first) && network.a.delivery.reserve(held)));
+  auto *writer = network.a.delivery.reserved_data(first);
+  auto *other = network.a.delivery.reserved_data(held);
+  ASSERT_TRUE((writer != nullptr && other != nullptr && writer != other));
+  ASSERT_TRUE((!network.a.delivery.reserve(first) && network.a.delivery.reserved_data(first) == writer));
+  std::copy(original.begin(), original.end(), writer);
+  std::copy(second.begin(), second.end(), other);
+  ASSERT_TRUE((!network.a.delivery.can_begin() && !network.a.delivery.reserve(extra)));
+  ASSERT_TRUE((!network.a.delivery.begin(2, original.data(), original.size(), 3, 0)));
+  network.step(0);
+  ASSERT_TRUE((network.history.empty() && network.a.delivery.pending_count() == 0));
+  ASSERT_TRUE((network.a.delivery.commit(first, 2, original.size(), 1, 5)));
+  ASSERT_TRUE((network.a.delivery.commit(held, 3, second.size(), 2, 5)));
+  ASSERT_TRUE((network.a.delivery.reserved_data(first) == nullptr));
+  network.a.delivery.cancel(first);  // Published originals are no longer reservations.
+  network.run(5);
+  ASSERT_TRUE((network.b.delivered == std::vector<Bytes>{original}));
+  ASSERT_TRUE((network.c.delivered == std::vector<Bytes>{second}));
+  ASSERT_TRUE((network.a.delivery.pending_count() == 0 && network.a.delivery.counters().acknowledged == 2));
+}
