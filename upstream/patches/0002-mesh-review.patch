+  handover.acknowledge(99, 0);  // An ACK without a pending request has no effect.
+  handover.begin(100, 99);
+  ASSERT_TRUE(handover.quiet() && handover.waiting() && handover.nonce() == 99);
+  handover.acknowledge(98, 200);
+  ASSERT_TRUE(!handover.acknowledged() && !handover.ready(450));
+  handover.acknowledge(99, 300);
+  ASSERT_TRUE(handover.acknowledged() && !handover.ready(649));
+  handover.acknowledge(99, 640);  // Duplicate ACK cannot postpone settling.
+  ASSERT_TRUE(handover.ready(650));
+  handover.connected();  // An early/stale Wi-Fi-connected callback cannot unquiet.
+  ASSERT_TRUE(handover.quiet() && handover.waiting());
+}
