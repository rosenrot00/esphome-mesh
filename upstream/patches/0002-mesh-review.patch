+TEST(MeshIpDelivery, BusyAckAdmissionPreservesElapsedDeadlineAndCommitUrgency) {
+  Network network;
+  network.b.admit_ack = false;
+  const auto packet = bytes(1500);
+  auto part = fragment(packet, 123, 0);
+  network.b.delivery.receive_fragment(1, 2, part.data(), part.size(), 0);
+  network.b.delivery.tick(9);
+  ASSERT_TRUE(network.b.delivery.counters().ack_busy == 0);
+  network.b.delivery.tick(10);
+  ASSERT_TRUE(network.b.delivery.counters().ack_busy == 1);
+  part = fragment(packet, 123, 1);
+  network.b.delivery.receive_fragment(1, 2, part.data(), part.size(), 11);
+  network.b.delivery.tick(11);
+  ASSERT_TRUE(network.b.delivery.counters().ack_busy == 2);  // New receive did not restart deadline.
+  for (uint8_t index = 2; index < kMaxFragments; ++index) {
+    part = fragment(packet, 123, index);
+    network.b.delivery.receive_fragment(1, 2, part.data(), part.size(), 12);
+  }
+  network.b.delivery.tick(12);  // Commit is retained even while ACK admission fails.
+  network.b.delivery.receive_fragment(1, 2, part.data(), part.size(), 13);
+  network.b.admit_ack = true;
+  network.b.delivery.tick(13);
+  ASSERT_TRUE(network.pending.size() == 1 && network.pending[0].payload[3] == 1);
+  ASSERT_TRUE(network.b.delivered == std::vector<Bytes>{packet});
+}
