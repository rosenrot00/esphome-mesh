+TEST(MeshCore, SerializationValidation) {
+  Frame frame{};
+  frame.source = 16;
+  frame.destination = 1;
+  frame.sequence = 0x1234;
+  frame.payload_length = kMaxPayload;
+  for (size_t i = 0; i < kMaxPayload; ++i)
+    frame.payload[i] = static_cast<uint8_t>(i);
+  uint8_t bytes[kMaxWireSize + 1]{};
+  size_t length = 99;
+  ASSERT_TRUE(encode_frame(frame, bytes, sizeof(bytes), length));
+  ASSERT_TRUE(length == kWireHeaderSize + kMaxPayload && bytes[6] == 0x34 && bytes[7] == 0x12);
+  Frame decoded{};
+  ASSERT_TRUE(decode_frame(bytes, length, decoded));
+  ASSERT_TRUE(decoded.sequence == frame.sequence && decoded.source == 16 && decoded.payload_length == kMaxPayload &&
+              std::memcmp(decoded.payload, frame.payload, frame.payload_length) == 0);
+  for (size_t truncated = 0; truncated < length; ++truncated)
+    ASSERT_TRUE(!decode_frame(bytes, truncated, decoded));
+  ASSERT_TRUE(!decode_frame(bytes, length + 1, decoded));
+  ASSERT_TRUE(!decode_frame(nullptr, length, decoded));
+  ASSERT_TRUE(!encode_frame(frame, bytes, length - 1, length));
+  ASSERT_TRUE(length == 0);
+  ASSERT_TRUE(encode_frame(frame, bytes, sizeof(bytes), length));
+  const uint8_t saved_version = bytes[2];
+  bytes[2] = 2;
+  ASSERT_TRUE(!decode_frame(bytes, length, decoded));
+  bytes[2] = saved_version;
+  bytes[8] = 0;
+  ASSERT_TRUE(!decode_frame(bytes, length, decoded));
+  bytes[8] = kMaxTtl;
+  bytes[13] = uint8_t(kMaxPayload + 1);
+  bytes[14] = uint8_t((kMaxPayload + 1) >> 8);
+  ASSERT_TRUE(!decode_frame(bytes, length, decoded));
+
+  auto invalid = advertisement(2, 1, 1, node_bit(2));
+  ASSERT_TRUE(!encode_frame(invalid, bytes, sizeof(bytes), length));
+  invalid = advertisement(1, 1, 1, node_bit(1) | node_bit(2));
+  ASSERT_TRUE(!encode_frame(invalid, bytes, sizeof(bytes), length));
+  invalid = advertisement(2, 1, 1, node_bit(1) | node_bit(2));
+  invalid.destination = 1;
+  ASSERT_TRUE(!encode_frame(invalid, bytes, sizeof(bytes), length));
+  MeshCore core(2);
+  core.receive(3, advertisement(1, 1, 0, node_bit(1)), 0);
+  ASSERT_TRUE(core.counters().invalid_drops == 1);
+  ASSERT_TRUE(!core.route().connected);
+}
