--- /dev/null
+++ b/tests/components/mesh/__init__.py
@@ -0,0 +1,50 @@
+"""Compile the portable mesh kernels in the official host GTest runner."""
+
+import esphome.codegen as cg
+import esphome.config_validation as cv
+from esphome.types import ConfigType
+from tests.testing_helpers import ComponentManifestOverride
+
+PORTABLE_KERNELS = {
+    "mesh_core",
+    "mesh_runtime",
+    "mesh_membership",
+    "mesh_session",
+    "mesh_endpoint",
+    "mesh_ip_packet",
+    "mesh_ip_delivery",
+    "mesh_ip_dhcp",
+    "mesh_ip_ipv6",
+    "mesh_ip_discovery",
+}
+PORTABLE_HEADERS = {
+    "mesh_limits.h",
+    "mesh_protocol.h",
+    "mesh_transport.h",
+    "mesh_ip_role.h",
+    "mesh_ip_handover.h",
+    "mesh_native_recovery.h",
+    "mesh_radio_ownership.h",
+}
+
+
+def override_manifest(manifest: ComponentManifestOverride) -> None:
+    """Select SDK-free resources without changing the production component."""
+    manifest.dependencies = []
+    manifest.auto_load = []
+    manifest.conflicts_with = []
+    manifest.config_schema = cv.Schema({})
+    manifest.final_validate_schema = None
+    manifest.resources = [
+        resource
+        for resource in manifest.resources
+        if resource.resource in PORTABLE_HEADERS
+        or resource.resource.rsplit(".", 1)[0] in PORTABLE_KERNELS
+    ]
+
+    async def to_code_testing(config: ConfigType) -> None:
+        # Existing capacity/alias tests cover all sixteen protocol IDs.
+        cg.add_build_flag("-DMESH_MAX_NODES=16")
+        cg.add_build_flag("-DMESH_IPV6=1")
+
+    manifest.to_code = to_code_testing
