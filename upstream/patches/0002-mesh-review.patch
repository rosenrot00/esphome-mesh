+DiscoveryDescriptor metadata() {
+  return {"mesh-c",
+          6053,
+          80,
+          {{"friendly_name", "Mesh C"},
+           {"version", "2026.9.1"},
+           {"config_hash", "1234abcd"},
+           {"mac", "e072a1d59eb8"},
+           {"platform", "ESP32"},
+           {"board", "esp32-s3-devkitc-1"},
+           {"network", "wifi"},
+           {"api_encryption", "Noise_NNpsk0_25519_ChaChaPoly_SHA256"}}};
