+    std::vector<RouteSnapshot> changes;
+    core.set_callbacks(Callbacks{&changes, nullptr, nullptr, [](void *context, const RouteSnapshot &route) {
+                                   static_cast<std::vector<RouteSnapshot> *>(context)->push_back(route);
+                                 }});
+    core.receive(1, advertisement(1, 1, 0, node_bit(1)), 100);
+    core.receive(2, advertisement(2, 2, 0, node_bit(2)), 110);
+    ASSERT_TRUE(core.route().parent == 1 && core.route().root == 1);
