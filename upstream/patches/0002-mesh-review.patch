+TEST(MeshIpPacket, InPlaceOriginalMatchesCopyingFragmenterAndIsImmutableWhenActive) {
+  const auto bytes = packet(kMtu);
+  Fragmenter copied, filled;
+  ASSERT_TRUE((!filled.begin_in_place(0, 1) && !filled.begin_in_place(kMtu + 1, 1)));
+  auto *target = filled.writable_packet();
+  ASSERT_TRUE((target != nullptr));
+  std::copy(bytes.begin(), bytes.end(), target);
+  ASSERT_TRUE((filled.begin_in_place(bytes.size(), 42)));
+  ASSERT_TRUE((filled.writable_packet() == nullptr && !filled.begin_in_place(1, 43)));
+  ASSERT_TRUE((copied.begin(bytes.data(), bytes.size(), 42)));
+  uint8_t left[mesh_core::kMaxPayload], right[mesh_core::kMaxPayload];
+  for (uint8_t index = 0; index < filled.fragment_count(); ++index) {
+    size_t left_length = 0, right_length = 0;
+    ASSERT_TRUE((filled.peek_at(index, left, sizeof(left), left_length)));
+    ASSERT_TRUE((copied.peek_at(index, right, sizeof(right), right_length)));
+    ASSERT_TRUE((left_length == right_length && std::memcmp(left, right, left_length) == 0));
+  }
+  filled.reset();
+  ASSERT_TRUE((filled.writable_packet() == target));
+}
