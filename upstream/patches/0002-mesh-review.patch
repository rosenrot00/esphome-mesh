+TEST(MeshManualSession, ProofClockWrapAndUnchallengedHelloCannotExtendDeadline) {
+  ManualBootSessionRegistry registry;
+  ASSERT_TRUE(registry.configure(1, 99));
+  const uint32_t started = UINT32_MAX - 15;
+  registry.receive(2, 0, hello(55), started, 1000);
+  const auto request = challenge_for(registry, started);
+  ASSERT_TRUE(registry.sent(request, started));
+  registry.receive(2, 0, hello(55), started + 1500, 1001);
+  ASSERT_TRUE(registry.receive(2, 1, response(request, 55), started + 2000, 1002) ==
+              ManualBootSessionRegistry::Result::REJECTED);
+  registry.receive(2, 0, hello(55), started + 2001, 1003);
+  const auto fresh = challenge_for(registry, started + 2001);
+  ASSERT_TRUE(registry.sent(fresh, started + 2001));
+  ASSERT_TRUE(registry.receive(2, 1, response(fresh, 55), started + 2002, 1004) ==
+              ManualBootSessionRegistry::Result::CHANGED);
+}
+TEST(MeshManualSession, NonceSequenceRepetitionAndMaximumStayClosed) {
+  ManualBootSessionRegistry registry;
+  ASSERT_TRUE(registry.configure(1, 99));
+  ManualBootSessionRegistry::Outgoing previous;
+  for (uint64_t boot = 200; boot < 204; ++boot) {
+    registry.receive(2, 0, hello(boot), 10, 1000);  // Deliberately repeated RNG seed.
+    const auto request = challenge_for(registry, 10);
+    ASSERT_TRUE(request.message.nonce == 1000 + boot - 200);
+    ASSERT_TRUE(registry.sent(request, 10));
+    if (boot != 200)
+      ASSERT_TRUE(registry.receive(2, 1, response(previous, boot - 1), 11, 1000) ==
+                  ManualBootSessionRegistry::Result::REJECTED);
+    ASSERT_TRUE(registry.receive(2, 1, response(request, boot), 12, 1000) ==
+                ManualBootSessionRegistry::Result::CHANGED);
+    ASSERT_TRUE(registry.activate(2, boot));
+    previous = request;
+  }
+  ManualBootSessionRegistry ending;
+  ASSERT_TRUE(ending.configure(1, 99, 3));
+  ending.receive(2, 0, hello(200), 10, UINT64_MAX - 1);
+  auto request = challenge_for(ending, 10);
+  ASSERT_TRUE(request.message.nonce == UINT64_MAX - 1);
+  ASSERT_TRUE(ending.sent(request, 10));
+  ASSERT_TRUE(ending.receive(2, 1, response(request, 200), 11, 1) == ManualBootSessionRegistry::Result::CHANGED);
+  ASSERT_TRUE(ending.activate(2, 200));
+  ending.receive(2, 0, hello(201), 12, 1);
+  request = challenge_for(ending, 12);
+  ASSERT_TRUE(request.message.nonce == UINT64_MAX);
+  ASSERT_TRUE(ending.sent(request, 12));
+  ASSERT_TRUE(ending.receive(2, 1, response(request, 201), 13, 1) == ManualBootSessionRegistry::Result::CHANGED);
+  ASSERT_TRUE(ending.activate(2, 201));
+  ending.receive(2, 0, hello(202), 14, 1);
+  ManualBootSessionRegistry::Outgoing out;
+  ASSERT_TRUE(!ending.next_outgoing(14, out) && ending.session(2) == 201);
+  ASSERT_TRUE(ending.receive(2, 1, response(request, 201), 15, 1) == ManualBootSessionRegistry::Result::REJECTED);
+}
+TEST(MeshManualSession, QuietReadyMeshLostDirectionAndOldHintRecover) {
+  Network network;
+  network.drop = [&](const Network::Packet &packet) {
+    if (network.now >= 3500 || packet.frame.type != FrameType::BOOT_SESSION || packet.frame.source != 3 ||
+        packet.frame.destination != 1)
+      return false;
+    Message message;
+    assert(mesh_session::decode(packet.frame.payload, packet.frame.payload_length, 3, 1, message));
+    return message.kind == Kind::RESPONSE;
+  };
+  network.run(1500);
+  ASSERT_TRUE(network.nodes[2]->registry.session(1) == 101 && network.nodes[2]->registry.session(2) == 102);
+  ASSERT_TRUE(network.nodes[0]->registry.session(3) == 0);
+  const size_t partial = network.history.size();
+  network.run(3000);
+  network.require_sessions();
+  for (size_t i = partial; i < network.history.size(); ++i) {
+    const auto &frame = network.history[i].frame;
+    if (frame.type != FrameType::BOOT_SESSION || frame.source != 3)
+      continue;
+    Message message;
+    ASSERT_TRUE(mesh_session::decode(frame.payload, frame.payload_length, frame.source, frame.destination, message));
+    ASSERT_TRUE(message.kind != Kind::HELLO);  // Its ready side stopped; fresh queries repaired the other direction.
+  }
+  const size_t quiet = network.history.size();
+  network.run(3000);
+  for (size_t i = quiet; i < network.history.size(); ++i)
+    ASSERT_TRUE(network.history[i].frame.type != FrameType::BOOT_SESSION);
+  network.drop = {};
+  network.reboot(3, 503);
+  network.run();
+  network.require_sessions();
+  const auto resets = network.nodes[0]->resets[2];
+  Frame old_hint;
+  old_hint.type = FrameType::BOOT_SESSION;
+  old_hint.source = 3;
+  old_hint.sequence = 65000;
+  size_t length;
+  ASSERT_TRUE(mesh_session::encode(hello(103), 3, 0, old_hint.payload, sizeof(old_hint.payload), length));
+  old_hint.payload_length = length;
+  network.nodes[0]->core.receive(2, old_hint, network.now);
+  network.run(500);
+  ASSERT_TRUE(network.nodes[0]->registry.session(3) == 503 && network.nodes[0]->resets[2] == resets);
+  const size_t quiet_again = network.history.size();
+  network.run(2500);
+  for (size_t i = quiet_again; i < network.history.size(); ++i)
+    ASSERT_TRUE(network.history[i].frame.type != FrameType::BOOT_SESSION);
+}
