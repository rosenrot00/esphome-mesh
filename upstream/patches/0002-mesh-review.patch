+  const auto digest = discovery_digest(data.data(), data.size());
+  for (size_t i = 0; i < 4; ++i)
+    expected[6 + i] = digest >> (8 * i);
+  expected[10] = data.size() & 255;
+  expected[11] = data.size() >> 8;
+  std::memcpy(expected.data() + 16, data.data(), 144);
+  ASSERT_TRUE(expected == implicit);
