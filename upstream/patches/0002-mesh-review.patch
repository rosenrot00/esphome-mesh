+  network.route(249);
+  network.run(250, 750);
+  ASSERT_TRUE(network.b.delivered == std::vector<Bytes>{packet} && network.c.delivered == std::vector<Bytes>{packet});
+  ASSERT_TRUE(network.a.delivery.counters().acknowledged == 2 && network.a.delivery.pending_count() == 0);
+}
