+TEST(MeshIpDelivery, GapsRepairsAndDuplicateFragmentsRequestImmediateAcks) {
+  Network network;
+  const auto packet = bytes(1500);
+  auto part = fragment(packet, 123, 1);  // Fragment0 missing: prompt bitmap10.
+  network.b.delivery.receive_fragment(1, 2, part.data(), part.size(), 0);
+  network.b.delivery.tick(0);
+  ASSERT_TRUE(network.pending.size() == 1 && network.pending.back().payload[16] == 2);
+  part = fragment(packet, 123, 0);  // Filling the hole also bypasses10ms delay.
+  network.b.delivery.receive_fragment(1, 2, part.data(), part.size(), 1);
+  network.b.delivery.tick(1);
+  ASSERT_TRUE(network.pending.size() == 2 && network.pending.back().payload[16] == 3);
+  part = fragment(packet, 123, 2);
+  network.b.delivery.receive_fragment(1, 2, part.data(), part.size(), 2);
+  network.b.delivery.tick(2);
+  ASSERT_TRUE(network.pending.size() == 2);
+  ASSERT_TRUE(network.b.delivery.receive_fragment(1, 2, part.data(), part.size(), 3) == ReceiveResult::DUPLICATE);
+  network.b.delivery.tick(3);
+  ASSERT_TRUE(network.pending.size() == 3 && network.pending.back().payload[16] == 7);
+  for (const auto &message : network.pending)
+    ASSERT_TRUE(message.payload[3] == 0);
+}
