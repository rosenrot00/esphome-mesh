+TEST(MeshRuntime, BindValidationAndLifecycle) {
+  MemoryBackend backend;
+  MeshRuntime runtime(2);
+  Observer observer;
+  ASSERT_TRUE(!runtime.start() && runtime.poll(0, 8) == 0 && runtime.queue_state().capacity == 0);
+  auto transport = backend.descriptor();
+  transport.poll_receive = nullptr;
+  ASSERT_TRUE(!runtime.bind(transport, {}, observer.callbacks()));
+  backend.mtu = 42;
+  ASSERT_TRUE(!runtime.bind(backend.descriptor(), {}, observer.callbacks(), 43));
+  backend.mtu = 160;
+  ASSERT_TRUE(!runtime.bind(backend.descriptor(), {0, 2000, 750}, observer.callbacks(), 43));
+  ASSERT_TRUE(runtime.bind(backend.descriptor(), {}, observer.callbacks(), 43));
+  ASSERT_TRUE(!runtime.bind(backend.descriptor(), {}, observer.callbacks()));
+  ASSERT_TRUE(runtime.start() && backend.started && backend.starts == 1);
+  runtime.process(1, false);
+  ASSERT_TRUE(backend.processes == 1 && !backend.allow);
+  runtime.stop();
+  ASSERT_TRUE(!backend.started && backend.stops == 1);
+  ASSERT_TRUE(runtime.start() && backend.starts == 2);  // Driver lifecycle can restart independently.
+}
+
+TEST(MeshRuntime, PollBudgetPolicyAndInterface) {
+  MemoryBackend backend;
+  MeshRuntime runtime(2);
+  Observer observer;
+  ASSERT_TRUE(runtime.bind(backend.descriptor(), {}, observer.callbacks()));
+  for (uint16_t i = 1; i <= 10; ++i)
+    backend.input.push_back({{7, 1, 77}, advertisement(i)});
+  ASSERT_TRUE(runtime.poll(0, 3) == 3 && backend.input.size() == 7);
+  ASSERT_TRUE(runtime.core().route().root == 1 && runtime.core().route().interface_id == 7);
+  ASSERT_TRUE(observer.changed == 1 && observer.received == 3 && runtime.counters().accepted_input == 3);
+  observer.accepting = false;
+  ASSERT_TRUE(runtime.poll(1, 2) == 2 && runtime.counters().policy_drops == 2);
+  observer.accepting = true;
+  runtime.discard_receive();
+  ASSERT_TRUE(backend.clears == 1 && backend.input.empty());
+  backend.input.push_back({{8, 1, 77}, advertisement(20)});
+  ASSERT_TRUE(runtime.poll(2, 8) == 0 && runtime.counters().accepted_input == 3);
+}
+
+TEST(MeshRuntime, NoSdkExchangeAndBackpressure) {
+  MemoryBackend a, b;
+  MeshRuntime root(1), leaf(2);
+  Observer root_observer, leaf_observer;
+  ASSERT_TRUE(root.bind(a.descriptor(), {}, root_observer.callbacks()));
+  ASSERT_TRUE(leaf.bind(b.descriptor(), {}, leaf_observer.callbacks()));
+  root.core().set_direct_uplink(true, 0);
+  root.tick(0);
+  ASSERT_TRUE(a.output.size() == 1);
+  b.input.push_back({{7, 1, 0}, a.output.front()});
+  leaf.poll(0, 8);
+  ASSERT_TRUE(leaf.core().route().connected);
+  const uint8_t data[]{1, 2, 3};
+  b.accepting = false;
+  ASSERT_TRUE(!leaf.core().send_data(1, 1, data, sizeof(data), 1));
+  ASSERT_TRUE(b.output.empty());
+  b.accepting = true;
+  ASSERT_TRUE(leaf.core().send_data(1, 1, data, sizeof(data), 1));
+  a.input.push_back({{7, 2, 0}, b.output.back()});
+  root.poll(1, 8);
+  ASSERT_TRUE(root_observer.delivered == 1);
+  ASSERT_TRUE(leaf.queue_state().pending == 1 && leaf.transport_counters().accepted == 1);
+  leaf.cancel_pending();
+  ASSERT_TRUE(b.cancels == 1 && b.output.empty());
+}
+
+TEST(MeshRuntime, ProfileExpiryAndOptionalHooks) {
+  MemoryBackend backend;
+  MeshRuntime runtime(2);
+  auto transport = backend.descriptor();
+  transport.start = nullptr;
+  transport.stop = nullptr;
+  transport.process = nullptr;
+  transport.queue_state = nullptr;
+  transport.counters = nullptr;
+  transport.cancel_pending = nullptr;
+  transport.discard_receive = nullptr;
+  ASSERT_TRUE(runtime.bind(transport, {1000, 10000, 2000}, {}));
+  ASSERT_TRUE(runtime.start());
+  backend.input.push_back({{7, 1, 0}, advertisement()});
+  runtime.poll(0xffffff00U, 1);
+  runtime.tick(0xffffff00U + 9999U);
+  ASSERT_TRUE(runtime.core().route().connected);
+  runtime.tick(0xffffff00U + 10000U);
+  ASSERT_TRUE(!runtime.core().route().connected);
+  runtime.process(0, false);
+  runtime.stop();
+  runtime.cancel_pending();
+  runtime.discard_receive();
+  runtime.set_wake_callback(nullptr, nullptr);  // Optional transport hook.
+  ASSERT_TRUE(runtime.queue_state().capacity == 0 && runtime.transport_counters().accepted == 0);
+}
+
+TEST(MeshRuntime, WakeRegistrationIsTransportOptional) {
+  MemoryBackend backend;
+  MeshRuntime runtime(2);
+  runtime.set_wake_callback(nullptr, nullptr);  // Unbound runtime is harmless.
+  auto transport = backend.descriptor();
+  unsigned calls = 0;
+  transport.set_wake_callback = [](void *context, void *wake_context, WakeCallback wake) {
+    ASSERT_TRUE((context != nullptr));
+    if (wake != nullptr)
+      wake(wake_context);
+  };
+  ASSERT_TRUE((runtime.bind(transport, {}, {})));
+  runtime.set_wake_callback(&calls, [](void *context) { ++*static_cast<unsigned *>(context); });
+  ASSERT_TRUE((calls == 1));
+  runtime.set_wake_callback(nullptr, nullptr);
+  ASSERT_TRUE((calls == 1));
+}
+
+}  // namespace esphome::mesh::testing::runtime
