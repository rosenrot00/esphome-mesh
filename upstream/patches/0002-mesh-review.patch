+using namespace mesh_ip;
+using Bytes = std::vector<uint8_t>;
+static constexpr uint8_t MAC[6]{0x02, 0x12, 0x34, 0x56, 0x78, 0x9a};
+static constexpr uint8_t PROXY[6]{0x02, 0x99, 0x88, 0x77, 0x66, 0x55};
+static Ipv6Address local() {
+  Ipv6Address ip{};
+  ip.bytes[0] = 0xfe;
+  ip.bytes[1] = 0x80;
+  ip.bytes[8] = MAC[0] ^ 2;
+  ip.bytes[9] = MAC[1];
+  ip.bytes[10] = MAC[2];
+  ip.bytes[11] = 0xff;
+  ip.bytes[12] = 0xfe;
+  std::copy(MAC + 3, MAC + 6, ip.bytes.begin() + 13);
+  return ip;
+}
+static Ipv6Address all_nodes() {
+  Ipv6Address ip{};
+  ip.bytes[0] = 0xff;
+  ip.bytes[1] = 2;
+  ip.bytes[15] = 1;
+  return ip;
+}
+static void put16(Bytes &b, size_t offset, uint16_t value) {
+  b[offset] = value >> 8;
+  b[offset + 1] = value;
+}
+static Bytes ip_packet(uint8_t next, size_t payload, const Ipv6Address &source = local(),
+                       const Ipv6Address &destination = all_nodes()) {
+  Bytes b(40 + payload);
+  b[0] = 0x60;
+  put16(b, 4, payload);
+  b[6] = next;
+  b[7] = 255;
+  std::copy(source.bytes.begin(), source.bytes.end(), b.begin() + 8);
+  std::copy(destination.bytes.begin(), destination.bytes.end(), b.begin() + 24);
+  return b;
+}
+// Independent contiguous pseudo-header checksum, no production helper.
+static void set_checksum(Bytes &b, size_t upper = 40) {
+  b[upper + 2] = b[upper + 3] = 0;
+  uint32_t sum = 58 + uint32_t(b.size() - upper);
+  for (size_t i = 8; i < 40; i += 2)
+    sum += (uint16_t(b[i]) << 8) + b[i + 1];
+  for (size_t i = upper; i < b.size(); i += 2) {
+    sum += uint16_t(b[i]) << 8;
+    if (i + 1 < b.size())
+      sum += b[i + 1];
+  }
+  while (sum >> 16)
+    sum = (sum & 65535) + (sum >> 16);
+  put16(b, upper + 2, uint16_t(~sum));
+}
+static Bytes nd_packet(uint8_t type, bool option = true, bool dad = false) {
+  const size_t body = type == 133 ? 8 : (type == 134 ? 16 : (type == 137 ? 40 : 24));
+  const auto target = local();
+  auto b = ip_packet(58, body + (option ? 8 : 0), dad ? Ipv6Address{} : local(),
+                     dad ? target.solicited_node() : (type == 137 ? local() : all_nodes()));
+  b[40] = type;
+  if (type == 135 || type == 136 || type == 137)
+    std::copy(target.bytes.begin(), target.bytes.end(), b.begin() + 48);
+  if (type == 137)
+    std::copy(target.bytes.begin(), target.bytes.end(), b.begin() + 64);
+  if (option) {
+    b[40 + body] = type == 136 || type == 137 ? 2 : 1;
+    b[41 + body] = 1;
+    std::copy(MAC, MAC + 6, b.begin() + 42 + body);
+  }
+  set_checksum(b);
+  return b;
+}
+static bool inspect(const Bytes &b, Ipv6PacketInfo *out = nullptr) {
+  Ipv6PacketInfo info;
+  bool valid = inspect_ipv6(b.data(), b.size(), info);
+  if (out)
+    *out = info;
+  return valid;
+}
+TEST(MeshIpv6Packet, AddressesAndFullPackets) {
+  ASSERT_TRUE(local().link_local() && !local().multicast() && local().matches_eui64(MAC));
+  ASSERT_TRUE(Ipv6Address{}.unspecified() && all_nodes().multicast());
+  auto solicited = local().solicited_node();
+  ASSERT_TRUE(solicited.bytes[11] == 1 && solicited.bytes[12] == 255 && solicited.bytes[15] == 0x9a);
+  for (size_t length : {40U, 1280U, 1500U}) {
+    auto b = ip_packet(17, length - 40);
+    Ipv6PacketInfo info;
+    ASSERT_TRUE(inspect(b, &info) && info.total_length == length && info.upper_offset == 40);
+    ASSERT_TRUE(info.source == local() && info.destination == all_nodes() && !info.nd);
+    b[4] ^= 1;
+    ASSERT_TRUE(!inspect(b));
+  }
+  auto b = ip_packet(17, 1461);
+  ASSERT_TRUE(!inspect(b));
+  b = ip_packet(17, 20);
+  b[0] = 0x40;
+  ASSERT_TRUE(!inspect(b));
+  b = ip_packet(17, 20, all_nodes());
+  ASSERT_TRUE(!inspect(b));
+  b = ip_packet(17, 20, local(), {});
+  ASSERT_TRUE(!inspect(b));
+}
+TEST(MeshIpv6Packet, NdAndProxyBytes) {
+  for (uint8_t type : {133, 134, 135, 136, 137}) {
+    auto b = nd_packet(type);
+    auto before = b;
+    Ipv6PacketInfo info;
+    ASSERT_TRUE(inspect(b, &info) && info.nd && info.icmp_type == type);
+    ASSERT_TRUE(rewrite_nd_link_address(b.data(), b.size(), PROXY));
+    ASSERT_TRUE(inspect(b));
+    ASSERT_TRUE(std::equal(PROXY, PROXY + 6, b.end() - 6));
+    for (size_t i = 0; i < b.size(); ++i)
+      if (i != 42 && i != 43 && i < b.size() - 6)
+        ASSERT_TRUE(b[i] == before[i]);
+    before[7] = 254;
+    ASSERT_TRUE(!inspect(before));
+    before = nd_packet(type);
+    before[41] = 1;
+    set_checksum(before);
+    ASSERT_TRUE(!inspect(before));
+    before = nd_packet(type);
+    before.back() ^= 1;
+    ASSERT_TRUE(!inspect(before));
+  }
+  auto b = nd_packet(135, false, true);
+  Ipv6PacketInfo info;
+  ASSERT_TRUE(inspect(b, &info) && info.dad && info.target == local());
+  const auto before = b;
+  ASSERT_TRUE(rewrite_nd_link_address(b.data(), b.size(), PROXY) && b == before);
+  b[42] = b[43] = 0;
+  ASSERT_TRUE(finalize_icmpv6_checksum(b.data(), b.size()) && b == before);
+  b = nd_packet(135, true, true);
+  ASSERT_TRUE(!inspect(b));
+  b = nd_packet(135, false, true);
+  b[39] ^= 1;
+  set_checksum(b);
+  ASSERT_TRUE(!inspect(b));
+  b = nd_packet(136);
+  b[44] = 0x40;
+  set_checksum(b);
+  ASSERT_TRUE(!inspect(b));
+  b = nd_packet(134);
+  b[8] = 0x20;
+  set_checksum(b);
+  ASSERT_TRUE(!inspect(b));
+  b = nd_packet(133);
+  std::fill(b.begin() + 8, b.begin() + 24, 0);
+  set_checksum(b);
+  ASSERT_TRUE(!inspect(b));
+  for (uint8_t prefix : {0x20, 0xfd}) {
+    b = nd_packet(133);
+    b[8] = prefix;
+    b[9] = 1;
+    set_checksum(b);
+    ASSERT_TRUE(inspect(b));
+  }
+}
+TEST(MeshIpv6Packet, OptionsAndSignature) {
+  auto b = nd_packet(135);
+  b[65] = 0;
+  set_checksum(b);
+  ASSERT_TRUE(!inspect(b));
+  b = nd_packet(135);
+  b[65] = 2;
+  set_checksum(b);
+  ASSERT_TRUE(!inspect(b));
+  b = nd_packet(135);
+  b[64] = 3;
+  b[65] = 2;
+  set_checksum(b);
+  ASSERT_TRUE(!inspect(b));
+  b = nd_packet(135);
+  b.resize(b.size() + 8);
+  put16(b, 4, b.size() - 40);
+  b[b.size() - 8] = 12;
+  b[b.size() - 7] = 1;
+  set_checksum(b);
+  ASSERT_TRUE(inspect(b));
+  const auto before = b;
+  ASSERT_TRUE(!rewrite_nd_link_address(b.data(), b.size(), PROXY) && b == before);
+  b = nd_packet(135);
+  uint8_t multicast_mac[6]{1};
+  ASSERT_TRUE(!rewrite_nd_link_address(b.data(), b.size(), multicast_mac));
+}
+static Bytes add_extension(Bytes b, uint8_t extension_type, uint8_t following, uint16_t fragment = 0) {
+  b.insert(b.begin() + 40, 8, 0);
+  b[6] = extension_type;
+  b[40] = following;
+  if (extension_type == 44)
+    put16(b, 42, fragment);
+  put16(b, 4, b.size() - 40);
+  return b;
+}
+TEST(MeshIpv6Packet, ExtensionsAndFragments) {
+  auto b = add_extension(nd_packet(135), 0, 58);
+  Ipv6PacketInfo info;
+  ASSERT_TRUE(inspect(b, &info) && info.upper_offset == 48);
+  ASSERT_TRUE(rewrite_nd_link_address(b.data(), b.size(), PROXY) && inspect(b));
+  b = add_extension(nd_packet(135), 44, 58);
+  ASSERT_TRUE(!inspect(b));  // Atomic ND fragment too.
+  b = add_extension(nd_packet(135), 44, 58, 1);
+  ASSERT_TRUE(!inspect(b));
+  b = add_extension(ip_packet(17, 16), 44, 17, 1);
+  ASSERT_TRUE(inspect(b, &info) && info.fragmented && !info.noninitial_fragment);
+  b = add_extension(ip_packet(17, 16), 44, 17, 8);
+  ASSERT_TRUE(inspect(b, &info) && info.noninitial_fragment);
+  b = add_extension(ip_packet(17, 16), 0, 17);
+  b[41] = 255;
+  ASSERT_TRUE(!inspect(b));
+  b = add_extension(add_extension(ip_packet(17, 16), 0, 17), 60, 0);
+  ASSERT_TRUE(!inspect(b));
+  b = add_extension(ip_packet(17, 16), 44, 17, 2);
+  ASSERT_TRUE(!inspect(b));
+  b = ip_packet(0, 4);
+  ASSERT_TRUE(!inspect(b));
+}
+struct ReaderState {
+  const Bytes *packet;
+  size_t fail_at{size_t(-1)}, largest{0}, calls{0};
+};
+static bool fragmented_read(const void *context, size_t offset, uint8_t *out, size_t count) {
+  auto &state = *const_cast<ReaderState *>(static_cast<const ReaderState *>(context));
+  state.largest = std::max(state.largest, count);
+  ++state.calls;
+  if (offset <= state.fail_at && state.fail_at < offset + count)
+    return false;
+  // Model pbuf chains whose segments do not align with ND/header/checksum words.
+  for (size_t i = 0; i < count; ++i)
+    out[i] = (*state.packet)[offset + i];
+  return true;
+}
+TEST(MeshIpv6Packet, ReaderAndMutations) {
+  auto b = nd_packet(134);
+  b.resize(1279, 0);
+  put16(b, 4, b.size() - 40);
+  // An odd-sized ordinary ICMP packet exercises parser bounds without ND options.
+  b[40] = 128;
+  set_checksum(b);
+  const auto checksum_before = b;
+  b[42] = b[43] = 0;
+  ASSERT_TRUE(finalize_icmpv6_checksum(b.data(), b.size()) && b == checksum_before);
+  ReaderState state{&b};
+  Ipv6PacketInfo info;
+  ASSERT_TRUE(inspect_ipv6({&state, fragmented_read}, b.size(), info));
+  b = nd_packet(134);
+  state = {&b};
+  ASSERT_TRUE(inspect_ipv6({&state, fragmented_read}, b.size(), info) && state.largest <= 64);
+  state = {&b, 44};
+  ASSERT_TRUE(!inspect_ipv6({&state, fragmented_read}, b.size(), info));
+  std::mt19937 rng(0x6dad);
+  for (size_t trial = 0; trial < 3000; ++trial) {
+    b = add_extension(nd_packet(135), 0, 58);
+    const size_t offset = rng() % b.size();
+    b[offset] ^= uint8_t(1U << (rng() % 8));
+    if (inspect(b, &info) && info.nd) {
+      const auto source = info.source, destination = info.destination, target = info.target;
+      ASSERT_TRUE(rewrite_nd_link_address(b.data(), b.size(), PROXY));
+      ASSERT_TRUE(inspect(b, &info) && info.source == source && info.destination == destination &&
+                  info.target == target);
+    }
+  }
+}
+
+}  // namespace esphome::mesh::testing::ip_ipv6
diff --git a/tests/components/mesh/test_ip_ipv6_discovery.cpp b/tests/components/mesh/test_ip_ipv6_discovery.cpp
