+TEST(MeshDiscovery, ExactStatusRefreshAndExpiryWithoutBeats) {
+  DiscoveryRegistry registry;
+  ASSERT_TRUE(registry.authorize(3, MAC));
+  auto packets = chunks(encode(metadata()));
+  ASSERT_TRUE(!registry.refresh(3, ADDRESS, 100));  // No metadata can be invented.
+  ASSERT_TRUE(receive(registry, 3, packets, 100));
+  const auto revision = registry.revision(3);
+  for (uint32_t now = 600; now <= 30100; now += 500) {
+    ASSERT_TRUE(registry.refresh(3, ADDRESS, now));
+    ASSERT_TRUE(registry.current(3, ADDRESS, now));
+  }
+  ASSERT_TRUE(registry.revision(3) == revision);  // Heartbeats do not change TXT.
+  ASSERT_TRUE(!registry.refresh(0, ADDRESS, 30200) && !registry.refresh(17, ADDRESS, 30200));
+  ASSERT_TRUE(!registry.refresh(2, ADDRESS, 30200) && !registry.refresh(3, ADDRESS + 1, 30200));
+  ASSERT_TRUE(!registry.refresh(3, 0, 30200));
+  ASSERT_TRUE(registry.current(3, ADDRESS, 45099));
+  ASSERT_TRUE(!registry.current(3, ADDRESS, 45100));
+  ASSERT_TRUE(!registry.refresh(3, ADDRESS, 45100));  // Expired descriptors stay expired.
+  registry.expire(45100);
+  ASSERT_TRUE(!registry.refresh(3, ADDRESS, 45101));
+  ASSERT_TRUE(receive(registry, 3, packets, 45200));
+  registry.forget(3);
+  ASSERT_TRUE(!registry.refresh(3, ADDRESS, 45201));  // Same-IP OTA needs fresh metadata.
+}
