+    bad = good;
+    bad[11] = count;
+    reject(bad);
+  }
+  for (const uint8_t index : {uint8_t(3), uint8_t(11), uint8_t(255)}) {
+    bad = good;
+    bad[10] = index;
+    reject(bad);
+  }
+  for (const NodeId node : {NodeId(0), NodeId(17), NodeId(255)}) {
+    ASSERT_TRUE(receive(r, good, 0, complete, node, 1) == ReceiveResult::INVALID);
