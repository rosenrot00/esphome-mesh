+    for (uint32_t id = 1; id <= 2; ++id) {
+      const auto parts = fragments(bytes, id);
+      ASSERT_TRUE(receive(r, parts[0], 0, complete, source) == ReceiveResult::INCOMPLETE);
+    }
+  }
+  ASSERT_TRUE(r.pending_packets() == kReassemblySlots);
+  auto parts = fragments(bytes, 3);
+  ASSERT_TRUE(receive(r, parts[0], 1, complete, 1) == ReceiveResult::NO_CAPACITY);
+  ASSERT_TRUE(receive(r, parts[0], 1, complete, 5) == ReceiveResult::NO_CAPACITY);
+  parts = fragments(bytes, 1);
+  ASSERT_TRUE(receive(r, parts[1], 2, complete, 1) == ReceiveResult::COMPLETE);
+  assert_complete(complete, bytes, 1, 1);
+  parts = fragments(bytes, 3);
+  ASSERT_TRUE(receive(r, parts[0], 3, complete, 5) == ReceiveResult::INCOMPLETE);
+  r.reset();
+  ASSERT_TRUE(r.pending_packets() == 0 && r.counters().completed_packets == 0);
+  for (uint32_t id = 0; id < 256; ++id) {
+    parts = fragments(bytes, id);
+    ASSERT_TRUE(receive(r, parts[0], 10, complete) == ReceiveResult::INCOMPLETE);
+    ASSERT_TRUE(receive(r, parts[1], 10, complete) == ReceiveResult::COMPLETE);
+    assert_complete(complete, bytes, id);
+  }
+  ASSERT_TRUE(r.pending_packets() == 0 && r.counters().capacity_drops == 0);
+
+  r.reset();
+  for (uint32_t id = 1; id <= 3; ++id) {
+    parts = fragments(bytes, id);
+    ASSERT_TRUE(receive(r, parts[0], 0, complete) ==
+                (id <= 2 ? ReceiveResult::INCOMPLETE : ReceiveResult::NO_CAPACITY));
+  }
+  // A single source cannot fill every global buffer.
+  parts = fragments(bytes, 4);
+  ASSERT_TRUE(receive(r, parts[0], 0, complete, 4) == ReceiveResult::INCOMPLETE);
+}
