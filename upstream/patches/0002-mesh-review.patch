+TEST(MeshIpPacket, FragmentsUseIndependentCoreSequences) {
+  const auto bytes = packet(kMtu);
+  const auto parts = fragments(bytes, 4242);
+  mesh_core::MeshCore sender(3);
+  mesh_core::MeshCore receiver(1);
+  struct Context {
+    std::vector<mesh_core::Frame> wire;
+    Reassembler reassembler;
+    Bytes delivered;
+    uint32_t packets{0};
+  } context;
+  mesh_core::Callbacks send_callbacks{};
+  send_callbacks.context = &context;
+  send_callbacks.send = [](void *opaque, NodeId, const mesh_core::Frame &frame) {
+    static_cast<Context *>(opaque)->wire.push_back(frame);
+    return true;
+  };
+  sender.set_callbacks(send_callbacks);
+  mesh_core::Frame advertisement{};
+  advertisement.type = mesh_core::FrameType::ADVERTISEMENT;
+  advertisement.source = 1;
+  advertisement.root = 1;
+  advertisement.rank = 0;
+  advertisement.path_bits = 1;
+  advertisement.sequence = 1;
+  sender.receive(1, advertisement, 0);
+  mesh_core::Callbacks receive_callbacks{};
+  receive_callbacks.context = &context;
+  receive_callbacks.deliver = [](void *opaque, const mesh_core::Frame &frame) {
+    auto &ctx = *static_cast<Context *>(opaque);
+    CompletedPacket complete;
+    const auto result =
+        ctx.reassembler.receive(frame.source, frame.destination, frame.payload, frame.payload_length, 0, complete);
+    if (result == ReceiveResult::COMPLETE) {
+      ctx.delivered.assign(complete.data, complete.data + complete.length);
+      ++ctx.packets;
+    } else {
+      ASSERT_TRUE(result == ReceiveResult::INCOMPLETE);
+    }
+  };
+  receiver.set_callbacks(receive_callbacks);
+  context.wire.clear();
+  for (size_t i = 0; i < parts.size(); ++i)
+    ASSERT_TRUE(sender.send_data(1, static_cast<uint16_t>(65530U + i), parts[i].data(), parts[i].size(), 0));
+  ASSERT_TRUE(context.wire.size() == kMaxFragments);
+  std::reverse(context.wire.begin(), context.wire.end());
+  for (const auto &frame : context.wire) {
+    uint8_t wire[mesh_core::kMaxWireSize];
+    size_t length = 0;
+    ASSERT_TRUE(mesh_core::encode_frame(frame, wire, sizeof(wire), length));
+    mesh_core::Frame decoded;
+    ASSERT_TRUE(mesh_core::decode_frame(wire, length, decoded));
+    receiver.receive(3, decoded, 0);
+    receiver.receive(3, decoded, 0);  // Core duplicate suppression per fragment.
+  }
+  ASSERT_TRUE(context.packets == 1 && context.delivered == bytes);
+  ASSERT_TRUE(receiver.counters().duplicate_drops == kMaxFragments);
+}
