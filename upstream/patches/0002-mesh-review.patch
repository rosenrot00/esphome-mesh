diff --git a/tests/components/mesh/test_core.cpp b/tests/components/mesh/test_core.cpp
new file mode 100644
index 000000000..2c1800f62
--- /dev/null
+++ b/tests/components/mesh/test_core.cpp
@@ -0,0 +1,1614 @@
+#include <gtest/gtest.h>
+
+// Keep assertions in non-void harness helpers active in every build mode.
+#ifdef NDEBUG
+#undef NDEBUG
+#endif
+#include "esphome/components/mesh/mesh_core.h"
+#include "esphome/components/mesh/mesh_endpoint.h"
+
+#include <cassert>
+#include <cstdint>
+#include <iostream>
+#include <limits>
+#include <utility>
+#include <vector>
+
+namespace esphome::mesh::testing::core {
+
+using namespace mesh_core;
+
+namespace {
+
+uint16_t node_bit(NodeId id) { return static_cast<uint16_t>(1U << (id - 1)); }
+
+Frame advertisement(NodeId source, NodeId root, uint8_t rank, uint16_t path_bits, uint16_t sequence = 1) {
+  Frame frame{};
+  frame.type = FrameType::ADVERTISEMENT;
+  frame.source = source;
+  frame.root = root;
+  frame.rank = rank;
+  frame.path_bits = path_bits;
+  frame.sequence = sequence;
+  return frame;
+}
+
+struct Harness {
+  struct Context {
+    Harness *harness;
+    NodeId node;
+  };
+  struct Packet {
+    NodeId from;
+    NodeId to;
+    Frame frame;
+  };
+  struct Delivery {
+    NodeId node;
+    Frame frame;
+  };
+  MeshCore nodes[6]{MeshCore(1), MeshCore(2), MeshCore(3), MeshCore(4), MeshCore(5), MeshCore(6)};
+  Context contexts[6]{{this, 1}, {this, 2}, {this, 3}, {this, 4}, {this, 5}, {this, 6}};
+  bool links[7][7]{};
+  bool alive[7]{false, true, true, true, true, true, true};
+  bool accepting[7]{false, true, true, true, true, true, true};
+  std::vector<Packet> packets;
+  std::vector<Packet> offers;
+  std::vector<Packet> trace;
+  std::vector<Delivery> deliveries;
+  uint32_t route_changes{0};
+
+  Harness() {
+    for (NodeId id = 1; id <= 6; ++id) {
+      nodes[id - 1].set_callbacks(Callbacks{&contexts[id - 1], transmit, deliver, changed});
+    }
+  }
+
+  MeshCore &node(NodeId id) { return nodes[id - 1]; }
+  void link(NodeId a, NodeId b) { links[a][b] = links[b][a] = true; }
+
+  static bool transmit(void *context, NodeId hop, const Frame &frame) {
+    auto &ctx = *static_cast<Context *>(context);
+    auto &h = *ctx.harness;
+    h.offers.push_back(Packet{ctx.node, hop, frame});
+    if (!h.alive[ctx.node] || !h.accepting[ctx.node])
+      return false;
+    for (NodeId id = 1; id <= 6; ++id) {
+      if ((hop == 0 || hop == id) && h.links[ctx.node][id] && h.alive[ctx.node] && h.alive[id]) {
+        // Exercise the same wire boundary as the device, including each hop.
+        uint8_t encoded[kMaxWireSize]{};
+        size_t length = 0;
+        assert(encode_frame(frame, encoded, sizeof(encoded), length));
+        Frame decoded{};
+        assert(decode_frame(encoded, length, decoded));
+        h.packets.push_back(Packet{ctx.node, id, decoded});
+      }
+    }
+    return true;
+  }
+
+  static void deliver(void *context, const Frame &frame) {
+    auto &ctx = *static_cast<Context *>(context);
+    ctx.harness->deliveries.push_back(Delivery{ctx.node, frame});
+  }
+
+  static void changed(void *context, const RouteSnapshot &) {
+    ++static_cast<Context *>(context)->harness->route_changes;
+  }
+
+  void pump(uint32_t now) {
+    size_t cursor = 0;
+    while (cursor < packets.size()) {
+      assert(cursor < 1000);  // A routing loop must never create a flood.
+      const Packet packet = packets[cursor++];
+      trace.push_back(packet);
+      if (alive[packet.to] && links[packet.from][packet.to])
+        node(packet.to).receive(packet.from, packet.frame, now);
+    }
+    packets.clear();
+  }
+
+  void step(uint32_t now) {
+    for (NodeId id = 1; id <= 6; ++id) {
+      if (alive[id])
+        node(id).tick(now);
+    }
+    pump(now);
+  }
+
+  void run(uint32_t first, uint32_t last) {
+    for (uint32_t now = first; now <= last; now += 10)
+      step(now);
+  }
+
+  size_t count_deliveries(NodeId node_id, FrameType type, uint16_t sequence) const {
+    size_t count = 0;
+    for (const auto &entry : deliveries)
+      count += entry.node == node_id && entry.frame.type == type && entry.frame.sequence == sequence;
+    return count;
+  }
+};
+
+struct Sessions {
+  uint64_t tags[kMaxNodes + 1]{};
+  Sessions() {
+    for (NodeId id = 1; id <= kMaxNodes; ++id)
+      tags[id] = 0x1020304050607000ULL + id;
+  }
+  static uint64_t resolve(void *context, NodeId id) {
+    return id >= 1 && id <= kMaxNodes ? static_cast<Sessions *>(context)->tags[id] : 0;
+  }
+  void enable(Harness &h) {
+    for (auto &core : h.nodes)
+      assert(core.set_session_resolver(this, resolve));
+  }
+  Frame scope(Frame frame) const {
+    frame.source_session = tags[frame.source];
+    frame.destination_session = tags[frame.destination];
+    frame.root_session = tags[frame.root];
+    return frame;
+  }
+};
+
+TEST(MeshCore, SessionWireVersionsCanonicalEpochsAndExactBounds) {
+  Sessions sessions;
+  Frame frame;
+  frame.source = 1;
+  frame.destination = 3;
+  frame.sequence = 65535;
+  frame.payload_length = kMaxPayload;
+  for (size_t i = 0; i < kMaxPayload; ++i)
+    frame.payload[i] = uint8_t(i);
+  frame = sessions.scope(frame);
+  uint8_t wire[kMaxWireSize + 1]{};
+  size_t written = 0;
+  ASSERT_TRUE(encode_frame(frame, wire, sizeof(wire), written));
+  ASSERT_TRUE(written == 512 && wire[2] == kSessionWireVersion && wire[15] == 1 && wire[22] == 0x10);
+  Frame decoded;
+  ASSERT_TRUE(decode_frame(wire, written, decoded));
+  ASSERT_TRUE(decoded.source_session == frame.source_session &&
+              decoded.destination_session == frame.destination_session && decoded.root_session == 0 &&
+              std::memcmp(decoded.payload, frame.payload, frame.payload_length) == 0);
+  for (size_t length = 0; length < written; ++length)
+    ASSERT_TRUE(!decode_frame(wire, length, decoded));
+  ASSERT_TRUE(!decode_frame(wire, written + 1, decoded));
+  ASSERT_TRUE(!encode_frame(frame, wire, written - 1, written) && written == 0);
+  ASSERT_TRUE(encode_frame(frame, wire, sizeof(wire), written));
+  wire[2] = 2;
+  ASSERT_TRUE(!decode_frame(wire, written, decoded));
+  wire[2] = kSessionWireVersion;
+  for (size_t i = 15; i < 23; ++i)
+    wire[i] = 0;
+  ASSERT_TRUE(!decode_frame(wire, written, decoded));
+  for (unsigned kind = 0; kind < 4; ++kind) {
+    Frame invalid = frame;
+    if (kind == 0)
+      invalid.destination_session = 0;
+    if (kind == 1)
+      invalid.root_session = 7;
+    if (kind == 2)
+      invalid.source_session = 0;
+    if (kind == 3) {
+      invalid.destination = 1;
+      invalid.destination_session = 9;
+    }
+    ASSERT_TRUE(!validate_frame(invalid) && !encode_frame(invalid, wire, sizeof(wire), written));
+  }
+  Frame ad = sessions.scope(advertisement(2, 1, 1, node_bit(1) | node_bit(2)));
+  ASSERT_TRUE(encode_frame(ad, wire, sizeof(wire), written) && written == 39 && wire[2] == kSessionWireVersion);
+  ASSERT_TRUE(decode_frame(wire, written, decoded) && decoded.root_session == sessions.tags[1]);
+  ad.root_session = 0;
+  ASSERT_TRUE(!validate_frame(ad));
+  ad = sessions.scope(advertisement(2, 0, 255, 0));
+  ASSERT_TRUE(validate_frame(ad) && encode_frame(ad, wire, sizeof(wire), written));
+  frame.source_session = frame.destination_session = 0;
+  ASSERT_TRUE(encode_frame(frame, wire, sizeof(wire), written) && written == kWireHeaderSize + kMaxPayload &&
+              wire[2] == kWireVersion);
+  decoded.source_session = decoded.destination_session = decoded.root_session = 99;
+  ASSERT_TRUE(decode_frame(wire, written, decoded) && decoded.source_session == 0 && decoded.destination_session == 0 &&
+              decoded.root_session == 0);
+  using namespace mesh_transport;
+  LinkCapabilities link;
+  ASSERT_TRUE(payload_mtu_for_frame_budget(512, 0, 39) == 473);
+  ASSERT_TRUE(payload_mtu_for_frame_budget(511, 0, 39) == 472);
+  ASSERT_TRUE(payload_mtu_for_frame_budget(38, 0, 39) == 0);
+  ASSERT_TRUE(payload_mtu_for_frame_budget(SIZE_MAX, SIZE_MAX, 39) == 0);
+  ASSERT_TRUE(validates_frame_budget(link, 473, 512, 0, 39));
+  ASSERT_TRUE(!validates_frame_budget(link, 473, 511, 0, 39));
+  ASSERT_TRUE(!validates_frame_budget(link, 0, SIZE_MAX, 0, 40));
+}
