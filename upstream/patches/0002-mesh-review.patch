+LeaseWitness lease_witness() {
+  LeaseWitness witness;
+  witness.node_id = 12;
+  witness.address = 0xc0a80179U;
+  witness.lease_id = 0x04030201U;
+  witness.remaining_seconds = 0x08070605U;
+  witness.subject_session = 0x1817161514131211ULL;
+  return witness;
+}
+TEST(MeshEndpoint, WitnessExplicitWireModesAndRoundtrip) {
+  auto witness = lease_witness();
+  std::array<uint8_t, SESSION_LEASE_WITNESS_SIZE + 1> bytes{};
+  bytes.fill(0xa5);
+  size_t written = 99;
+  ASSERT_TRUE(encode_lease_witness(witness, WitnessIdentityMode::SESSION_BOUND, bytes.data(), bytes.size(), written));
+  ASSERT_TRUE(written == SESSION_LEASE_WITNESS_SIZE && bytes[23] == 0xa5);
+  const std::array<uint8_t, SESSION_LEASE_WITNESS_SIZE> expected{
+      2, 12, 12, 192, 168, 1, 121, 1, 2, 3, 4, 5, 6, 7, 8, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17, 0x18};
+  for (size_t i = 0; i < expected.size(); i++)
+    ASSERT_TRUE(bytes[i] == expected[i]);
+  LeaseWitness decoded;
+  ASSERT_TRUE(decode_lease_witness(bytes.data(), written, WitnessIdentityMode::SESSION_BOUND, decoded));
+  ASSERT_TRUE(decoded.node_id == witness.node_id && decoded.subject_session == witness.subject_session);
+  ASSERT_TRUE(decoded.address == witness.address && decoded.lease_id == witness.lease_id &&
+              decoded.remaining_seconds == witness.remaining_seconds);
+  ASSERT_TRUE(!decode_lease_witness(bytes.data(), written, WitnessIdentityMode::LEGACY, decoded));
+  witness.subject_session = 0;
+  ASSERT_TRUE(encode_lease_witness(witness, WitnessIdentityMode::LEGACY, bytes.data(), bytes.size(), written));
+  ASSERT_TRUE(written == LEGACY_LEASE_WITNESS_SIZE && bytes[0] == 1);
+  ASSERT_TRUE(decode_lease_witness(bytes.data(), written, WitnessIdentityMode::LEGACY, decoded));
+  ASSERT_TRUE(decoded.subject_session == 0 && decoded.node_id == witness.node_id);
+  ASSERT_TRUE(!decode_lease_witness(bytes.data(), written, WitnessIdentityMode::SESSION_BOUND, decoded));
+}
+TEST(MeshEndpoint, WitnessSubjectReuseAndRebootNeverInheritsEvidence) {
+  const auto old_owner = lease_witness();
+  std::array<uint8_t, SESSION_LEASE_WITNESS_SIZE> queued{};
+  size_t written;
+  ASSERT_TRUE(
+      encode_lease_witness(old_owner, WitnessIdentityMode::SESSION_BOUND, queued.data(), queued.size(), written));
+  LeaseWitness delayed;
+  ASSERT_TRUE(decode_lease_witness(queued.data(), written, WitnessIdentityMode::SESSION_BOUND, delayed));
+  ASSERT_TRUE(witness_matches_subject(delayed, WitnessIdentityMode::SESSION_BOUND, old_owner.subject_session));
+  // Source and destination gateways may remain in the same sessions. Neither
+  // a replacement client nor the same MAC in a new boot may inherit a witness
+  // queued about its old slot owner, even with the same address/DHCP token.
+  for (const uint64_t replacement : {0x2827262524232221ULL, 0x3837363534333231ULL})
+    ASSERT_TRUE(!witness_matches_subject(delayed, WitnessIdentityMode::SESSION_BOUND, replacement));
+  ASSERT_TRUE(!witness_matches_subject(delayed, WitnessIdentityMode::SESSION_BOUND, 0));
+  auto current = old_owner;
+  current.subject_session = 0x2827262524232221ULL;
+  ASSERT_TRUE(encode_lease_witness(current, WitnessIdentityMode::SESSION_BOUND, queued.data(), queued.size(), written));
+  ASSERT_TRUE(decode_lease_witness(queued.data(), written, WitnessIdentityMode::SESSION_BOUND, delayed));
+  ASSERT_TRUE(witness_matches_subject(delayed, WitnessIdentityMode::SESSION_BOUND, current.subject_session));
+  ASSERT_TRUE(!witness_matches_subject(delayed, WitnessIdentityMode::SESSION_BOUND, old_owner.subject_session));
+}
+TEST(MeshEndpoint, WitnessNeverDowngradesWhenSubjectIsMissing) {
+  auto witness = lease_witness();
+  std::array<uint8_t, SESSION_LEASE_WITNESS_SIZE> bytes{};
+  size_t written = 99;
+  ASSERT_TRUE(!encode_lease_witness(witness, WitnessIdentityMode::LEGACY, bytes.data(), bytes.size(), written) &&
+              written == 0);
+  ASSERT_TRUE(!witness_matches_subject(witness, WitnessIdentityMode::LEGACY, 0));
+  witness.subject_session = 0;
+  ASSERT_TRUE(!encode_lease_witness(witness, WitnessIdentityMode::SESSION_BOUND, bytes.data(), bytes.size(), written) &&
+              written == 0);
+  ASSERT_TRUE(!witness_matches_subject(witness, WitnessIdentityMode::SESSION_BOUND, 0));
+  ASSERT_TRUE(witness_matches_subject(witness, WitnessIdentityMode::LEGACY, 0));
+  ASSERT_TRUE(!witness_matches_subject(witness, WitnessIdentityMode::LEGACY, 1));
+  ASSERT_TRUE(encode_lease_witness(witness, WitnessIdentityMode::LEGACY, bytes.data(), bytes.size(), written));
+  LeaseWitness decoded;
+  decoded.subject_session = 99;
+  ASSERT_TRUE(!decode_lease_witness(bytes.data(), written, WitnessIdentityMode::SESSION_BOUND, decoded));
+  ASSERT_TRUE(decoded.subject_session == 99);
+}
+TEST(MeshEndpoint, WitnessMalformedBoundsAndNoOutputMutation) {
+  const auto witness = lease_witness();
+  std::array<uint8_t, SESSION_LEASE_WITNESS_SIZE + 1> bytes{};
+  size_t written = 99;
+  ASSERT_TRUE(encode_lease_witness(witness, WitnessIdentityMode::SESSION_BOUND, bytes.data(), bytes.size(), written));
+  LeaseWitness decoded;
+  decoded.subject_session = 99;
+  for (size_t length = 0; length <= bytes.size(); length++) {
+    if (length == SESSION_LEASE_WITNESS_SIZE)
+      continue;
+    ASSERT_TRUE(!decode_lease_witness(bytes.data(), length, WitnessIdentityMode::SESSION_BOUND, decoded));
+    ASSERT_TRUE(decoded.subject_session == 99);
+  }
+  ASSERT_TRUE(!decode_lease_witness(nullptr, written, WitnessIdentityMode::SESSION_BOUND, decoded));
+  for (size_t capacity = 0; capacity < SESSION_LEASE_WITNESS_SIZE; capacity++) {
+    const auto original = bytes;
+    ASSERT_TRUE(!encode_lease_witness(witness, WitnessIdentityMode::SESSION_BOUND, bytes.data(), capacity, written));
+    ASSERT_TRUE(written == 0 && original == bytes);
+  }
+  ASSERT_TRUE(!encode_lease_witness(witness, WitnessIdentityMode::SESSION_BOUND, nullptr, bytes.size(), written));
+  const auto original = bytes;
+  for (const size_t offset : {size_t(0), size_t(1), size_t(2)}) {
+    bytes = original;
+    bytes[offset] = 0;
+    ASSERT_TRUE(
+        !decode_lease_witness(bytes.data(), SESSION_LEASE_WITNESS_SIZE, WitnessIdentityMode::SESSION_BOUND, decoded));
+    ASSERT_TRUE(decoded.subject_session == 99);
+  }
+  for (const std::array<size_t, 2> field : {std::array<size_t, 2>{3, 4}, {7, 4}, {11, 4}, {15, 8}}) {
+    bytes = original;
+    for (size_t i = 0; i < field[1]; i++)
+      bytes[field[0] + i] = 0;
+    ASSERT_TRUE(
+        !decode_lease_witness(bytes.data(), SESSION_LEASE_WITNESS_SIZE, WitnessIdentityMode::SESSION_BOUND, decoded));
+  }
+  auto invalid = witness;
+  invalid.node_id = 17;
+  ASSERT_TRUE(!encode_lease_witness(invalid, WitnessIdentityMode::SESSION_BOUND, bytes.data(), bytes.size(), written));
+  invalid = witness;
+  invalid.address = 0xe0000001U;
+  ASSERT_TRUE(!encode_lease_witness(invalid, WitnessIdentityMode::SESSION_BOUND, bytes.data(), bytes.size(), written));
+  ASSERT_TRUE(!encode_lease_witness(witness, static_cast<WitnessIdentityMode>(2), bytes.data(), bytes.size(), written));
+}
