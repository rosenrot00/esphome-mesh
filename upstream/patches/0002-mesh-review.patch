+TEST(MeshCore, ProbePayloadEchoOverMultipleHops) {
+  Harness h;
+  h.link(1, 2);
+  h.link(2, 3);
+  h.node(1).set_direct_uplink(true, 0);
+  h.run(0, 100);
+  ASSERT_TRUE(!h.node(1).send_probe(3, 199, 105));
+  h.pump(105);
+  const auto before = h.node(2).counters().forwarded;
+  uint8_t payload[kMaxPayload]{};
+  for (size_t i = 0; i < sizeof(payload); ++i)
+    payload[i] = static_cast<uint8_t>(i * 37U);
+
+  // Both the benchmark size and the wire limit cross two hops in each
+  // direction. The harness encodes/decodes each hop, not just the endpoints.
+  const size_t lengths[]{32, 160};
+  uint16_t sequence = 200;
+  for (const size_t length : lengths) {
+    ++sequence;
+    ASSERT_TRUE(h.node(3).send_probe_payload(1, sequence, payload, length, 110));
+    h.pump(110);
+    ASSERT_TRUE(h.count_deliveries(1, FrameType::PROBE, sequence) == 1);
+    ASSERT_TRUE(h.count_deliveries(3, FrameType::PROBE_REPLY, sequence) == 1);
+    for (const auto &delivery : h.deliveries) {
+      if (delivery.frame.sequence != sequence)
+        continue;
+      ASSERT_TRUE(delivery.frame.payload_length == length);
+      for (size_t i = 0; i < length; ++i)
+        ASSERT_TRUE(delivery.frame.payload[i] == payload[i]);
+    }
+    size_t packets = 0;
+    for (const auto &packet : h.trace) {
+      if (packet.frame.sequence != sequence ||
+          (packet.frame.type != FrameType::PROBE && packet.frame.type != FrameType::PROBE_REPLY))
+        continue;
+      ++packets;
+      ASSERT_TRUE(packet.frame.payload_length == length);
+      for (size_t i = 0; i < length; ++i)
+        ASSERT_TRUE(packet.frame.payload[i] == payload[i]);
+    }
+    ASSERT_TRUE(packets == 4);
+  }
+  ASSERT_TRUE(h.node(2).counters().forwarded == before + 4);
+  ASSERT_TRUE(h.node(3).send_probe(1, ++sequence, 120));
+  h.pump(120);
+  ASSERT_TRUE(h.count_deliveries(3, FrameType::PROBE_REPLY, sequence) == 1);
+  ASSERT_TRUE(h.deliveries.back().frame.payload_length == 0);
+}
