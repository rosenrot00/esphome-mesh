+  proof.claim = remote;
+  proof.requester = mac(99);
+  ASSERT_TRUE(deliver(fixture.member, proof, 40) && fixture.member.find(2) == nullptr);
+  proof.requester = fixture.member.local_claim().mac;
+  ASSERT_TRUE(deliver(fixture.member, proof, 50));
+  ASSERT_TRUE(fixture.member.find(2)->boot == remote.boot && fixture.member.counters().proofs_accepted == 1);
