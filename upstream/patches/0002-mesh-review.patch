+}
+TEST(MeshIpDhcp, ArpConflictDeclineWaitAndNoIpUse) {
+  auto c = client();
+  ASSERT_TRUE(!c.decline(0));
+  bind(c);
+  ASSERT_TRUE(c.decline(21) && !c.lease_valid(21));
+  auto p = transmit(c, 21);
+  DhcpMessage m;
+  ASSERT_TRUE(parse_dhcp_request(p.data(), p.size(), m) && m.type == 4 && m.requested_address == kIp &&
+              m.server == kServer && !m.broadcast);
+  ASSERT_TRUE(c.state() == DhcpState::BACKOFF && c.lease().address == 0);
+  c.tick(10020);
+  ASSERT_TRUE(c.state() == DhcpState::BACKOFF);
+  c.tick(10021);
+  ASSERT_TRUE(c.state() == DhcpState::SELECTING);
+}
+TEST(MeshIpDhcp, WrappingClockAndLongLease) {
+  auto c = client(0xfffffff0U);
+  bind(c, 0xfffffff0U);
+  ASSERT_TRUE(c.lease_valid(1000));
+  c.tick(40004);
+  ASSERT_TRUE(c.state() == DhcpState::RENEWING);
+  auto long_client = client();
+  bind(long_client, 0, 4000000000U);
+  // Add 3 billion milliseconds per call, spanning many 49-day millis wraps.
+  uint32_t now = 20;
+  for (unsigned i = 0; i < 667; ++i) {
+    now += 3000000000U;
+    long_client.tick(now);
+  }
+  ASSERT_TRUE(long_client.state() == DhcpState::RENEWING && long_client.lease_valid(now));
+  for (unsigned i = 0; i < 667; ++i) {
+    now += 3000000000U;
+    long_client.tick(now);
+  }
+  ASSERT_TRUE(!long_client.lease_valid(now) && long_client.lease().address == 0);
+}
+TEST(MeshIpDhcp, InfiniteLeaseStopAndRestartNeverAssumesPreviousIp) {
+  auto c = client();
+  bind(c, 0, UINT32_MAX);
+  c.tick(UINT32_MAX - 1);
+  c.tick(UINT32_MAX - 2);
+  ASSERT_TRUE(c.state() == DhcpState::BOUND && c.lease_valid(UINT32_MAX - 2));
+  c.stop();
+  ASSERT_TRUE(c.state() == DhcpState::STOPPED && !c.lease_valid(0) && c.lease().address == 0);
+  c.start(77, 5);
+  ASSERT_TRUE(c.state() == DhcpState::SELECTING && c.lease().address == 0 && c.xid() == 77);
+  const auto p = transmit(c, 5);
+  DhcpMessage m;
+  ASSERT_TRUE(parse_dhcp_request(p.data(), p.size(), m) && m.source == 0 && m.xid == 77);
+}
+TEST(MeshIpDhcp, RemainingSecondsRequiresAckAndExpiresConservatively) {
+  DhcpClient stopped;
+  ASSERT_TRUE(stopped.remaining_seconds(0) == 0);
+  auto c = client();
+  ASSERT_TRUE(c.remaining_seconds(0) == 0);
+  transmit(c, 0);
+  ASSERT_TRUE(receive(c, reply(2, kSeed, 8), 10) == DhcpResult::OFFER_ACCEPTED);
+  ASSERT_TRUE(c.remaining_seconds(10) == 0);  // An OFFER never grants ownership.
+  transmit(c, 10);
+  ASSERT_TRUE(receive(c, reply(5, kSeed, 8), 20) == DhcpResult::LEASE_BOUND);
+  ASSERT_TRUE(c.remaining_seconds(20) == 8);
+  ASSERT_TRUE(c.remaining_seconds(7020) == 1);
+  ASSERT_TRUE(c.lease_valid(7021) && c.remaining_seconds(7021) == 0);
+  ASSERT_TRUE(c.lease_valid(8019) && c.remaining_seconds(8019) == 0);
+  ASSERT_TRUE(!c.lease_valid(8020) && c.remaining_seconds(8020) == 0);
+  c.tick(8020);
+  ASSERT_TRUE(c.state() == DhcpState::SELECTING && c.remaining_seconds(8020) == 0);
+  c.stop();
+  ASSERT_TRUE(c.remaining_seconds(9000) == 0);
+}
+TEST(MeshIpDhcp, RemainingSecondsRoundsDownFractionalBudgetAcrossTicks) {
+  auto c = client();
+  bind(c);
+  ASSERT_TRUE(c.remaining_seconds(20) == 80);
+  ASSERT_TRUE(c.remaining_seconds(21) == 79);
+  ASSERT_TRUE(c.remaining_seconds(1019) == 79);
+  ASSERT_TRUE(c.remaining_seconds(1020) == 79);
+  ASSERT_TRUE(c.remaining_seconds(1021) == 78);
+  // The const getter cannot advance or reset the lease clock itself.
+  ASSERT_TRUE(c.remaining_seconds(20) == 80);
+  c.tick(520);  // Preserve half a second in the client's age accumulator.
+  ASSERT_TRUE(c.remaining_seconds(520) == 79);
+  ASSERT_TRUE(c.remaining_seconds(1020) == 79);
+  ASSERT_TRUE(c.remaining_seconds(1021) == 78);
+  c.tick(1021);  // One elapsed second plus a one-millisecond remainder.
+  ASSERT_TRUE(c.remaining_seconds(1021) == 78);
+  ASSERT_TRUE(c.remaining_seconds(2020) == 78);
+  ASSERT_TRUE(c.remaining_seconds(2021) == 77);
+  c.tick(2021);
+  ASSERT_TRUE(c.remaining_seconds(2021) == 77);
+}
+TEST(MeshIpDhcp, RemainingSecondsRevalidationAndRenewalNeedFreshAck) {
+  auto c = client();
+  bind(c, 0, 8);
+  ASSERT_TRUE(c.remaining_seconds(3021) == 4);
+  c.force_revalidate(77, 3021);
+  ASSERT_TRUE(c.state() == DhcpState::RENEWING && c.remaining_seconds(3021) == 4);
+  transmit(c, 3021);
+  ASSERT_TRUE(receive(c, reply(5, kSeed, 80), 3022) == DhcpResult::IGNORED);
+  ASSERT_TRUE(c.remaining_seconds(3022) == 4);
+  c.force_revalidate(88, 4021);
+  ASSERT_TRUE(c.remaining_seconds(4021) == 3);
+  transmit(c, 4021);
+  ASSERT_TRUE(receive(c, reply(5, 88, 16), 4030) == DhcpResult::LEASE_BOUND);
+  ASSERT_TRUE(c.remaining_seconds(4030) == 16);
+  c.tick(12030);
+  ASSERT_TRUE(c.state() == DhcpState::RENEWING && c.remaining_seconds(12030) == 8);
+  ASSERT_TRUE(c.remaining_seconds(12031) == 7);
+  ASSERT_TRUE(receive(c, reply(6, c.xid()), 12032) == DhcpResult::LEASE_REJECTED);
+  ASSERT_TRUE(c.remaining_seconds(12032) == 0);
+}
+TEST(MeshIpDhcp, RemainingSecondsWrapAndLargeFiniteLease) {
+  constexpr uint32_t start = UINT32_MAX - 3000;
+  auto c = client(start);
+  bind(c, start, 8);
+  constexpr uint32_t bound = start + 20;
+  ASSERT_TRUE(c.remaining_seconds(bound) == 8);
+  ASSERT_TRUE(c.remaining_seconds(bound + 2999) == 5);
+  c.tick(bound + 2500);
+  ASSERT_TRUE(c.remaining_seconds(bound + 3000) == 5);
+  ASSERT_TRUE(c.remaining_seconds(bound + 3001) == 4);
+  c.tick(bound + 3001);
+  ASSERT_TRUE(c.remaining_seconds(bound + 7000) == 1);
+  ASSERT_TRUE(c.remaining_seconds(bound + 7001) == 0);
+  ASSERT_TRUE(c.remaining_seconds(bound + 8000) == 0);
+
+  auto long_client = client();
+  bind(long_client, 0, 4000000000U);
+  ASSERT_TRUE(long_client.remaining_seconds(20) == 4000000000U);
+  uint32_t now = 20;
+  uint64_t elapsed_seconds = 0;
+  // Repeated intervals cross the 32-bit millisecond clock without multiplying
+  // a multi-year lease into an overflowing millisecond deadline.
+  for (unsigned i = 0; i < 4; i++) {
+    now += 3000000000U;
+    elapsed_seconds += 3000000U;
+    long_client.tick(now);
+    ASSERT_TRUE(long_client.remaining_seconds(now) == 4000000000U - elapsed_seconds);
+    ASSERT_TRUE(long_client.remaining_seconds(now + 1) == 3999999999U - elapsed_seconds);
+  }
+}
+TEST(MeshIpDhcp, RemainingSecondsInfiniteLeaseAndWithdrawal) {
+  auto c = client();
+  bind(c, 0, UINT32_MAX);
+  ASSERT_TRUE(c.remaining_seconds(20) == UINT32_MAX);
+  ASSERT_TRUE(c.remaining_seconds(21) == UINT32_MAX);
+  uint32_t now = 20;
+  for (unsigned i = 0; i < 4; i++) {
+    now += 3000000000U;
+    c.tick(now);
+    ASSERT_TRUE(c.remaining_seconds(now) == UINT32_MAX);
+  }
+  c.force_revalidate(77, now + 1);
+  ASSERT_TRUE(c.state() == DhcpState::RENEWING && c.remaining_seconds(now + 1) == UINT32_MAX);
+  ASSERT_TRUE(c.decline(now + 2));
+  ASSERT_TRUE(c.remaining_seconds(now + 2) == 0);
+  c.stop();
+  ASSERT_TRUE(c.remaining_seconds(now + 3) == 0);
+  c.start(88, now + 4);
+  ASSERT_TRUE(c.remaining_seconds(now + 4) == 0);
+}
+TEST(MeshIpDhcp, GatewayRequestRestrictions) {
+  auto c = client();
+  const auto good = transmit(c, 0);
+  DhcpMessage m;
+  ASSERT_TRUE(parse_dhcp_request(good.data(), good.size(), m));
+  for (size_t offset : {size_t{20}, size_t{22}, size_t{28}, size_t{29}, size_t{30}, size_t{31}, size_t{56}}) {
+    auto p = good;
+    p[offset] ^= 1;
+    recheck(p);
+    ASSERT_TRUE(!parse_dhcp_request(p.data(), p.size(), m));
+  }
+  auto p = good;
+  p[38] = 0;
+  recheck(p);
+  ASSERT_TRUE(!parse_dhcp_request(p.data(), p.size(), m));
+  p = good;
+  w32(p.data() + 12, kIp);
+  recheck(p);
+  ASSERT_TRUE(!parse_dhcp_request(p.data(), p.size(), m));
+  p = good;
+  w32(p.data() + 16, kServer);
+  recheck(p);
+  ASSERT_TRUE(!parse_dhcp_request(p.data(), p.size(), m));
+}
+TEST(MeshIpDhcp, OptionOverloadBoundedAndDuplicateRejected) {
+  auto p = reply(2);
+  DhcpMessage m;
+  // Move router into the 128-byte BOOTP file field and replace the option with padding.
+  const size_t router = 28 + 240 + 3 + 6 + 6;
+  ASSERT_TRUE(p[router] == 3);
+  std::memcpy(p.data() + 28 + 108, p.data() + router, 6);
+  p[28 + 114] = 255;
+  p[router] = 52;
+  p[router + 1] = 1;
+  p[router + 2] = 1;
+  p[router + 3] = p[router + 4] = p[router + 5] = 0;
+  recheck(p);
+  ASSERT_TRUE(parse_dhcp_reply(p.data(), p.size(), m) && m.router == kServer);
+  auto c = client();
+  transmit(c, 0);
+  ASSERT_TRUE(receive(c, p) == DhcpResult::OFFER_ACCEPTED);
+  p[28 + 108] = 54;
+  recheck(p);  // Duplicate server option across option regions.
+  ASSERT_TRUE(!parse_dhcp_reply(p.data(), p.size(), m));
+}
+TEST(MeshIpDhcp, FuzzParserBounds) {
+  std::mt19937 rng(618431);
+  DhcpMessage m;
+  const auto good = reply(2);
+  for (unsigned i = 0; i < 5000; ++i) {
+    auto p = good;
+    for (unsigned changes = 0; changes < 1 + i % 8; ++changes)
+      p[rng() % p.size()] = static_cast<uint8_t>(rng());
+    // Half of mutations retain valid checksums to exercise the deep decoder.
+    if ((i & 1) == 0)
+      recheck(p);
+    (void) parse_dhcp_reply(p.data(), p.size(), m);
+    (void) parse_dhcp_request(p.data(), p.size(), m);
+  }
+}
+TEST(MeshIpDhcp, ZeroSeedAndTransactionWrapPreserveNonzeroEndpointIdentity) {
+  auto c = client();
+  c.start(0, 0);
+  ASSERT_TRUE(c.xid() == 1);
+  c.force_revalidate(0, 1);
+  ASSERT_TRUE(c.xid() != 0 && c.xid() != 1);
+  constexpr uint32_t before_wrap = 0U - 0x9e3779b9U;
+  c.start(before_wrap, 2);
+  // A repeated seed advances by the transaction increment, crossing zero.
+  c.force_revalidate(before_wrap, 3);
+  ASSERT_TRUE(c.xid() == 1);
+  const auto discover = transmit(c, 3);
+  DhcpMessage m;
+  ASSERT_TRUE(parse_dhcp_request(discover.data(), discover.size(), m) && m.xid == 1);
+}
