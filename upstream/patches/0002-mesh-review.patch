+TEST(MeshDiscovery, PackedDescriptorBoundsCopyAndAliases) {
+  DiscoveryDescriptor descriptor{"mesh-c", 6053, 80, {{"mac", "e072a1d59eb8"}}};
+  // Exactly 768 wire bytes and all 16 TXT entries fit, including terminators.
+  const std::string long_value(253, 'x'), last_value(187, 'y');
+  for (size_t i = 0; i < 15; ++i) {
+    const char key = 'a' + i;
+    ASSERT_TRUE(descriptor.add_txt({&key, 1}, i < 2
+                                                  ? esphome::StringRef(long_value)
+                                                  : (i == 2 ? esphome::StringRef(last_value) : esphome::StringRef{})));
+  }
+  const auto bytes = encode(descriptor);
+  ASSERT_TRUE(bytes.size() == DISCOVERY_DESCRIPTOR_MAX && descriptor.txt_count() == DISCOVERY_TXT_MAX);
+  DiscoveryDescriptor decoded;
+  ASSERT_TRUE(decode_discovery(bytes.data(), bytes.size(), decoded));
+  ASSERT_TRUE(encode(decoded) == bytes);
+  auto copy = decoded;
+  auto moved = std::move(copy);
+  decoded.clear();
+  copy.clear();
+  ASSERT_TRUE(encode(moved) == bytes);  // Copied offsets never retain another arena's pointers.
+
+  auto edited = metadata();
+  const std::string hostname(63, 'h');
+  ASSERT_TRUE(edited.set_hostname(esphome::StringRef(hostname)));
+  ASSERT_TRUE(edited.txt(3).value == "e072a1d59eb8" && edited.txt(7).key == "api_encryption");
+  ASSERT_TRUE(edited.set_hostname("mesh-c"));
+  ASSERT_TRUE(edited.set_txt_value(0, edited.txt(7).value));  // Source aliases shifted tail storage.
+  ASSERT_TRUE(edited.txt(0).value == edited.txt(7).value);
+  ASSERT_TRUE(edited.txt(3).value == "e072a1d59eb8");
+  ASSERT_TRUE(edited.set_txt_value(0, ""));
+  ASSERT_TRUE(edited.txt(1).value == "2026.9.1" && edited.txt(3).value == "e072a1d59eb8");
+  ASSERT_TRUE(!edited.set_txt_value(DISCOVERY_TXT_MAX, "out-of-range"));
+  ASSERT_TRUE(!encode(edited).empty());
+
+  // Failed setters cannot make truncated metadata encodable; clear restores it.
+  const auto stable = encode(moved);
+  ASSERT_TRUE(!moved.add_txt("overflow", "x"));
+  uint8_t output[DISCOVERY_DESCRIPTOR_MAX];
+  size_t written = 999;
+  ASSERT_TRUE(!encode_discovery(moved, output, sizeof(output), written) && written == 0);
+  moved = metadata();
+  ASSERT_TRUE(!moved.set_txt_value(0, esphome::StringRef(std::string(256, 'x'))));
+  ASSERT_TRUE(!encode_discovery(moved, output, sizeof(output), written));
+  auto unchanged = metadata();
+  const auto unchanged_bytes = encode(unchanged);
+  auto invalid = stable;
+  invalid[0] = 255;
+  ASSERT_TRUE(!decode_discovery(invalid.data(), invalid.size(), unchanged));
+  ASSERT_TRUE(encode(unchanged) == unchanged_bytes);
+}
+TEST(MeshDiscovery, RegistryAndCodecDoNotAllocateAfterSetup) {
+  // Test inputs and the allocation-counter self-check are prepared first.
+  const auto baseline = metadata();
+  auto updated = baseline;
+  ASSERT_TRUE(updated.set_txt_value(2, "deadbeef"));
+  auto spoofed = baseline;
+  ASSERT_TRUE(spoofed.set_txt_value(3, "e072a1d59f18"));
+  const auto base_bytes = encode(baseline), updated_bytes = encode(updated);
+  const auto base_packets = chunks(base_bytes), updated_packets = chunks(updated_bytes);
+  const auto spoofed_packets = chunks(encode(spoofed));
+  auto corrupted_packets = updated_packets;
+  corrupted_packets.back().back() ^= 1;
+  const auto before_probe = allocations;
+  void *probe = ::operator new(1);
+  ::operator delete(probe);
+  ASSERT_TRUE(allocations == before_probe + 1);
+
+  DiscoveryRegistry registry;
+  DiscoveryDescriptor decoded;
+  uint8_t output[DISCOVERY_DESCRIPTOR_MAX];
+  size_t written;
+  const auto before = allocations;
+  ASSERT_TRUE(registry.authorize(3, MAC));
+  for (uint32_t i = 1; i <= 100; ++i) {
+    const uint32_t now = i * 100;
+    ASSERT_TRUE(receive(registry, 3, base_packets, now));
+    const auto *current = registry.current(3, ADDRESS, now);
+    ASSERT_TRUE(current && current->txt(2).value == "1234abcd");
+    const auto revision = registry.revision(3);
+    ASSERT_TRUE(receive(registry, 3, base_packets, now + 1));
+    ASSERT_TRUE(registry.current(3, ADDRESS, now + 1) == current && registry.revision(3) == revision);
+    // Partial, corrupt and valid-but-wrong-identity refreshes retain live metadata.
+    ASSERT_TRUE(registry.receive(3, updated_packets[0].data(), updated_packets[0].size(), now + 2));
+    ASSERT_TRUE(registry.current(3, ADDRESS, now + 2)->txt(2).value == "1234abcd");
+    ASSERT_TRUE(!receive(registry, 3, corrupted_packets, now + 3));
+    ASSERT_TRUE(!receive(registry, 3, spoofed_packets, now + 4));
+    ASSERT_TRUE(registry.current(3, ADDRESS, now + 4) == current && registry.revision(3) == revision);
+    ASSERT_TRUE(receive(registry, 3, updated_packets, now + 5));
+    ASSERT_TRUE(registry.current(3, ADDRESS, now + 5)->txt(2).value == "deadbeef");
+    ASSERT_TRUE(registry.refresh(3, ADDRESS, now + 6));
+    ASSERT_TRUE(decode_discovery(updated_bytes.data(), updated_bytes.size(), decoded));
+    ASSERT_TRUE(encode_discovery(decoded, output, sizeof(output), written));
+    ASSERT_TRUE(written == updated_bytes.size() && std::memcmp(output, updated_bytes.data(), written) == 0);
+    registry.forget(3);
+    ASSERT_TRUE(!registry.current(3, ADDRESS, now + 7));
+  }
+  ASSERT_TRUE(receive(registry, 3, base_packets, 20000));
+  registry.expire(20000 + DISCOVERY_LIFETIME_MS);
+  ASSERT_TRUE(!registry.current(3, ADDRESS, 20000 + DISCOVERY_LIFETIME_MS));
+  registry.revoke(3);
+  ASSERT_TRUE(!receive(registry, 3, base_packets, 40000));
+  ASSERT_TRUE(registry.authorize(3, MAC));
+  ASSERT_TRUE(receive(registry, 3, base_packets, 40001));
+  ASSERT_TRUE(allocations == before);
+}
+
+using Packets = std::vector<Bytes>;
+constexpr size_t POOL_NODES = mesh_limits::MAX_NODES;
+constexpr size_t POOL_SLOTS = DISCOVERY_ASSEMBLY_SLOTS;
+
+struct PoolFixture {
+  std::array<Packets, POOL_NODES> original, updated;
+  std::array<std::array<uint8_t, 6>, POOL_NODES> macs{};
+  PoolFixture() {
+    for (size_t i = 0; i < POOL_NODES; ++i) {
+      macs[i] = {2, 0, 0, 0, 0, uint8_t(i + 1)};
+      char mac[13] = "020000000000";
+      const char hex[] = "0123456789abcdef";
+      mac[10] = hex[(i + 1) >> 4];
+      mac[11] = hex[(i + 1) & 15];
+      DiscoveryDescriptor descriptor;
+      char hostname[8];
+      std::snprintf(hostname, sizeof(hostname), "mesh-%u", static_cast<unsigned>(i + 1));
+      assert(descriptor.set_hostname(hostname));
+      descriptor.api_port = 6053;
+      assert(descriptor.add_txt("mac", mac));
+      assert(descriptor.add_txt("version", "old"));
+      assert(descriptor.add_txt(esphome::StringRef("padding"), esphome::StringRef(std::string(180, 'x'))));
+      original[i] = encode(descriptor, i);
+      assert(descriptor.set_txt_value(1, "new"));
+      updated[i] = encode(descriptor, i);
+      assert(original[i].size() > 1 && updated[i].size() > 1);
+    }
+  }
+  static uint32_t address(size_t i) { return uint32_t(0x0200000aU + (i << 24)); }
+  static Packets encode(const DiscoveryDescriptor &descriptor, size_t peer) {
+    uint8_t wire[DISCOVERY_DESCRIPTOR_MAX];
+    size_t length = 0;
+    assert(encode_discovery(descriptor, wire, sizeof(wire), length));
+    Packets result;
+    for (size_t offset = 0; offset < length; offset += DISCOVERY_CHUNK_SIZE) {
+      Bytes fragment(DISCOVERY_FRAME_MAX);
+      size_t written = 0;
+      assert(discovery_chunk(wire, length, address(peer), offset, fragment.data(), fragment.size(), written));
+      fragment.resize(written);
+      result.push_back(std::move(fragment));
+    }
+    return result;
+  }
+  void authorize(DiscoveryRegistry &registry) const {
+    for (size_t i = 0; i < POOL_NODES; ++i)
+      assert(registry.authorize(i + 1, macs[i].data()));
+  }
+  static bool first(DiscoveryRegistry &registry, size_t peer, const Packets &packets, uint32_t now) {
+    return registry.receive(peer + 1, packets[0].data(), packets[0].size(), now);
+  }
+  static bool all(DiscoveryRegistry &registry, size_t peer, const Packets &packets, uint32_t now) {
+    bool result = true;
+    for (const auto &fragment : packets)
+      result = registry.receive(peer + 1, fragment.data(), fragment.size(), now) && result;
+    return result;
+  }
+};
+
+TEST(MeshDiscovery, FullAssemblyPoolKeepsIndependentPeerRefreshesWithoutAllocations) {
+  PoolFixture fixture;
+  const size_t before = allocations;
+  if constexpr (POOL_SLOTS != POOL_NODES) {
+    GTEST_SKIP() << "This case verifies the full default assembly pool";
+  }
+  DiscoveryRegistry registry;
+  fixture.authorize(registry);
+  for (size_t i = 0; i < POOL_NODES; ++i)
+    ASSERT_TRUE((PoolFixture::all(registry, i, fixture.original[i], 100)));
+  for (size_t i = 0; i < POOL_NODES; ++i)
+    ASSERT_TRUE((PoolFixture::first(registry, i, fixture.updated[i], 1000)));
+  // One peer may restart its own assembly without disturbing any other peer.
+  ASSERT_TRUE((PoolFixture::first(registry, 0, fixture.original[0], 2999)));
+  for (size_t i = 1; i < POOL_NODES; ++i) {
+    ASSERT_TRUE((PoolFixture::all(registry, i, fixture.updated[i], 2999)));
+    ASSERT_TRUE((registry.current(i + 1, PoolFixture::address(i), 2999)->txt(1).value == "new"));
+  }
+  ASSERT_TRUE((PoolFixture::all(registry, 0, fixture.original[0], 3001)));
+  ASSERT_TRUE((registry.current(1, PoolFixture::address(0), 3001)->txt(1).value == "old"));
+
+  ASSERT_TRUE(allocations == before);
+}
