+Bytes encode(const DiscoveryDescriptor &descriptor) {
+  Bytes data(DISCOVERY_DESCRIPTOR_MAX);
+  size_t size = 0;
+  assert(encode_discovery(descriptor, data.data(), data.size(), size));
+  data.resize(size);
+  return data;
+}
+std::vector<Bytes> chunks(const Bytes &data, uint32_t address = ADDRESS, size_t budget = DISCOVERY_FRAME_MAX) {
+  std::vector<Bytes> result;
+  for (size_t offset = 0; offset < data.size(); offset += budget - DISCOVERY_HEADER_SIZE) {
+    Bytes chunk(DISCOVERY_FRAME_MAX);
+    size_t size = 0;
+    assert(discovery_chunk(data.data(), data.size(), address, offset, chunk.data(), chunk.size(), size, budget));
+    chunk.resize(size);
+    result.push_back(std::move(chunk));
+  }
+  return result;
+}
+bool receive(DiscoveryRegistry &registry, uint8_t node, const std::vector<Bytes> &packets, uint32_t now) {
+  bool success = true;
+  for (const auto &packet : packets)
+    success = registry.receive(node, packet.data(), packet.size(), now) && success;
+  return success;
+}
