+namespace mesh_ip {
+namespace {
+
+static_assert(kFragmentDataSize > 0, "Fragment header must fit core payload");
+static_assert(kMaxFragmentCount <= 64, "Reassembly mask is 64 bits");
+static_assert(kMinimumFragmentDataSize > 0, "Fragment stride must remain positive");
+static_assert(kMtu <= UINT16_MAX, "Wire packet length is 16 bits");
+static_assert(kFragmentDataSize <= UINT16_MAX, "Wire fragment stride is 16 bits");
+
+uint16_t read16(const uint8_t *p) {
+  return static_cast<uint16_t>(p[0]) | static_cast<uint16_t>(static_cast<uint16_t>(p[1]) << 8);
+}
+
+uint32_t read32(const uint8_t *p) {
+  return static_cast<uint32_t>(p[0]) | (static_cast<uint32_t>(p[1]) << 8) | (static_cast<uint32_t>(p[2]) << 16) |
+         (static_cast<uint32_t>(p[3]) << 24);
+}
+
+void write16(uint8_t *p, uint16_t value) {
+  p[0] = static_cast<uint8_t>(value);
+  p[1] = static_cast<uint8_t>(value >> 8);
+}
+
+void write32(uint8_t *p, uint32_t value) {
+  p[0] = static_cast<uint8_t>(value);
+  p[1] = static_cast<uint8_t>(value >> 8);
+  p[2] = static_cast<uint8_t>(value >> 16);
+  p[3] = static_cast<uint8_t>(value >> 24);
+}
+
+bool valid_node(NodeId node) { return node >= 1 && node <= mesh_core::kMaxNodes; }
+
+}  // namespace
+
+uint32_t packet_crc32(const uint8_t *data, size_t length) {
+  uint32_t crc = UINT32_MAX;
+  for (size_t i = 0; i < length; ++i) {
+    crc ^= data[i];
+    for (uint8_t bit = 0; bit < 8; ++bit)
+      crc = (crc >> 1) ^ ((0U - (crc & 1U)) & 0xedb88320U);
+  }
+  return crc ^ UINT32_MAX;
+}
+
+bool Fragmenter::set_profile(const PacketProfile &profile) {
+  if (active_ || !valid_packet_profile(profile))
+    return false;
+  profile_ = profile;
+  return true;
+}
+
+bool Fragmenter::begin(const uint8_t *packet, size_t length, uint32_t packet_id) {
+  if (active_ || packet == nullptr || length == 0 || length > kMtu)
+    return false;
+  std::memcpy(packet_, packet, length);
+  return begin_in_place(length, packet_id);
+}
+
+bool Fragmenter::begin_in_place(size_t length, uint32_t packet_id) {
+  if (active_ || length == 0 || length > kMtu)
+    return false;
+  packet_id_ = packet_id;
+  length_ = static_cast<uint16_t>(length);
+  crc_ = packet_crc32(packet_, length);
+  index_ = 0;
+  const size_t data_size = profile_.payload_mtu - kFragmentHeaderSize;
+  count_ = static_cast<uint8_t>((length + data_size - 1) / data_size);
+  active_ = true;
+  return true;
+}
+
+bool Fragmenter::peek(uint8_t *output, size_t capacity, size_t &written) const {
+  return peek_at(index_, output, capacity, written);
+}
+
+bool Fragmenter::peek_at(uint8_t index, uint8_t *output, size_t capacity, size_t &written) const {
+  written = 0;
+  if (!active_ || index >= count_ || output == nullptr)
+    return false;
+  const size_t data_size = profile_.payload_mtu - kFragmentHeaderSize;
+  const size_t offset = static_cast<size_t>(index) * data_size;
+  const size_t chunk = std::min(data_size, length_ - offset);
+  if (capacity < kFragmentHeaderSize + chunk)
+    return false;
+  output[0] = 'M';
+  output[1] = 'I';
+  output[2] = 3;
+  output[3] = 0;
+  write32(output + 4, packet_id_);
+  write16(output + 8, length_);
+  output[10] = index;
+  output[11] = count_;
+  write32(output + 12, crc_);
+  write16(output + 16, static_cast<uint16_t>(data_size));
+  std::memcpy(output + kFragmentHeaderSize, packet_ + offset, chunk);
+  written = kFragmentHeaderSize + chunk;
+  return true;
+}
+
+bool Fragmenter::advance() {
+  if (!active_)
+    return false;
+  ++index_;
+  if (index_ == count_)
+    active_ = false;
+  return true;
+}
+
+void Fragmenter::reset() {
+  active_ = false;
+  length_ = 0;
+  index_ = 0;
+  count_ = 0;
+}
+
+bool Reassembler::set_profile(const PacketProfile &profile) {
+  if (pending_packets() != 0 || !valid_packet_profile(profile))
+    return false;
+  profile_ = profile;
+  // Do not preserve replay entries across a lifetime-profile change.
+  for (auto &entry : recent_)
+    entry.length = 0;
+  recent_cursor_ = 0;
+  return true;
+}
+
+void Reassembler::expire(uint32_t now_ms) {
+  for (auto &slot : slots_) {
+    if (slot.used && now_ms - slot.started_at >= profile_.reassembly_timeout_ms) {
+      slot.used = false;
+      ++counters_.expired_packets;
+    }
+  }
+  for (auto &entry : recent_) {
+    if (entry.length != 0 && now_ms - entry.completed_at >= profile_.reassembly_timeout_ms)
+      entry.length = 0;
+  }
+}
+
+void Reassembler::reset() {
+  for (auto &slot : slots_)
+    slot.used = false;
+  for (auto &entry : recent_)
+    entry.length = 0;
+  recent_cursor_ = 0;
+  counters_ = ReassemblyCounters{};
+}
+
+size_t Reassembler::pending_packets() const {
+  size_t count = 0;
+  for (const auto &slot : slots_)
+    count += slot.used;
+  return count;
+}
+
+ReceiveResult Reassembler::receive(NodeId source, NodeId destination, const uint8_t *fragment, size_t length,
+                                   uint32_t now_ms, CompletedPacket &completed) {
+  return receive_(source, destination, fragment, length, now_ms, completed, false);
+}
+
+ReceiveResult Reassembler::receive_deferred(NodeId source, NodeId destination, const uint8_t *fragment, size_t length,
+                                            uint32_t now_ms, CompletedPacket &completed) {
+  return receive_(source, destination, fragment, length, now_ms, completed, true);
+}
+
+bool Reassembler::status(NodeId source, NodeId destination, uint32_t packet_id, ReassemblyStatus &out) const {
+  out = {};
+  for (const auto &slot : slots_) {
+    if (slot.used && slot.source == source && slot.destination == destination && slot.packet_id == packet_id) {
+      out = {slot.packet_id, slot.crc, slot.length, slot.count, slot.received_mask, slot.complete, false};
+      return true;
+    }
+  }
+  for (const auto &entry : recent_) {
+    if (entry.length != 0 && entry.source == source && entry.destination == destination &&
+        entry.packet_id == packet_id) {
+      const uint64_t mask = entry.count == 64 ? UINT64_MAX : (UINT64_C(1) << entry.count) - 1;
+      out = {entry.packet_id, entry.crc, entry.length, entry.count, mask, true, true};
+      return true;
+    }
+  }
+  return false;
+}
+
+bool Reassembler::completed_at(size_t index, CompletedPacket &out) const {
+  out = {};
+  if (index >= kReassemblySlots || !slots_[index].used || !slots_[index].complete)
+    return false;
+  const auto &slot = slots_[index];
+  out = {slot.packet, slot.length, slot.source, slot.destination, slot.packet_id};
+  return true;
+}
+
+bool Reassembler::commit(NodeId source, NodeId destination, uint32_t packet_id, uint32_t now_ms) {
+  for (auto &slot : slots_) {
+    if (!slot.used || !slot.complete || slot.source != source || slot.destination != destination ||
+        slot.packet_id != packet_id)
+      continue;
+    recent_[recent_cursor_] =
+        Recent{slot.packet_id, slot.crc, now_ms, slot.length, slot.source, slot.destination, slot.count};
+    recent_cursor_ = (recent_cursor_ + 1) % kReplaySlots;
+    slot.used = false;
+    return true;
+  }
+  return false;
+}
+
+void Reassembler::discard(NodeId source, NodeId destination, uint32_t packet_id) {
+  for (auto &slot : slots_)
+    if (slot.used && slot.source == source && slot.destination == destination && slot.packet_id == packet_id)
+      slot.used = false;
+}
+
+void Reassembler::reset_peer(NodeId peer) {
+  for (auto &slot : slots_)
+    if (slot.source == peer || slot.destination == peer)
+      slot.used = false;
+  for (auto &entry : recent_)
+    if (entry.source == peer || entry.destination == peer)
+      entry.length = 0;
+}
+
+ReceiveResult Reassembler::receive_(NodeId source, NodeId destination, const uint8_t *fragment, size_t length,
+                                    uint32_t now_ms, CompletedPacket &completed, bool deferred) {
+  completed = CompletedPacket{};
+  expire(now_ms);
+  const auto invalid = [this]() {
+    ++counters_.invalid_fragments;
+    return ReceiveResult::INVALID;
+  };
+  if (!valid_node(source) || !valid_node(destination) || fragment == nullptr || length < kFragmentHeaderSize ||
+      length > profile_.payload_mtu)
+    return invalid();
+  if (fragment[0] != 'M' || fragment[1] != 'I')
+    return invalid();
+  if (fragment[2] != 3 || fragment[3] != 0)
+    return invalid();
+  const size_t data_size = read16(fragment + 16);
+  // A short final fragment does not permit a sender to announce a larger
+  // budget than this receiver supports; every packet has one explicit stride.
+  if (data_size < kMinimumFragmentDataSize || data_size + kFragmentHeaderSize > profile_.payload_mtu)
+    return invalid();
+  const uint32_t packet_id = read32(fragment + 4);
+  const uint16_t total = read16(fragment + 8);
+  const uint8_t index = fragment[10];
+  const uint8_t count = fragment[11];
+  const uint32_t crc = read32(fragment + 12);
+  if (total == 0 || total > kMtu || count == 0 || count > kMaxFragmentCount ||
+      count != (total + data_size - 1) / data_size || index >= count)
+    return invalid();
+  const size_t offset = static_cast<size_t>(index) * data_size;
+  const size_t chunk = std::min(data_size, static_cast<size_t>(total) - offset);
+  if (length != kFragmentHeaderSize + chunk)
+    return invalid();
+
+  for (const auto &entry : recent_) {
+    if (entry.length != 0 && entry.source == source && entry.destination == destination &&
+        entry.packet_id == packet_id) {
+      if (entry.length != total || entry.crc != crc)
+        return invalid();
+      ++counters_.duplicate_fragments;
+      return ReceiveResult::DUPLICATE;
+    }
+  }
+
+  Slot *slot = nullptr;
+  Slot *free_slot = nullptr;
+  size_t source_slots = 0;
+  for (auto &candidate : slots_) {
+    if (!candidate.used) {
+      if (free_slot == nullptr)
+        free_slot = &candidate;
+      continue;
+    }
+    source_slots += candidate.source == source;
+    if (candidate.source == source && candidate.destination == destination && candidate.packet_id == packet_id)
+      slot = &candidate;
+  }
+  if (slot != nullptr) {
+    // Reject conflicting metadata without allowing it to evict a valid packet.
+    if (slot->length != total || slot->crc != crc || slot->count != count || slot->fragment_data_size != data_size)
+      return invalid();
+  } else {
+    if (free_slot == nullptr || source_slots >= kMaxSlotsPerSource) {
+      ++counters_.capacity_drops;
+      return ReceiveResult::NO_CAPACITY;
+    }
+    slot = free_slot;
+    slot->used = true;
+    slot->complete = false;
+    slot->source = source;
+    slot->destination = destination;
+    slot->packet_id = packet_id;
+    slot->crc = crc;
+    slot->length = total;
+    slot->count = count;
+    slot->fragment_data_size = static_cast<uint16_t>(data_size);
+    slot->received_mask = 0;
+    slot->started_at = now_ms;
+  }
+
+  const uint64_t bit = UINT64_C(1) << index;
+  if ((slot->received_mask & bit) != 0) {
+    if (std::memcmp(slot->packet + offset, fragment + kFragmentHeaderSize, chunk) != 0)
+      return invalid();
+    ++counters_.duplicate_fragments;
+    return ReceiveResult::DUPLICATE;
+  }
+  std::memcpy(slot->packet + offset, fragment + kFragmentHeaderSize, chunk);
+  slot->received_mask |= bit;
+  ++counters_.accepted_fragments;
+  const uint64_t complete_mask = count == 64 ? UINT64_MAX : (UINT64_C(1) << count) - 1U;
+  if (slot->received_mask != complete_mask)
+    return ReceiveResult::INCOMPLETE;
+
+  if (packet_crc32(slot->packet, total) != crc) {
+    slot->used = false;
+    return invalid();
+  }
+  slot->complete = true;
+  completed = CompletedPacket{slot->packet, total, source, destination, packet_id};
+  ++counters_.completed_packets;
+  if (!deferred)
+    commit(source, destination, packet_id, now_ms);
+  return ReceiveResult::COMPLETE;
+}
+
+}  // namespace mesh_ip
diff --git a/esphome/components/mesh/mesh_ip_packet.h b/esphome/components/mesh/mesh_ip_packet.h
new file mode 100644
index 000000000..638d62a86
--- /dev/null
+++ b/esphome/components/mesh/mesh_ip_packet.h
@@ -0,0 +1,194 @@
+#pragma once
+
+#include "mesh_limits.h"
+
+#include "mesh_core.h"
+#include "mesh_ip_role.h"
+
+#include <cstddef>
+#include <cstdint>
+
+// Portable packet transport only. The adapter validates the enclosed IP packet,
+// authenticates peers and gives every emitted fragment its own MeshCore sequence.
+// Instances are single-threaded: callers must serialize all access.
+namespace mesh_ip {
+
+using NodeId = mesh_core::NodeId;
+// Accept ordinary Ethernet-sized IP packets, including TCP connections that
+// were established before a transport change. A netif may advertise a lower MTU.
+constexpr size_t kMtu = 1500;
+constexpr size_t kPacketMtu = kMtu;
+constexpr size_t kFragmentHeaderSize = 18;
+constexpr size_t kFragmentDataSize = mesh_core::kMaxPayload - kFragmentHeaderSize;
+// Legacy/default packet count remains useful to callers sizing ESP-NOW tests.
+constexpr size_t kMaxFragments = (kMtu + kFragmentDataSize - 1) / kFragmentDataSize;
+constexpr size_t kMaxFragmentCount = 64;
+constexpr size_t kMinimumFragmentDataSize = (kMtu + kMaxFragmentCount - 1) / kMaxFragmentCount;
+constexpr size_t kMinimumPayloadMtu = kFragmentHeaderSize + kMinimumFragmentDataSize;
+#ifdef MESH_IP_CLIENT_ONLY
+constexpr size_t kReassemblySlots = 2;  // Existing per-source bound; source is the gateway.
+#else
+constexpr size_t kReassemblySlots = 8;
+#endif
+constexpr size_t kMaxSlotsPerSource = 2;
+constexpr size_t kReplaySlots = 64;
+constexpr uint32_t kReassemblyTimeoutMs = 2000;
+
+struct PacketProfile {
+  // Complete mesh payload budget, including the 18-byte v3 fragment header.
+  size_t payload_mtu{mesh_core::kMaxPayload};
+  uint32_t reassembly_timeout_ms{kReassemblyTimeoutMs};
+};
+constexpr bool valid_packet_profile(const PacketProfile &profile) {
+  return profile.payload_mtu >= kMinimumPayloadMtu && profile.payload_mtu <= mesh_core::kMaxPayload &&
+         profile.reassembly_timeout_ms != 0 && profile.reassembly_timeout_ms < 0x80000000U;
+}
+
+// A native radio may have a larger frame budget; the portable wire/buffers
+// remain bounded by kMaxPayload instead of expanding implicitly.
+constexpr PacketProfile packet_profile_for_link(const mesh_transport::LinkCapabilities &link,
+                                                uint32_t timeout_ms = kReassemblyTimeoutMs) {
+  return PacketProfile{link.payload_mtu < mesh_core::kMaxPayload ? link.payload_mtu : mesh_core::kMaxPayload,
+                       timeout_ms};
+}
+
+// CRC detects corruption and accidentally mixed fragments; it is not a MAC.
+uint32_t packet_crc32(const uint8_t *data, size_t length);
+
+// Version3 header: 'M','I',version=3,flags=0,id LE32,total_length LE16,
+// fragment_index U8,fragment_count U8,whole_packet_crc32 LE32,stride LE16.
+// Explicit wide stride supports native v2 frames without wrapping at 255.
+// Old v1/v2 fragments are rejected; the authenticated common protocol profile
+// requires v3 on every member. IP packets and the fragment count remain bounded.
+class Fragmenter {
+ public:
+  // Changes are rejected while a packet is active; failure preserves settings.
+  bool set_profile(const PacketProfile &profile);
+  const PacketProfile &profile() const { return profile_; }
+  // Copies the packet. An active packet cannot be replaced; use reset() to abort.
+  bool begin(const uint8_t *packet, size_t length, uint32_t packet_id);
+  // The single owner may fill an inactive packet directly, then publish it.
+  // Active originals remain immutable until reset(), including ARQ retries.
+  uint8_t *writable_packet() { return active_ ? nullptr : packet_; }
+  bool begin_in_place(size_t length, uint32_t packet_id);
+  // Does not advance. Retry the same fragment when the caller's queue is full.
+  bool peek(uint8_t *output, size_t capacity, size_t &written) const;
+  // Random access to the retained original for selective repeat; no advancement.
+  bool peek_at(uint8_t index, uint8_t *output, size_t capacity, size_t &written) const;
+  // Call only after the current fragment was copied into the adapter's queue.
+  bool advance();
+  void reset();
+  bool active() const { return active_; }
+  uint8_t fragment_index() const { return index_; }
+  uint8_t fragment_count() const { return count_; }
+  uint32_t packet_id() const { return packet_id_; }
+  size_t packet_length() const { return length_; }
+  uint32_t packet_crc() const { return crc_; }
+
+ private:
+  PacketProfile profile_{};
+  uint8_t packet_[kMtu]{};
+  uint32_t packet_id_{0};
+  uint32_t crc_{0};
+  uint16_t length_{0};
+  uint8_t index_{0};
+  uint8_t count_{0};
+  bool active_{false};
+};
+
+enum class ReceiveResult : uint8_t {
+  INVALID,
+  INCOMPLETE,
+  DUPLICATE,
+  COMPLETE,
+  NO_CAPACITY,
+};
+
+struct CompletedPacket {
+  // Owned by Reassembler, valid only until its next non-const operation.
+  const uint8_t *data{nullptr};
+  size_t length{0};
+  NodeId source{0};
+  NodeId destination{0};
+  uint32_t packet_id{0};
+};
+
+struct ReassemblyCounters {
+  uint32_t accepted_fragments{0};
+  uint32_t completed_packets{0};
+  uint32_t duplicate_fragments{0};
+  uint32_t invalid_fragments{0};
+  uint32_t expired_packets{0};
+  uint32_t capacity_drops{0};
+};
+
+struct ReassemblyStatus {
+  uint32_t packet_id{0}, crc{0};
+  uint16_t length{0};
+  uint8_t count{0};
+  uint64_t received_mask{0};
+  bool complete{false}, committed{false};
+};
+
+class Reassembler {
+ public:
+  // Changes are rejected while any packet is pending. Reassembly timeout and
+  // replay lifetime share this profile; duplicates never extend either.
+  bool set_profile(const PacketProfile &profile);
+  const PacketProfile &profile() const { return profile_; }
+  ReceiveResult receive(NodeId source, NodeId destination, const uint8_t *fragment, size_t length, uint32_t now_ms,
+                        CompletedPacket &completed);
+  // Transactional path: a complete CRC-checked packet remains held until the
+  // endpoint accepts it. No replay entry is committed before commit().
+  ReceiveResult receive_deferred(NodeId source, NodeId destination, const uint8_t *fragment, size_t length,
+                                 uint32_t now_ms, CompletedPacket &completed);
+  bool status(NodeId source, NodeId destination, uint32_t packet_id, ReassemblyStatus &out) const;
+  bool completed_at(size_t slot, CompletedPacket &out) const;
+  bool commit(NodeId source, NodeId destination, uint32_t packet_id, uint32_t now_ms);
+  void discard(NodeId source, NodeId destination, uint32_t packet_id);
+  void reset_peer(NodeId peer);
+  // Lifetime is measured from the first fragment, never refreshed by duplicates.
+  // now_ms is a monotonic wrapping millisecond clock; intervals must be <2^31 ms.
+  void expire(uint32_t now_ms);
+  void reset();
+  size_t pending_packets() const;
+  const ReassemblyCounters &counters() const { return counters_; }
+
+ private:
+  struct Slot {
+    uint64_t received_mask{0};
+    uint32_t packet_id{0};
+    uint32_t crc{0};
+    uint32_t started_at{0};
+    uint16_t length{0};
+    NodeId source{0};
+    NodeId destination{0};
+    uint8_t count{0};
+    uint16_t fragment_data_size{0};
+    bool used{false};
+    bool complete{false};
+    uint8_t packet[kMtu]{};
+  };
+  struct Recent {
+    uint32_t packet_id{0};
+    uint32_t crc{0};
+    uint32_t completed_at{0};
+    uint16_t length{0};  // Zero denotes an unused replay entry; packets are nonempty.
+    NodeId source{0};
+    NodeId destination{0};
+    uint8_t count{0};
+  };
+
+  ReceiveResult receive_(NodeId source, NodeId destination, const uint8_t *fragment, size_t length, uint32_t now_ms,
+                         CompletedPacket &completed, bool deferred);
+
+  PacketProfile profile_{};
+  Slot slots_[kReassemblySlots]{};
+  // A bounded replay cache, not an unbounded guarantee against malicious replay.
+  // Completed packet buffers are immediately reusable to avoid throughput limits.
+  Recent recent_[kReplaySlots]{};
+  size_t recent_cursor_{0};
+  ReassemblyCounters counters_{};
+};
+
+}  // namespace mesh_ip
diff --git a/esphome/components/mesh/mesh_ip_queue.h b/esphome/components/mesh/mesh_ip_queue.h
new file mode 100644
index 000000000..eea6246eb
--- /dev/null
+++ b/esphome/components/mesh/mesh_ip_queue.h
@@ -0,0 +1,311 @@
+#pragma once
+
+#include "mesh_limits.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace mesh_ip {
+
+// Epoch/ownership metadata can travel without a second full packet buffer.
+struct QueuedIpMetadata {
+  uint32_t generation{0};
+  uint32_t peer_epoch{0}, ingress_epoch{0};
+  uint8_t destination{0};
+  uint8_t ingress_source{0};
+  bool gateway_ingress{false};
+  uint16_t length{0};
+};
+
+struct QueuedIpPacket {
+  static constexpr size_t MAX_PACKET_SIZE = 1500;
+  uint32_t generation{0};
+  uint32_t peer_epoch{0}, ingress_epoch{0};
+  uint8_t destination{0};
+  uint8_t ingress_source{0};
+  bool gateway_ingress{false};
+  uint16_t length{0};
+  uint8_t data[MAX_PACKET_SIZE]{};
+};
+
+// Bounded deficit round robin. No protocol, port number, DSCP or ICMP type
+// receives preferential treatment. One greedy flow cannot occupy every slot.
+// The platform serializes metadata operations. A reservation gives one writer
+// exclusive payload access outside that lock until commit/cancel. Reset never
+// reuses an unpublished slot while its writer is still filling it.
+class IpFlowQueue {
+ public:
+  static constexpr size_t CAPACITY = 8;
+  static constexpr size_t MAX_PER_FLOW = CAPACITY / 2;
+  static constexpr size_t SPARSE_RESERVE = 2;
+  static constexpr uint16_t QUANTUM = 512;
+  enum class Admission : uint8_t { ACCEPTED, FULL, FLOW_LIMIT };
+  struct Reservation {
+    uint32_t serial{0};
+    uint8_t slot{255};
+  };
+  struct Key {
+    uint32_t source{0}, target{0};
+#ifdef MESH_IPV6
+    uint32_t source_high[3]{}, target_high[3]{};
+    uint8_t family{4};
+#endif
+    uint16_t source_port{0}, target_port{0};
+    uint8_t protocol{0}, destination{0};
+    bool operator==(const Key &other) const {
+#ifdef MESH_IPV6
+      if (family != other.family || std::memcmp(source_high, other.source_high, sizeof(source_high)) != 0 ||
+          std::memcmp(target_high, other.target_high, sizeof(target_high)) != 0)
+        return false;
+#endif
+      return source == other.source && target == other.target && source_port == other.source_port &&
+             target_port == other.target_port && protocol == other.protocol && destination == other.destination;
+    }
+  };
+
+  Admission reserve(const Key &key, Reservation &reservation) {
+    reservation = {};
+    uint8_t flow = NONE, free_flow = NONE, slot = NONE;
+    for (uint8_t i = 0; i < CAPACITY; ++i) {
+      if (flows_[i].count && flows_[i].key == key)
+        flow = i;
+      if (!flows_[i].count && free_flow == NONE)
+        free_flow = i;
+      if (slots_[i].state == State::FREE && slot == NONE)
+        slot = i;
+    }
+    if (flow != NONE &&
+        (flows_[flow].count >= MAX_PER_FLOW || (flows_[flow].count >= 2 && occupied_ >= CAPACITY - SPARSE_RESERVE)))
+      return Admission::FLOW_LIMIT;
+    if (slot == NONE || (flow == NONE && free_flow == NONE))
+      return Admission::FULL;
+    if (flow == NONE) {
+      flow = free_flow;
+      flows_[flow] = Flow{};
+      flows_[flow].key = key;
+    }
+    auto &entry = slots_[slot];
+    entry.next = NONE;
+    entry.flow = flow;
+    entry.state = State::RESERVED;
+    if (++serial_ == 0)
+      ++serial_;
+    entry.serial = serial_;
+    ++flows_[flow].count;
+    ++occupied_;
+    reservation.serial = entry.serial;
+    reservation.slot = slot;
+    return Admission::ACCEPTED;
+  }
+
+  QueuedIpPacket *reserved_packet(const Reservation &reservation) {
+    return owns_(reservation) ? &slots_[reservation.slot].packet : nullptr;
+  }
+
+  bool commit(const Reservation &reservation) {
+    if (!owns_(reservation))
+      return false;
+    auto &entry = slots_[reservation.slot];
+    // A reset leaves the writer's storage intact but invalidates its flow.
+    if (entry.flow == NONE || entry.packet.length > QueuedIpPacket::MAX_PACKET_SIZE ||
+        !(classify(entry.packet) == flows_[entry.flow].key)) {
+      cancel(reservation);
+      return false;
+    }
+    auto &queue = flows_[entry.flow];
+    entry.state = State::READY;
+    if (queue.tail != NONE)
+      slots_[queue.tail].next = reservation.slot;
+    else
+      queue.head = reservation.slot;
+    queue.tail = reservation.slot;
+    ++size_;
+    return true;
+  }
+
+  void cancel(const Reservation &reservation) {
+    if (!owns_(reservation))
+      return;
+    auto &entry = slots_[reservation.slot];
+    if (entry.flow != NONE && --flows_[entry.flow].count == 0)
+      flows_[entry.flow] = Flow{};
+    entry.state = State::FREE;
+    entry.flow = entry.next = NONE;
+    --occupied_;
+  }
+
+  Admission push(const QueuedIpPacket &packet) {
+    Reservation reservation;
+    const auto admitted = reserve(classify(packet), reservation);
+    if (admitted != Admission::ACCEPTED)
+      return admitted;
+    *reserved_packet(reservation) = packet;
+    return commit(reservation) ? Admission::ACCEPTED : Admission::FULL;
+  }
+
+  bool pop(QueuedIpPacket &packet) {
+    QueuedIpMetadata metadata;
+    if (!consume(packet.data, sizeof(packet.data), metadata))
+      return false;
+    packet.generation = metadata.generation;
+    packet.peer_epoch = metadata.peer_epoch;
+    packet.ingress_epoch = metadata.ingress_epoch;
+    packet.destination = metadata.destination;
+    packet.ingress_source = metadata.ingress_source;
+    packet.gateway_ingress = metadata.gateway_ingress;
+    packet.length = metadata.length;
+    return true;
+  }
+
+  // Consume directly into a reserved downstream original. A complete MTU-sized
+  // destination is required; failure cannot skip a large head packet or change
+  // its DRR deficit. The existing platform queue lock protects this one copy.
+  bool consume(uint8_t *target, size_t capacity, QueuedIpMetadata &metadata) {
+    if (target == nullptr || capacity < QueuedIpPacket::MAX_PACKET_SIZE)
+      return false;
+    if (!size_)
+      return false;
+    // Every packet is <=1500B. Four rounds suffice even from zero deficit.
+    for (size_t visit = 0; visit < CAPACITY * 4; ++visit) {
+      auto &flow = flows_[cursor_];
+      if (flow.head == NONE) {
+        advance_();
+        continue;
+      }
+      auto &entry = slots_[flow.head];
+      if (flow.deficit < entry.packet.length)
+        flow.deficit += QUANTUM;
+      if (flow.deficit < entry.packet.length) {
+        advance_();
+        continue;
+      }
+      metadata.generation = entry.packet.generation;
+      metadata.peer_epoch = entry.packet.peer_epoch;
+      metadata.ingress_epoch = entry.packet.ingress_epoch;
+      metadata.destination = entry.packet.destination;
+      metadata.ingress_source = entry.packet.ingress_source;
+      metadata.gateway_ingress = entry.packet.gateway_ingress;
+      metadata.length = entry.packet.length;
+      std::memcpy(target, entry.packet.data, metadata.length);
+      flow.deficit -= metadata.length;
+      flow.head = entry.next;
+      entry.state = State::FREE;
+      entry.flow = entry.next = NONE;
+      --flow.count;
+      --size_;
+      --occupied_;
+      if (flow.head == NONE)
+        flow.tail = NONE;
+      if (!flow.count) {
+        flow = Flow{};
+        advance_();
+      } else if (flow.head == NONE || flow.deficit < slots_[flow.head].packet.length)
+        advance_();
+      return true;
+    }
+    return false;
+  }
+
+  void reset() {
+    occupied_ = 0;
+    for (auto &entry : slots_) {
+      if (entry.state == State::RESERVED)
+        ++occupied_;
+      else
+        entry.state = State::FREE;
+      entry.flow = entry.next = NONE;
+    }
+    for (auto &flow : flows_)
+      flow = Flow{};
+    size_ = cursor_ = 0;
+  }
+  size_t size() const { return size_; }
+
+ private:
+  static constexpr uint8_t NONE = 255;
+  enum class State : uint8_t { FREE, RESERVED, READY };
+  struct Slot {
+    QueuedIpPacket packet;
+    uint32_t serial{0};
+    uint8_t next{NONE}, flow{NONE};
+    State state{State::FREE};
+  };
+  struct Flow {
+    Key key;
+    uint16_t deficit{0};
+    uint8_t head{NONE}, tail{NONE}, count{0};
+  };
+  static uint16_t be16_(const uint8_t *p) { return uint16_t(p[0]) << 8 | p[1]; }
+
+ public:
+  static Key classify(const QueuedIpPacket &packet) { return classify(packet.destination, packet.data, packet.length); }
+  // A complete IPv4 header plus four transport bytes (at most 64 bytes) is
+  // sufficient; callers need not copy the rest of a pbuf just to admit a flow.
+  static Key classify(uint8_t destination, const uint8_t *p, size_t length) {
+    Key key;
+    key.destination = destination;
+    if (p == nullptr || length < 20)
+      return key;
+#ifdef MESH_IPV6
+    key.family = p[0] >> 4;
+    if (key.family == 6) {
+      if (length < 40)
+        return key;
+      std::memcpy(&key.source, p + 8, 4);
+      std::memcpy(key.source_high, p + 12, 12);
+      std::memcpy(&key.target, p + 24, 4);
+      std::memcpy(key.target_high, p + 28, 12);
+      key.protocol = p[6];
+      // The same fixed prefix is classified both before admission and after
+      // filling the slot. Long extension chains fall back to exact endpoints;
+      // no first/noninitial fragment can manufacture a fresh transport flow.
+      const size_t prefix = length < 64 ? length : 64;
+      size_t offset = 40;
+      uint8_t next = p[6];
+      bool fragment = false;
+      for (size_t i = 0; i < 6 && (next == 0 || next == 43 || next == 60 || next == 44); ++i) {
+        if (offset + 2 > prefix)
+          return key;
+        const size_t bytes = next == 44 ? 8 : (size_t(p[offset + 1]) + 1) * 8;
+        if (bytes > prefix - offset)
+          return key;
+        fragment |= next == 44;
+        next = p[offset];
+        offset += bytes;
+      }
+      if (!fragment && (next == 6 || next == 17) && offset + 4 <= prefix) {
+        key.protocol = next;
+        key.source_port = be16_(p + offset);
+        key.target_port = be16_(p + offset + 2);
+      }
+      return key;
+    }
+#endif
+    std::memcpy(&key.source, p + 12, 4);
+    std::memcpy(&key.target, p + 16, 4);
+    key.protocol = p[9];
+    const size_t header = (p[0] & 15) * 4;
+    // Fragmented traffic uses the endpoint/protocol fallback. A new IPv4 ID
+    // must not manufacture a new flow and bypass the bounded flow admission.
+    if ((be16_(p + 6) & 0x3fffU) == 0 && (key.protocol == 6 || key.protocol == 17) && header >= 20 &&
+        header + 4 <= length) {
+      key.source_port = be16_(p + header);
+      key.target_port = be16_(p + header + 2);
+    }
+    return key;
+  }
+
+ private:
+  bool owns_(const Reservation &reservation) const {
+    return reservation.slot < CAPACITY && slots_[reservation.slot].state == State::RESERVED &&
+           slots_[reservation.slot].serial == reservation.serial;
+  }
+  void advance_() { cursor_ = (cursor_ + 1) % CAPACITY; }
+  Slot slots_[CAPACITY]{};
+  Flow flows_[CAPACITY]{};
+  uint32_t serial_{0};
+  uint8_t size_{0}, occupied_{0}, cursor_{0};
+};
+
+}  // namespace mesh_ip
