+#include "mesh_ip_delivery.h"
+
+#include <cstring>
+
+namespace mesh_ip {
+namespace {
+bool node_valid(NodeId id) { return id >= 1 && id <= mesh_core::kMaxNodes; }
+uint16_t read16(const uint8_t *p) { return uint16_t(p[0]) | (uint16_t(p[1]) << 8); }
+uint32_t read32(const uint8_t *p) {
+  return uint32_t(p[0]) | (uint32_t(p[1]) << 8) | (uint32_t(p[2]) << 16) | (uint32_t(p[3]) << 24);
+}
+uint64_t read64(const uint8_t *p) {
+  uint64_t result = 0;
+  for (size_t i = 0; i < 8; ++i)
+    result |= uint64_t(p[i]) << (8 * i);
+  return result;
+}
+void write(uint8_t *p, uint64_t value, size_t bytes) {
+  for (size_t i = 0; i < bytes; ++i)
+    p[i] = uint8_t(value >> (8 * i));
+}
+bool newer(uint32_t a, uint32_t b) { return a != b && uint32_t(a - b) < 0x80000000U; }
+}  // namespace
+
+bool valid_delivery_profile(const DeliveryProfile &profile) {
+  return valid_packet_profile(profile.packet) && profile.retry_interval_ms != 0 &&
+         profile.retry_interval_ms < profile.packet_lifetime_ms &&
+         profile.packet_lifetime_ms <= profile.packet.reassembly_timeout_ms &&
+         profile.packet_lifetime_ms < 0x80000000U && profile.max_attempts >= 2 &&
+         profile.max_ack_delay_ms < profile.retry_interval_ms && profile.ack_batch_size >= 1 &&
+         profile.ack_batch_size <= kDeliveryWindow;
+}
+
+bool PacketDelivery::configure(NodeId local, const DeliveryProfile &profile, const DeliveryCallbacks &callbacks,
+                               bool clear_replay) {
+  if (!node_valid(local) || !valid_delivery_profile(profile) || callbacks.send_fragment == nullptr ||
+      callbacks.send_ack == nullptr || callbacks.deliver == nullptr)
+    return false;
+  // Valid reconfiguration is an explicit session boundary. Invalid requests
+  // above leave the current ownership/state/callbacks untouched.
+  reset(clear_replay || local != local_);
+  if (!receiver_.set_profile(profile.packet))
+    return false;
+  for (auto &tx : tx_)
+    if (!tx.fragments.set_profile(profile.packet))
+      return false;
+  local_ = local;
+  profile_ = profile;
+  callbacks_ = callbacks;
+  configured_ = true;
+  return true;
+}
+
+bool PacketDelivery::can_begin() const {
+  if (!configured_)
+    return false;
+  for (const auto &tx : tx_)
+    if (!tx.used && !tx.reserved)
+      return true;
+  return false;
+}
+
+size_t PacketDelivery::pending_count() const {
+  size_t result = 0;
+  for (const auto &tx : tx_)
+    result += tx.used;
+  return result;
+}
+
+bool PacketDelivery::begin(NodeId destination, const uint8_t *packet, size_t length, uint32_t packet_id,
+                           uint32_t now_ms, NodeId owner) {
+  if (packet == nullptr || length == 0 || length > kMtu)
+    return false;
+  TxReservation reservation;
+  if (!reserve(reservation))
+    return false;
+  std::memcpy(reserved_data(reservation), packet, length);
+  return commit(reservation, destination, length, packet_id, now_ms, owner);
+}
+
+bool PacketDelivery::reserve(TxReservation &reservation) {
+  if (reservation_matches_(reservation))
+    return false;
+  reservation = {};
+  if (!configured_)
+    return false;
+  for (size_t slot = 0; slot < kDeliveryTxSlots; ++slot) {
+    auto &tx = tx_[slot];
+    if (tx.used || tx.reserved)
+      continue;
+    bool collision;
+    do {
+      if (++reservation_serial_ == 0)
+        ++reservation_serial_;
+      collision = false;
+      for (const auto &other : tx_)
+        collision |= other.reserved && other.reservation_serial == reservation_serial_;
+    } while (collision);
+    tx.reserved = tx.reservation_valid = true;
+    tx.reservation_serial = reservation_serial_;
+    reservation = {reservation_serial_, static_cast<uint8_t>(slot)};
+    return true;
+  }
+  return false;
+}
+
+bool PacketDelivery::reservation_matches_(const TxReservation &reservation) const {
+  return reservation.slot < kDeliveryTxSlots && reservation.serial != 0 && tx_[reservation.slot].reserved &&
+         tx_[reservation.slot].reservation_serial == reservation.serial;
+}
+
+uint8_t *PacketDelivery::reserved_data(const TxReservation &reservation) {
+  return reservation_matches_(reservation) && tx_[reservation.slot].reservation_valid
+             ? tx_[reservation.slot].fragments.writable_packet()
+             : nullptr;
+}
+
+void PacketDelivery::cancel(const TxReservation &reservation) {
+  if (!reservation_matches_(reservation))
+    return;
+  auto &tx = tx_[reservation.slot];
+  tx.reserved = tx.reservation_valid = false;
+  tx.fragments.reset();
+}
+
+bool PacketDelivery::commit(const TxReservation &reservation, NodeId destination, size_t length, uint32_t packet_id,
+                            uint32_t now_ms, NodeId owner) {
+  if (!reservation_matches_(reservation))
+    return false;
+  auto &tx = tx_[reservation.slot];
+  bool valid = configured_ && tx.reservation_valid && node_valid(destination) && destination != local_ &&
+               (owner == 0 || (node_valid(owner) && owner != local_));
+  for (const auto &other : tx_)
+    if (other.used && other.fragments.packet_id() == packet_id)
+      valid = false;
+  if (!valid || !tx.fragments.begin_in_place(length, packet_id)) {
+    cancel(reservation);
+    return false;
+  }
+  tx.reserved = tx.reservation_valid = false;
+  tx.used = true;
+  tx.destination = destination;
+  tx.owner = owner;
+  tx.started_at = tx.last_probe = now_ms;
+  tx.acknowledged = tx.sent = 0;
+  tx.waiting_commit = tx.window_blocked = false;
+  std::memset(tx.attempts, 0, sizeof(tx.attempts));
+  ++counters_.submitted;
+  return true;
+}
+
+uint64_t PacketDelivery::mask_(uint8_t count) { return count == 64 ? UINT64_MAX : (UINT64_C(1) << count) - 1; }
+
+void PacketDelivery::release_(size_t slot) {
+  tx_[slot].used = false;
+  tx_[slot].reservation_valid = false;
+  tx_[slot].fragments.reset();
+  for (auto &flight : flights_)
+    if (flight.used && flight.slot == slot)
+      flight.used = false;
+}
+
+bool PacketDelivery::is_ack(const uint8_t *payload, size_t length) {
+  return payload != nullptr && length == kDeliveryAckSize && payload[0] == 'M' && payload[1] == 'J' && payload[2] == 1;
+}
+
+bool PacketDelivery::accept_ack(NodeId source, const uint8_t *payload, size_t length, uint32_t now_ms) {
+  if (!configured_ || !node_valid(source) || source == local_ || !is_ack(payload, length) || payload[3] > 1 ||
+      payload[11] != 0 || payload[10] == 0 || payload[10] > kMaxFragmentCount) {
+    ++counters_.invalid_acks;
+    return false;
+  }
+  const uint32_t id = read32(payload + 4), crc = read32(payload + 12);
+  const uint16_t total = read16(payload + 8);
+  const uint8_t count = payload[10];
+  const uint64_t bits = read64(payload + 16), all = mask_(count);
+  if ((bits & ~all) != 0 || (payload[3] == 1 && bits != all)) {
+    ++counters_.invalid_acks;
+    return false;
+  }
+  for (size_t i = 0; i < kDeliveryTxSlots; ++i) {
+    auto &tx = tx_[i];
+    if (!tx.used || tx.destination != source || tx.fragments.packet_id() != id)
+      continue;
+    if (tx.fragments.packet_crc() != crc || tx.fragments.packet_length() != total ||
+        tx.fragments.fragment_count() != count || (bits & ~tx.sent) != 0) {
+      ++counters_.invalid_acks;
+      return false;
+    }
+    if (uint32_t(now_ms - tx.started_at) >= profile_.packet_lifetime_ms) {
+      release_(i);
+      ++counters_.tx_expired;
+      return false;
+    }
+    tx.acknowledged |= bits;
+    for (auto &flight : flights_)
+      if (flight.used && flight.slot == i && (bits & (UINT64_C(1) << flight.fragment)))
+        flight.used = false;
+    if (payload[3] == 1) {
+      release_(i);
+      ++counters_.acknowledged;
+    } else if (tx.acknowledged == all && !tx.waiting_commit) {
+      tx.waiting_commit = true;
+      tx.last_probe = now_ms;
+    }
+    return true;
+  }
+  ++counters_.invalid_acks;
+  return false;
+}
+
+bool PacketDelivery::replayed_(NodeId source, uint32_t packet_id) const {
+  const auto &entry = replay_[source - 1];
+  if (!entry.used || newer(packet_id, entry.highest))
+    return false;
+  const uint32_t distance = entry.highest - packet_id;
+  return distance < 64 && (entry.committed & (UINT64_C(1) << distance)) != 0;
+}
+
+bool PacketDelivery::outside_window_(NodeId source, uint32_t packet_id) const {
+  const auto &entry = replay_[source - 1];
+  return entry.used && !newer(packet_id, entry.highest) && uint32_t(entry.highest - packet_id) >= 64;
+}
+
+void PacketDelivery::remember_(NodeId source, uint32_t packet_id) {
+  auto &entry = replay_[source - 1];
+  if (!entry.used) {
+    entry.used = true;
+    entry.highest = packet_id;
+    entry.committed = 1;
+  } else if (newer(packet_id, entry.highest)) {
+    const uint32_t distance = packet_id - entry.highest;
+    entry.committed = distance >= 64 ? 1 : (entry.committed << distance) | 1;
+    entry.highest = packet_id;
+  } else {
+    const uint32_t distance = entry.highest - packet_id;
+    if (distance < 64)
+      entry.committed |= UINT64_C(1) << distance;
+  }
+}
+
+void PacketDelivery::queue_ack_(NodeId source, const ReassemblyStatus &status, uint32_t now_ms, bool new_fragment,
+                                bool immediate) {
+  Ack *free = nullptr;
+  for (auto &ack : acks_) {
+    if (ack.used && ack.destination == source && ack.status.packet_id == status.packet_id) {
+      // A later status must never downgrade an already pending commit ACK.
+      if (!ack.status.committed)
+        ack.status = status;
+      if (new_fragment && ack.new_fragments < kMaxFragmentCount)
+        ++ack.new_fragments;
+      ack.immediate |= immediate || status.committed;
+      return;
+    }
+    if (!ack.used && free == nullptr)
+      free = &ack;
+  }
+  // A dropped ACK is recovered by a bounded retransmission/commit probe. Never
+  // evict another receiver's packet data or allocate an unbounded ACK queue.
+  if (free != nullptr)
+    *free = Ack{status, now_ms, source, uint8_t(new_fragment ? 1 : 0), true, immediate || status.committed};
+  else
+    ++counters_.ack_busy;
+}
+
+ReceiveResult PacketDelivery::receive_fragment(NodeId source, NodeId destination, const uint8_t *fragment,
+                                               size_t length, uint32_t now_ms) {
+  if (!configured_ || !node_valid(source) || source == local_ || destination != local_)
+    return ReceiveResult::INVALID;
+  CompletedPacket packet;
+  // Reassembler validates the canonical header/stride/length before any ACK.
+  const auto result = receiver_.receive_deferred(source, destination, fragment, length, now_ms, packet);
+  if (result == ReceiveResult::NO_CAPACITY)
+    ++counters_.receive_busy;
+  if (result == ReceiveResult::INVALID || result == ReceiveResult::NO_CAPACITY)
+    return result;
+  const uint32_t id = read32(fragment + 4);
+  ReassemblyStatus status;
+  if (!receiver_.status(source, destination, id, status))
+    return result;
+  if (status.committed || replayed_(source, id)) {
+    // The complete packet may already have left the generic replay cache.
+    // Session-bound serial history still forbids duplicate delivery. Incoming
+    // metadata is canonical; a sender must never reuse a packet ID in-session.
+    status.received_mask = mask_(status.count);
+    status.complete = status.committed = true;
+    queue_ack_(source, status, now_ms, false, true);
+    receiver_.discard(source, destination, id);
+    ++counters_.stale_fragments;
+    return ReceiveResult::DUPLICATE;
+  }
+  if (outside_window_(source, id)) {
+    // An ID outside the bounded serial window may be old but never committed.
+    // Discard without an ACK rather than falsely acknowledge its delivery.
+    receiver_.discard(source, destination, id);
+    ++counters_.stale_fragments;
+    return ReceiveResult::DUPLICATE;
+  }
+  // A non-prefix bitmap exposes a gap. Receiving a lower fragment while a
+  // higher one is present repairs/reorders that gap; both need prompt feedback.
+  const uint8_t index = fragment[10];
+  const bool gap = (status.received_mask & (status.received_mask + 1)) != 0;
+  const bool higher_received = (status.received_mask & ~mask_(uint8_t(index + 1))) != 0;
+  queue_ack_(source, status, now_ms, result != ReceiveResult::DUPLICATE,
+             result == ReceiveResult::DUPLICATE || status.complete || gap || higher_received);
+  return result;
+}
+
+void PacketDelivery::deliver_ready_(uint32_t now_ms) {
+  for (size_t checked = 0; checked < kReassemblySlots; ++checked) {
+    const size_t index = rx_cursor_++ % kReassemblySlots;
+    CompletedPacket packet;
+    if (!receiver_.completed_at(index, packet))
+      continue;
+    if (replayed_(packet.source, packet.packet_id)) {
+      receiver_.commit(packet.source, packet.destination, packet.packet_id, now_ms);
+      continue;
+    }
+    if (!callbacks_.deliver(callbacks_.context, packet.source, packet.data, packet.length)) {
+      ++counters_.receive_busy;
+      continue;
+    }
+    ReassemblyStatus status;
+    receiver_.status(packet.source, packet.destination, packet.packet_id, status);
+    if (receiver_.commit(packet.source, packet.destination, packet.packet_id, now_ms)) {
+      remember_(packet.source, packet.packet_id);
+      status.committed = true;
+      queue_ack_(packet.source, status, now_ms, false, true);
+      ++counters_.delivered;
+    }
+  }
+}
+
+bool PacketDelivery::transmit_(size_t slot, uint8_t index, uint32_t now_ms, Flight *flight) {
+  auto &tx = tx_[slot];
+  if (tx.attempts[index] >= profile_.max_attempts) {
+    release_(slot);
+    ++counters_.retry_exhausted;
+    return false;
+  }
+  uint8_t payload[mesh_core::kMaxPayload];
+  size_t length = 0;
+  if (!tx.fragments.peek_at(index, payload, sizeof(payload), length))
+    return false;
+  if (!callbacks_.send_fragment(callbacks_.context, tx.destination, payload, length)) {
+    ++counters_.send_busy;
+    return false;
+  }
+  if (tx.attempts[index]++ != 0)
+    ++counters_.fragment_retries;
+  tx.sent |= UINT64_C(1) << index;
+  *flight = Flight{now_ms, uint8_t(slot), index, true};
+  ++counters_.fragments_sent;
+  return true;
+}
+
+bool PacketDelivery::within_replay_window_(size_t slot) const {
+  const auto &tx = tx_[slot];
+  const uint32_t id = tx.fragments.packet_id();
+  for (size_t other = 0; other < kDeliveryTxSlots; ++other) {
+    const auto &old = tx_[other];
+    if (other == slot || !old.used || old.destination != tx.destination)
+      continue;
+    const uint32_t old_id = old.fragments.packet_id();
+    // Keep the receiver's bounded 64-ID serial window behind every still-live
+    // packet to this endpoint, even if its first fragment has not arrived yet.
+    // The original newer packet is retained; unrelated endpoints stay free.
+    if (newer(id, old_id) && uint32_t(id - old_id) >= 64)
+      return false;
+  }
+  return true;
+}
+
+void PacketDelivery::tick(uint32_t now_ms) {
+  if (!configured_)
+    return;
+  receiver_.expire(now_ms);
+  deliver_ready_(now_ms);
+  // Rotate bounded pending ACKs independently of data admission.
+  for (size_t checked = 0; checked < kAckSlots; ++checked) {
+    auto &ack = acks_[ack_cursor_++ % kAckSlots];
+    if (!ack.used)
+      continue;
+    const uint32_t elapsed = now_ms - ack.first_pending;
+    if (!ack.immediate && ack.new_fragments < profile_.ack_batch_size &&
+        !(elapsed < 0x80000000U && elapsed >= profile_.max_ack_delay_ms))
+      continue;
+    const auto &status = ack.status;
+    uint8_t payload[kDeliveryAckSize]{'M', 'J', 1, uint8_t(status.committed ? 1 : 0)};
+    write(payload + 4, status.packet_id, 4);
+    write(payload + 8, status.length, 2);
+    payload[10] = status.count;
+    write(payload + 12, status.crc, 4);
+    write(payload + 16, status.received_mask, 8);
+    if (callbacks_.send_ack(callbacks_.context, ack.destination, payload, sizeof(payload))) {
+      ack.used = false;
+      ++counters_.acks_sent;
+    } else
+      ++counters_.ack_busy;
+  }
+  for (size_t slot = 0; slot < kDeliveryTxSlots; ++slot) {
+    if (tx_[slot].used && uint32_t(now_ms - tx_[slot].started_at) >= profile_.packet_lifetime_ms) {
+      release_(slot);
+      ++counters_.tx_expired;
+    }
+  }
+  // At most the fixed global window is admitted per service pass. A slot gets
+  // one attempt before its peer slot, including retransmissions.
+  for (size_t budget = 0; budget < kDeliveryWindow; ++budget) {
+    bool attempted = false, accepted = false;
+    for (size_t checked = 0; checked < kDeliveryTxSlots; ++checked) {
+      const size_t slot = tx_cursor_++ % kDeliveryTxSlots;
+      auto &tx = tx_[slot];
+      if (!tx.used)
+        continue;
+      if (!within_replay_window_(slot)) {
+        if (!tx.window_blocked)
+          ++counters_.window_stalls;
+        tx.window_blocked = true;
+        continue;
+      }
+      tx.window_blocked = false;
+      Flight *free = nullptr, *retry = nullptr;
+      for (auto &flight : flights_) {
+        if (!flight.used) {
+          if (free == nullptr)
+            free = &flight;
+        } else if (flight.slot == slot && uint32_t(now_ms - flight.sent_at) >= profile_.retry_interval_ms &&
+                   retry == nullptr)
+          retry = &flight;
+      }
+      if (retry != nullptr) {
+        attempted = true;
+        accepted = transmit_(slot, retry->fragment, now_ms, retry);
+      } else if (free != nullptr) {
+        if (tx.waiting_commit) {
+          if (uint32_t(now_ms - tx.last_probe) < profile_.retry_interval_ms)
+            continue;
+          attempted = true;
+          accepted = transmit_(slot, uint8_t(tx.fragments.fragment_count() - 1), now_ms, free);
+          if (accepted)
+            tx.last_probe = now_ms;
+        } else {
+          uint8_t index = 0;
+          for (; index < tx.fragments.fragment_count(); ++index)
+            if ((tx.sent & (UINT64_C(1) << index)) == 0)
+              break;
+          if (index == tx.fragments.fragment_count())
+            continue;
+          attempted = true;
+          accepted = transmit_(slot, index, now_ms, free);
+        }
+      }
+      if (attempted)
+        break;
+    }
+    if (!attempted || !accepted)
+      break;
+  }
+}
+
+void PacketDelivery::reset(bool clear_replay) {
+  for (size_t slot = 0; slot < kDeliveryTxSlots; ++slot)
+    release_(slot);
+  receiver_.reset();
+  for (auto &ack : acks_)
+    ack.used = false;
+  if (clear_replay)
+    for (auto &entry : replay_)
+      entry.used = false;
+  tx_cursor_ = ack_cursor_ = rx_cursor_ = 0;
+}
+
+void PacketDelivery::reset_peer(NodeId peer) {
+  if (!node_valid(peer))
+    return;
+  for (size_t slot = 0; slot < kDeliveryTxSlots; ++slot) {
+    // A filling reservation has not declared its destination/ingress owner yet.
+    // Keep its storage, but require the caller to obtain a fresh epoch snapshot.
+    tx_[slot].reservation_valid = false;
+    if (tx_[slot].used && (tx_[slot].destination == peer || tx_[slot].owner == peer))
+      release_(slot);
+  }
+  receiver_.reset_peer(peer);
+  for (auto &ack : acks_)
+    if (ack.destination == peer)
+      ack.used = false;
+  replay_[peer - 1] = {};
+}
+
+}  // namespace mesh_ip
diff --git a/esphome/components/mesh/mesh_ip_delivery.h b/esphome/components/mesh/mesh_ip_delivery.h
new file mode 100644
index 000000000..ef5ae35d7
--- /dev/null
+++ b/esphome/components/mesh/mesh_ip_delivery.h
@@ -0,0 +1,148 @@
+#pragma once
+
+#include "mesh_limits.h"
+
+#include "mesh_ip_packet.h"
+
+// Bounded endpoint ARQ above opaque routed frames. This module knows no IP
+// protocol/port, radio SDK, RTOS or wall clock. Callers serialize access, send
+// each fragment/ACK with a fresh Core sequence, and reset on ownership/session
+// or gateway changes. Packet IDs must be unique, monotonically increasing
+// modulo 2^32 within one sender session (at most two packets outstanding).
+namespace mesh_ip {
+
+constexpr size_t kDeliveryTxSlots = 2;
+constexpr size_t kDeliveryWindow = 8;
+constexpr size_t kDeliveryAckSize = 24;
+
+struct DeliveryProfile {
+  PacketProfile packet{};
+  uint32_t retry_interval_ms{250};
+  uint32_t packet_lifetime_ms{2000};
+  uint8_t max_attempts{5};
+  uint32_t max_ack_delay_ms{10};
+  uint8_t ack_batch_size{4};
+};
+bool valid_delivery_profile(const DeliveryProfile &profile);
+
+struct DeliveryCallbacks {
+  void *context{nullptr};
+  // True means a complete copy was queued. This is not an endpoint ACK.
+  bool (*send_fragment)(void *, NodeId, const uint8_t *, size_t){nullptr};
+  // ACKs should use the generic CONTROL class; never protocol/port priority.
+  bool (*send_ack)(void *, NodeId, const uint8_t *, size_t){nullptr};
+  // True transfers complete datagram ownership to a bounded downstream queue.
+  // False retains the ready reassembly slot for a later retry.
+  bool (*deliver)(void *, NodeId, const uint8_t *, size_t){nullptr};
+};
+
+struct DeliveryCounters {
+  uint32_t submitted{0}, acknowledged{0}, delivered{0};
+  uint32_t fragments_sent{0}, fragment_retries{0}, send_busy{0};
+  uint32_t tx_expired{0}, retry_exhausted{0}, receive_busy{0};
+  uint32_t acks_sent{0}, ack_busy{0}, invalid_acks{0}, stale_fragments{0};
+  uint32_t window_stalls{0};
+};
+
+class PacketDelivery {
+ public:
+  struct TxReservation {
+    uint32_t serial{0};
+    uint8_t slot{255};
+  };
+  // Valid reconfiguration aborts packet work, preserving DeliveryCounters.
+  // Normally it also clears replay state (a session boundary); false preserves
+  // unaffected peers after reset_peer(changed_id). Changing local ID always
+  // clears replay history. Invalid configuration leaves state untouched.
+  bool configure(NodeId local, const DeliveryProfile &profile, const DeliveryCallbacks &callbacks,
+                 bool clear_replay = true);
+  bool can_begin() const;
+  size_t pending_count() const;
+  size_t pending_receive_count() const { return receiver_.pending_packets(); }
+  // Forwarded packets name their ingress peer so reset_peer() can abort its
+  // retained original. Zero denotes local traffic; the local ID is not an owner.
+  bool begin(NodeId destination, const uint8_t *packet, size_t length, uint32_t packet_id, uint32_t now_ms,
+             NodeId owner = 0);
+  // Reserve either of the existing two originals. Unpublished bytes are never
+  // sent. Reset invalidates publication, but retains storage until its writer
+  // cancels or attempts commit; an obsolete writer cannot corrupt a new packet.
+  bool reserve(TxReservation &reservation);
+  uint8_t *reserved_data(const TxReservation &reservation);
+  // A matching reservation is consumed on success or failure. Invalid tokens
+  // cannot cancel another writer; caller serialization matches begin()/tick().
+  bool commit(const TxReservation &reservation, NodeId destination, size_t length, uint32_t packet_id, uint32_t now_ms,
+              NodeId owner = 0);
+  void cancel(const TxReservation &reservation);
+  ReceiveResult receive_fragment(NodeId source, NodeId destination, const uint8_t *fragment, size_t length,
+                                 uint32_t now_ms);
+  bool accept_ack(NodeId source, const uint8_t *payload, size_t length, uint32_t now_ms);
+  void tick(uint32_t now_ms);
+  // Aborts state, preserving lifetime counters and configured callbacks.
+  // Route-only changes abort work but preserve serial replay history. A new
+  // peer boot/identity requires the default full reset or reset_peer().
+  void reset(bool clear_replay = true);
+  void reset_peer(NodeId peer);
+  const DeliveryCounters &counters() const { return counters_; }
+  const ReassemblyCounters &reassembly_counters() const { return receiver_.counters(); }
+  const DeliveryProfile &profile() const { return profile_; }
+  static bool is_ack(const uint8_t *payload, size_t length);
+
+ private:
+  struct Tx {
+    Fragmenter fragments{};
+    uint32_t started_at{0}, last_probe{0};
+    uint64_t acknowledged{0}, sent{0};
+    uint8_t attempts[kMaxFragmentCount]{};
+    // Forwarded originals retain their authenticated ingress owner even after
+    // leaving the platform queue. Zero denotes locally originated traffic.
+    NodeId destination{0}, owner{0};
+    bool used{false}, waiting_commit{false}, window_blocked{false};
+    uint32_t reservation_serial{0};
+    bool reserved{false}, reservation_valid{false};
+  };
+  struct Flight {
+    uint32_t sent_at{0};
+    uint8_t slot{0}, fragment{0};
+    bool used{false};
+  };
+  struct Ack {
+    ReassemblyStatus status{};
+    uint32_t first_pending{0};
+    NodeId destination{0};
+    uint8_t new_fragments{0};
+    bool used{false}, immediate{false};
+  };
+  // A bounded serial-number window supplements the ordinary replay cache.
+  // Two in-flight packets can commit out of order without duplicate delivery.
+  struct Replay {
+    uint64_t committed{0};
+    uint32_t highest{0};
+    bool used{false};
+  };
+  static constexpr size_t kAckSlots = kReassemblySlots + kDeliveryTxSlots;
+  static uint64_t mask_(uint8_t count);
+  void release_(size_t slot);
+  void queue_ack_(NodeId source, const ReassemblyStatus &status, uint32_t now_ms, bool new_fragment, bool immediate);
+  void deliver_ready_(uint32_t now_ms);
+  bool replayed_(NodeId source, uint32_t packet_id) const;
+  bool outside_window_(NodeId source, uint32_t packet_id) const;
+  void remember_(NodeId source, uint32_t packet_id);
+  bool transmit_(size_t slot, uint8_t index, uint32_t now_ms, Flight *flight);
+  bool within_replay_window_(size_t slot) const;
+  bool reservation_matches_(const TxReservation &reservation) const;
+
+  NodeId local_{0};
+  DeliveryProfile profile_{};
+  DeliveryCallbacks callbacks_{};
+  Tx tx_[kDeliveryTxSlots]{};
+  Flight flights_[kDeliveryWindow]{};
+  Reassembler receiver_{};
+  Ack acks_[kAckSlots]{};
+  Replay replay_[mesh_core::kMaxNodes]{};
+  size_t tx_cursor_{0}, ack_cursor_{0}, rx_cursor_{0};
+  DeliveryCounters counters_{};
+  bool configured_{false};
+  uint32_t reservation_serial_{0};
+};
+
+}  // namespace mesh_ip
diff --git a/esphome/components/mesh/mesh_ip_dhcp.cpp b/esphome/components/mesh/mesh_ip_dhcp.cpp
new file mode 100644
index 000000000..60794adf7
--- /dev/null
+++ b/esphome/components/mesh/mesh_ip_dhcp.cpp
@@ -0,0 +1,537 @@
+#include "mesh_ip_dhcp.h"
+
+#include <algorithm>
+#include <cstring>
+
+namespace mesh_ip {
+namespace {
+constexpr uint16_t kType = 1U << 0;
+constexpr uint16_t kServer = 1U << 1;
+constexpr uint16_t kMask = 1U << 2;
+constexpr uint16_t kRouter = 1U << 3;
+constexpr uint16_t kDns = 1U << 4;
+constexpr uint16_t kLease = 1U << 5;
+constexpr uint16_t kT1 = 1U << 6;
+constexpr uint16_t kT2 = 1U << 7;
+constexpr uint16_t kRequested = 1U << 8;
+constexpr uint16_t kOverload = 1U << 9;
+constexpr uint32_t kBroadcast = 0xffffffffU;
+
+uint16_t read16(const uint8_t *p) { return static_cast<uint16_t>((p[0] << 8) | p[1]); }
+uint32_t read32(const uint8_t *p) {
+  return (static_cast<uint32_t>(p[0]) << 24) | (static_cast<uint32_t>(p[1]) << 16) |
+         (static_cast<uint32_t>(p[2]) << 8) | p[3];
+}
+void write16(uint8_t *p, uint16_t value) {
+  p[0] = value >> 8;
+  p[1] = value & 255;
+}
+void write32(uint8_t *p, uint32_t value) {
+  p[0] = value >> 24;
+  p[1] = value >> 16;
+  p[2] = value >> 8;
+  p[3] = value & 255;
+}
+bool unicast(uint32_t ip) { return (ip >> 24) != 0 && (ip >> 24) != 127 && (ip >> 24) < 224; }
+bool mac_valid(const uint8_t *mac) {
+  if (mac == nullptr || (mac[0] & 1) != 0)
+    return false;
+  uint8_t any = 0;
+  for (size_t i = 0; i < 6; ++i)
+    any |= mac[i];
+  return any != 0;
+}
+uint32_t sum16(const uint8_t *data, size_t length, uint32_t sum = 0) {
+  for (size_t i = 0; i + 1 < length; i += 2)
+    sum += read16(data + i);
+  if ((length & 1) != 0)
+    sum += static_cast<uint16_t>(data[length - 1]) << 8;
+  return sum;
+}
+uint16_t finish_sum(uint32_t sum) {
+  while ((sum >> 16) != 0)
+    sum = (sum & 0xffffU) + (sum >> 16);
+  return static_cast<uint16_t>(~sum);
+}
+bool due(uint32_t now, uint32_t deadline) { return static_cast<int32_t>(now - deadline) >= 0; }
+
+bool read_packet(const PacketReader &reader, size_t length, size_t offset, uint8_t *output, size_t count) {
+  return reader.read != nullptr && offset <= length && count <= length - offset &&
+         reader.read(reader.context, offset, output, count);
+}
+
+bool sum_packet(const PacketReader &reader, size_t packet_length, size_t offset, size_t length, uint32_t &sum,
+                uint8_t (&scratch)[64]) {
+  // Every non-final chunk has even length, preserving checksum word boundaries
+  // independently of the source's fragment boundaries. Pad only the final byte.
+  while (length != 0) {
+    const size_t count = std::min(length, sizeof(scratch));
+    if (!read_packet(reader, packet_length, offset, scratch, count))
+      return false;
+    sum = sum16(scratch, count, sum);
+    offset += count;
+    length -= count;
+  }
+  return true;
+}
+
+bool options(const PacketReader &reader, size_t packet_length, size_t offset, size_t length, DhcpMessage &m,
+             uint8_t &overload, bool primary) {
+  for (size_t pos = 0; pos < length;) {
+    uint8_t field[4];
+    if (!read_packet(reader, packet_length, offset + pos++, field, 1))
+      return false;
+    const uint8_t code = field[0];
+    if (code == 255)
+      return true;
+    if (code == 0)
+      continue;
+    if (pos == length)
+      return false;
+    if (!read_packet(reader, packet_length, offset + pos++, field, 1))
+      return false;
+    const size_t count = field[0];
+    if (count > length - pos)
+      return false;
+    uint16_t flag = 0;
+    uint32_t *target = nullptr;
+    switch (code) {
+      case 53:
+        flag = kType;
+        if (count != 1 || !read_packet(reader, packet_length, offset + pos, field, 1))
+          return false;
+        m.type = field[0];
+        break;
+      case 54:
+        flag = kServer;
+        target = &m.server;
+        break;
+      case 1:
+        flag = kMask;
+        target = &m.netmask;
+        break;
+      case 3:
+        flag = kRouter;
+        target = &m.router;
+        if (count < 4 || count % 4 != 0)
+          return false;
+        break;
+      case 6:
+        flag = kDns;
+        target = &m.dns;
+        if (count < 4 || count % 4 != 0)
+          return false;
+        break;
+      case 51:
+        flag = kLease;
+        target = &m.lifetime_seconds;
+        break;
+      case 58:
+        flag = kT1;
+        target = &m.renewal_seconds;
+        break;
+      case 59:
+        flag = kT2;
+        target = &m.rebind_seconds;
+        break;
+      case 50:
+        flag = kRequested;
+        target = &m.requested_address;
+        break;
+      case 52:
+        flag = kOverload;
+        if (!primary || count != 1 || !read_packet(reader, packet_length, offset + pos, field, 1) || field[0] == 0 ||
+            field[0] > 3)
+          return false;
+        overload = field[0];
+        break;
+      // Option 61 would change identity relative to ESP-IDF's native STA DHCP.
+      // Do not accept client identifiers on forwarded requests in this lab.
+      case 61:
+        return false;
+      default:
+        break;
+    }
+    if (flag != 0) {
+      if ((m.present & flag) != 0)
+        return false;
+      m.present |= flag;
+    }
+    if (target != nullptr) {
+      if (code != 3 && code != 6 && count != 4)
+        return false;
+      if (!read_packet(reader, packet_length, offset + pos, field, sizeof(field)))
+        return false;
+      *target = read32(field);
+    }
+    pos += count;
+  }
+  // An END marker is required; accepting a truncated option list is unsafe.
+  return false;
+}
+
+bool parse(const PacketReader &reader, size_t length, bool reply, DhcpMessage &out) {
+  out = {};
+  uint8_t scratch[64];
+  if (length < 20 + 8 + 240 || length > kDhcpPacketCapacity || !read_packet(reader, length, 0, scratch, 20) ||
+      (scratch[0] >> 4) != 4)
+    return false;
+  const size_t ihl = (scratch[0] & 15) * 4U;
+  if (ihl < 20 || ihl > length - 8 - 240 || read16(scratch + 2) != length || scratch[9] != 17 ||
+      (read16(scratch + 6) & 0xbfffU) != 0)
+    return false;
+  const uint32_t source = read32(scratch + 12), destination = read32(scratch + 16);
+  uint32_t sum = 0;
+  if (!sum_packet(reader, length, 0, ihl, sum, scratch) || finish_sum(sum) != 0)
+    return false;
+  const size_t udp_length = length - ihl;
+  if (!read_packet(reader, length, ihl, scratch, 8) || read16(scratch) != (reply ? 67 : 68) ||
+      read16(scratch + 2) != (reply ? 68 : 67) || read16(scratch + 4) != udp_length)
+    return false;
+  if (read16(scratch + 6) != 0) {
+    sum = (source >> 16) + (source & 0xffffU) + (destination >> 16) + (destination & 0xffffU) + 17U +
+          static_cast<uint32_t>(udp_length);
+    if (!sum_packet(reader, length, ihl, udp_length, sum, scratch) || finish_sum(sum) != 0)
+      return false;
+  }
+  const size_t bootp_offset = ihl + 8;
+  const size_t b_length = udp_length - 8;
+  if (!read_packet(reader, length, bootp_offset, scratch, 34) || scratch[0] != (reply ? 2 : 1) || scratch[1] != 1 ||
+      scratch[2] != 6 || scratch[3] != 0 || read32(scratch + 24) != 0 || !mac_valid(scratch + 28))
+    return false;
+  out.xid = read32(scratch + 4);
+  out.source = source;
+  out.destination = destination;
+  out.client_address = read32(scratch + 12);
+  out.offered_address = read32(scratch + 16);
+  out.broadcast = (read16(scratch + 10) & 0x8000U) != 0;
+  if ((read16(scratch + 10) & 0x7fffU) != 0)
+    return false;
+  std::memcpy(out.mac, scratch + 28, 6);
+  if (!read_packet(reader, length, bootp_offset + 236, scratch, 4) || read32(scratch) != 0x63825363U)
+    return false;
+  uint8_t overload = 0;
+  if (!options(reader, length, bootp_offset + 240, b_length - 240, out, overload, true) ||
+      ((overload & 1) != 0 && !options(reader, length, bootp_offset + 108, 128, out, overload, false)) ||
+      ((overload & 2) != 0 && !options(reader, length, bootp_offset + 44, 64, out, overload, false)) ||
+      (out.present & kType) == 0)
+    return false;
+  if (reply) {
+    if (out.type != 2 && out.type != 5 && out.type != 6)
+      return false;
+    if (!unicast(out.source) || !unicast(out.server) || (out.present & kServer) == 0)
+      return false;
+    if (out.destination != kBroadcast && out.destination != out.offered_address &&
+        out.destination != out.client_address)
+      return false;
+    return true;
+  }
+  if (out.offered_address != 0 || (out.source != 0 && out.source != out.client_address))
+    return false;
+  if (out.destination != kBroadcast && !unicast(out.destination))
+    return false;
+  if (out.type == 1)
+    return out.broadcast && out.source == 0 && out.client_address == 0 && out.destination == kBroadcast &&
+           (out.present & kServer) == 0;
+  if (out.type == 3) {
+    if (!out.broadcast)
+      return false;
+    if (out.client_address == 0)
+      return out.source == 0 && out.destination == kBroadcast &&
+             (out.present & (kServer | kRequested)) == (kServer | kRequested) && unicast(out.server) &&
+             unicast(out.requested_address);
+    return unicast(out.client_address) && (out.present & (kServer | kRequested)) == 0;
+  }
+  if (out.type == 4)
+    return !out.broadcast && out.source == 0 && out.client_address == 0 && out.destination == kBroadcast &&
+           (out.present & (kServer | kRequested)) == (kServer | kRequested) && unicast(out.server) &&
+           unicast(out.requested_address);
+  if (out.type == 7)
+    return !out.broadcast && unicast(out.client_address) && (out.present & kServer) != 0 && unicast(out.server) &&
+           out.destination == out.server;
+  return false;
+}
+
+bool read_contiguous(const void *context, size_t offset, uint8_t *output, size_t count) {
+  if (context == nullptr)
+    return false;
+  std::memcpy(output, static_cast<const uint8_t *>(context) + offset, count);
+  return true;
+}
+}  // namespace
+
+bool parse_dhcp_request(const uint8_t *packet, size_t length, DhcpMessage &message) {
+  return parse(PacketReader{packet, read_contiguous}, length, false, message);
+}
+bool parse_dhcp_reply(const uint8_t *packet, size_t length, DhcpMessage &message) {
+  return parse(PacketReader{packet, read_contiguous}, length, true, message);
+}
+bool parse_dhcp_reply(const PacketReader &reader, size_t length, DhcpMessage &message) {
+  return parse(reader, length, true, message);
+}
+
+bool DhcpClient::configure(const uint8_t mac[6]) {
+  if (!mac_valid(mac))
+    return false;
+  stop();
+  std::memcpy(mac_, mac, 6);
+  configured_ = true;
+  return true;
+}
+void DhcpClient::stop() {
+  state_ = DhcpState::STOPPED;
+  lease_ = {};
+  lease_xid_ = 0;
+  age_seconds_ = 0;
+  age_remainder_ms_ = 0;
+  attempts_ = 0;
+}
+void DhcpClient::start(uint32_t random_xid, uint32_t now_ms) {
+  stop();
+  if (!configured_)
+    return;
+  xid_ = random_xid == 0 ? 1 : random_xid;
+  clock_ms_ = now_ms;
+  discover_(now_ms, false);
+}
+void DhcpClient::force_revalidate(uint32_t random_xid, uint32_t now_ms) {
+  const uint32_t previous_xid = xid_;
+  tick(now_ms);
+  if (!configured_)
+    return;
+  xid_ = random_xid == 0 ? 1 : random_xid;
+  if (xid_ == previous_xid)
+    next_xid_();
+  if (!lease_valid(now_ms)) {
+    discover_(now_ms, false);
+    return;
+  }
+  // Rebinding must remain broadcast and able to accept another DHCP server.
+  // Neither the gateway transition nor this retransmission renews lease age.
+  begin_request_(state_ == DhcpState::REBINDING ? DhcpState::REBINDING : DhcpState::RENEWING, now_ms);
+}
+uint32_t DhcpClient::next_xid_() {
+  // Subsequent exchanges use a different xid; xid is a correlation token, not
+  // authentication. The first exchange is seeded by the platform random source.
+  xid_ += 0x9e3779b9U;
+  // Zero marks a missing lease identity in the endpoint control protocol.
+  if (xid_ == 0)
+    xid_ = 1;
+  return xid_;
+}
+void DhcpClient::discover_(uint32_t now_ms, bool new_xid) {
+  if (new_xid)
+    next_xid_();
+  lease_ = {};
+  lease_xid_ = 0;
+  age_seconds_ = 0;
+  age_remainder_ms_ = 0;
+  clock_ms_ = now_ms;
+  begin_request_(DhcpState::SELECTING, now_ms);
+}
+void DhcpClient::begin_request_(DhcpState state, uint32_t now_ms) {
+  state_ = state;
+  attempts_ = 0;
+  due_ms_ = now_ms;
+  request_started_ms_ = now_ms;
+}
+void DhcpClient::tick(uint32_t now_ms) {
+  const uint32_t elapsed = now_ms - clock_ms_;
+  clock_ms_ = now_ms;
+  const uint64_t millis = static_cast<uint64_t>(age_remainder_ms_) + elapsed;
+  age_seconds_ += millis / 1000;
+  age_remainder_ms_ = millis % 1000;
+  if (state_ == DhcpState::BOUND || state_ == DhcpState::RENEWING || state_ == DhcpState::REBINDING) {
+    if (lease_.lifetime_seconds != UINT32_MAX && age_seconds_ >= lease_.lifetime_seconds) {
+      discover_(now_ms, true);
+    } else if (lease_.lifetime_seconds != UINT32_MAX && age_seconds_ >= lease_.rebind_seconds &&
+               state_ != DhcpState::REBINDING) {
+      begin_request_(DhcpState::REBINDING, now_ms);
+    } else if (lease_.lifetime_seconds != UINT32_MAX && age_seconds_ >= lease_.renewal_seconds &&
+               state_ == DhcpState::BOUND) {
+      next_xid_();
+      begin_request_(DhcpState::RENEWING, now_ms);
+    }
+  } else if (state_ == DhcpState::BACKOFF && due(now_ms, due_ms_)) {
+    discover_(now_ms, true);
+  } else if (state_ == DhcpState::REQUESTING && attempts_ >= 5 && due(now_ms, due_ms_)) {
+    discover_(now_ms, true);
+  }
+}
+bool DhcpClient::lease_valid(uint32_t now_ms) const {
+  if (state_ != DhcpState::BOUND && state_ != DhcpState::RENEWING && state_ != DhcpState::REBINDING)
+    return false;
+  if (lease_.lifetime_seconds == UINT32_MAX)
+    return true;
+  const uint64_t age =
+      age_seconds_ + (static_cast<uint64_t>(age_remainder_ms_) + static_cast<uint32_t>(now_ms - clock_ms_)) / 1000;
+  return age < lease_.lifetime_seconds;
+}
+uint32_t DhcpClient::remaining_seconds(uint32_t now_ms) const {
+  if (!lease_valid(now_ms))
+    return 0;
+  if (lease_.lifetime_seconds == UINT32_MAX)
+    return UINT32_MAX;
+  const uint64_t elapsed_ms = static_cast<uint64_t>(age_remainder_ms_) + static_cast<uint32_t>(now_ms - clock_ms_);
+  const uint64_t age = age_seconds_ + (elapsed_ms + 999) / 1000;
+  return age >= lease_.lifetime_seconds ? 0 : lease_.lifetime_seconds - static_cast<uint32_t>(age);
+}
+bool DhcpClient::valid_lease_(DhcpLease &lease) const {
+  if (!unicast(lease.address) || !unicast(lease.server) || !unicast(lease.router) || lease.lifetime_seconds < 4)
+    return false;
+  const uint32_t inverse = ~lease.netmask;
+  if (lease.netmask == 0 || inverse < 3 || (inverse & (inverse + 1)) != 0 || (lease.address & inverse) == 0 ||
+      (lease.address & inverse) == inverse || (lease.router & lease.netmask) != (lease.address & lease.netmask) ||
+      lease.router == lease.address || (lease.router & inverse) == 0 || (lease.router & inverse) == inverse ||
+      (lease.dns != 0 && !unicast(lease.dns)))
+    return false;
+  if (lease.lifetime_seconds == UINT32_MAX) {
+    lease.renewal_seconds = lease.rebind_seconds = UINT32_MAX;
+    return true;
+  }
+  if (lease.renewal_seconds == 0)
+    lease.renewal_seconds = lease.lifetime_seconds / 2;
+  if (lease.rebind_seconds == 0)
+    lease.rebind_seconds = static_cast<uint32_t>(static_cast<uint64_t>(lease.lifetime_seconds) * 7 / 8);
+  return lease.renewal_seconds > 0 && lease.renewal_seconds < lease.rebind_seconds &&
+         lease.rebind_seconds < lease.lifetime_seconds;
+}
+DhcpResult DhcpClient::receive(const uint8_t *packet, size_t length, uint32_t now_ms) {
+  tick(now_ms);
+  if (state_ == DhcpState::STOPPED || state_ == DhcpState::BOUND || state_ == DhcpState::BACKOFF ||
+      state_ == DhcpState::DECLINING)
+    return DhcpResult::IGNORED;
+  DhcpMessage m;
+  if (!parse_dhcp_reply(packet, length, m) || m.xid != xid_ || std::memcmp(mac_, m.mac, 6) != 0)
+    return DhcpResult::IGNORED;
+  const bool selecting = state_ == DhcpState::SELECTING;
+  if (!selecting && state_ != DhcpState::REBINDING && m.server != lease_.server)
+    return DhcpResult::IGNORED;
+  if (m.type == 6 && !selecting) {
+    lease_ = {};
+    lease_xid_ = 0;
+    state_ = DhcpState::BACKOFF;
+    due_ms_ = now_ms + 1000;
+    return DhcpResult::LEASE_REJECTED;
+  }
+  if ((selecting && m.type != 2) || (!selecting && m.type != 5))
+    return DhcpResult::IGNORED;
+  DhcpLease candidate{};
+  candidate.address = m.offered_address;
+  candidate.server = m.server;
+  candidate.netmask = m.netmask;
+  candidate.router = m.router;
+  candidate.dns = m.dns;
+  candidate.lifetime_seconds = m.lifetime_seconds;
+  candidate.renewal_seconds = m.renewal_seconds;
+  candidate.rebind_seconds = m.rebind_seconds;
+  if ((m.present & (kMask | kRouter | kLease)) != (kMask | kRouter | kLease) || !valid_lease_(candidate) ||
+      (!selecting && candidate.address != lease_.address))
+    return DhcpResult::IGNORED;
+  lease_ = candidate;
+  if (selecting) {
+    begin_request_(DhcpState::REQUESTING, now_ms);
+    return DhcpResult::OFFER_ACCEPTED;
+  }
+  age_seconds_ = 0;
+  age_remainder_ms_ = 0;
+  clock_ms_ = now_ms;
+  state_ = DhcpState::BOUND;
+  lease_xid_ = xid_;
+  attempts_ = 0;
+  return DhcpResult::LEASE_BOUND;
+}
+bool DhcpClient::decline(uint32_t now_ms) {
+  tick(now_ms);
+  if (!lease_valid(now_ms))
+    return false;
+  begin_request_(DhcpState::DECLINING, now_ms);
+  return true;
+}
+bool DhcpClient::build_(uint8_t *output, size_t capacity, size_t &written) const {
+  written = 0;
+  constexpr size_t length = 328;  // Minimum 300-byte DHCP payload.
+  if (output == nullptr || capacity < length)
+    return false;
+  std::memset(output, 0, length);
+  output[0] = 0x45;
+  write16(output + 2, length);
+  write16(output + 4, static_cast<uint16_t>(xid_));
+  output[8] = 64;
+  output[9] = 17;
+  const bool has_ciaddr = state_ == DhcpState::RENEWING || state_ == DhcpState::REBINDING;
+  write32(output + 12, has_ciaddr ? lease_.address : 0);
+  write32(output + 16, state_ == DhcpState::RENEWING ? lease_.server : kBroadcast);
+  uint8_t *udp = output + 20;
+  write16(udp, 68);
+  write16(udp + 2, 67);
+  write16(udp + 4, length - 20);
+  uint8_t *b = udp + 8;
+  b[0] = b[1] = 1;
+  b[2] = 6;
+  write32(b + 4, xid_);
+  write16(b + 10, state_ == DhcpState::DECLINING ? 0 : 0x8000);
+  write32(b + 12, has_ciaddr ? lease_.address : 0);
+  std::memcpy(b + 28, mac_, 6);
+  write32(b + 236, 0x63825363);
+  size_t pos = 240;
+  b[pos++] = 53;
+  b[pos++] = 1;
+  b[pos++] = state_ == DhcpState::SELECTING ? 1 : (state_ == DhcpState::DECLINING ? 4 : 3);
+  if (state_ == DhcpState::REQUESTING || state_ == DhcpState::DECLINING) {
+    b[pos++] = 50;
+    b[pos++] = 4;
+    write32(b + pos, lease_.address);
+    pos += 4;
+    b[pos++] = 54;
+    b[pos++] = 4;
+    write32(b + pos, lease_.server);
+    pos += 4;
+  }
+  if (state_ != DhcpState::DECLINING) {
+    b[pos++] = 55;
+    b[pos++] = 7;
+    for (uint8_t option : {1, 3, 6, 51, 54, 58, 59})
+      b[pos++] = option;
+    b[pos++] = 57;
+    b[pos++] = 2;
+    write16(b + pos, 1472);
+    pos += 2;
+  }
+  b[pos] = 255;
+  write16(output + 10, finish_sum(sum16(output, 20)));
+  uint32_t sum = sum16(output + 12, 8) + 17U + static_cast<uint32_t>(length - 20);
+  uint16_t checksum = finish_sum(sum16(udp, length - 20, sum));
+  write16(udp + 6, checksum == 0 ? 0xffff : checksum);
+  written = length;
+  return true;
+}
+bool DhcpClient::poll(uint32_t now_ms, uint8_t *output, size_t capacity, size_t &written) {
+  written = 0;
+  tick(now_ms);
+  if (state_ == DhcpState::STOPPED || state_ == DhcpState::BOUND || state_ == DhcpState::BACKOFF ||
+      !due(now_ms, due_ms_) || !build_(output, capacity, written))
+    return false;
+  // RFC secs field: acquisition/renewal time, saturated rather than wrapping.
+  write16(output + 28 + 8, state_ == DhcpState::DECLINING ? 0
+                                                          : static_cast<uint16_t>(std::min<uint32_t>(
+                                                                (now_ms - request_started_ms_) / 1000, 65535)));
+  // Changing secs requires recomputing the UDP checksum.
+  write16(output + 26, 0);
+  uint32_t sum = sum16(output + 12, 8) + 17U + static_cast<uint32_t>(written - 20);
+  uint16_t checksum = finish_sum(sum16(output + 20, written - 20, sum));
+  write16(output + 26, checksum == 0 ? 0xffff : checksum);
+  if (state_ == DhcpState::DECLINING) {
+    lease_ = {};
+    lease_xid_ = 0;
+    state_ = DhcpState::BACKOFF;
+    due_ms_ = now_ms + 10000;
+    return true;
+  }
+  const uint32_t interval = 1000U << std::min<uint8_t>(attempts_, 4);
+  if (attempts_ < 255)
+    ++attempts_;
+  due_ms_ = now_ms + interval + (xid_ & 255U);
+  return true;
+}
+}  // namespace mesh_ip
diff --git a/esphome/components/mesh/mesh_ip_dhcp.h b/esphome/components/mesh/mesh_ip_dhcp.h
new file mode 100644
index 000000000..e0abd8790
--- /dev/null
+++ b/esphome/components/mesh/mesh_ip_dhcp.h
@@ -0,0 +1,119 @@
+#pragma once
+
+#include "mesh_limits.h"
+
+#include <cstddef>
+#include <cstdint>
+
+// Small, allocation-free DHCPv4 client for a mesh link with a LAN gateway.
+// Addresses are numeric network-order values (192.168.1.2 == 0xc0a80102),
+// independent of host byte order. Instances require serialized access.
+namespace mesh_ip {
+
+constexpr size_t kDhcpPacketCapacity = 1500;
+
+enum class DhcpState : uint8_t { STOPPED, SELECTING, REQUESTING, BOUND, RENEWING, REBINDING, DECLINING, BACKOFF };
+enum class DhcpResult : uint8_t { IGNORED, OFFER_ACCEPTED, LEASE_BOUND, LEASE_REJECTED };
+
+struct DhcpLease {
+  uint32_t address{0};
+  uint32_t netmask{0};
+  uint32_t router{0};
+  uint32_t dns{0};
+  uint32_t server{0};
+  uint32_t lifetime_seconds{0};
+  uint32_t renewal_seconds{0};
+  uint32_t rebind_seconds{0};
+};
+
+struct DhcpMessage {
+  uint8_t type{0};
+  uint8_t mac[6]{};
+  uint32_t xid{0};
+  uint32_t source{0};
+  uint32_t destination{0};
+  uint32_t client_address{0};
+  uint32_t offered_address{0};
+  uint32_t requested_address{0};
+  uint32_t server{0};
+  uint32_t netmask{0};
+  uint32_t router{0};
+  uint32_t dns{0};
+  uint32_t lifetime_seconds{0};
+  uint32_t renewal_seconds{0};
+  uint32_t rebind_seconds{0};
+  uint16_t present{0};
+  bool broadcast{false};
+};
+
+// Read-only view of a possibly fragmented packet. The owner keeps the bytes
+// stable for the entire parse; read must copy exactly count bytes or return
+// false. Offsets are relative to the IPv4 header, not a link-layer header.
+struct PacketReader {
+  const void *context{nullptr};
+  bool (*read)(const void *context, size_t offset, uint8_t *output, size_t count){nullptr};
+};
+
+// Strict bounded IPv4/UDP/BOOTP parsing, including IP and nonzero UDP checksums,
+// no IP fragments, no relay giaddr, matching Ethernet MAC and DHCP cookie.
+// Request parser accepts only DISCOVER, REQUEST, DECLINE and RELEASE. The gateway
+// must additionally match mac to the authenticated mesh source's configured STA
+// MAC, and bind replies to a live (source, xid, mac) transaction.
+bool parse_dhcp_request(const uint8_t *packet, size_t length, DhcpMessage &message);
+bool parse_dhcp_reply(const uint8_t *packet, size_t length, DhcpMessage &message);
+bool parse_dhcp_reply(const PacketReader &reader, size_t length, DhcpMessage &message);
+
+class DhcpClient {
+ public:
+  bool configure(const uint8_t mac[6]);
+  // xid must come from platform entropy, never the node ID or a persisted IP.
+  // No previous lease is assumed by this entry point.
+  void start(uint32_t random_xid, uint32_t now_ms);
+  // Revalidate a still-valid lease through a new mesh gateway using a fresh
+  // transaction and ciaddr. The original age remains authoritative until ACK;
+  // an absent/expired lease instead starts normal cold DHCP discovery.
+  void force_revalidate(uint32_t random_xid, uint32_t now_ms);
+  void stop();
+  // Call regularly, even when the mesh route is unavailable. Lease time is
+  // counted in seconds without multiplying long leases into a wrapping millis
+  // deadline. Calls must be separated by less than one uint32_t clock wrap.
+  void tick(uint32_t now_ms);
+  // Call when the packet transport can accept a packet. A true return consumes
+  // one logical transmission; dropped packets are retried with bounded backoff.
+  bool poll(uint32_t now_ms, uint8_t *output, size_t capacity, size_t &written);
+  DhcpResult receive(const uint8_t *packet, size_t length, uint32_t now_ms);
+  // When LAN-side ARP probing detects a conflicting address after ACK, do not
+  // install/advertise the lease. Send DECLINE and wait ten seconds to retry.
+  bool decline(uint32_t now_ms);
+  DhcpState state() const { return state_; }
+  const DhcpLease &lease() const { return lease_; }
+  uint32_t xid() const { return xid_; }
+  // Transaction that last established this lease; unlike xid(), stable while
+  // renewal or gateway revalidation is awaiting a new server ACK.
+  uint32_t lease_xid() const { return lease_xid_; }
+  bool lease_valid(uint32_t now_ms) const;
+  // Conservative whole seconds; the endpoint, never a route, owns this clock.
+  uint32_t remaining_seconds(uint32_t now_ms) const;
+
+ private:
+  void discover_(uint32_t now_ms, bool new_xid);
+  void begin_request_(DhcpState state, uint32_t now_ms);
+  bool build_(uint8_t *output, size_t capacity, size_t &written) const;
+  bool valid_lease_(DhcpLease &lease) const;
+  uint32_t next_xid_();
+
+  DhcpLease lease_{};
+  uint8_t mac_[6]{};
+  DhcpState state_{DhcpState::STOPPED};
+  uint32_t xid_{0};
+  uint32_t lease_xid_{0};
+  uint32_t clock_ms_{0};
+  uint32_t age_remainder_ms_{0};
+  uint64_t age_seconds_{0};
+  uint32_t due_ms_{0};
+  uint32_t request_started_ms_{0};
+  uint8_t attempts_{0};
+  bool configured_{false};
+};
+
+}  // namespace mesh_ip
diff --git a/esphome/components/mesh/mesh_ip_discovery.cpp b/esphome/components/mesh/mesh_ip_discovery.cpp
new file mode 100644
index 000000000..6ddbbb0b4
--- /dev/null
+++ b/esphome/components/mesh/mesh_ip_discovery.cpp
@@ -0,0 +1,558 @@
+#include "mesh_ip_discovery.h"
+
+#include <cstring>
+
+namespace mesh_ip {
+namespace {
+bool valid_hostname(esphome::StringRef name) {
+  if (name.empty() || name.size() > 63 || name[0] == '-' || name[name.size() - 1] == '-')
+    return false;
+  for (const unsigned char c : name)
+    if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-'))
+      return false;
+  return true;
+}
+bool valid_items(esphome::StringRef hostname, uint16_t api_port, const DiscoveryTxt *items, size_t count) {
+  if (!valid_hostname(hostname) || api_port == 0 || count > DISCOVERY_TXT_MAX)
+    return false;
+  bool mac = false;
+  for (size_t i = 0; i < count; ++i) {
+    const auto &item = items[i];
+    if (item.key.empty() || item.key.size() > 63 || item.key.size() + 1 + item.value.size() > 255 ||
+        (!item.value.empty() && std::memchr(item.value.c_str(), '\0', item.value.size()) != nullptr))
+      return false;
+    for (const unsigned char c : item.key)
+      if (c < 0x21 || c > 0x7e || c == '=')
+        return false;
+    for (size_t j = 0; j < i; ++j)
+      if (items[j].key == item.key)
+        return false;
+    if (item.key == "mac") {
+      if (item.value.size() != 12)
+        return false;
+      for (const unsigned char c : item.value)
+        if (!((c >= 'a' && c <= 'f') || (c >= '0' && c <= '9')))
+          return false;
+      mac = true;
+    }
+  }
+  return mac;
+}
+struct DescriptorView {
+  esphome::StringRef hostname;
+  uint16_t api_port{0}, http_port{0};
+  size_t count{0};
+  std::array<DiscoveryTxt, DISCOVERY_TXT_MAX> items{};
+};
+bool valid_descriptor(const DiscoveryDescriptor &descriptor) {
+  DescriptorView view;
+  for (size_t i = 0; i < descriptor.txt_count(); ++i)
+    view.items[i] = descriptor.txt(i);
+  return descriptor.storage_valid() &&
+         valid_items(descriptor.hostname(), descriptor.api_port, view.items.data(), descriptor.txt_count());
+}
+uint16_t read16(const uint8_t *p) { return uint16_t(p[0]) | uint16_t(p[1]) << 8; }
+void write16(uint8_t *p, uint16_t value) {
+  p[0] = value & 255;
+  p[1] = value >> 8;
+}
+uint32_t read32(const uint8_t *p) {
+  return uint32_t(p[0]) | uint32_t(p[1]) << 8 | uint32_t(p[2]) << 16 | uint32_t(p[3]) << 24;
+}
+void write32(uint8_t *p, uint32_t value) {
+  for (size_t i = 0; i < 4; i++)
+    p[i] = value >> (8 * i);
+}
+}  // namespace
+
+bool DiscoveryAddress::valid() const {
+#ifdef MESH_IPV6
+  if (this->is_ipv6)
+    return !this->ipv6.unspecified() && !this->ipv6.multicast();
+#endif
+  return this->ipv4 != 0;
+}
+bool DiscoveryAddress::operator==(const DiscoveryAddress &other) const {
+#ifdef MESH_IPV6
+  if (this->is_ipv6 != other.is_ipv6)
+    return false;
+  if (this->is_ipv6)
+    return this->ipv6 == other.ipv6;
+#endif
+  return this->ipv4 == other.ipv4;
+}
+
+namespace {
+bool parse_descriptor(const uint8_t *data, size_t length, DescriptorView &view) {
+  if (data == nullptr || length < 8 || length > DISCOVERY_DESCRIPTOR_MAX || data[0] != 1)
+    return false;
+  size_t cursor = 2;
+  const size_t name_length = data[1];
+  if (name_length > 63 || cursor + name_length + 5 > length)
+    return false;
+  view.hostname = {reinterpret_cast<const char *>(data + cursor), name_length};
+  cursor += name_length;
+  view.api_port = read16(data + cursor);
+  cursor += 2;
+  view.http_port = read16(data + cursor);
+  cursor += 2;
+  view.count = data[cursor++];
+  if (view.count > DISCOVERY_TXT_MAX)
+    return false;
+  for (size_t i = 0; i < view.count; ++i) {
+    if (cursor + 2 > length)
+      return false;
+    const size_t key_length = data[cursor++], value_length = data[cursor++];
+    if (cursor + key_length + value_length > length)
+      return false;
+    view.items[i].key = {reinterpret_cast<const char *>(data + cursor), key_length};
+    cursor += key_length;
+    view.items[i].value = {reinterpret_cast<const char *>(data + cursor), value_length};
+    cursor += value_length;
+  }
+  return cursor == length && valid_items(view.hostname, view.api_port, view.items.data(), view.count);
+}
+void assign_descriptor(const DescriptorView &view, DiscoveryDescriptor &descriptor) {
+  // Validation established wire length<=768. Packed text needs wire length-6,
+  // including every terminator, so these bounded appends cannot fail.
+  descriptor.clear();
+  descriptor.set_hostname(view.hostname);
+  descriptor.api_port = view.api_port;
+  descriptor.http_port = view.http_port;
+  for (size_t i = 0; i < view.count; ++i)
+    descriptor.add_txt(view.items[i].key, view.items[i].value);
+}
+}  // namespace
+
+DiscoveryDescriptor::DiscoveryDescriptor(esphome::StringRef hostname, uint16_t api, uint16_t http,
+                                         std::initializer_list<DiscoveryTxt> txt) {
+  this->set_hostname(hostname);
+  this->api_port = api;
+  this->http_port = http;
+  for (const auto &item : txt)
+    this->add_txt(item.key, item.value);
+}
+void DiscoveryDescriptor::clear() {
+  this->api_port = this->http_port = 0;
+  this->used_ = 1;
+  this->hostname_length_ = this->txt_count_ = 0;
+  this->storage_valid_ = true;
+  this->text_[0] = 0;
+}
+DiscoveryTxt DiscoveryDescriptor::txt(size_t index) const {
+  if (index >= this->txt_count_)
+    return {};
+  const auto &entry = this->txt_[index];
+  return {{this->text_.data() + entry.key, entry.key_length}, {this->text_.data() + entry.value, entry.value_length}};
+}
+bool DiscoveryDescriptor::replace_text_(uint16_t offset, uint8_t previous_length, esphome::StringRef value) {
+  if (value.size() > 255) {
+    this->storage_valid_ = false;
+    return false;
+  }
+  const int delta = int(value.size()) - previous_length;
+  if (int(this->used_) + delta > int(this->text_.size())) {
+    this->storage_valid_ = false;
+    return false;
+  }
+  char copy[256];
+  if (!value.empty())
+    std::memmove(copy, value.c_str(), value.size());
+  const size_t tail = offset + previous_length + 1;
+  std::memmove(this->text_.data() + int(tail) + delta, this->text_.data() + tail, this->used_ - tail);
+  if (!value.empty())
+    std::memcpy(this->text_.data() + offset, copy, value.size());
+  this->text_[offset + value.size()] = 0;
+  this->used_ = uint16_t(int(this->used_) + delta);
+  for (size_t i = 0; i < this->txt_count_; ++i) {
+    if (this->txt_[i].key > offset)
+      this->txt_[i].key = uint16_t(int(this->txt_[i].key) + delta);
+    if (this->txt_[i].value > offset)
+      this->txt_[i].value = uint16_t(int(this->txt_[i].value) + delta);
+  }
+  return true;
+}
+bool DiscoveryDescriptor::set_hostname(esphome::StringRef hostname) {
+  if (hostname.size() > 63) {
+    this->storage_valid_ = false;
+    return false;
+  }
+  if (!this->replace_text_(0, this->hostname_length_, hostname))
+    return false;
+  this->hostname_length_ = uint8_t(hostname.size());
+  return true;
+}
+bool DiscoveryDescriptor::add_txt(esphome::StringRef key, esphome::StringRef value) {
+  if (this->txt_count_ == DISCOVERY_TXT_MAX || key.size() > 63 || value.size() > 255 ||
+      key.size() + value.size() + 2 > this->text_.size() - this->used_) {
+    this->storage_valid_ = false;
+    return false;
+  }
+  auto &entry = this->txt_[this->txt_count_++];
+  entry.key = this->used_;
+  entry.key_length = uint8_t(key.size());
+  if (!key.empty())
+    std::memmove(this->text_.data() + this->used_, key.c_str(), key.size());
+  this->used_ += key.size();
+  this->text_[this->used_++] = 0;
+  entry.value = this->used_;
+  entry.value_length = uint8_t(value.size());
+  if (!value.empty())
+    std::memmove(this->text_.data() + this->used_, value.c_str(), value.size());
+  this->used_ += value.size();
+  this->text_[this->used_++] = 0;
+  return true;
+}
+bool DiscoveryDescriptor::set_txt_value(size_t index, esphome::StringRef value) {
+  if (index >= this->txt_count_)
+    return false;
+  auto &entry = this->txt_[index];
+  if (!this->replace_text_(entry.value, entry.value_length, value))
+    return false;
+  entry.value_length = uint8_t(value.size());
+  return true;
+}
+
+bool encode_discovery(const DiscoveryDescriptor &descriptor, uint8_t *output, size_t capacity, size_t &written) {
+  written = 0;
+  if (output == nullptr || !valid_descriptor(descriptor))
+    return false;
+  const auto hostname = descriptor.hostname();
+  size_t required = 7 + hostname.size();
+  for (size_t i = 0; i < descriptor.txt_count(); ++i) {
+    const auto txt = descriptor.txt(i);
+    required += 2 + txt.key.size() + txt.value.size();
+  }
+  if (required > DISCOVERY_DESCRIPTOR_MAX || required > capacity)
+    return false;
+  output[written++] = 1;
+  output[written++] = hostname.size();
+  std::memcpy(output + written, hostname.c_str(), hostname.size());
+  written += hostname.size();
+  write16(output + written, descriptor.api_port);
+  written += 2;
+  write16(output + written, descriptor.http_port);
+  written += 2;
+  output[written++] = descriptor.txt_count();
+  for (size_t i = 0; i < descriptor.txt_count(); ++i) {
+    const auto txt = descriptor.txt(i);
+    output[written++] = txt.key.size();
+    output[written++] = txt.value.size();
+    std::memcpy(output + written, txt.key.c_str(), txt.key.size());
+    written += txt.key.size();
+    if (!txt.value.empty())
+      std::memcpy(output + written, txt.value.c_str(), txt.value.size());
+    written += txt.value.size();
+  }
+  return true;
+}
+bool decode_discovery(const uint8_t *data, size_t length, DiscoveryDescriptor &descriptor) {
+  DescriptorView view;
+  if (!parse_descriptor(data, length, view))
+    return false;
+  assign_descriptor(view, descriptor);
+  return true;
+}
+
+uint32_t discovery_digest(const uint8_t *data, size_t length) {
+  uint32_t digest = 0xffffffffU;
+  for (size_t i = 0; i < length; i++) {
+    digest ^= data[i];
+    for (size_t bit = 0; bit < 8; bit++)
+      digest = (digest >> 1) ^ ((digest & 1) ? 0xedb88320U : 0);
+  }
+  return ~digest;
+}
+
+bool discovery_chunk(const uint8_t *data, size_t length, uint32_t address, size_t offset, uint8_t *output,
+                     size_t capacity, size_t &written, size_t payload_budget) {
+  written = 0;
+  if (payload_budget < DISCOVERY_FRAME_MIN || payload_budget > DISCOVERY_FRAME_MAX)
+    return false;
+  const size_t stride = payload_budget - DISCOVERY_HEADER_SIZE;
+  if (data == nullptr || output == nullptr || length == 0 || length > DISCOVERY_DESCRIPTOR_MAX || address == 0 ||
+      offset >= length || offset % stride != 0)
+    return false;
+  const size_t count = length - offset < stride ? length - offset : stride;
+  if (capacity < DISCOVERY_HEADER_SIZE + count)
+    return false;
+  // The default encoding remains byte-for-byte v1. The v2 extension declares
+  // the stride, so a receiver never infers offsets from its own link's MTU.
+  output[0] = payload_budget == DISCOVERY_FRAME_MAX ? 1 : 2;
+  output[1] = DISCOVERY_CONTROL;
+  std::memcpy(output + 2, &address, 4);
+  write32(output + 6, discovery_digest(data, length));
+  write16(output + 10, length);
+  write16(output + 12, offset);
+  output[14] = output[0] == 1 ? 0 : stride;
+  output[15] = 0;
+  std::memcpy(output + DISCOVERY_HEADER_SIZE, data + offset, count);
+  written = DISCOVERY_HEADER_SIZE + count;
+  return true;
+}
+
+#ifdef MESH_IPV6
+bool discovery_chunk(const uint8_t *data, size_t length, const Ipv6Address &address, size_t offset, uint8_t *output,
+                     size_t capacity, size_t &written, size_t payload_budget) {
+  written = 0;
+  if (payload_budget < DISCOVERY_IPV6_FRAME_MIN || payload_budget > DISCOVERY_FRAME_MAX)
+    return false;
+  const size_t stride = payload_budget - DISCOVERY_IPV6_HEADER_SIZE;
+  if (data == nullptr || output == nullptr || length == 0 || length > DISCOVERY_DESCRIPTOR_MAX ||
+      !DiscoveryAddress(address).valid() || offset >= length || offset % stride != 0)
+    return false;
+  const size_t count = length - offset < stride ? length - offset : stride;
+  if (capacity < DISCOVERY_IPV6_HEADER_SIZE + count)
+    return false;
+  output[0] = 3;
+  output[1] = DISCOVERY_CONTROL;
+  std::memcpy(output + 2, address.bytes.data(), 16);
+  write32(output + 18, discovery_digest(data, length));
+  write16(output + 22, length);
+  write16(output + 24, offset);
+  output[26] = static_cast<uint8_t>(stride);
+  output[27] = 0;
+  std::memcpy(output + DISCOVERY_IPV6_HEADER_SIZE, data + offset, count);
+  written = DISCOVERY_IPV6_HEADER_SIZE + count;
+  return true;
+}
+#endif
+
+DiscoveryRegistry::Assembly *DiscoveryRegistry::assembly_(uint8_t node) {
+  for (auto &assembly : this->assemblies_)
+    if (assembly.owner == node)
+      return &assembly;
+  return nullptr;
+}
+
+void DiscoveryRegistry::clear_assembly_(uint8_t node) {
+  this->waiting_ &= uint16_t(~(uint16_t(1) << (node - 1)));
+  if (auto *assembly = this->assembly_(node)) {
+    assembly->owner = 0;
+    assembly->active = false;
+  }
+}
+
+void DiscoveryRegistry::expire_assemblies_(uint32_t now) {
+  for (auto &assembly : this->assemblies_)
+    if (assembly.owner != 0 && uint32_t(now - assembly.started) >= 2000) {
+      assembly.owner = 0;
+      assembly.active = false;
+    }
+}
+
+void DiscoveryRegistry::admit_waiters_(uint32_t now) {
+  for (auto &assembly : this->assemblies_) {
+    if (assembly.owner != 0)
+      continue;
+    for (size_t visited = 0; visited < mesh_limits::MAX_NODES; ++visited) {
+      const uint8_t index = this->admission_cursor_;
+      this->admission_cursor_ = (index + 1) % mesh_limits::MAX_NODES;
+      const uint16_t bit = uint16_t(1) << index;
+      if ((this->waiting_ & bit) == 0)
+        continue;
+      this->waiting_ &= uint16_t(~bit);
+      if (!this->peers_[index].authorized)
+        continue;
+      assembly.owner = index + 1;
+      assembly.active = false;
+      assembly.chunks = 0;
+      assembly.started = now;
+      break;
+    }
+  }
+}
+
+bool DiscoveryRegistry::authorize(uint8_t node, const uint8_t *mac) {
+  if (node == 0 || node > mesh_limits::MAX_NODES || mac == nullptr || (mac[0] & 1))
+    return false;
+  uint8_t any = 0;
+  for (size_t i = 0; i < 6; i++)
+    any |= mac[i];
+  if (!any)
+    return false;
+  auto &peer = this->peers_[node - 1];
+  this->clear_assembly_(node);
+  peer.descriptor_valid = false;
+  peer.descriptor.clear();
+  peer.address = {};
+  peer.digest = peer.seen = peer.revision = 0;
+  std::memcpy(peer.mac, mac, 6);
+  peer.authorized = true;
+  return true;
+}
+
+void DiscoveryRegistry::revoke(uint8_t node) {
+  if (node < 1 || node > mesh_limits::MAX_NODES)
+    return;
+  auto &peer = this->peers_[node - 1];
+  this->clear_assembly_(node);
+  peer.authorized = peer.descriptor_valid = false;
+  peer.descriptor.clear();
+  peer.address = {};
+  peer.digest = peer.seen = peer.revision = 0;
+}
+
+bool DiscoveryRegistry::receive(uint8_t node, const uint8_t *data, size_t length, uint32_t now) {
+  if (node == 0 || node > mesh_limits::MAX_NODES || !this->peers_[node - 1].authorized || data == nullptr ||
+      length <= DISCOVERY_HEADER_SIZE || length > DISCOVERY_FRAME_MAX || data[1] != DISCOVERY_CONTROL)
+    return false;
+  size_t stride, header = DISCOVERY_HEADER_SIZE, digest_offset = 6;
+  DiscoveryAddress address;
+#ifdef MESH_IPV6
+  if (data[0] == 3) {
+    if (length <= DISCOVERY_IPV6_HEADER_SIZE || data[27] != 0 ||
+        data[26] < DISCOVERY_IPV6_FRAME_MIN - DISCOVERY_IPV6_HEADER_SIZE ||
+        data[26] > DISCOVERY_FRAME_MAX - DISCOVERY_IPV6_HEADER_SIZE)
+      return false;
+    Ipv6Address ipv6;
+    std::memcpy(ipv6.bytes.data(), data + 2, 16);
+    address = DiscoveryAddress(ipv6);
+    stride = data[26];
+    header = DISCOVERY_IPV6_HEADER_SIZE;
+    digest_offset = 18;
+  } else
+#endif
+      if (data[15] == 0 && data[0] == 1 && data[14] == 0) {
+    stride = DISCOVERY_CHUNK_SIZE;
+  } else if (data[15] == 0 && data[0] == 2 && data[14] >= DISCOVERY_FRAME_MIN - DISCOVERY_HEADER_SIZE &&
+             data[14] < DISCOVERY_CHUNK_SIZE) {
+    stride = data[14];
+  } else {
+    return false;
+  }
+  if (header == DISCOVERY_HEADER_SIZE)
+    std::memcpy(&address.ipv4, data + 2, 4);
+  const uint32_t digest = read32(data + digest_offset);
+  const size_t total = read16(data + digest_offset + 4), offset = read16(data + digest_offset + 6);
+  if (!address.valid() || total == 0 || total > DISCOVERY_DESCRIPTOR_MAX || offset >= total || offset % stride != 0 ||
+      length - header != (total - offset < stride ? total - offset : stride))
+    return false;
+  const size_t chunks = (total + stride - 1) / stride;
+  if (chunks > 32)
+    return false;
+  auto &peer = this->peers_[node - 1];
+  this->expire_assemblies_(now);
+  if (this->assembly_(node) == nullptr)
+    this->waiting_ |= uint16_t(1) << (node - 1);
+  this->admit_waiters_(now);
+  auto *owned = this->assembly_(node);
+  if (owned == nullptr)
+    return false;
+  auto &assembly = *owned;
+  if (!assembly.active || assembly.address != address || assembly.digest != digest || assembly.length != total ||
+      assembly.stride != stride || uint32_t(now - assembly.started) >= 2000) {
+    assembly.active = true;
+    assembly.chunks = 0;
+    assembly.address = address;
+    assembly.digest = digest;
+    assembly.length = total;
+    assembly.stride = stride;
+    // Full capacity retains the old independent per-peer restart semantics.
+    // A reduced pool gives every admitted peer an absolute two-second grant.
+    if constexpr (DISCOVERY_ASSEMBLY_SLOTS == mesh_limits::MAX_NODES)
+      assembly.started = now;
+  }
+  const uint32_t bit = uint32_t(1) << (offset / stride);
+  if ((assembly.chunks & bit) != 0)
+    return std::memcmp(assembly.data.data() + offset, data + header, length - header) == 0;
+  std::memcpy(assembly.data.data() + offset, data + header, length - header);
+  assembly.chunks |= bit;
+  const uint32_t all_chunks = chunks == 32 ? UINT32_MAX : (uint32_t(1) << chunks) - 1;
+  if (assembly.chunks != all_chunks)
+    return true;
+  DescriptorView descriptor;
+  if (discovery_digest(assembly.data.data(), total) != digest ||
+      !parse_descriptor(assembly.data.data(), total, descriptor)) {
+    this->clear_assembly_(node);
+    return false;
+  }
+  const char hex[] = "0123456789abcdef";
+  char mac[12];
+  for (size_t i = 0; i < 6; ++i) {
+    mac[2 * i] = hex[peer.mac[i] >> 4];
+    mac[2 * i + 1] = hex[peer.mac[i] & 15];
+  }
+  for (size_t i = 0; i < descriptor.count; ++i)
+    if (descriptor.items[i].key == "mac" && descriptor.items[i].value != esphome::StringRef(mac, sizeof(mac))) {
+      this->clear_assembly_(node);
+      return false;
+    }
+  // A second allowed node may not overwrite another node's live hostname.
+  for (size_t i = 0; i < mesh_limits::MAX_NODES; ++i) {
+    const auto &other = this->peers_[i];
+    if (i + 1 != node && other.descriptor_valid && uint32_t(now - other.seen) < DISCOVERY_LIFETIME_MS &&
+        other.descriptor.hostname() == descriptor.hostname) {
+      this->clear_assembly_(node);
+      return false;
+    }
+  }
+  if (!peer.descriptor_valid || peer.digest != digest || peer.address != address) {
+    assign_descriptor(descriptor, peer.descriptor);
+    peer.descriptor_valid = true;
+    peer.digest = digest;
+    peer.address = address;
+    ++peer.revision;
+  }
+  peer.seen = now;
+  this->clear_assembly_(node);
+  return true;
+}
+
+const DiscoveryDescriptor *DiscoveryRegistry::current(uint8_t node, uint32_t address, uint32_t now) const {
+  return this->current_(node, DiscoveryAddress(address), now);
+}
+#ifdef MESH_IPV6
+const DiscoveryDescriptor *DiscoveryRegistry::current(uint8_t node, const Ipv6Address &address, uint32_t now) const {
+  return this->current_(node, DiscoveryAddress(address), now);
+}
+bool DiscoveryRegistry::refresh(uint8_t node, const Ipv6Address &address, uint32_t now) {
+  return this->refresh_(node, DiscoveryAddress(address), now);
+}
+#endif
+const DiscoveryDescriptor *DiscoveryRegistry::current_(uint8_t node, const DiscoveryAddress &address,
+                                                       uint32_t now) const {
+  if (node == 0 || node > mesh_limits::MAX_NODES || !address.valid())
+    return nullptr;
+  const auto &peer = this->peers_[node - 1];
+  return peer.descriptor_valid && peer.address == address && uint32_t(now - peer.seen) < DISCOVERY_LIFETIME_MS
+             ? &peer.descriptor
+             : nullptr;
+}
+uint32_t DiscoveryRegistry::revision(uint8_t node) const {
+  return node >= 1 && node <= mesh_limits::MAX_NODES ? this->peers_[node - 1].revision : 0;
+}
+bool DiscoveryRegistry::refresh(uint8_t node, uint32_t address, uint32_t now) {
+  return this->refresh_(node, DiscoveryAddress(address), now);
+}
+bool DiscoveryRegistry::refresh_(uint8_t node, const DiscoveryAddress &address, uint32_t now) {
+  if (node == 0 || node > mesh_limits::MAX_NODES || !address.valid())
+    return false;
+  auto &peer = this->peers_[node - 1];
+  if (!peer.descriptor_valid || peer.address != address || uint32_t(now - peer.seen) >= DISCOVERY_LIFETIME_MS)
+    return false;
+  peer.seen = now;
+  return true;
+}
+void DiscoveryRegistry::forget(uint8_t node) {
+  if (node == 0 || node > mesh_limits::MAX_NODES)
+    return;
+  auto &peer = this->peers_[node - 1];
+  if (peer.descriptor_valid || this->assembly_(node) != nullptr) {
+    peer.descriptor_valid = false;
+    peer.descriptor.clear();
+    ++peer.revision;
+  }
+  this->clear_assembly_(node);
+}
+void DiscoveryRegistry::expire(uint32_t now) {
+  this->expire_assemblies_(now);
+  this->admit_waiters_(now);
+  for (auto &peer : this->peers_) {
+    if (peer.descriptor_valid && uint32_t(now - peer.seen) >= DISCOVERY_LIFETIME_MS) {
+      peer.descriptor_valid = false;
+      peer.descriptor.clear();
+    }
+  }
+}
+}  // namespace mesh_ip
diff --git a/esphome/components/mesh/mesh_ip_discovery.h b/esphome/components/mesh/mesh_ip_discovery.h
new file mode 100644
index 000000000..b1a9677c3
--- /dev/null
+++ b/esphome/components/mesh/mesh_ip_discovery.h
@@ -0,0 +1,162 @@
+#pragma once
+
+#include "mesh_limits.h"
+#ifdef MESH_IPV6
+#include "mesh_ip_ipv6.h"
+#endif
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <initializer_list>
+#include "esphome/core/string_ref.h"
+
+namespace mesh_ip {
+
+// A descriptor carries the node's actual ESPHome API records, never gateway
+// metadata. Only this small control message is relayed; mDNS is LAN-local.
+constexpr size_t DISCOVERY_DESCRIPTOR_MAX = 768;
+constexpr size_t DISCOVERY_FRAME_MAX = 160;
+constexpr size_t DISCOVERY_FRAME_MIN = 43;
+constexpr size_t DISCOVERY_HEADER_SIZE = 16;
+#ifdef MESH_IPV6
+constexpr size_t DISCOVERY_IPV6_HEADER_SIZE = 28;
+constexpr size_t DISCOVERY_IPV6_FRAME_MIN = 52;
+#endif
+constexpr size_t DISCOVERY_CHUNK_SIZE = DISCOVERY_FRAME_MAX - DISCOVERY_HEADER_SIZE;
+constexpr uint8_t DISCOVERY_CONTROL = 7;
+constexpr uint32_t DISCOVERY_LIFETIME_MS = 15000;
+
+#ifndef MESH_DISCOVERY_ASSEMBLY_SLOTS
+#define MESH_DISCOVERY_ASSEMBLY_SLOTS \
+  MESH_MAX_NODES  // NOLINT: Codegen-controlled conditional/array capacity shared across translation units.
+#endif
+constexpr size_t DISCOVERY_ASSEMBLY_SLOTS = MESH_DISCOVERY_ASSEMBLY_SLOTS;
+static_assert(DISCOVERY_ASSEMBLY_SLOTS >= 1 && DISCOVERY_ASSEMBLY_SLOTS <= mesh_limits::MAX_NODES,
+              "Discovery assembly slots must be between one and max_nodes");
+
+constexpr size_t DISCOVERY_TXT_MAX = 16;
+
+struct DiscoveryTxt {
+  DiscoveryTxt() = default;
+  DiscoveryTxt(esphome::StringRef key, esphome::StringRef value) : key(key), value(value) {}
+  DiscoveryTxt(const char *key, const char *value) : DiscoveryTxt(esphome::StringRef(key), esphome::StringRef(value)) {}
+  DiscoveryTxt(const char *key, esphome::StringRef value) : DiscoveryTxt(esphome::StringRef(key), value) {}
+  esphome::StringRef key, value;
+};
+
+// All text shares one bounded arena. The wire's two length bytes per TXT item
+// leave room for two terminators, so every valid 768-byte descriptor fits.
+class DiscoveryDescriptor {
+ public:
+  DiscoveryDescriptor() = default;
+  DiscoveryDescriptor(esphome::StringRef hostname, uint16_t api, uint16_t http,
+                      std::initializer_list<DiscoveryTxt> txt);
+  DiscoveryDescriptor(const char *hostname, uint16_t api, uint16_t http, std::initializer_list<DiscoveryTxt> txt)
+      : DiscoveryDescriptor(esphome::StringRef(hostname), api, http, txt) {}
+  void clear();
+  bool set_hostname(esphome::StringRef hostname);
+  bool set_hostname(const char *hostname) { return this->set_hostname(esphome::StringRef(hostname)); }
+  bool add_txt(esphome::StringRef key, esphome::StringRef value);
+  bool add_txt(const char *key, const char *value) {
+    return this->add_txt(esphome::StringRef(key), esphome::StringRef(value));
+  }
+  bool set_txt_value(size_t index, esphome::StringRef value);
+  bool set_txt_value(size_t index, const char *value) { return this->set_txt_value(index, esphome::StringRef(value)); }
+  esphome::StringRef hostname() const { return {this->text_.data(), this->hostname_length_}; }
+  size_t txt_count() const { return this->txt_count_; }
+  DiscoveryTxt txt(size_t index) const;
+  bool storage_valid() const { return this->storage_valid_; }
+  uint16_t api_port{0}, http_port{0};
+
+ private:
+  struct TxtOffset {
+    uint16_t key{0}, value{0};
+    uint8_t key_length{0}, value_length{0};
+  };
+  bool replace_text_(uint16_t offset, uint8_t previous_length, esphome::StringRef value);
+  std::array<char, DISCOVERY_DESCRIPTOR_MAX> text_{};
+  std::array<TxtOffset, DISCOVERY_TXT_MAX> txt_{};
+  uint16_t used_{1};
+  uint8_t hostname_length_{0}, txt_count_{0};
+  bool storage_valid_{true};
+};
+
+// Metadata is bound to one currently usable address. The gateway obtains the
+// full A/AAAA set separately from its validated endpoint ownership snapshots.
+struct DiscoveryAddress {
+  uint32_t ipv4{0};
+  DiscoveryAddress(uint32_t address = 0) : ipv4(address) {}
+#ifdef MESH_IPV6
+  Ipv6Address ipv6{};
+  bool is_ipv6{false};
+  DiscoveryAddress(const Ipv6Address &address) : ipv6(address), is_ipv6(true) {}
+#endif
+  bool valid() const;
+  bool operator==(const DiscoveryAddress &other) const;
+  bool operator!=(const DiscoveryAddress &other) const { return !(*this == other); }
+};
+
+bool encode_discovery(const DiscoveryDescriptor &descriptor, uint8_t *output, size_t capacity, size_t &written);
+bool decode_discovery(const uint8_t *data, size_t length, DiscoveryDescriptor &descriptor);
+uint32_t discovery_digest(const uint8_t *data, size_t length);
+// Addresses are opaque four-byte lwIP IPv4 addresses, matching IP_STATUS.
+bool discovery_chunk(const uint8_t *data, size_t length, uint32_t address, size_t offset, uint8_t *output,
+                     size_t capacity, size_t &written, size_t payload_budget = DISCOVERY_FRAME_MAX);
+#ifdef MESH_IPV6
+bool discovery_chunk(const uint8_t *data, size_t length, const Ipv6Address &address, size_t offset, uint8_t *output,
+                     size_t capacity, size_t &written, size_t payload_budget = DISCOVERY_FRAME_MAX);
+#endif
+
+class DiscoveryRegistry {
+ public:
+  static constexpr size_t assembly_capacity() { return DISCOVERY_ASSEMBLY_SLOTS; }
+  bool authorize(uint8_t node, const uint8_t *mac);
+  void revoke(uint8_t node);  // Main-loop owner only; removes authorization too.
+  bool receive(uint8_t node, const uint8_t *data, size_t length, uint32_t now);
+  const DiscoveryDescriptor *current(uint8_t node, uint32_t address, uint32_t now) const;
+#ifdef MESH_IPV6
+  const DiscoveryDescriptor *current(uint8_t node, const Ipv6Address &address, uint32_t now) const;
+  bool refresh(uint8_t node, const Ipv6Address &address, uint32_t now);
+#endif
+  uint32_t revision(uint8_t node) const;
+  // Only a separately validated, fresh IP_STATUS for this same lease owner
+  // may maintain an existing descriptor. Never invent or revive metadata.
+  bool refresh(uint8_t node, uint32_t address, uint32_t now);
+  void forget(uint8_t node);
+  void expire(uint32_t now);
+
+ private:
+  const DiscoveryDescriptor *current_(uint8_t node, const DiscoveryAddress &address, uint32_t now) const;
+  bool refresh_(uint8_t node, const DiscoveryAddress &address, uint32_t now);
+  struct Assembly {
+    std::array<uint8_t, DISCOVERY_DESCRIPTOR_MAX> data{};
+    DiscoveryAddress address{};
+    uint32_t digest{0}, started{0};
+    uint16_t length{0};
+    uint32_t chunks{0};
+    uint8_t stride{0};
+    bool active{false};
+    uint8_t owner{0};
+  };
+  struct Peer {
+    uint8_t mac[6]{};
+    bool authorized{false};
+    DiscoveryDescriptor descriptor{};
+    bool descriptor_valid{false};
+    DiscoveryAddress address{};
+    uint32_t digest{0}, seen{0}, revision{0};
+  };
+  Assembly *assembly_(uint8_t node);
+  void clear_assembly_(uint8_t node);
+  void admit_waiters_(uint32_t now);
+  void expire_assemblies_(uint32_t now);
+  Peer peers_[mesh_limits::MAX_NODES]{};
+  // A reduced local pool trades simultaneous reception for bounded RAM. Its
+  // fixed grants cannot be extended by changing a digest or by duplicates.
+  Assembly assemblies_[DISCOVERY_ASSEMBLY_SLOTS]{};
+  uint16_t waiting_{0};
+  uint8_t admission_cursor_{0};
+};
+
+}  // namespace mesh_ip
diff --git a/esphome/components/mesh/mesh_ip_handover.h b/esphome/components/mesh/mesh_ip_handover.h
new file mode 100644
index 000000000..897e19518
--- /dev/null
+++ b/esphome/components/mesh/mesh_ip_handover.h
@@ -0,0 +1,70 @@
+#pragma once
+
+#include "mesh_limits.h"
+
+#include <cstdint>
+
+namespace mesh_ip {
+
+// Withdraw proxy forwarding before native DHCP conflict detection resumes.
+// Candidate mode waits for every configured LAN edge. The bounded fallback
+// exceeds the challenge-anchored 5-second forwarding grant; it does not bound
+// a blocked mDNS responder's asynchronous removal or its remote cache TTLs.
+class OwnershipHandover {
+ public:
+  void begin(uint32_t now, uint32_t nonce, uint16_t expected_mask = 0) {
+    this->quiet_ = this->waiting_ = true;
+    this->acked_ = false;
+    this->expected_mask_ = expected_mask;
+    this->acknowledged_mask_ = 0;
+    this->started_ = now;
+    this->nonce_ = nonce;
+  }
+  void acknowledge(uint32_t nonce, uint32_t now) {
+    // Keep the single-gateway API compatible, but never let it bypass the
+    // per-candidate proof requirement of a multi-gateway handover.
+    if (this->expected_mask_ == 0 && this->waiting_ && !this->acked_ && nonce == this->nonce_) {
+      this->acked_ = true;
+      this->acked_at_ = now;
+    }
+  }
+  void acknowledge(uint8_t source, uint32_t nonce, uint32_t now) {
+    if (!this->waiting_ || this->acked_ || nonce != this->nonce_ || source == 0 || source > mesh_limits::MAX_NODES)
+      return;
+    const uint16_t bit = uint16_t(1U << (source - 1));
+    if ((this->expected_mask_ & bit) == 0)
+      return;
+    this->acknowledged_mask_ |= bit;
+    if (this->acknowledged_mask_ == this->expected_mask_) {
+      this->acked_ = true;
+      this->acked_at_ = now;
+    }
+  }
+  bool ready(uint32_t now) const {
+    const uint32_t elapsed = now - this->started_;
+    return this->waiting_ && ((this->acked_ && uint32_t(now - this->acked_at_) >= 350) || elapsed >= 6000);
+  }
+  void rejoining() { this->waiting_ = false; }
+  // Keep withdrawal active throughout DHCP/DAD, until STA has its address.
+  void connected() {
+    if (!this->waiting_)
+      this->quiet_ = false;
+  }
+  void cancel() {
+    this->quiet_ = this->waiting_ = this->acked_ = false;
+    this->expected_mask_ = this->acknowledged_mask_ = 0;
+  }
+  bool quiet() const { return this->quiet_; }
+  bool waiting() const { return this->waiting_; }
+  bool acknowledged() const { return this->acked_; }
+  uint32_t nonce() const { return this->nonce_; }
+  uint16_t expected_mask() const { return this->expected_mask_; }
+  uint16_t acknowledged_mask() const { return this->acknowledged_mask_; }
+
+ private:
+  bool quiet_{false}, waiting_{false}, acked_{false};
+  uint16_t expected_mask_{0}, acknowledged_mask_{0};
+  uint32_t started_{0}, acked_at_{0}, nonce_{0};
+};
+
+}  // namespace mesh_ip
diff --git a/esphome/components/mesh/mesh_ip_ipv6.cpp b/esphome/components/mesh/mesh_ip_ipv6.cpp
new file mode 100644
index 000000000..ea74f5da7
--- /dev/null
+++ b/esphome/components/mesh/mesh_ip_ipv6.cpp
@@ -0,0 +1,237 @@
+#include "mesh_ip_ipv6.h"
+
+#include <algorithm>
+#include <cstring>
+
+namespace mesh_ip {
+namespace {
+constexpr size_t IPV6_HEADER = 40, MAX_PACKET = 1500;
+uint16_t be16(const uint8_t *p) { return (uint16_t(p[0]) << 8) | p[1]; }
+bool read(const Ipv6PacketReader &reader, size_t length, size_t offset, uint8_t *out, size_t count) {
+  return reader.read != nullptr && offset <= length && count <= length - offset &&
+         reader.read(reader.context, offset, out, count);
+}
+bool contiguous_read(const void *context, size_t offset, uint8_t *out, size_t count) {
+  if (context == nullptr)
+    return false;
+  std::memcpy(out, static_cast<const uint8_t *>(context) + offset, count);
+  return true;
+}
+uint32_t add_bytes(uint32_t sum, const uint8_t *bytes, size_t length) {
+  for (size_t i = 0; i + 1 < length; i += 2)
+    sum += be16(bytes + i);
+  if (length & 1)
+    sum += uint16_t(bytes[length - 1]) << 8;
+  return sum;
+}
+bool checksum(const Ipv6PacketReader &reader, size_t length, const Ipv6PacketInfo &info, uint16_t &value) {
+  uint32_t sum = add_bytes(0, info.source.bytes.data(), 16);
+  sum = add_bytes(sum, info.destination.bytes.data(), 16);
+  sum += info.upper_length;
+  sum += 58;  // Pseudo-header uses the upper protocol, not an extension header.
+  uint8_t scratch[64];
+  for (size_t offset = info.upper_offset; offset < length; offset += sizeof(scratch)) {
+    const size_t count = std::min(sizeof(scratch), length - offset);
+    if (!read(reader, length, offset, scratch, count))
+      return false;
+    sum = add_bytes(sum, scratch, count);
+  }
+  while (sum >> 16)
+    sum = (sum & 0xffff) + (sum >> 16);
+  value = static_cast<uint16_t>(~sum);
+  return true;
+}
+bool nd_options(const Ipv6PacketReader &reader, size_t length, const Ipv6PacketInfo &info) {
+  uint8_t option[2];
+  for (size_t offset = info.options_offset; offset < length;) {
+    if (!read(reader, length, offset, option, sizeof(option)) || option[1] == 0)
+      return false;
+    const size_t count = size_t(option[1]) * 8;
+    if (count > length - offset)
+      return false;
+    if ((option[0] == 1 || option[0] == 2 || option[0] == 5) && count != 8)
+      return false;
+    if (option[0] == 3 && count != 32)
+      return false;
+    if (info.source.unspecified() && option[0] == 1)
+      return false;
+    offset += count;
+  }
+  return true;
+}
+}  // namespace
+
+bool Ipv6Address::unspecified() const {
+  for (const auto byte : bytes)
+    if (byte != 0)
+      return false;
+  return true;
+}
+bool Ipv6Address::matches_eui64(const uint8_t mac[6]) const {
+  return mac != nullptr && bytes[8] == (mac[0] ^ 2) && bytes[9] == mac[1] && bytes[10] == mac[2] && bytes[11] == 0xff &&
+         bytes[12] == 0xfe && bytes[13] == mac[3] && bytes[14] == mac[4] && bytes[15] == mac[5];
+}
+Ipv6Address Ipv6Address::solicited_node() const {
+  Ipv6Address address{};
+  address.bytes[0] = 0xff;
+  address.bytes[1] = 2;
+  address.bytes[11] = 1;
+  address.bytes[12] = 0xff;
+  std::copy(bytes.begin() + 13, bytes.end(), address.bytes.begin() + 13);
+  return address;
+}
+
+static bool inspect_ipv6_impl(const Ipv6PacketReader &reader, size_t length, Ipv6PacketInfo &info,
+                              bool validate_checksum) {
+  info = {};
+  uint8_t header[40];
+  if (length < IPV6_HEADER || length > MAX_PACKET || !read(reader, length, 0, header, sizeof(header)) ||
+      (header[0] >> 4) != 6 || size_t(be16(header + 4)) + IPV6_HEADER != length)
+    return false;
+  std::copy(header + 8, header + 24, info.source.bytes.begin());
+  std::copy(header + 24, header + 40, info.destination.bytes.begin());
+  if (info.source.multicast() || info.destination.unspecified())
+    return false;
+  info.total_length = static_cast<uint16_t>(length);
+  info.hop_limit = header[7];
+  uint8_t next = header[6];
+  size_t offset = IPV6_HEADER;
+  bool protected_payload = false;
+  while (next == 0 || next == 43 || next == 60 || next == 44 || next == 51) {
+    uint8_t extension[8];
+    if (!read(reader, length, offset, extension, sizeof(extension)))
+      return false;
+    const uint8_t following = extension[0];
+    size_t count;
+    if (next == 44) {
+      if (info.fragmented || extension[1] != 0 || (be16(extension + 2) & 6) != 0)
+        return false;
+      info.fragmented = true;
+      info.noninitial_fragment = (be16(extension + 2) & 0xfff8) != 0;
+      count = 8;
+    } else if (next == 51) {
+      count = (size_t(extension[1]) + 2) * 4;
+      if (count < 12)
+        return false;
+      protected_payload = true;
+    } else {
+      if (next == 0 && offset != IPV6_HEADER)
+        return false;
+      count = (size_t(extension[1]) + 1) * 8;
+    }
+    if (count > length - offset)
+      return false;
+    offset += count;
+    next = following;
+    // Later fragments need not start with a complete upper-layer header.
+    if (info.noninitial_fragment)
+      break;
+  }
+  info.next_header = next;
+  info.protected_payload = protected_payload;
+  info.upper_offset = static_cast<uint16_t>(offset);
+  info.upper_length = static_cast<uint16_t>(length - offset);
+  if (info.noninitial_fragment || next != 58)
+    return true;
+  uint8_t icmp[24];
+  if (!read(reader, length, offset, icmp, 4))
+    return false;
+  info.icmp_type = icmp[0];
+  if (icmp[0] < 133 || icmp[0] > 137)
+    return true;
+  info.nd = true;
+  if (info.fragmented || protected_payload || info.hop_limit != 255 || icmp[1] != 0)
+    return false;
+  const size_t body = icmp[0] == 133 ? 8 : (icmp[0] == 134 ? 16 : (icmp[0] == 137 ? 40 : 24));
+  if (length - offset < body)
+    return false;
+  info.options_offset = static_cast<uint16_t>(offset + body);
+  if (icmp[0] == 134 || icmp[0] == 137) {
+    if (!info.source.link_local())
+      return false;
+  } else if (icmp[0] != 133) {
+    if (!read(reader, length, offset, icmp, sizeof(icmp)))
+      return false;
+    std::copy(icmp + 8, icmp + 24, info.target.bytes.begin());
+    if (info.target.multicast() || info.target.unspecified())
+      return false;
+    if (icmp[0] == 135) {
+      info.dad = info.source.unspecified();
+      if (info.dad && info.destination != info.target.solicited_node())
+        return false;
+    } else if (info.source.unspecified() || ((icmp[4] & 0x40) != 0 && info.destination.multicast())) {
+      return false;
+    }
+  }
+  if (icmp[0] == 137) {
+    uint8_t redirect[32];
+    if (!read(reader, length, offset + 8, redirect, sizeof(redirect)))
+      return false;
+    std::copy(redirect, redirect + 16, info.target.bytes.begin());
+    Ipv6Address redirected_destination{};
+    std::copy(redirect + 16, redirect + 32, redirected_destination.bytes.begin());
+    if (info.destination.multicast() || redirected_destination.multicast() || redirected_destination.unspecified() ||
+        (!info.target.link_local() && info.target != redirected_destination))
+      return false;
+  }
+  uint16_t value;
+  return nd_options(reader, length, info) &&
+         (!validate_checksum || (checksum(reader, length, info, value) && value == 0));
+}
+
+bool inspect_ipv6(const uint8_t *packet, size_t length, Ipv6PacketInfo &info) {
+  return packet != nullptr && inspect_ipv6({packet, contiguous_read}, length, info);
+}
+bool inspect_ipv6(const Ipv6PacketReader &reader, size_t length, Ipv6PacketInfo &info) {
+  return inspect_ipv6_impl(reader, length, info, true);
+}
+bool finalize_icmpv6_checksum(uint8_t *packet, size_t length) {
+  Ipv6PacketInfo info;
+  if (packet == nullptr || !inspect_ipv6_impl({packet, contiguous_read}, length, info, false) ||
+      info.next_header != 58 || info.fragmented || info.protected_payload)
+    return false;
+  if (info.nd)
+    for (size_t offset = info.options_offset; offset < length; offset += size_t(packet[offset + 1]) * 8)
+      if (packet[offset] == 12)
+        return false;
+  packet[info.upper_offset + 2] = packet[info.upper_offset + 3] = 0;
+  uint16_t value;
+  if (!checksum({packet, contiguous_read}, length, info, value))
+    return false;
+  packet[info.upper_offset + 2] = static_cast<uint8_t>(value >> 8);
+  packet[info.upper_offset + 3] = static_cast<uint8_t>(value);
+  return true;
+}
+
+bool rewrite_nd_link_address(uint8_t *packet, size_t length, const uint8_t mac[6]) {
+  Ipv6PacketInfo info;
+  bool nonzero_mac = false;
+  if (mac != nullptr)
+    for (size_t i = 0; i < 6; ++i)
+      nonzero_mac |= mac[i] != 0;
+  if (mac == nullptr || (mac[0] & 1) != 0 || !nonzero_mac || !inspect_ipv6(packet, length, info) || !info.nd)
+    return false;
+  bool changed = false;
+  // Validate the entire option list before mutation. SEND's RSA signature
+  // covers the ND message and would be invalidated by any LLA rewrite.
+  for (size_t offset = info.options_offset; offset < length; offset += size_t(packet[offset + 1]) * 8)
+    if (packet[offset] == 12)
+      return false;
+  for (size_t offset = info.options_offset; offset < length; offset += size_t(packet[offset + 1]) * 8) {
+    if (packet[offset] == 1 || packet[offset] == 2) {
+      std::memcpy(packet + offset + 2, mac, 6);
+      changed = true;
+    }
+  }
+  if (!changed)
+    return true;
+  packet[info.upper_offset + 2] = packet[info.upper_offset + 3] = 0;
+  uint16_t value;
+  if (!checksum({packet, contiguous_read}, length, info, value))
+    return false;
+  packet[info.upper_offset + 2] = static_cast<uint8_t>(value >> 8);
+  packet[info.upper_offset + 3] = static_cast<uint8_t>(value);
+  return true;
+}
+
+}  // namespace mesh_ip
diff --git a/esphome/components/mesh/mesh_ip_ipv6.h b/esphome/components/mesh/mesh_ip_ipv6.h
new file mode 100644
index 000000000..869a6fa2a
--- /dev/null
+++ b/esphome/components/mesh/mesh_ip_ipv6.h
@@ -0,0 +1,60 @@
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+namespace mesh_ip {
+
+struct Ipv6Address {
+  std::array<uint8_t, 16> bytes{};
+  bool operator==(const Ipv6Address &other) const { return bytes == other.bytes; }
+  bool operator!=(const Ipv6Address &other) const { return !(*this == other); }
+  bool unspecified() const;
+  bool multicast() const { return bytes[0] == 0xff; }
+  bool link_local() const { return bytes[0] == 0xfe && (bytes[1] & 0xc0) == 0x80; }
+  bool matches_eui64(const uint8_t mac[6]) const;
+  Ipv6Address solicited_node() const;
+};
+
+// Read-only, coherent publication by the TCP/IP owner. Tentative and duplicate
+// addresses are never reported as ready; lifetime remains owned by lwIP.
+struct Ipv6AddressSnapshot {
+  static constexpr size_t CAPACITY = 3;
+  Ipv6Address addresses[CAPACITY]{};
+  uint32_t generation{0}, peer_epoch{0};
+  uint8_t count{0};
+  // Local address preference only; the claim/grant wire format carries valid
+  // addresses, not this hint. Deprecated addresses remain usable until expiry.
+  uint8_t preferred_mask{0};
+  bool ready{false};
+};
+
+// Offsets are relative to the IPv6 header. Reads copy exactly count bytes or
+// fail; the caller keeps the complete packet stable for the inspection.
+struct Ipv6PacketReader {
+  const void *context{nullptr};
+  bool (*read)(const void *, size_t, uint8_t *, size_t){nullptr};
+};
+struct Ipv6PacketInfo {
+  Ipv6Address source{}, destination{}, target{};
+  uint16_t total_length{0}, upper_offset{0}, upper_length{0}, options_offset{0};
+  uint8_t next_header{0}, icmp_type{0}, hop_limit{0};
+  bool fragmented{false}, noninitial_fragment{false}, protected_payload{false}, nd{false}, dad{false};
+};
+
+// Bounded IPv6/extension-header parsing. ND additionally requires a valid
+// ICMPv6 checksum, hop limit 255, code zero and well-formed options. Fragmented
+// ND is rejected per RFC 6980; ordinary IP fragments remain opaque IP traffic.
+bool inspect_ipv6(const Ipv6PacketReader &reader, size_t length, Ipv6PacketInfo &info);
+bool inspect_ipv6(const uint8_t *packet, size_t length, Ipv6PacketInfo &info);
+// Only changes the six bytes of a valid ND SLLA/TLLA option and its checksum.
+// Authenticated SEND messages cannot be rewritten and are rejected. A packet
+// without a link-address option is valid and remains unchanged (e.g. DAD).
+bool rewrite_nd_link_address(uint8_t *packet, size_t length, const uint8_t mac[6]);
+// For a newly constructed ICMPv6 packet, including a checksum-zero DAD NS.
+// Validates packet layout/ND rules before calculating the checksum. Does not
+// rewrite authenticated or fragmented messages.
+bool finalize_icmpv6_checksum(uint8_t *packet, size_t length);
+
+}  // namespace mesh_ip
diff --git a/esphome/components/mesh/mesh_ip_mdns.cpp b/esphome/components/mesh/mesh_ip_mdns.cpp
new file mode 100644
index 000000000..d172b40fd
--- /dev/null
+++ b/esphome/components/mesh/mesh_ip_mdns.cpp
@@ -0,0 +1,475 @@
+#include "mesh_ip_mdns.h"
+#ifdef USE_MESH_DISCOVERY
+#include "esphome/core/application.h"
+#include "esphome/core/hal.h"
+#include "esphome/core/log.h"
+#include <mdns.h>
+#include <cstring>
+
+namespace esphome::mesh {
+#ifndef MESH_IP_CLIENT_ONLY
+ESPHOME_LOG_TAG(TAG, "mesh.mdns");
+#endif
+
+void MeshIpMdns::setup() {
+#ifndef MESH_IP_CLIENT_ONLY
+  this->queue_ = xQueueCreateStatic(8, sizeof(Chunk), this->queue_buffer_, &this->queue_storage_);
+#endif
+}
+bool MeshIpMdns::update_peer_identity(uint8_t node, const uint8_t *mac, uint32_t identity_epoch) {
+  if (node == 0 || node > mesh_limits::MAX_NODES || identity_epoch == 0)
+    return false;
+  uint32_t low = 0, high = 0;
+  if (mac != nullptr) {
+    if ((mac[0] & 1) != 0)
+      return false;
+    std::memcpy(&low, mac, 4);
+    std::memcpy(&high, mac + 4, 2);
+    if (low == 0 && high == 0)
+      return false;
+  }
+#ifdef MESH_IP_CLIENT_ONLY
+  return true;  // A client build owns no delegated hostname or peer registry.
+#else
+  auto &request = this->identities_[node - 1];
+  if (request.epoch.load() == identity_epoch) {
+    if (request.low.load() != low || request.high.load() != high)
+      return false;
+    return request.applied.load() == identity_epoch;
+  }
+  request.generation.fetch_add(1);
+  // Worker is the sole status writer. Fence old queued metadata and clear the
+  // latest status before the main loop can authorize a replacement owner.
+  auto &status = this->statuses_[node - 1];
+  status.epoch.fetch_add(1);
+  status.generation.fetch_add(1);
+  status.address.store(0);
+  status.seen.store(0);
+#ifdef MESH_IPV6
+  status.ipv6_active.store(false);
+  status.ipv6_seen.store(0);
+#endif
+  status.generation.fetch_add(1);
+  request.low.store(low);
+  request.high.store(high);
+  request.epoch.store(identity_epoch);
+  request.generation.fetch_add(1);
+  return false;
+#endif
+}
+#ifndef MESH_IP_CLIENT_ONLY
+bool MeshIpMdns::identity_current_(uint8_t node) const {
+  const auto &request = this->identities_[node - 1];
+  const uint32_t generation = request.generation.load();
+  return (generation & 1) == 0 && request.epoch.load() == request.applied.load() &&
+         request.generation.load() == generation;
+}
+void MeshIpMdns::apply_identity_changes_() {
+  for (uint8_t node = 1; node <= mesh_limits::MAX_NODES; ++node) {
+    auto &request = this->identities_[node - 1];
+    const uint32_t generation = request.generation.load();
+    const uint32_t epoch = request.epoch.load();
+    if ((generation & 1) != 0 || epoch == request.applied.load())
+      continue;
+    uint8_t mac[6]{};
+    const uint32_t low = request.low.load(), high = request.high.load();
+    std::memcpy(mac, &low, 4);
+    std::memcpy(mac + 4, &high, 2);
+    if (request.generation.load() != generation)
+      continue;
+    // An unavailable responder can still retire an unpublished registry slot.
+    // Actual delegated ownership must wait for real asynchronous SDK removal.
+    if (this->records_[node - 1].hostname[0] != 0 && (!this->ready_() || !this->withdraw_(node)))
+      continue;
+    this->registry_.revoke(node);
+    if (low != 0 || high != 0)
+      this->registry_.authorize(node, mac);
+    this->retry_after_[node - 1] = 0;
+    auto &status = this->statuses_[node - 1];
+    status.consumed_epoch = status.epoch.load();
+    status.consumed = status.generation.load();
+    if (request.generation.load() == generation)
+      request.applied.store(epoch);
+  }
+}
+#endif
+bool MeshIpMdns::ready_() const {
+  if (this->component_ == nullptr || this->component_->is_failed())
+    return false;
+  char hostname[MDNS_NAME_BUF_LEN]{};
+  return mdns_hostname_get(hostname) == ESP_OK;
+}
+bool MeshIpMdns::local_descriptor(uint8_t *output, size_t capacity, size_t &written) {
+#ifdef MESH_IP_GATEWAY_ONLY
+  (void) output;
+  (void) capacity;
+  written = 0;
+  return false;
+#else
+  written = 0;
+  if (!this->ready_())
+    return false;
+  ::mesh_ip::DiscoveryDescriptor descriptor;
+  if (!descriptor.set_hostname(App.get_name().c_str()))
+    return false;
+  for (const auto &service : this->component_->get_services()) {
+    const auto *type = MDNS_STR_ARG(service.service_type);
+    if (std::strcmp(MDNS_STR_ARG(service.proto), "_tcp") != 0)
+      continue;
+    if (std::strcmp(type, "_esphomelib") == 0) {
+      descriptor.api_port = service.port.value();
+      for (const auto &txt : service.txt_records)
+        if (!descriptor.add_txt(MDNS_STR_ARG(txt.key), MDNS_STR_ARG(txt.value)))
+          return false;
+    } else if (std::strcmp(type, "_http") == 0) {
+      descriptor.http_port = service.port.value();
+    }
+  }
+  return ::mesh_ip::encode_discovery(descriptor, output, capacity, written);
+#endif
+}
+void MeshIpMdns::enqueue(uint8_t node, const uint8_t *data, size_t length) {
+#ifdef MESH_IP_CLIENT_ONLY
+  (void) node;
+  (void) data;
+  (void) length;
+#else
+  if (this->queue_ == nullptr || node == 0 || node > mesh_limits::MAX_NODES || data == nullptr ||
+      length > sizeof(Chunk::data))
+    return;
+  if (!this->identity_current_(node))
+    return;
+  Chunk chunk;
+  chunk.node = node;
+  chunk.length = length;
+  chunk.epoch = this->statuses_[node - 1].epoch.load();
+  std::memcpy(chunk.data, data, length);
+  if (xQueueSend(this->queue_, &chunk, 0) != pdTRUE) {
+    ESP_LOGW(TAG, "Discovery metadata queue full; node will refresh");
+  }
+#endif
+}
+
+void MeshIpMdns::note_status(uint8_t node, uint32_t address, bool fallback) {
+#ifdef MESH_IP_CLIENT_ONLY
+  (void) node;
+  (void) address;
+  (void) fallback;
+#else
+  if (node == 0 || node > mesh_limits::MAX_NODES)
+    return;
+  if (!this->identity_current_(node))
+    return;
+  auto &status = this->statuses_[node - 1];
+  if (!fallback
+#ifdef MESH_IPV6
+      && !status.ipv6_active.load()
+#endif
+  )
+    status.epoch.fetch_add(1);
+  // The worker is the sole writer; the main loop reads a coherent snapshot
+  // without taking its transport mutex or delaying OTA forwarding.
+  status.generation.fetch_add(1);
+  status.address.store(fallback ? address : 0);
+  status.seen.store(millis());
+  status.generation.fetch_add(1);
+#endif
+}
+
+#ifdef MESH_IPV6
+void MeshIpMdns::note_ipv6_status(uint8_t node, const ::mesh_ip::Ipv6AddressSnapshot &snapshot) {
+#ifdef MESH_IP_CLIENT_ONLY
+  (void) node;
+  (void) snapshot;
+#else
+  if (node == 0 || node > mesh_limits::MAX_NODES || !this->identity_current_(node))
+    return;
+  auto &status = this->statuses_[node - 1];
+  const bool active = snapshot.ready && snapshot.count != 0;
+  if (status.ipv6_active.exchange(active) && !active && status.address.load() == 0)
+    status.epoch.fetch_add(1);
+  status.ipv6_seen.store(millis());
+#endif
+}
+#endif
+
+#ifndef MESH_IP_CLIENT_ONLY
+bool MeshIpMdns::withdraw_(uint8_t node) {
+  auto &record = this->records_[node - 1];
+  if (record.hostname[0] == 0) {
+    this->published_[node - 1].store(false);
+    return true;
+  }
+  // ESP-IDF service removal transmits PTR TTL=0 before deleting the record.
+  // Cached A/SRV/TXT retain their normal TTL; no further answers are emitted.
+  // Leave published=true on a failure so a handover cannot ACK prematurely.
+  if (record.api) {
+    const auto err =
+        mdns_service_remove_for_host(record.hostname.data(), "_esphomelib", "_tcp", record.hostname.data());
+    if (err != ESP_OK && err != ESP_ERR_NOT_FOUND)
+      return false;
+    record.api = false;
+  }
+  if (record.http) {
+    const auto err = mdns_service_remove_for_host(record.hostname.data(), "_http", "_tcp", record.hostname.data());
+    if (err != ESP_OK && err != ESP_ERR_NOT_FOUND)
+      return false;
+    record.http = false;
+  }
+  if (!record.removal_pending) {
+    const auto err = mdns_delegate_hostname_remove(record.hostname.data());
+    if (err != ESP_OK)
+      return false;
+    record.removal_pending = true;
+  }
+  // Host removal is asynchronous in ESP-IDF. Do not acknowledge a handover
+  // until the responder really stopped owning the delegated A record too.
+  if (mdns_hostname_exists(record.hostname.data()))
+    return false;
+  ESP_LOGI(TAG, "DISCOVERY withdraw node=%u host=%s.local", node, record.hostname.data());
+  record = Published{};
+  this->published_[node - 1].store(false);
+  return true;
+}
+#endif
+
+#ifndef MESH_IP_CLIENT_ONLY
+#ifdef MESH_IPV6
+bool MeshIpMdns::collect_ipv6_(uint8_t node, ::mesh_ip::MeshIpNetif &netif,
+                               ::mesh_ip::Ipv6AddressSnapshot &snapshot) const {
+  if (!netif.peer_ipv6_snapshot(node, snapshot) || !snapshot.ready || snapshot.count == 0 ||
+      snapshot.count > ::mesh_ip::Ipv6AddressSnapshot::CAPACITY) {
+    snapshot = {};
+    return false;
+  }
+  for (size_t i = 0; i < snapshot.count; ++i) {
+    if (!netif.peer_ipv6_address_valid(node, snapshot.addresses[i])) {
+      snapshot = {};
+      return false;
+    }
+  }
+  return true;
+}
+#endif
+bool MeshIpMdns::publish_(uint8_t node, uint32_t address, const ::mesh_ip::DiscoveryDescriptor &descriptor,
+                          ::mesh_ip::MeshIpNetif &netif) {
+  if (!this->identity_current_(node))
+    return false;
+  if (descriptor.hostname() == App.get_name().c_str() || mdns_hostname_exists(descriptor.hostname().c_str())) {
+    ESP_LOGW(TAG, "Discovery hostname already owned: %s", descriptor.hostname().c_str());
+    return false;
+  }
+  mdns_ip_addr_t ips[1
+#ifdef MESH_IPV6
+                     + ::mesh_ip::Ipv6AddressSnapshot::CAPACITY
+#endif
+  ]{};
+  size_t count = 0;
+  if (address != 0) {
+    ips[count].addr.type = ESP_IPADDR_TYPE_V4;
+    ips[count++].addr.u_addr.ip4.addr = address;
+  }
+#ifdef MESH_IPV6
+  ::mesh_ip::Ipv6AddressSnapshot ipv6;
+  this->collect_ipv6_(node, netif, ipv6);
+  for (size_t i = 0; i < ipv6.count; ++i) {
+    ips[count].addr.type = ESP_IPADDR_TYPE_V6;
+    std::memcpy(ips[count++].addr.u_addr.ip6.addr, ipv6.addresses[i].bytes.data(), 16);
+  }
+#endif
+  if (count == 0)
+    return false;
+  for (size_t i = 1; i < count; ++i)
+    ips[i - 1].next = &ips[i];
+  // Claim before the final ownership check. If a quiet heartbeat raced this
+  // main-loop pass, either the worker already ACKed and we see address=0, or
+  // it sees published=true and waits for our goodbye. Never publish after ACK.
+  this->published_[node - 1].store(true);
+  bool owned = netif.peer_mesh_address(node) == address;
+#ifdef MESH_IPV6
+  for (size_t i = 0; i < ipv6.count; ++i)
+    owned &= netif.peer_ipv6_address_valid(node, ipv6.addresses[i]);
+#endif
+  if (!owned) {
+    this->published_[node - 1].store(false);
+    return false;
+  }
+  if (mdns_delegate_hostname_add(descriptor.hostname().c_str(), ips) != ESP_OK ||
+      !mdns_hostname_exists(descriptor.hostname().c_str())) {
+    this->published_[node - 1].store(false);
+    return false;
+  }
+  auto &record = this->records_[node - 1];
+  const auto hostname = descriptor.hostname();
+  std::memcpy(record.hostname.data(), hostname.c_str(), hostname.size());
+  record.hostname[hostname.size()] = 0;
+  record.address = address;
+#ifdef MESH_IPV6
+  record.ipv6 = ipv6;
+#endif
+  record.revision = this->registry_.revision(node);
+  // Mark partial registration as owned too; its removal must precede handover.
+  std::array<mdns_txt_item_t, ::mesh_ip::DISCOVERY_TXT_MAX> txt{};
+  for (size_t i = 0; i < descriptor.txt_count(); ++i) {
+    const auto item = descriptor.txt(i);
+    txt[i] = {item.key.c_str(), item.value.c_str()};
+  }
+  auto err =
+      mdns_service_add_for_host(descriptor.hostname().c_str(), "_esphomelib", "_tcp", descriptor.hostname().c_str(),
+                                descriptor.api_port, txt.data(), descriptor.txt_count());
+  if (err == ESP_OK)
+    record.api = true;
+  if (err == ESP_OK && descriptor.http_port != 0) {
+    err = mdns_service_add_for_host(descriptor.hostname().c_str(), "_http", "_tcp", descriptor.hostname().c_str(),
+                                    descriptor.http_port, nullptr, 0);
+    if (err == ESP_OK)
+      record.http = true;
+  }
+  if (err != ESP_OK) {
+    ESP_LOGW(TAG, "Discovery registration failed: %s", esp_err_to_name(err));
+    this->withdraw_(node);
+    return false;
+  }
+  ESP_LOGI(TAG, "DISCOVERY publish node=%u host=%s.local api=%u", node, descriptor.hostname().c_str(),
+           descriptor.api_port);
+  return true;
+}
+#endif
+
+void MeshIpMdns::loop(::mesh_ip::MeshIpNetif &netif, bool gateway) {
+#ifdef MESH_IP_CLIENT_ONLY
+  (void) netif;
+  (void) gateway;
+#else
+  uint32_t now = millis();
+  if (uint32_t(now - this->last_loop_) < 50)
+    return;
+  this->last_loop_ = now;
+  this->apply_identity_changes_();
+  if (!gateway) {
+    // Gateway selection runs in the worker, while SDK ownership changes run
+    // here. A demoted candidate must send its goodbyes even when it no longer
+    // receives peer traffic. Never retain metadata for a later re-promotion.
+    for (uint8_t node = 1; node <= mesh_limits::MAX_NODES; node++) {
+      auto &status = this->statuses_[node - 1];
+      this->registry_.forget(node);
+      status.consumed_epoch = status.epoch.fetch_add(1) + 1;
+      status.consumed = status.generation.load();
+      this->retry_after_[node - 1] = 0;
+    }
+    Chunk chunk;
+    while (this->queue_ != nullptr && xQueueReceive(this->queue_, &chunk, 0) == pdTRUE) {
+    }
+    // Retain published ownership until asynchronous host removal completes.
+    // If mDNS is temporarily unavailable, the next pass retries withdrawal;
+    // the invalidated queue and registry stay invalid in the meantime.
+    if (this->ready_())
+      for (uint8_t node = 1; node <= mesh_limits::MAX_NODES; node++)
+        this->withdraw_(node);
+    return;
+  }
+  if (!this->ready_())
+    return;
+  // Preserve a quiet/direct ownership gap even if a later fallback heartbeat
+  // arrived before the main loop could observe the intermediate state.
+  for (uint8_t node = 1; node <= mesh_limits::MAX_NODES; node++) {
+    auto &status = this->statuses_[node - 1];
+    const uint32_t epoch = status.epoch.load();
+    if (epoch != status.consumed_epoch) {
+      this->registry_.forget(node);
+      status.consumed_epoch = epoch;
+    }
+  }
+  Chunk chunk;
+  while (xQueueReceive(this->queue_, &chunk, 0) == pdTRUE)
+    if (chunk.node >= 1 && chunk.node <= mesh_limits::MAX_NODES && this->identity_current_(chunk.node) &&
+        chunk.epoch == this->statuses_[chunk.node - 1].epoch.load())
+      this->registry_.receive(chunk.node, chunk.data, chunk.length, now);
+  for (uint8_t node = 1; node <= mesh_limits::MAX_NODES; node++) {
+    if (!this->identity_current_(node))
+      continue;
+    auto &status = this->statuses_[node - 1];
+    const uint32_t generation = status.generation.load();
+    if ((generation & 1) != 0 || generation == status.consumed)
+      continue;
+    const uint32_t address = status.address.load(), seen = status.seen.load();
+    if (status.generation.load() != generation)
+      continue;
+    status.consumed = generation;
+    if (address != 0 && uint32_t(millis() - seen) < 5000 && netif.peer_mesh_address(node) == address)
+      this->registry_.refresh(node, address, seen);
+  }
+#ifdef MESH_IPV6
+  for (uint8_t node = 1; node <= mesh_limits::MAX_NODES; ++node) {
+    if (!this->identity_current_(node))
+      continue;
+    auto &status = this->statuses_[node - 1];
+    const uint32_t seen = status.ipv6_seen.load();
+    ::mesh_ip::Ipv6AddressSnapshot ipv6;
+    if (!status.ipv6_active.load() || uint32_t(millis() - seen) >= 5000 || !this->collect_ipv6_(node, netif, ipv6))
+      continue;
+    for (size_t i = 0; i < ipv6.count; ++i)
+      this->registry_.refresh(node, ipv6.addresses[i], seen);
+  }
+#endif
+  // The worker can publish a newer heartbeat while this main-loop pass drains
+  // metadata. Never expire that timestamp using an older captured clock value.
+  now = millis();
+  this->registry_.expire(now);
+  for (uint8_t node = 1; node <= mesh_limits::MAX_NODES; node++) {
+    const uint32_t address = netif.peer_mesh_address(node);
+#ifdef MESH_IPV6
+    ::mesh_ip::Ipv6AddressSnapshot ipv6;
+    this->collect_ipv6_(node, netif, ipv6);
+#endif
+    // A reboot/OTA may acquire the same DHCP address with different metadata.
+    // Never reuse the preceding firmware's descriptor across an ownership gap.
+    if (address == 0
+#ifdef MESH_IPV6
+        && ipv6.count == 0
+#endif
+    )
+      this->registry_.forget(node);
+    const ::mesh_ip::DiscoveryDescriptor *descriptor = nullptr;
+    if (this->identity_current_(node)) {
+      descriptor = this->registry_.current(node, address, now);
+#ifdef MESH_IPV6
+      for (size_t i = 0; descriptor == nullptr && i < ipv6.count; ++i)
+        descriptor = this->registry_.current(node, ipv6.addresses[i], now);
+#endif
+    }
+    auto &record = this->records_[node - 1];
+    bool address_changed = record.address != address;
+#ifdef MESH_IPV6
+    address_changed |= record.ipv6.count != ipv6.count;
+    for (size_t i = 0; i < ipv6.count; ++i)
+      address_changed |= record.ipv6.addresses[i] != ipv6.addresses[i];
+#endif
+    if (record.hostname[0] != 0 && (record.removal_pending || descriptor == nullptr || address_changed ||
+                                    record.revision != this->registry_.revision(node))) {
+      if (!record.removal_pending) {
+        ESP_LOGI(TAG, "DISCOVERY unavailable node=%u reason=%s", node,
+                 address == 0 ? LOG_STR_LITERAL("ownership")
+                              : (descriptor == nullptr ? LOG_STR_LITERAL("metadata_expired")
+                                                       : LOG_STR_LITERAL("metadata_changed")));
+      }
+      if (!this->withdraw_(node))
+        continue;
+    }
+    if (descriptor && record.hostname[0] == 0 && uint32_t(now - this->retry_after_[node - 1]) >= 1000) {
+      this->retry_after_[node - 1] = now;
+      this->publish_(node, address, *descriptor, netif);
+    }
+  }
+#endif
+}
+void MeshIpMdns::shutdown() {
+#ifndef MESH_IP_CLIENT_ONLY
+  if (!this->ready_())
+    return;
+  for (uint8_t node = 1; node <= mesh_limits::MAX_NODES; node++)
+    this->withdraw_(node);
+#endif
+}
+}  // namespace esphome::mesh
+#endif
diff --git a/esphome/components/mesh/mesh_ip_mdns.h b/esphome/components/mesh/mesh_ip_mdns.h
new file mode 100644
index 000000000..cc5f344f5
--- /dev/null
+++ b/esphome/components/mesh/mesh_ip_mdns.h
@@ -0,0 +1,103 @@
+#pragma once
+
+#include "mesh_limits.h"
+
+#include "esphome/core/defines.h"
+#ifdef USE_MESH_DISCOVERY
+#include "mesh_ip_discovery.h"
+#include "mesh_ip_netif.h"
+#include "esphome/components/mdns/mdns_component.h"
+
+#include <atomic>
+#include <freertos/FreeRTOS.h>
+#include <freertos/queue.h>
+
+namespace esphome::mesh {
+
+// All ESP-IDF mDNS calls and bounded metadata updates run in the main loop. The
+// mesh worker only queues bounded control chunks and reads atomic flags.
+class MeshIpMdns {
+ public:
+  void set_component(mdns::MDNSComponent *component) { this->component_ = component; }
+  void authorize(uint8_t node, const uint8_t *mac) {
+#ifndef MESH_IP_CLIENT_ONLY
+    this->registry_.authorize(node, mac);
+#else
+    (void) node;
+    (void) mac;
+#endif
+  }
+  void setup();
+  // Worker request/main-loop acknowledgment. Retrying an identical nonzero
+  // epoch is idempotent; a new boot session uses a new epoch even at the same
+  // MAC. True only after old delegated ownership and metadata are gone.
+  bool update_peer_identity(uint8_t node, const uint8_t *mac, uint32_t identity_epoch);
+  bool local_descriptor(uint8_t *output, size_t capacity, size_t &written);
+  void enqueue(uint8_t node, const uint8_t *data, size_t length);
+  // Call only after the gateway accepted an authenticated IP_STATUS through
+  // MeshIpNetif::set_peer. DATA and other controls never renew discovery.
+  void note_status(uint8_t node, uint32_t address, bool fallback);
+#ifdef MESH_IPV6
+  void note_ipv6_status(uint8_t node, const ::mesh_ip::Ipv6AddressSnapshot &snapshot);
+#endif
+  void loop(::mesh_ip::MeshIpNetif &netif, bool gateway);
+  bool announced(uint8_t node) const {
+#ifndef MESH_IP_CLIENT_ONLY
+    return node >= 1 && node <= mesh_limits::MAX_NODES && this->published_[node - 1].load();
+#else
+    (void) node;
+    return false;
+#endif
+  }
+  void shutdown();
+
+ private:
+  bool ready_() const;
+  mdns::MDNSComponent *component_{nullptr};
+#ifndef MESH_IP_CLIENT_ONLY
+  struct Chunk {
+    uint8_t node{0}, length{0};
+    uint32_t epoch{0};
+    uint8_t data[::mesh_ip::DISCOVERY_FRAME_MAX]{};
+  };
+  struct Published {
+    std::array<char, 64> hostname{};
+    uint32_t revision{0}, address{0};
+#ifdef MESH_IPV6
+    ::mesh_ip::Ipv6AddressSnapshot ipv6{};  // Main-loop-owned published set.
+#endif
+    bool api{false}, http{false}, removal_pending{false};
+  };
+  struct Status {
+    std::atomic<uint32_t> generation{0}, address{0}, seen{0};
+    std::atomic<uint32_t> epoch{0};
+    uint32_t consumed{0}, consumed_epoch{0};  // Main loop only.
+#ifdef MESH_IPV6
+    std::atomic<bool> ipv6_active{false};
+    std::atomic<uint32_t> ipv6_seen{0};
+#endif
+  };
+  bool publish_(uint8_t node, uint32_t address, const ::mesh_ip::DiscoveryDescriptor &descriptor,
+                ::mesh_ip::MeshIpNetif &netif);
+#ifdef MESH_IPV6
+  bool collect_ipv6_(uint8_t node, ::mesh_ip::MeshIpNetif &netif, ::mesh_ip::Ipv6AddressSnapshot &snapshot) const;
+#endif
+  bool withdraw_(uint8_t node);
+  void apply_identity_changes_();
+  bool identity_current_(uint8_t node) const;
+  struct IdentityRequest {
+    std::atomic<uint32_t> generation{0}, low{0}, high{0}, epoch{0}, applied{0};
+  };
+  IdentityRequest identities_[mesh_limits::MAX_NODES]{};
+  ::mesh_ip::DiscoveryRegistry registry_;
+  Published records_[mesh_limits::MAX_NODES]{};
+  std::atomic<bool> published_[mesh_limits::MAX_NODES]{};
+  Status statuses_[mesh_limits::MAX_NODES]{};
+  StaticQueue_t queue_storage_{};
+  uint8_t queue_buffer_[8 * sizeof(Chunk)]{};
+  QueueHandle_t queue_{nullptr};
+  uint32_t last_loop_{0}, retry_after_[mesh_limits::MAX_NODES]{};
+#endif
+};
+}  // namespace esphome::mesh
+#endif
diff --git a/esphome/components/mesh/mesh_ip_netif.cpp b/esphome/components/mesh/mesh_ip_netif.cpp
new file mode 100644
index 000000000..080d6c5be
--- /dev/null
+++ b/esphome/components/mesh/mesh_ip_netif.cpp
@@ -0,0 +1,2076 @@
+#include "mesh_ip_netif.h"
+#include "mesh_ip_dhcp.h"
+
+#include <algorithm>
+#include <cstring>
+#include <esp_netif.h>
+#include <esp_netif_net_stack.h>
+#include <esp_timer.h>
+#include <freertos/task.h>
+#include <lwip/etharp.h>
+#include <lwip/def.h>
+#include <lwip/ip4.h>
+#include <lwip/pbuf.h>
+#include <lwip/tcpip.h>
+#ifdef MESH_HAS_ETHERNET
+#include <netif/ethernet.h>
+#endif
+
+namespace mesh_ip {
+
+MeshIpNetif *MeshIpNetif::instance_ = nullptr;
+
+static uint32_t now_ms() { return static_cast<uint32_t>(esp_timer_get_time() / 1000); }
+#ifndef MESH_IP_CLIENT_ONLY
+static uint32_t now_seconds() { return static_cast<uint32_t>(esp_timer_get_time() / 1000000); }
+#endif
+static uint16_t read_be16(const uint8_t *p) { return (uint16_t(p[0]) << 8) | p[1]; }
+static uint32_t read_address(const uint8_t *p) {
+  uint32_t address;
+  std::memcpy(&address, p, 4);
+  return address;
+}
+#ifndef MESH_IP_CLIENT_ONLY
+struct PbufPacketView {
+  struct pbuf *packet;
+  uint16_t offset, length;
+};
+static bool read_pbuf_packet(const void *context, size_t offset, uint8_t *output, size_t count) {
+  const auto &view = *static_cast<const PbufPacketView *>(context);
+  if (offset > view.length || count > view.length - offset)
+    return false;
+  return pbuf_copy_partial(view.packet, output, static_cast<uint16_t>(count),
+                           static_cast<uint16_t>(view.offset + offset)) == count;
+}
+#endif
+
+bool MeshIpNetif::configure(uint8_t node_id, uint8_t gateway_id, bool require_dhcp, uint16_t gateway_candidates) {
+  if (this->configured_.load())
+    return this->node_id_ == node_id && this->gateway_id_ == gateway_id && this->require_dhcp_ == require_dhcp &&
+           this->gateway_candidates_ == gateway_candidates;
+  if (node_id == 0 || node_id > mesh_limits::MAX_NODES || gateway_id == 0 || gateway_id > mesh_limits::MAX_NODES ||
+      (instance_ != nullptr && instance_ != this))
+    return false;
+  if (gateway_candidates != 0 && (gateway_candidates & (1U << (gateway_id - 1))) == 0)
+    return false;
+#ifdef MESH_IP_CLIENT_ONLY
+  if (node_id == gateway_id || (gateway_candidates & (1U << (node_id - 1))) != 0)
+    return false;
+#elif defined(MESH_IP_GATEWAY_ONLY)
+  if (node_id != gateway_id)
+    return false;
+#endif
+  this->node_id_ = node_id;
+  this->require_dhcp_ = require_dhcp;
+  this->gateway_candidates_ = gateway_candidates;
+  this->gateway_id_ = gateway_id;
+  this->rx_queue_ = xQueueCreateStatic(RX_CAPACITY, sizeof(IpPacket), this->rx_buffer_, &this->rx_storage_);
+#ifndef MESH_IP_CLIENT_ONLY
+  this->arp_queue_ = xQueueCreateStatic(ARP_CAPACITY, sizeof(ArpRequest), this->arp_buffer_, &this->arp_storage_);
+  this->probe_request_queue_ = xQueueCreateStatic(PROBE_QUEUE_CAPACITY, sizeof(LeaseProbeResult),
+                                                  this->probe_request_buffer_, &this->probe_request_storage_);
+  this->probe_result_queue_ = xQueueCreateStatic(PROBE_QUEUE_CAPACITY, sizeof(LeaseProbeResult),
+                                                 this->probe_result_buffer_, &this->probe_result_storage_);
+#endif
+  instance_ = this;
+  this->configured_.store(true);
+  this->schedule_();
+  return true;
+}
+
+bool MeshIpNetif::role_current_() const {
+  const uint8_t gateway = this->gateway_id_.load();
+  return this->transport_current_() && gateway != 0 && (gateway == this->node_id_ || this->peer_current_(gateway));
+}
+
+bool MeshIpNetif::peer_epoch_current_(uint8_t node_id, uint32_t epoch) const {
+  if (node_id == 0 || node_id > mesh_limits::MAX_NODES)
+    return false;
+  const auto &request = this->identity_requests_[node_id - 1];
+  const uint32_t revision = request.revision.load();
+  return (revision & 1) == 0 && request.epoch.load() == epoch && request.applied.load() == epoch &&
+         (epoch == 0 || request.low.load() != 0 || request.high.load() != 0) && request.revision.load() == revision;
+}
+
+bool MeshIpNetif::peer_current_(uint8_t node_id) const {
+  return node_id != 0 && node_id <= mesh_limits::MAX_NODES &&
+         this->peer_epoch_current_(node_id, this->identity_requests_[node_id - 1].epoch.load());
+}
+
+bool MeshIpNetif::transport_current_() const {
+#ifdef MESH_HAS_ETHERNET
+  const uint32_t revision = this->native_uplink_revision_.load();
+  if ((revision & 1U) != 0 || revision != this->applied_native_uplink_revision_.load() ||
+      revision != this->native_uplink_revision_.load())
+    return false;
+#endif
+  const uint32_t generation = this->gateway_generation_.load();
+  return (generation & 1) == 0 && this->applied_generation_.load() == generation &&
+         this->gateway_generation_.load() == generation;
+}
+
+bool MeshIpNetif::candidate_(uint8_t node_id) const {
+  return node_id != 0 && node_id <= mesh_limits::MAX_NODES && (this->gateway_candidates_ & (1U << (node_id - 1))) != 0;
+}
+
+bool MeshIpNetif::gateway_active_() const {
+  if (!this->gateway_enabled_.load() || !this->transport_current_())
+    return false;
+  if (this->gateway_candidates_ != 0)
+    return this->configured_.load() && this->candidate_(this->node_id_) && this->station_connected_.load();
+  return this->role_current_() && this->node_id_ == this->gateway_id_.load() && this->station_connected_.load();
+}
+
+bool MeshIpNetif::select_gateway(uint8_t gateway_id) {
+  if (!this->configured_.load() || gateway_id > mesh_limits::MAX_NODES)
+    return false;
+  if (this->gateway_candidates_ != 0 && gateway_id != 0 && !this->candidate_(gateway_id))
+    return false;
+#ifdef MESH_IP_CLIENT_ONLY
+  if (gateway_id == this->node_id_)
+    return false;
+#elif defined(MESH_IP_GATEWAY_ONLY)
+  if (gateway_id != 0 && gateway_id != this->node_id_)
+    return false;
+#endif
+  if (this->gateway_id_.load() == gateway_id)
+    return true;
+  // The mesh worker is the sole selector. Odd generations close all gateway
+  // hooks before publishing a new ID; the TCP/IP worker alone clears state and
+  // acknowledges an even generation. Driver packets carry that same epoch.
+  this->gateway_generation_.fetch_add(1);
+  this->applied_generation_.store(0);
+  this->gateway_id_.store(gateway_id);
+  if (this->gateway_candidates_ == 0) {
+    this->mesh_path_validated_.store(false);
+    this->available_.store(false);
+    this->fallback_active_.store(false);
+  }
+  this->gateway_generation_.fetch_add(1);
+  this->schedule_();
+  return true;
+}
+
+#ifndef MESH_IP_CLIENT_ONLY
+void MeshIpNetif::reset_peer_identity_state_(size_t i) {
+#ifdef MESH_IPV6
+  this->reset_ipv6_peer_(i);
+#endif
+  Peer &peer = this->peers_[i];
+  peer.fallback.store(false);
+  peer.endpoint.store(false);
+  peer.generation.store(0);
+  peer.lease_id.store(0);
+  peer.lease_started.store(0);
+  peer.lease_seconds.store(0);
+  peer.identity_known.store(false);
+  peer.desired_address.store(0);
+  peer.desired_xid.store(0);
+  peer.ip.store(0);
+  peer.seen.store(0);
+  peer.announced = false;
+  peer.last_announcement = 0;
+  DhcpTransaction &transaction = this->dhcp_transactions_[i];
+  transaction.generation.store(0);
+  transaction.xid.store(0);
+  transaction.seen.store(0);
+  transaction.request_type.store(0);
+  transaction.mac_low.store(0);
+  transaction.mac_high.store(0);
+  transaction.candidate_xid.store(0);
+  transaction.candidate_address.store(0);
+  LeaseProbe &probe = this->lease_probes_[i];
+  probe.phase.store(0);
+  probe.address.store(0);
+  probe.conflict.store(false);
+  probe.nonce = probe.last_probe = probe.completed = probe.generation = probe.peer_epoch = 0;
+  probe.attempts = 0;
+  DhcpOwnership &ownership = this->dhcp_ownership_[i];
+  // A newly elected gateway must observe its own authenticated DHCP ACK.
+  // An old client heartbeat alone never establishes LAN address ownership.
+  ownership.managed.store(true);
+  ownership.local.store(false);
+  ownership.active.store(false);
+  ownership.revoked.store(false);
+  ownership.generation.store(0);
+  ownership.address.store(0);
+  ownership.xid.store(0);
+  ownership.seconds.store(0);
+  ownership.started.store(0);
+  ownership.revoked_xid.store(0);
+  ownership.revoked_lease_xid.store(0);
+  RemoteWitness &remote = this->remote_witnesses_[i];
+  remote.active.store(false);
+  remote.generation.store(0);
+  remote.address.store(0);
+  remote.xid.store(0);
+  remote.seconds.store(0);
+  remote.started.store(0);
+}
+#endif
+
+bool MeshIpNetif::apply_gateway_change_(uint32_t generation) {
+  if ((generation & 1) != 0 || generation != this->gateway_generation_.load())
+    return false;
+#ifndef MESH_IP_CLIENT_ONLY
+  // A driver may have entered before select_gateway closed its gate. Never
+  // erase its DHCP snapshots while it is still publishing.
+  if (this->driver_tx_busy_.exchange(true))
+    return false;
+#endif
+  if (generation != this->gateway_generation_.load()) {
+#ifndef MESH_IP_CLIENT_ONLY
+    this->driver_tx_busy_.store(false);
+#endif
+    return false;
+  }
+  portENTER_CRITICAL(&this->tx_lock_);
+  this->tx_flows_.reset();
+  portEXIT_CRITICAL(&this->tx_lock_);
+  this->rx_pending_ = false;
+  xQueueReset(this->rx_queue_);
+#ifndef MESH_IP_CLIENT_ONLY
+  xQueueReset(this->arp_queue_);
+  xQueueReset(this->probe_request_queue_);
+  xQueueReset(this->probe_result_queue_);
+  if (this->gateway_candidates_ != 0 && generation != 2) {
+    for (LeaseProbe &probe : this->lease_probes_)
+      probe.phase.store(0);  // Retry an unfinished initial probe in this epoch.
+  }
+  if ((generation != 2 || this->require_dhcp_ || this->gateway_candidates_ != 0) &&
+      (this->gateway_candidates_ == 0 || generation == 2)) {
+    for (size_t i = 0; i < mesh_limits::MAX_NODES; i++)
+      this->reset_peer_identity_state_(i);
+  }
+  this->driver_tx_busy_.store(false);
+#endif
+  if (generation != this->gateway_generation_.load())
+    return false;
+  this->applied_generation_.store(generation);
+  return true;
+}
+
+bool MeshIpNetif::apply_pending_identities_() {
+  const uint16_t pending = this->identity_pending_mask_.load();
+  if (pending == 0)
+    return true;
+#ifndef MESH_IP_CLIENT_ONLY
+  if (this->driver_tx_busy_.exchange(true))
+    return false;
+#endif
+  for (size_t i = 0; i < mesh_limits::MAX_NODES; ++i) {
+    const uint16_t bit = 1U << i;
+    if ((pending & bit) == 0)
+      continue;
+    auto &request = this->identity_requests_[i];
+    const uint32_t revision = request.revision.load();
+    if ((revision & 1) != 0)
+      continue;
+    const uint32_t epoch = request.epoch.load(), low = request.low.load(), high = request.high.load();
+    if (request.revision.load() != revision)
+      continue;
+    if (request.applied.load() != epoch) {
+#ifndef MESH_IP_CLIENT_ONLY
+      // Only this owner changes: unrelated packet queues, grants and the local
+      // interface remain live. Driver snapshots are excluded during the reset.
+      this->reset_peer_identity_state_(i);
+      this->dhcp_peer_macs_[i].low.store(low);
+      this->dhcp_peer_macs_[i].high.store(high);
+      if (low != 0 || high != 0)
+        this->dhcp_peer_mac_mask_.fetch_or(bit);
+      else
+        this->dhcp_peer_mac_mask_.fetch_and(static_cast<uint16_t>(~bit));
+#else
+      (void) low;
+      (void) high;
+#endif
+    }
+    if (request.revision.load() != revision)
+      continue;
+    request.applied.store(epoch);
+    this->identity_pending_mask_.fetch_and(static_cast<uint16_t>(~bit));
+    // A newer publication may race the mask clear. Its revision must stay
+    // pending even if it had already set this same bit.
+    if (request.revision.load() != revision)
+      this->identity_pending_mask_.fetch_or(bit);
+  }
+#ifndef MESH_IP_CLIENT_ONLY
+  this->driver_tx_busy_.store(false);
+#endif
+  return this->identity_pending_mask_.load() == 0;
+}
+
+void MeshIpNetif::update(uint32_t ip, uint32_t mask, uint32_t gateway, bool connected, bool reachable,
+                         NativeUplink uplink) {
+  if (!this->configured_.load())
+    return;
+#ifdef MESH_HAS_ETHERNET
+  if (uplink != this->native_uplink_.load()) {
+    this->native_uplink_revision_.fetch_add(1);
+    this->native_uplink_.store(uplink);
+    this->native_uplink_revision_.fetch_add(1);
+  }
+#else
+  (void) uplink;
+#endif
+  if (this->require_dhcp_ && !connected && this->station_connected_.load()) {
+    // Native DHCP ownership is not proof at another gateway, even when the
+    // routing root itself did not change during this local Wi-Fi outage.
+    this->mesh_path_validated_.store(false);
+    this->available_.store(false);
+    this->fallback_active_.store(false);
+  }
+  if (ip != 0 && connected) {
+    this->mesh_lease_.store(false);
+    this->address_.store(ip);
+    this->mask_.store(mask);
+    this->gateway_.store(gateway);
+  }
+  this->station_connected_.store(connected);
+  this->mesh_reachable_.store(reachable);
+  this->schedule_();
+}
+
+bool MeshIpNetif::set_dhcp_peer_mac(uint8_t node_id, const uint8_t *mac) {
+#ifdef MESH_IP_CLIENT_ONLY
+  (void) node_id;
+  (void) mac;
+  return false;
+#else
+  if (node_id == 0 || node_id > mesh_limits::MAX_NODES || node_id == this->node_id_ || mac == nullptr ||
+      (mac[0] & 1) != 0)
+    return false;
+  bool nonzero = false;
+  for (size_t i = 0; i < 6; i++)
+    nonzero |= mac[i] != 0;
+  if (!nonzero)
+    return false;
+  // Setup-only configuration; immutable once the mesh worker can receive data.
+  uint32_t low = 0, high = 0;
+  std::memcpy(&low, mac, 4);
+  std::memcpy(&high, mac + 4, 2);
+  this->dhcp_peer_macs_[node_id - 1].low.store(low);
+  this->dhcp_peer_macs_[node_id - 1].high.store(high);
+  this->dhcp_peer_mac_mask_.fetch_or(1U << (node_id - 1));
+  return true;
+#endif
+}
+
+bool MeshIpNetif::update_peer_identity(uint8_t node_id, const uint8_t *mac, uint32_t identity_epoch) {
+  if (!this->configured_.load() || node_id == 0 || node_id > mesh_limits::MAX_NODES || node_id == this->node_id_ ||
+      identity_epoch == 0)
+    return false;
+  uint32_t low = 0, high = 0;
+  if (mac != nullptr) {
+    if ((mac[0] & 1) != 0)
+      return false;
+    std::memcpy(&low, mac, 4);
+    std::memcpy(&high, mac + 4, 2);
+    if (low == 0 && high == 0)
+      return false;
+  }
+  auto &request = this->identity_requests_[node_id - 1];
+  if (request.epoch.load() == identity_epoch) {
+    if (request.low.load() != low || request.high.load() != high)
+      return false;
+    const bool applied = request.applied.load() == identity_epoch && this->transport_current_();
+    if (!applied)
+      this->schedule_();  // Retry a busy driver or full TCP/IP mailbox.
+    return applied;
+  }
+  // Close this peer before changing its identity. The route epoch belongs to
+  // gateway changes; a different member must not disconnect a valid client.
+  request.revision.fetch_add(1);
+  if (node_id == this->gateway_id_.load()) {
+    // The local lease survives a remote identity change, but a different
+    // gateway owner must freshly prove its authority over that client path.
+    this->mesh_path_validated_.store(false);
+    this->fallback_active_.store(false);
+    if (!this->station_connected_.load())
+      this->available_.store(false);
+  }
+#ifndef MESH_IP_CLIENT_ONLY
+  this->dhcp_peer_mac_mask_.fetch_and(static_cast<uint16_t>(~(1U << (node_id - 1))));
+#endif
+  request.low.store(low);
+  request.high.store(high);
+  request.epoch.store(identity_epoch);
+  request.revision.fetch_add(1);
+  this->identity_pending_mask_.fetch_or(1U << (node_id - 1));
+  this->schedule_();
+  return false;
+}
+
+#ifndef MESH_IP_CLIENT_ONLY
+bool MeshIpNetif::dhcp_peer_mac_(uint8_t node_id, uint8_t output[6]) const {
+  if (node_id == 0 || node_id > mesh_limits::MAX_NODES || output == nullptr || !this->transport_current_() ||
+      !this->peer_current_(node_id) || (this->dhcp_peer_mac_mask_.load() & (1U << (node_id - 1))) == 0)
+    return false;
+  const uint32_t generation = this->gateway_generation_.load();
+  const auto &peer = this->dhcp_peer_macs_[node_id - 1];
+  const uint32_t low = peer.low.load(), high = peer.high.load();
+  std::memcpy(output, &low, 4);
+  std::memcpy(output + 4, &high, 2);
+  return this->gateway_generation_.load() == generation && this->transport_current_() && this->peer_current_(node_id) &&
+         (this->dhcp_peer_mac_mask_.load() & (1U << (node_id - 1))) != 0;
+}
+#endif
+
+#ifndef MESH_IP_CLIENT_ONLY
+bool MeshIpNetif::gateway_lease_valid_(uint8_t node_id, uint32_t address) const {
+  if (!this->peer_current_(node_id))
+    return false;
+  const DhcpOwnership &ownership = this->dhcp_ownership_[node_id - 1];
+  if (!ownership.managed.load())
+    return true;  // Preserve the separate short-outage legacy experiment.
+  if (!ownership.active.load() || ownership.revoked.load())
+    return false;
+  const uint32_t generation = ownership.generation.load();
+  if (generation == 0 || (generation & 1) != 0 || ownership.address.load() != address)
+    return false;
+  const uint32_t lifetime = ownership.seconds.load(), started = ownership.started.load();
+  const uint32_t now = now_seconds();
+  return ownership.generation.load() == generation && ownership.active.load() &&
+         (lifetime == UINT32_MAX || uint32_t(now - started) < lifetime);
+}
+
+bool MeshIpNetif::gateway_source_valid_(uint8_t node_id, uint32_t address) const {
+  if (!this->gateway_active_() || node_id == 0 || node_id > mesh_limits::MAX_NODES || node_id == this->node_id_ ||
+      !this->peer_current_(node_id))
+    return false;
+  const Peer &peer = this->peers_[node_id - 1];
+  const uint32_t seen = peer.seen.load();
+  const uint32_t now = now_ms();
+  return peer.ip.load() == address && address != 0 && uint32_t(now - seen) < PEER_LEASE_MS &&
+         this->valid_peer_address_(node_id, address) &&
+         (this->gateway_candidates_ == 0 ? this->gateway_lease_valid_(node_id, address)
+                                         : (peer.fallback.load() && this->endpoint_lease_valid_(node_id, address)));
+}
+
+bool MeshIpNetif::witness_remaining_(uint8_t node_id, uint32_t address, uint32_t xid, uint32_t &remaining) const {
+  if (!this->peer_current_(node_id))
+    return false;
+  const DhcpOwnership &local = this->dhcp_ownership_[node_id - 1];
+  if ((local.revoked.load() || this->gateway_candidates_ != 0) &&
+      (local.revoked_xid.load() == xid || local.revoked_lease_xid.load() == xid))
+    return false;
+  remaining = UINT32_MAX;
+  bool found = false;
+  // Both independent observations of the same ACK bound the same hard lease.
+  // Even an expired matching observation is a fence, never a reason to take
+  // a later replay's longer deadline instead.
+  const auto read = [&](const auto &witness) {
+    const uint32_t generation = witness.generation.load();
+    if (generation == 0 || (generation & 1) != 0)
+      return generation == 0;
+    const uint32_t ip = witness.address.load(), token = witness.xid.load();
+    if (ip != address || token != xid)
+      return witness.generation.load() == generation;
+    const uint32_t lifetime = witness.seconds.load(), started = witness.started.load();
+    const uint32_t elapsed = uint32_t(now_seconds() - started);
+    if (!witness.active.load() || (lifetime != UINT32_MAX && elapsed >= lifetime) ||
+        witness.generation.load() != generation)
+      return false;
+    remaining = std::min(remaining, lifetime == UINT32_MAX ? UINT32_MAX : lifetime - elapsed);
+    found = true;
+    return true;
+  };
+  return read(local) && read(this->remote_witnesses_[node_id - 1]) && found;
+}
+
+bool MeshIpNetif::endpoint_lease_valid_(uint8_t node_id, uint32_t address) const {
+  if (!this->peer_current_(node_id))
+    return false;
+  const Peer &peer = this->peers_[node_id - 1];
+  const uint32_t generation = peer.generation.load();
+  if (generation == 0 || (generation & 1) != 0 || !peer.endpoint.load() || peer.ip.load() != address)
+    return false;
+  const uint32_t lifetime = peer.lease_seconds.load(), started = peer.lease_started.load();
+  return (lifetime == UINT32_MAX || uint32_t(now_seconds() - started) < lifetime) &&
+         peer.generation.load() == generation && peer.endpoint.load();
+}
+#endif
+
+bool MeshIpNetif::submit_dhcp_request(const uint8_t *packet, size_t length) {
+  const uint32_t generation = this->gateway_generation_.load();
+  DhcpMessage message;
+  if (!this->configured_.load() || !this->role_current_() || this->node_id_ == this->gateway_id_ ||
+      !parse_dhcp_request(packet, length, message) ||
+      (message.source != 0 && lwip_ntohl(message.source) != this->address_.load())) {
+    this->invalid_packets_.fetch_add(1);
+    return false;
+  }
+  const uint8_t destination = this->gateway_id_.load();
+  if (destination == 0 || destination > mesh_limits::MAX_NODES)
+    return false;
+  const uint32_t peer_epoch = this->identity_requests_[destination - 1].epoch.load();
+  IpFlowQueue::Reservation reservation;
+  IpPacket *outgoing = this->reserve_outgoing_(IpFlowQueue::classify(destination, packet, length), reservation);
+  if (outgoing == nullptr) {
+    this->queue_drops_.fetch_add(1);
+    return false;
+  }
+  outgoing->generation = generation;
+  outgoing->destination = destination;
+  outgoing->peer_epoch = peer_epoch;
+  outgoing->ingress_source = 0;
+  outgoing->ingress_epoch = 0;
+  outgoing->gateway_ingress = false;
+  outgoing->length = length;
+  std::memcpy(outgoing->data, packet, length);
+  if (!this->commit_outgoing_(reservation)) {
+    this->queue_drops_.fetch_add(1);
+    return false;
+  }
+  this->mesh_tx_.fetch_add(1);
+  return true;
+}
+
+bool MeshIpNetif::install_valid_lease(uint32_t ip, uint32_t mask, uint32_t gateway) {
+  const uint32_t host_mask = ~lwip_ntohl(mask);
+  const uint32_t host_part = lwip_ntohl(ip) & host_mask;
+  if (!this->configured_.load() || !this->role_current_() || this->node_id_ == this->gateway_id_ ||
+      !unicast_address_(ip) || mask == 0 || host_mask == 0 || (host_mask & (host_mask + 1)) != 0 || host_part == 0 ||
+      host_part == host_mask || !unicast_address_(gateway) || (gateway & mask) != (ip & mask) || gateway == ip)
+    return false;
+  this->address_.store(ip);
+  this->mask_.store(mask);
+  this->gateway_.store(gateway);
+  this->mesh_lease_.store(true);
+  this->mesh_path_validated_.store(true);
+  this->schedule_();
+  return true;
+}
+
+void MeshIpNetif::clear_mesh_lease() {
+  if (this->configured_.load() && this->node_id_ != this->gateway_id_) {
+    // Explicit withdrawal also clears a cached native-STA address when root
+    // switches from the historical short-outage path to managed mesh DHCP.
+    this->mesh_lease_.store(false);
+    this->mesh_path_validated_.store(false);
+    this->address_.store(0);
+    this->mask_.store(0);
+    this->gateway_.store(0);
+    this->available_.store(false);
+    this->fallback_active_.store(false);
+    this->ready_.store(false);
+    this->schedule_();
+  }
+}
+
+bool MeshIpNetif::begin_lease_probe(uint8_t node_id, uint32_t address, uint32_t nonce) {
+#ifdef MESH_IP_CLIENT_ONLY
+  (void) node_id;
+  (void) address;
+  (void) nonce;
+  return false;
+#else
+  if (!this->configured_.load() || !this->gateway_active_() || !this->valid_peer_address_(node_id, address))
+    return false;
+  const DhcpTransaction &transaction = this->dhcp_transactions_[node_id - 1];
+  const uint32_t generation = transaction.generation.load();
+  if (generation == 0 || (generation & 1) != 0 || transaction.xid.load() != nonce ||
+      uint32_t(now_ms() - transaction.seen.load()) >= DHCP_TRANSACTION_MS ||
+      transaction.candidate_xid.load() != nonce || transaction.candidate_address.load() != address ||
+      transaction.generation.load() != generation || !this->gateway_lease_valid_(node_id, address))
+    return false;
+  LeaseProbeResult request;
+  request.node_id = node_id;
+  request.address = address;
+  request.nonce = nonce;
+  request.generation = this->gateway_generation_.load();
+  request.peer_epoch = this->identity_requests_[node_id - 1].epoch.load();
+  if (xQueueSend(this->probe_request_queue_, &request, 0) != pdTRUE) {
+    this->queue_drops_.fetch_add(1);
+    return false;
+  }
+  this->schedule_();
+  return true;
+#endif
+}
+
+bool MeshIpNetif::pop_probe_result(LeaseProbeResult &result) {
+#ifdef MESH_IP_CLIENT_ONLY
+  (void) result;
+  return false;
+#else
+  if (this->probe_result_queue_ == nullptr || !this->gateway_active_())
+    return false;
+  while (xQueueReceive(this->probe_result_queue_, &result, 0) == pdTRUE) {
+    if (result.generation == this->gateway_generation_.load() &&
+        this->peer_epoch_current_(result.node_id, result.peer_epoch) &&
+        this->gateway_lease_valid_(result.node_id, result.address))
+      return true;
+  }
+  return false;
+#endif
+}
+
+#ifndef MESH_IP_CLIENT_ONLY
+bool MeshIpNetif::valid_dhcp_request_(uint8_t source, const uint8_t *packet, size_t length) const {
+  DhcpMessage message;
+  uint8_t mac[6]{};
+  return source != 0 && source <= mesh_limits::MAX_NODES && source != this->node_id_ &&
+         this->dhcp_peer_mac_(source, mac) && parse_dhcp_request(packet, length, message) &&
+         std::memcmp(message.mac, mac, 6) == 0 &&
+         (message.source == 0 || this->valid_peer_address_(source, lwip_ntohl(message.source)));
+}
+#endif
+
+#ifndef MESH_IP_CLIENT_ONLY
+bool MeshIpNetif::track_dhcp_request_(uint8_t source, const uint8_t *packet, size_t length) {
+  DhcpMessage message;
+  if (!parse_dhcp_request(packet, length, message))
+    return false;
+  if (this->driver_tx_busy_.exchange(true)) {
+    this->queue_drops_.fetch_add(1);
+    return false;
+  }
+  DhcpTransaction &transaction = this->dhcp_transactions_[source - 1];
+  DhcpOwnership &ownership = this->dhcp_ownership_[source - 1];
+  ownership.managed.store(true);
+  if (message.type == 1 || message.type == 4 || message.type == 7) {
+    ownership.active.store(false);
+    this->peers_[source - 1].fallback.store(false);
+    this->peers_[source - 1].endpoint.store(false);
+    this->remote_witnesses_[source - 1].active.store(false);
+    if (message.type != 1) {
+      ownership.revoked_xid.store(message.xid);
+      ownership.revoked_lease_xid.store(this->peers_[source - 1].lease_id.load());
+      ownership.revoked.store(true);
+    }
+  }
+  transaction.generation.fetch_add(1);  // Odd: a new snapshot is being written.
+  if (transaction.xid.load() != message.xid || message.type != 3) {
+    transaction.candidate_xid.store(0);
+    transaction.candidate_address.store(0);
+  }
+  transaction.xid.store(message.xid);
+  transaction.request_type.store(message.type);
+  transaction.mac_low.store(read_address(message.mac));
+  transaction.mac_high.store(uint32_t(message.mac[4]) | (uint32_t(message.mac[5]) << 8));
+  transaction.seen.store(now_ms());
+  transaction.generation.fetch_add(1);  // Even: all fields belong to this request.
+  this->driver_tx_busy_.store(false);
+  return true;
+}
+#endif
+
+#ifndef MESH_IP_CLIENT_ONLY
+uint8_t MeshIpNetif::dhcp_destination_(const DhcpMessage &message, uint32_t *peer_epoch) {
+  if (!this->gateway_active_())
+    return 0;
+  const uint32_t source = lwip_ntohl(message.source);
+  if ((source & this->mask_.load()) != (this->address_.load() & this->mask_.load()))
+    return 0;  // This lab has no external DHCP relay or off-subnet server.
+  const uint32_t mac_low = read_address(message.mac);
+  const uint32_t mac_high = uint32_t(message.mac[4]) | (uint32_t(message.mac[5]) << 8);
+  for (size_t i = 0; i < mesh_limits::MAX_NODES; i++) {
+    const uint32_t epoch = this->identity_requests_[i].epoch.load();
+    if (!this->peer_epoch_current_(i + 1, epoch))
+      continue;
+    DhcpTransaction &transaction = this->dhcp_transactions_[i];
+    const uint32_t generation = transaction.generation.load();
+    if (generation == 0 || (generation & 1) != 0)
+      continue;
+    const uint32_t xid = transaction.xid.load(), seen = transaction.seen.load();
+    const uint32_t low = transaction.mac_low.load(), high = transaction.mac_high.load();
+    if (transaction.generation.load() == generation && xid == message.xid && low == mac_low && high == mac_high &&
+        uint32_t(now_ms() - seen) < DHCP_TRANSACTION_MS) {
+      if (peer_epoch != nullptr)
+        *peer_epoch = epoch;
+      if (message.type == 5 && transaction.request_type.load() == 3) {
+        // Client proof requests must refer to a real server ACK observed here,
+        // never merely an offered address or a mesh client's chosen address.
+        const uint32_t candidate = message.offered_address != 0 ? message.offered_address : message.client_address;
+        DhcpOwnership &ownership = this->dhcp_ownership_[i];
+        if (((ownership.revoked.load() || this->gateway_candidates_ != 0) &&
+             (ownership.revoked_xid.load() == message.xid || ownership.revoked_lease_xid.load() == message.xid)) ||
+            message.lifetime_seconds < 4)
+          return i + 1;
+        if (ownership.generation.load() == 0 || ownership.xid.load() != message.xid) {
+          RemoteWitness &remote = this->remote_witnesses_[i];
+          if (remote.address.load() != lwip_ntohl(candidate))
+            remote.active.store(false);
+          ownership.generation.fetch_add(1);
+          ownership.address.store(lwip_ntohl(candidate));
+          ownership.xid.store(message.xid);
+          ownership.seconds.store(message.lifetime_seconds);
+          // SDK uptime is monotonic 64-bit; floor to seconds at ACK reception.
+          // Never mistake a concurrent reconstructed-clock update for expiry.
+          ownership.started.store(now_seconds());
+          ownership.local.store(true);
+          ownership.generation.fetch_add(1);
+          ownership.revoked.store(false);
+          ownership.active.store(true);
+          if (this->gateway_candidates_ != 0 && this->peers_[i].ip.load() != lwip_ntohl(candidate)) {
+            // Same-IP renewal changes evidence, not the established grant.
+            // A different address invalidates old proxy ownership immediately.
+            this->peers_[i].fallback.store(false);
+            this->peers_[i].endpoint.store(false);
+          }
+          this->schedule_();
+        } else if (ownership.address.load() == lwip_ntohl(candidate)) {
+          // An imported witness may precede our own copy of the same ACK.
+          // Mark real local observation without moving its existing deadline.
+          ownership.local.store(true);
+        } else {
+          return i + 1;  // Same transaction cannot silently change its address.
+        }
+        transaction.candidate_address.store(lwip_ntohl(candidate));
+        transaction.candidate_xid.store(message.xid);
+      } else if (message.type == 6) {
+        this->dhcp_ownership_[i].revoked_xid.store(message.xid);
+        this->dhcp_ownership_[i].revoked_lease_xid.store(this->peers_[i].lease_id.load());
+        this->dhcp_ownership_[i].revoked.store(true);
+        this->dhcp_ownership_[i].active.store(false);
+        this->peers_[i].fallback.store(false);
+        this->peers_[i].endpoint.store(false);
+        this->remote_witnesses_[i].active.store(false);
+        transaction.candidate_xid.store(0);
+        transaction.candidate_address.store(0);
+      }
+      return i + 1;
+    }
+  }
+  return 0;
+}
+#endif
+
+#ifndef MESH_IP_CLIENT_ONLY
+bool MeshIpNetif::capture_dhcp_reply_(struct pbuf *packet, uint16_t length) {
+  const uint32_t generation = this->gateway_generation_.load();
+  if (!this->gateway_active_() || length > MAX_PACKET_SIZE || length < 268)
+    return false;
+  if (this->driver_tx_busy_.exchange(true)) {
+    this->queue_drops_.fetch_add(1);
+    return false;
+  }
+  // Observe the ACK/NAK independently of TX admission, including when every
+  // queue slot is occupied. Parse the pbuf in place instead of retaining a
+  // second complete packet solely for DHCP inspection.
+  const PbufPacketView view{packet, 14, length};
+  const PacketReader reader{&view, read_pbuf_packet};
+  DhcpMessage message;
+  uint8_t destination = 0;
+  uint32_t peer_epoch = 0;
+  if (parse_dhcp_reply(reader, length, message))
+    destination = this->dhcp_destination_(message, &peer_epoch);
+  if (destination != 0) {
+    IpFlowQueue::Key key;
+    key.source = lwip_ntohl(message.source);
+    key.target = lwip_ntohl(message.destination);
+    key.source_port = 67;
+    key.target_port = 68;
+    key.protocol = 17;
+    key.destination = destination;
+    IpFlowQueue::Reservation reservation;
+    IpPacket *outgoing = this->reserve_outgoing_(key, reservation);
+    bool queued = false;
+    if (outgoing != nullptr) {
+      outgoing->generation = generation;
+      outgoing->destination = destination;
+      outgoing->peer_epoch = peer_epoch;
+      outgoing->ingress_source = 0;
+      outgoing->ingress_epoch = 0;
+      outgoing->gateway_ingress = false;
+      outgoing->length = length;
+      const bool copied = pbuf_copy_partial(packet, outgoing->data, length, 14) == length;
+      queued = this->commit_outgoing_(reservation, copied);
+    }
+    if (queued)
+      this->mesh_tx_.fetch_add(1);
+    else
+      this->queue_drops_.fetch_add(1);
+  }
+  this->driver_tx_busy_.store(false);
+  return destination != 0;
+}
+#endif
+
+bool MeshIpNetif::set_peer(uint8_t node_id, uint32_t ip, bool fallback) {
+#ifdef MESH_IP_CLIENT_ONLY
+  (void) node_id;
+  (void) ip;
+  (void) fallback;
+  return false;
+#else
+  if (this->gateway_candidates_ != 0) {
+    // Legacy status packets carry no challenge or lease identity. They may
+    // withdraw a route but never establish/refresh endpoint authorization.
+    if (node_id == 0 || node_id > mesh_limits::MAX_NODES || node_id == this->node_id_ || fallback)
+      return false;
+    return this->withdraw_endpoint(node_id);
+  }
+  if (!this->gateway_active_() || !this->valid_peer_address_(node_id, ip) ||
+      (fallback && !this->gateway_lease_valid_(node_id, ip))) {
+    this->invalid_packets_.fetch_add(1);
+    return false;
+  }
+  Peer &peer = this->peers_[node_id - 1];
+  peer.ip.store(ip);
+  peer.seen.store(now_ms());
+  peer.fallback.store(fallback);
+  this->schedule_();
+  return true;
+#endif
+}
+
+bool MeshIpNetif::local_lease_witness(uint8_t node_id, uint32_t &address, uint32_t &xid,
+                                      uint32_t &remaining_seconds) const {
+#ifdef MESH_IP_CLIENT_ONLY
+  (void) node_id;
+  (void) address;
+  (void) xid;
+  (void) remaining_seconds;
+  return false;
+#else
+  if (!this->configured_.load() || node_id == 0 || node_id > mesh_limits::MAX_NODES || node_id == this->node_id_ ||
+      (this->dhcp_peer_mac_mask_ & (1U << (node_id - 1))) == 0)
+    return false;
+  const DhcpOwnership &ownership = this->dhcp_ownership_[node_id - 1];
+  const uint32_t generation = ownership.generation.load();
+  const uint32_t ip = ownership.address.load(), transaction = ownership.xid.load();
+  uint32_t remaining;
+  if (generation == 0 || (generation & 1) != 0 || !ownership.local.load() || !this->valid_peer_address_(node_id, ip) ||
+      !this->witness_remaining_(node_id, ip, transaction, remaining))
+    return false;
+  // Uptime-second fractions differ between devices. Deduct one conservative
+  // second rather than exporting an expiry later than this observation.
+  if (remaining != UINT32_MAX) {
+    if (remaining <= 1)
+      return false;
+    remaining--;
+  }
+  if (ownership.generation.load() != generation || !ownership.local.load() || !ownership.active.load() ||
+      ownership.revoked.load())
+    return false;
+  address = ip;
+  xid = transaction;
+  remaining_seconds = remaining;
+  return true;
+#endif
+}
+
+bool MeshIpNetif::install_peer_witness(uint8_t node_id, uint32_t address, uint32_t xid, uint32_t remaining_seconds) {
+#ifdef MESH_IP_CLIENT_ONLY
+  (void) node_id;
+  (void) address;
+  (void) xid;
+  (void) remaining_seconds;
+  return false;
+#else
+  if (!this->configured_.load() || this->gateway_candidates_ == 0 || !this->candidate_(this->node_id_) ||
+      node_id == 0 || node_id > mesh_limits::MAX_NODES || node_id == this->node_id_ || xid == 0 ||
+      remaining_seconds == 0 || (this->dhcp_peer_mac_mask_ & (1U << (node_id - 1))) == 0 ||
+      !this->valid_peer_address_(node_id, address) || this->driver_tx_busy_.exchange(true))
+    return false;
+  const DhcpOwnership &local = this->dhcp_ownership_[node_id - 1];
+  const Peer &peer = this->peers_[node_id - 1];
+  RemoteWitness &remote = this->remote_witnesses_[node_id - 1];
+  const bool same = remote.generation.load() != 0 && remote.address.load() == address && remote.xid.load() == xid;
+  const uint32_t now = now_seconds();
+  const uint32_t lifetime = remote.seconds.load(), elapsed = uint32_t(now - remote.started.load());
+  if ((peer.identity_known.load() && (peer.desired_address.load() != address || peer.desired_xid.load() != xid)) ||
+      (local.revoked_xid.load() == xid || local.revoked_lease_xid.load() == xid) ||
+      (same && (!remote.active.load() || (lifetime != UINT32_MAX && elapsed >= lifetime)))) {
+    this->driver_tx_busy_.store(false);
+    return false;
+  }
+  if (same) {
+    if (remaining_seconds != UINT32_MAX && (lifetime == UINT32_MAX || remaining_seconds < lifetime - elapsed)) {
+      remote.generation.fetch_add(1);
+      remote.started.store(now);
+      remote.seconds.store(remaining_seconds);
+      remote.generation.fetch_add(1);
+    }
+  } else {
+    remote.generation.fetch_add(1);
+    remote.active.store(false);
+    remote.address.store(address);
+    remote.xid.store(xid);
+    remote.seconds.store(remaining_seconds);
+    remote.started.store(now);
+    remote.generation.fetch_add(1);
+    remote.active.store(true);
+  }
+  // Importing competing gateway evidence never edits local ACK evidence or an
+  // established endpoint grant. Only a fresh client challenge selects a token.
+  this->driver_tx_busy_.store(false);
+  this->schedule_();
+  return true;
+#endif
+}
+
+bool MeshIpNetif::authorize_endpoint(uint8_t node_id, uint32_t address, uint32_t lease_id, uint32_t remaining_seconds,
+                                     uint32_t fresh_budget_ms) {
+#ifdef MESH_IP_CLIENT_ONLY
+  (void) node_id;
+  (void) address;
+  (void) lease_id;
+  (void) remaining_seconds;
+  (void) fresh_budget_ms;
+  return false;
+#else
+  if (!this->configured_.load() || this->gateway_candidates_ == 0 || !this->gateway_active_() || node_id == 0 ||
+      node_id > mesh_limits::MAX_NODES || node_id == this->node_id_ || lease_id == 0 || remaining_seconds == 0 ||
+      fresh_budget_ms == 0 || fresh_budget_ms > PEER_LEASE_MS ||
+      (this->dhcp_peer_mac_mask_ & (1U << (node_id - 1))) == 0 || !this->valid_peer_address_(node_id, address) ||
+      this->driver_tx_busy_.exchange(true))
+    return false;
+  Peer &peer = this->peers_[node_id - 1];
+  peer.desired_address.store(address);
+  peer.desired_xid.store(lease_id);
+  peer.identity_known.store(true);
+  // A freshly proved address change retires occupancy of the old IP as well
+  // as its forwarding grant. Keep ACK evidence fields for stale-token fencing,
+  // but do not block the router's legitimate reassignment to another node.
+  DhcpOwnership &local = this->dhcp_ownership_[node_id - 1];
+  RemoteWitness &remote = this->remote_witnesses_[node_id - 1];
+  if (local.address.load() != address)
+    local.active.store(false);
+  if (remote.address.load() != address)
+    remote.active.store(false);
+  if (peer.ip.load() != address) {
+    // A fresh client proof for another address immediately retires the old IP,
+    // even if the new witness has not reached this gateway yet.
+    peer.fallback.store(false);
+    peer.endpoint.store(false);
+  }
+  uint32_t witness_remaining;
+  if (!this->witness_remaining_(node_id, address, lease_id, witness_remaining)) {
+    this->driver_tx_busy_.store(false);
+    this->schedule_();
+    return false;
+  }
+  const uint32_t now = now_seconds();
+  uint32_t lifetime = std::min(remaining_seconds, witness_remaining);
+  if (peer.generation.load() != 0 && peer.ip.load() == address && peer.lease_id.load() == lease_id) {
+    const uint32_t old_lifetime = peer.lease_seconds.load(), elapsed = uint32_t(now - peer.lease_started.load());
+    // Repeated challenge replies renew reachability, never the original lease.
+    if (old_lifetime != UINT32_MAX) {
+      if (elapsed >= old_lifetime) {
+        this->driver_tx_busy_.store(false);
+        return false;
+      }
+      lifetime = std::min(lifetime, old_lifetime - elapsed);
+    }
+  }
+  uint32_t budget = fresh_budget_ms;
+  if (lifetime < PEER_LEASE_MS / 1000)
+    budget = std::min(budget, lifetime * 1000);
+  peer.generation.fetch_add(1);
+  peer.fallback.store(false);
+  peer.endpoint.store(true);
+  peer.lease_id.store(lease_id);
+  peer.ip.store(address);
+  peer.lease_seconds.store(lifetime);
+  peer.lease_started.store(now);
+  peer.seen.store(now_ms() - (PEER_LEASE_MS - budget));
+  peer.generation.fetch_add(1);
+  peer.fallback.store(true);
+  this->driver_tx_busy_.store(false);
+  this->schedule_();
+  return true;
+#endif
+}
+
+bool MeshIpNetif::has_lease_witness(uint8_t node_id, uint32_t address, uint32_t xid) const {
+#ifdef MESH_IP_CLIENT_ONLY
+  (void) node_id;
+  (void) address;
+  (void) xid;
+  return false;
+#else
+  if (!this->configured_.load() || this->gateway_candidates_ == 0 || !this->gateway_active_() || node_id == 0 ||
+      node_id > mesh_limits::MAX_NODES || node_id == this->node_id_ ||
+      (this->dhcp_peer_mac_mask_ & (1U << (node_id - 1))) == 0 || !this->valid_peer_address_(node_id, address))
+    return false;
+  uint32_t remaining;
+  return this->witness_remaining_(node_id, address, xid, remaining);
+#endif
+}
+
+bool MeshIpNetif::withdraw_endpoint(uint8_t node_id) {
+#ifdef MESH_IP_CLIENT_ONLY
+  (void) node_id;
+  return false;
+#else
+  if (!this->configured_.load() || node_id == 0 || node_id > mesh_limits::MAX_NODES || node_id == this->node_id_ ||
+      !this->peer_current_(node_id) || (this->dhcp_peer_mac_mask_ & (1U << (node_id - 1))) == 0 ||
+      this->driver_tx_busy_.exchange(true))
+    return false;
+  this->peers_[node_id - 1].fallback.store(false);
+  this->peers_[node_id - 1].endpoint.store(false);
+  this->driver_tx_busy_.store(false);
+  this->schedule_();
+  return true;
+#endif
+}
+
+bool MeshIpNetif::revoke_peer(uint8_t node_id, uint32_t address, uint32_t lease_xid) {
+#ifdef MESH_IP_CLIENT_ONLY
+  (void) node_id;
+  (void) address;
+  (void) lease_xid;
+  return false;
+#else
+  if (!this->configured_.load() || node_id == 0 || node_id > mesh_limits::MAX_NODES || node_id == this->node_id_ ||
+      !this->peer_current_(node_id) || (this->dhcp_peer_mac_mask_ & (1U << (node_id - 1))) == 0 ||
+      !unicast_address_(address))
+    return false;
+  if (this->driver_tx_busy_.exchange(true))
+    return false;
+  Peer &peer = this->peers_[node_id - 1];
+  DhcpOwnership &ownership = this->dhcp_ownership_[node_id - 1];
+  const uint32_t cached = ownership.address.load() != 0 ? ownership.address.load() : peer.ip.load();
+  if ((cached != 0 && cached != address) || (ownership.generation.load() != 0 && ownership.xid.load() != lease_xid)) {
+    this->driver_tx_busy_.store(false);
+    return false;
+  }
+  // Keep the address as a tombstone, so duplicate releases remain idempotent
+  // and late heartbeats cannot turn the old lease back into live proxying.
+  ownership.managed.store(true);
+  ownership.revoked_xid.store(this->dhcp_transactions_[node_id - 1].xid.load());
+  ownership.revoked_lease_xid.store(lease_xid);
+  ownership.revoked.store(true);
+  ownership.active.store(false);
+  peer.fallback.store(false);
+  peer.endpoint.store(false);
+  this->remote_witnesses_[node_id - 1].active.store(false);
+  this->lease_probes_[node_id - 1].phase.store(0);
+  this->dhcp_transactions_[node_id - 1].candidate_xid.store(0);
+  this->dhcp_transactions_[node_id - 1].candidate_address.store(0);
+  this->driver_tx_busy_.store(false);
+  this->schedule_();
+  return true;
+#endif
+}
+
+uint32_t MeshIpNetif::peer_mesh_address(uint8_t node_id) const {
+#ifdef MESH_IP_CLIENT_ONLY
+  (void) node_id;
+  return 0;
+#else
+  if (node_id == 0 || node_id > mesh_limits::MAX_NODES || !this->gateway_active_() ||
+      !this->station_connected_.load() || !this->available_.load())
+    return 0;
+  const auto &peer = this->peers_[node_id - 1];
+  const uint32_t address = peer.ip.load();
+  // Load the worker's timestamp BEFORE sampling time. A newly published stamp
+  // must not underflow against an earlier captured clock and appear expired.
+  const uint32_t seen = peer.seen.load();
+  const uint32_t now = now_ms();
+  if (!peer.fallback.load() || uint32_t(now - seen) >= PEER_LEASE_MS ||
+      (this->gateway_candidates_ == 0 ? !this->gateway_lease_valid_(node_id, address)
+                                      : !this->endpoint_lease_valid_(node_id, address)))
+    return 0;
+  return this->peer_for_ip_(address, true) == node_id ? address : 0;
+#endif
+}
+
+bool MeshIpNetif::has_active_mesh_clients() const {
+#ifndef MESH_IP_CLIENT_ONLY
+  if (!this->gateway_active_())
+    return false;
+  for (uint8_t node = 1; node <= mesh_limits::MAX_NODES; ++node) {
+    if (this->peer_mesh_address(node) != 0)
+      return true;
+#ifdef MESH_IPV6
+    if (this->ipv6_peer_active_(node))
+      return true;
+#endif
+  }
+#endif
+  return false;
+}
+
+bool MeshIpNetif::unicast_address_(uint32_t address) {
+  const uint32_t host = lwip_ntohl(address);
+  return host != 0 && host != 0xffffffffU && (host >> 24) != 0 && (host >> 24) != 127 && (host >> 28) < 14;
+}
+
+#ifndef MESH_IP_CLIENT_ONLY
+bool MeshIpNetif::valid_peer_address_(uint8_t node_id, uint32_t ip) const {
+  const uint32_t own = this->address_.load();
+  const uint32_t mask = this->mask_.load();
+  const uint32_t host_mask = ~lwip_ntohl(mask);
+  const uint32_t host_part = lwip_ntohl(ip) & host_mask;
+  if (node_id == 0 || node_id > mesh_limits::MAX_NODES || node_id == this->node_id_ || !unicast_address_(ip) ||
+      own == 0 || !this->peer_current_(node_id) || mask == 0 || host_mask == 0 || (host_mask & (host_mask + 1)) != 0 ||
+      (ip & mask) != (own & mask) || host_part == 0 || host_part == host_mask || ip == own ||
+      ip == this->gateway_.load())
+    return false;
+  for (size_t i = 0; i < mesh_limits::MAX_NODES; i++) {
+    if (i + 1 == node_id)
+      continue;
+    if (this->gateway_candidates_ == 0) {
+      if (this->peers_[i].ip.load() == ip && this->gateway_lease_valid_(i + 1, ip))
+        return false;
+    } else {
+      uint32_t remaining;
+      if ((this->peers_[i].ip.load() == ip && this->endpoint_lease_valid_(i + 1, ip)) ||
+          (this->dhcp_ownership_[i].address.load() == ip && this->gateway_lease_valid_(i + 1, ip)) ||
+          (this->remote_witnesses_[i].address.load() == ip &&
+           this->witness_remaining_(i + 1, ip, this->remote_witnesses_[i].xid.load(), remaining)))
+        return false;
+    }
+  }
+  return true;
+}
+#endif
+
+void MeshIpNetif::set_transport_wake(void *context, void (*wake)(void *)) {
+  portENTER_CRITICAL(&this->tx_lock_);
+  this->transport_wake_context_ = context;
+  this->transport_wake_ = wake;
+  portEXIT_CRITICAL(&this->tx_lock_);
+}
+
+bool MeshIpNetif::consume_outgoing(uint8_t *target, size_t capacity, QueuedIpMetadata &metadata) {
+  metadata = {};
+  if (target == nullptr || capacity < MAX_PACKET_SIZE)
+    return false;
+  if (!this->configured_.load() || !this->transport_current_() || (!this->role_current_() && !this->gateway_active_()))
+    return false;
+  while (true) {
+    portENTER_CRITICAL(&this->tx_lock_);
+    const bool popped = this->tx_flows_.consume(target, capacity, metadata);
+    portEXIT_CRITICAL(&this->tx_lock_);
+    if (!popped) {
+      metadata = {};
+      return false;
+    }
+    if (metadata.generation == this->gateway_generation_.load() &&
+        this->peer_epoch_current_(metadata.destination, metadata.peer_epoch) &&
+        (metadata.ingress_source == 0 || this->peer_epoch_current_(metadata.ingress_source, metadata.ingress_epoch)))
+      return true;
+  }
+}
+
+bool MeshIpNetif::pop_outgoing(IpPacket &packet) {
+  QueuedIpMetadata metadata;
+  if (!this->consume_outgoing(packet.data, sizeof(packet.data), metadata))
+    return false;
+  packet.generation = metadata.generation;
+  packet.peer_epoch = metadata.peer_epoch;
+  packet.ingress_epoch = metadata.ingress_epoch;
+  packet.destination = metadata.destination;
+  packet.ingress_source = metadata.ingress_source;
+  packet.gateway_ingress = metadata.gateway_ingress;
+  packet.length = metadata.length;
+  return true;
+}
+
+bool MeshIpNetif::valid_ipv4_(const uint8_t *packet, size_t length) {
+  if (packet == nullptr || length < 20 || length > MAX_PACKET_SIZE || (packet[0] >> 4) != 4)
+    return false;
+  const size_t header_length = (packet[0] & 15) * 4;
+  if (header_length < 20 || header_length > length || read_be16(packet + 2) != length)
+    return false;
+  uint32_t checksum = 0;
+  for (size_t i = 0; i < header_length; i += 2)
+    checksum += read_be16(packet + i);
+  checksum = (checksum & 0xffffU) + (checksum >> 16);
+  checksum = (checksum & 0xffffU) + (checksum >> 16);
+  return checksum == 0xffffU;
+}
+
+bool MeshIpNetif::deliver_mesh(uint8_t source, const uint8_t *packet, size_t length) {
+#ifdef MESH_IPV6
+  if (packet != nullptr && length >= 40 && (packet[0] >> 4) == 6)
+    return this->deliver_ipv6_(source, packet, length);
+#endif
+  return this->deliver_ipv4_(source, packet, length);
+}
+
+bool MeshIpNetif::deliver_ipv4_(uint8_t source, const uint8_t *packet, size_t length) {
+  const uint32_t generation = this->gateway_generation_.load();
+  const uint32_t peer_epoch =
+      source != 0 && source <= mesh_limits::MAX_NODES ? this->identity_requests_[source - 1].epoch.load() : 0;
+  if (!this->configured_.load() || !this->transport_current_() ||
+      (!this->role_current_() && !this->gateway_active_()) || source == 0 || source > mesh_limits::MAX_NODES ||
+      source == this->node_id_ || !this->peer_epoch_current_(source, peer_epoch) || !valid_ipv4_(packet, length)) {
+    this->invalid_packets_.fetch_add(1);
+    return false;
+  }
+  const uint32_t source_ip = read_address(packet + 12);
+  const uint32_t destination_ip = read_address(packet + 16);
+  const uint32_t mask = this->mask_.load();
+#ifdef MESH_IP_CLIENT_ONLY
+  const bool bootstrap = false;
+#else
+  const bool bootstrap = this->gateway_active_() && this->valid_dhcp_request_(source, packet, length);
+  const size_t header_length = (packet[0] & 15) * 4;
+  const bool dhcp_port_pair = packet[9] == 17 && length >= header_length + 8 &&
+                              read_be16(packet + header_length) == 68 && read_be16(packet + header_length + 2) == 67;
+  if (this->gateway_active_() && dhcp_port_pair && !bootstrap) {
+    // Malformed/spoofed unicast renewals must not bypass DHCP validation by
+    // falling through to ordinary traffic with a previously advertised IP.
+    this->invalid_packets_.fetch_add(1);
+    return false;
+  }
+#endif
+  bool gateway_ingress = bootstrap;
+#ifndef MESH_IP_CLIENT_ONLY
+  gateway_ingress |= this->gateway_source_valid_(source, source_ip);
+#endif
+  if (!bootstrap) {
+    // No cached address or advertisement is required for validated DHCP. All
+    // other zero-source/broadcast traffic remains excluded from this tunnel.
+    if (!unicast_address_(source_ip) || !unicast_address_(destination_ip) ||
+        (mask != 0 && (destination_ip & mask) == (this->address_.load() & mask) &&
+         ((destination_ip | mask) == 0xffffffffU || (destination_ip & ~mask) == 0))) {
+      this->invalid_packets_.fetch_add(1);
+      return false;
+    }
+    // The encrypted mesh authenticates the node ID. Bind that ID to its
+    // advertised source IP; accept gateway traffic only for this client's IP.
+    const bool from_gateway = this->gateway_candidates_ != 0 ? this->candidate_(source) : source == this->gateway_id_;
+    if (!gateway_ingress && (!from_gateway || destination_ip != this->address_.load() ||
+                             (!this->station_connected_.load() && !this->mesh_path_validated_.load()))) {
+      this->invalid_packets_.fetch_add(1);
+      return false;
+    }
+  }
+  IpPacket incoming;
+  incoming.generation = generation;
+  incoming.gateway_ingress = gateway_ingress;
+  incoming.destination = source;
+  incoming.peer_epoch = peer_epoch;
+  incoming.length = length;
+  std::memcpy(incoming.data, packet, length);
+  if (xQueueSend(this->rx_queue_, &incoming, 0) != pdTRUE) {
+    this->queue_drops_.fetch_add(1);
+    return false;
+  }
+  this->schedule_();
+  return true;
+}
+
+MeshIpNetif::IpPacket *MeshIpNetif::reserve_outgoing_(const IpFlowQueue::Key &key,
+                                                      IpFlowQueue::Reservation &reservation) {
+  // Only queue metadata is locked. Each admitted writer owns its unpublished
+  // slot, so full pbuf/memcpy payload copies do not stall the other producers.
+  portENTER_CRITICAL(&this->tx_lock_);
+  const auto admitted = this->tx_flows_.reserve(key, reservation);
+  IpPacket *packet =
+      admitted == IpFlowQueue::Admission::ACCEPTED ? this->tx_flows_.reserved_packet(reservation) : nullptr;
+  portEXIT_CRITICAL(&this->tx_lock_);
+  if (admitted == IpFlowQueue::Admission::FLOW_LIMIT)
+    this->flow_backpressure_.fetch_add(1);
+  return packet;
+}
+
+bool MeshIpNetif::commit_outgoing_(const IpFlowQueue::Reservation &reservation, bool publish) {
+  portENTER_CRITICAL(&this->tx_lock_);
+  const IpPacket *packet = this->tx_flows_.reserved_packet(reservation);
+  const bool current =
+      publish && packet != nullptr && packet->generation == this->gateway_generation_.load() &&
+      this->transport_current_() && (this->role_current_() || this->gateway_active_()) &&
+      this->peer_epoch_current_(packet->destination, packet->peer_epoch) &&
+      (packet->ingress_source == 0 || this->peer_epoch_current_(packet->ingress_source, packet->ingress_epoch));
+  const bool committed = current && this->tx_flows_.commit(reservation);
+  if (!committed)
+    this->tx_flows_.cancel(reservation);
+  const auto wake = committed ? this->transport_wake_ : nullptr;
+  void *const wake_context = this->transport_wake_context_;
+  portEXIT_CRITICAL(&this->tx_lock_);
+  // Publish the complete packet before waking its consumer. The notification
+  // must never run inside the queue's metadata critical section.
+  if (wake != nullptr)
+    wake(wake_context);
+  return committed;
+}
+
+bool MeshIpNetif::enqueue_(uint8_t destination, const uint8_t *packet, size_t length, bool count_rejection,
+                           uint8_t ingress_source, uint32_t ingress_epoch) {
+  const uint32_t generation = this->gateway_generation_.load();
+  const uint32_t peer_epoch = destination != 0 && destination <= mesh_limits::MAX_NODES
+                                  ? this->identity_requests_[destination - 1].epoch.load()
+                                  : 0;
+  if (!this->transport_current_() || (!this->role_current_() && !this->gateway_active_()) ||
+      !this->peer_epoch_current_(destination, peer_epoch) ||
+      (ingress_source != 0 && !this->peer_epoch_current_(ingress_source, ingress_epoch)) ||
+      (!valid_ipv4_(packet, length)
+#ifdef MESH_IPV6
+       && !([&]() {
+            Ipv6PacketInfo info;
+            return inspect_ipv6(packet, length, info);
+          })()
+#endif
+           )) {
+    this->invalid_packets_.fetch_add(1);
+    return false;
+  }
+  IpFlowQueue::Reservation reservation;
+  IpPacket *outgoing = this->reserve_outgoing_(IpFlowQueue::classify(destination, packet, length), reservation);
+  if (outgoing == nullptr) {
+    if (count_rejection)
+      this->queue_drops_.fetch_add(1);
+    return false;
+  }
+  outgoing->generation = generation;
+  outgoing->destination = destination;
+  outgoing->peer_epoch = peer_epoch;
+  outgoing->ingress_source = ingress_source;
+  outgoing->ingress_epoch = ingress_epoch;
+  outgoing->gateway_ingress = false;
+  outgoing->length = length;
+  std::memcpy(outgoing->data, packet, length);
+  if (!this->commit_outgoing_(reservation)) {
+    if (count_rejection)
+      this->queue_drops_.fetch_add(1);
+    return false;
+  }
+  this->mesh_tx_.fetch_add(1);
+  return true;
+}
+
+bool MeshIpNetif::enqueue_(uint8_t destination, struct pbuf *packet, uint16_t offset, uint16_t length,
+                           bool from_driver) {
+  const uint32_t generation = this->gateway_generation_.load();
+  const uint32_t peer_epoch = destination != 0 && destination <= mesh_limits::MAX_NODES
+                                  ? this->identity_requests_[destination - 1].epoch.load()
+                                  : 0;
+  if (!this->transport_current_() || (!this->role_current_() && !this->gateway_active_()) ||
+      !this->peer_epoch_current_(destination, peer_epoch) || packet == nullptr || offset > packet->tot_len ||
+      length > packet->tot_len - offset || length > MAX_PACKET_SIZE || length < 20) {
+    this->invalid_packets_.fetch_add(1);
+    return false;
+  }
+#ifdef MESH_IP_CLIENT_ONLY
+  if (from_driver)
+    return false;
+#else
+  if (from_driver && this->driver_tx_busy_.exchange(true)) {
+    this->queue_drops_.fetch_add(1);
+    return false;
+  }
+#endif
+  uint8_t header[64];
+  const uint16_t header_bytes = std::min<size_t>(sizeof(header), length);
+  bool queued = false;
+  if (pbuf_copy_partial(packet, header, header_bytes, offset) != header_bytes || !valid_ipv4_(header, length)
+#ifndef MESH_IP_CLIENT_ONLY
+      || (from_driver && this->peer_for_ip_(read_address(header + 16), false) != destination)
+#endif
+  ) {
+    this->invalid_packets_.fetch_add(1);
+  } else {
+    IpFlowQueue::Reservation reservation;
+    IpPacket *outgoing = this->reserve_outgoing_(IpFlowQueue::classify(destination, header, header_bytes), reservation);
+    if (outgoing != nullptr) {
+      outgoing->generation = generation;
+      outgoing->destination = destination;
+      outgoing->peer_epoch = peer_epoch;
+      outgoing->ingress_source = 0;
+      outgoing->ingress_epoch = 0;
+      outgoing->gateway_ingress = false;
+      outgoing->length = length;
+      const bool copied = pbuf_copy_partial(packet, outgoing->data, length, offset) == length;
+      queued = this->commit_outgoing_(reservation, copied);
+    }
+    if (queued)
+      this->mesh_tx_.fetch_add(1);
+    else
+      this->queue_drops_.fetch_add(1);
+  }
+#ifndef MESH_IP_CLIENT_ONLY
+  if (from_driver)
+    this->driver_tx_busy_.store(false);
+#endif
+  return queued;
+}
+
+#ifndef MESH_IP_CLIENT_ONLY
+uint8_t MeshIpNetif::peer_for_ip_(uint32_t ip, bool require_fallback) const {
+  if (!this->gateway_active_() || !unicast_address_(ip))
+    return 0;
+  for (size_t i = 0; i < mesh_limits::MAX_NODES; i++) {
+    const Peer &peer = this->peers_[i];
+    const uint32_t seen = peer.seen.load();
+    const uint32_t now = now_ms();
+    if (peer.ip.load() == ip && uint32_t(now - seen) < PEER_LEASE_MS && this->gateway_source_valid_(i + 1, ip) &&
+        (!require_fallback || peer.fallback.load()))
+      return i + 1;
+  }
+  return 0;
+}
+#endif
+
+err_t MeshIpNetif::netif_init_(struct netif *netif) {
+  netif->name[0] = 'm';
+  netif->name[1] = 's';
+  netif->mtu = 1280;
+  netif->flags = 0;  // Raw IP, without Ethernet/ARP or broadcast handling.
+  netif->output = netif_output_;
+#ifdef MESH_IPV6
+  netif->output_ip6 = netif_output_ipv6_;
+  netif->flags |= NETIF_FLAG_MLD6;
+#endif
+  return ERR_OK;
+}
+
+err_t MeshIpNetif::netif_output_(struct netif *netif, struct pbuf *packet, const ip4_addr_t *destination) {
+  auto *self = instance_;
+  if (self == nullptr || netif != &self->virtual_netif_ || !self->available_.load())
+    return ERR_RTE;
+  // IDF's source-address route hook can choose this /32 alias ahead of STA even
+  // while STA is connected. Preserve direct Wi-Fi for such packets rather than
+  // accidentally tunnelling normal traffic (or dropping gateway responses).
+  struct netif *station = self->station_netif_;
+  if (station != nullptr && self->station_connected_.load() && netif_is_up(station) && netif_is_link_up(station) &&
+      netif_ip4_addr(station)->addr == self->address_.load() && station->output != nullptr)
+    return station->output(station, packet, destination);
+  if (!self->role_current_() || !self->mesh_path_validated_.load() || self->node_id_ == self->gateway_id_)
+    return ERR_RTE;
+  return self->enqueue_(self->gateway_id_, packet, 0, packet->tot_len) ? ERR_OK : ERR_MEM;
+}
+
+#ifndef MESH_IP_CLIENT_ONLY
+err_t MeshIpNetif::station_output_(struct netif *netif, struct pbuf *packet, const ip4_addr_t *destination) {
+  auto *self = instance_;
+  if (self == nullptr || self->station_netif_ != netif || self->original_station_output_ == nullptr)
+    return ERR_IF;
+  const uint8_t peer = self->peer_for_ip_(destination->addr, true);
+  if (peer != 0)
+    return self->enqueue_(peer, packet, 0, packet->tot_len) ? ERR_OK : ERR_MEM;
+  return self->original_station_output_(netif, packet, destination);
+}
+#endif
+
+#ifndef MESH_IP_CLIENT_ONLY
+err_t MeshIpNetif::station_input_(struct pbuf *packet, struct netif *netif) {
+#ifdef MESH_HAS_ETHERNET
+  // Use lwIP's normal input mailbox and retain the pbuf, with no packet copy.
+  // Queued input and interface changes then have the same TCP/IP owner.
+  return tcpip_inpkt(packet, netif, lan_input_);
+}
+
+err_t MeshIpNetif::lan_input_(struct pbuf *packet, struct netif *netif) {
+#endif
+  auto *self = instance_;
+#ifdef MESH_HAS_ETHERNET
+  if (self == nullptr || self->station_netif_ != netif || !self->transport_current_())
+    return ethernet_input(packet, netif);
+#else
+  if (self == nullptr || self->station_netif_ != netif || self->original_station_input_ == nullptr)
+    return ERR_IF;
+#endif
+#ifdef MESH_IPV6
+  bool consume_ipv6 = false;
+  self->station_input_ipv6_(packet, consume_ipv6);
+  if (consume_ipv6) {
+    pbuf_free(packet);
+    return ERR_OK;
+  }
+#endif
+  if (!self->gateway_active_())
+#ifdef MESH_HAS_ETHERNET
+    return ethernet_input(packet, netif);
+#else
+    return self->original_station_input_(packet, netif);
+#endif
+  uint8_t header[42];
+  const uint16_t copied = pbuf_copy_partial(packet, header, sizeof(header), 0);
+  if (copied >= 34 && read_be16(header + 12) == 0x0800) {
+    const uint16_t length = read_be16(header + 16);
+    const uint16_t header_length = (header[14] & 15) * 4;
+    uint8_t ports[4];
+    const bool dhcp = header[23] == 17 && header_length >= 20 &&
+                      pbuf_copy_partial(packet, ports, sizeof(ports), 14 + header_length) == sizeof(ports) &&
+                      read_be16(ports) == 67 && read_be16(ports + 2) == 68;
+    if (dhcp && length <= packet->tot_len - 14 && self->capture_dhcp_reply_(packet, length)) {
+      pbuf_free(packet);
+      return ERR_OK;
+    }
+    const uint8_t destination = self->peer_for_ip_(read_address(header + 30), false);
+    if (destination != 0) {
+      if (length <= packet->tot_len - 14)
+        self->enqueue_(destination, packet, 14, length, true);
+      else
+        self->invalid_packets_.fetch_add(1);
+      pbuf_free(packet);
+      return ERR_OK;
+    }
+  } else if (copied == sizeof(header) && read_be16(header + 12) == 0x0806 && read_be16(header + 14) == 1 &&
+             read_be16(header + 16) == 0x0800 && header[18] == 6 && header[19] == 4 &&
+             (read_be16(header + 20) == 1 || read_be16(header + 20) == 2)) {
+    self->observe_probe_arp_(header);
+    if (read_be16(header + 20) != 1)
+#ifdef MESH_HAS_ETHERNET
+      return ethernet_input(packet, netif);
+#else
+      return self->original_station_input_(packet, netif);
+#endif
+    const uint32_t claimed = read_address(header + 38);
+    const uint32_t requester = read_address(header + 28);
+    const uint8_t peer = self->peer_for_ip_(claimed, true);
+    if (requester != 0 && requester != claimed && self->station_connected_.load() && peer != 0) {
+      ArpRequest request{};
+      request.generation = self->gateway_generation_.load();
+      request.peer = peer;
+      request.peer_epoch = self->identity_requests_[peer - 1].epoch.load();
+      request.claimed_ip = claimed;
+      request.target_ip = requester;
+      std::memcpy(request.target_mac, header + 22, 6);
+      if (xQueueSend(self->arp_queue_, &request, 0) == pdTRUE)
+        self->schedule_();
+      else
+        self->queue_drops_.fetch_add(1);
+    }
+  }
+#ifdef MESH_HAS_ETHERNET
+  return ethernet_input(packet, netif);
+#else
+  return self->original_station_input_(packet, netif);
+#endif
+}
+#endif
+
+void MeshIpNetif::schedule_() {
+  if (!this->configured_.load() || this->pending_.exchange(true))
+    return;
+  if (tcpip_try_callback(work_callback_, this) != ERR_OK) {
+    this->pending_.store(false);
+    this->queue_drops_.fetch_add(1);
+  }
+}
+
+void MeshIpNetif::work_callback_(void *context) {
+  auto *self = static_cast<MeshIpNetif *>(context);
+  self->pending_.store(false);
+  self->work_();
+  const uint32_t remaining = uxTaskGetStackHighWaterMark(nullptr);
+  if (remaining < self->tcpip_stack_min_.load())
+    self->tcpip_stack_min_.store(remaining);
+}
+
+#ifndef MESH_IP_CLIENT_ONLY
+void MeshIpNetif::arp_reply_(const ArpRequest &request) {
+  if (!this->gateway_active_() || request.generation != this->gateway_generation_.load() ||
+      (request.peer != 0 && !this->peer_epoch_current_(request.peer, request.peer_epoch)) ||
+      this->station_netif_ == nullptr || !netif_is_up(this->station_netif_) ||
+      !netif_is_link_up(this->station_netif_) || this->station_netif_->linkoutput == nullptr)
+    return;
+  uint8_t frame[42]{};
+  std::memcpy(frame, request.target_mac, 6);
+  std::memcpy(frame + 6, this->station_netif_->hwaddr, 6);
+  frame[12] = 0x08;
+  frame[13] = 0x06;
+  frame[15] = 1;
+  frame[16] = 0x08;
+  frame[18] = 6;
+  frame[19] = 4;
+  frame[21] = 2;  // ARP reply, including unsolicited broadcast announcements.
+  std::memcpy(frame + 22, this->station_netif_->hwaddr, 6);
+  std::memcpy(frame + 28, &request.claimed_ip, 4);
+  std::memcpy(frame + 32, request.target_mac, 6);
+  std::memcpy(frame + 38, &request.target_ip, 4);
+  struct pbuf *packet = pbuf_alloc(PBUF_RAW, sizeof(frame), PBUF_RAM);
+  if (packet == nullptr) {
+    this->queue_drops_.fetch_add(1);
+    return;
+  }
+  pbuf_take(packet, frame, sizeof(frame));
+  if (this->station_netif_->linkoutput(this->station_netif_, packet) == ERR_OK)
+    this->proxy_arp_.fetch_add(1);
+  pbuf_free(packet);
+}
+#endif
+
+#ifndef MESH_IP_CLIENT_ONLY
+void MeshIpNetif::announce_(uint32_t address) {
+  ArpRequest request{};
+  request.generation = this->gateway_generation_.load();
+  request.claimed_ip = request.target_ip = address;
+  std::memset(request.target_mac, 0xff, 6);
+  this->arp_reply_(request);
+}
+#endif
+
+#ifndef MESH_IP_CLIENT_ONLY
+bool MeshIpNetif::arp_probe_(uint32_t address) {
+  if (!this->gateway_active_() || this->station_netif_ == nullptr || this->station_netif_->linkoutput == nullptr)
+    return false;
+  uint8_t frame[42]{};
+  std::memset(frame, 0xff, 6);
+  std::memcpy(frame + 6, this->station_netif_->hwaddr, 6);
+  frame[12] = 0x08;
+  frame[13] = 0x06;
+  frame[15] = 1;
+  frame[16] = 0x08;
+  frame[18] = 6;
+  frame[19] = 4;
+  frame[21] = 1;
+  std::memcpy(frame + 22, this->station_netif_->hwaddr, 6);
+  std::memcpy(frame + 38, &address, 4);
+  struct pbuf *packet = pbuf_alloc(PBUF_RAW, sizeof(frame), PBUF_RAM);
+  if (packet == nullptr) {
+    this->queue_drops_.fetch_add(1);
+    return false;
+  }
+  pbuf_take(packet, frame, sizeof(frame));
+  const bool sent = this->station_netif_->linkoutput(this->station_netif_, packet) == ERR_OK;
+  if (!sent)
+    this->queue_drops_.fetch_add(1);
+  pbuf_free(packet);
+  return sent;
+}
+#endif
+
+#ifndef MESH_IP_CLIENT_ONLY
+void MeshIpNetif::observe_probe_arp_(const uint8_t *header) {
+  if (!this->gateway_active_() || this->station_netif_ == nullptr ||
+      std::memcmp(header + 22, this->station_netif_->hwaddr, 6) == 0)
+    return;
+  const uint32_t sender = read_address(header + 28), target = read_address(header + 38);
+  for (LeaseProbe &probe : this->lease_probes_) {
+    if (probe.phase.load() == 1 &&
+        (sender == probe.address.load() || (sender == 0 && target == probe.address.load()))) {
+      probe.conflict.store(true);
+      this->schedule_();
+    }
+  }
+}
+#endif
+
+#ifndef MESH_IP_CLIENT_ONLY
+void MeshIpNetif::work_probes_(bool connected) {
+  const uint32_t now = now_ms();
+  LeaseProbeResult request;
+  while (xQueueReceive(this->probe_request_queue_, &request, 0) == pdTRUE) {
+    if (!this->gateway_active_() || request.generation != this->gateway_generation_.load() ||
+        !this->peer_epoch_current_(request.node_id, request.peer_epoch))
+      continue;
+    const DhcpTransaction &transaction = this->dhcp_transactions_[request.node_id - 1];
+    if (transaction.xid.load() != request.nonce || transaction.candidate_xid.load() != request.nonce ||
+        transaction.candidate_address.load() != request.address ||
+        uint32_t(now - transaction.seen.load()) >= DHCP_TRANSACTION_MS ||
+        !this->gateway_lease_valid_(request.node_id, request.address))
+      continue;
+    LeaseProbe &probe = this->lease_probes_[request.node_id - 1];
+    if (probe.phase.load() != 0 && probe.address.load() == request.address && probe.nonce == request.nonce) {
+      if (probe.phase.load() == 2 && uint32_t(now - probe.completed) < 10000) {
+        request.conflict = probe.conflict.load();
+        if (xQueueSend(this->probe_result_queue_, &request, 0) != pdTRUE)
+          this->queue_drops_.fetch_add(1);
+      }
+      continue;
+    }
+    probe.phase.store(0);
+    probe.address.store(request.address);
+    probe.nonce = request.nonce;
+    probe.generation = request.generation;
+    probe.peer_epoch = request.peer_epoch;
+    probe.attempts = 0;
+    probe.conflict.store(false);
+    for (size_t i = 0; i < mesh_limits::MAX_NODES; i++) {
+      if (i + 1 != request.node_id && this->lease_probes_[i].phase.load() == 1 &&
+          this->lease_probes_[i].address.load() == request.address) {
+        this->lease_probes_[i].conflict.store(true);
+        probe.conflict.store(true);
+      }
+    }
+    this->peers_[request.node_id - 1].fallback.store(false);
+    probe.phase.store(1);
+  }
+  for (size_t i = 0; i < mesh_limits::MAX_NODES; i++) {
+    LeaseProbe &probe = this->lease_probes_[i];
+    if (probe.phase.load() == 2) {
+      if (uint32_t(now - probe.completed) >= 10000)
+        probe.phase.store(0);
+      continue;
+    }
+    if (probe.phase.load() != 1 || !connected || !this->gateway_active_() ||
+        probe.generation != this->gateway_generation_.load() || !this->peer_epoch_current_(i + 1, probe.peer_epoch))
+      continue;
+    if (uint32_t(now - this->dhcp_transactions_[i].seen.load()) >= DHCP_TRANSACTION_MS ||
+        !this->gateway_lease_valid_(i + 1, probe.address.load())) {
+      probe.phase.store(0);
+      continue;
+    }
+    const bool elapsed = probe.attempts == 0 || uint32_t(now - probe.last_probe) >= 1000;
+    if (probe.conflict.load() || (probe.attempts == 3 && elapsed)) {
+      probe.completed = now;
+      probe.phase.store(2);
+      LeaseProbeResult result;
+      result.node_id = i + 1;
+      result.address = probe.address.load();
+      result.nonce = probe.nonce;
+      result.conflict = probe.conflict.load();
+      result.generation = probe.generation;
+      result.peer_epoch = probe.peer_epoch;
+      if (xQueueSend(this->probe_result_queue_, &result, 0) != pdTRUE)
+        this->queue_drops_.fetch_add(1);
+    } else if (elapsed) {
+      probe.last_probe = now;
+      if (this->arp_probe_(probe.address.load()))
+        probe.attempts++;
+    }
+  }
+}
+#endif
+
+#ifdef MESH_HAS_ETHERNET
+bool MeshIpNetif::apply_native_uplink_() {
+  const uint32_t revision = this->native_uplink_revision_.load();
+  if ((revision & 1U) != 0)
+    return false;
+  const auto requested = this->native_uplink_.load();
+  auto *handle = esp_netif_get_handle_from_ifkey(native_uplink_key(requested));
+  auto *selected = handle == nullptr ? nullptr : static_cast<struct netif *>(esp_netif_get_netif_impl(handle));
+  if (revision != this->native_uplink_revision_.load())
+    return false;
+  if (revision == this->applied_native_uplink_revision_.load() && selected == this->station_netif_)
+    return true;
+#ifndef MESH_IP_CLIENT_ONLY
+  if (this->driver_tx_busy_.exchange(true))
+    return false;
+  // Retire LAN-bound ownership before changing the interface, retaining each
+  // member's authenticated identity and the mesh transport/routing state.
+  for (size_t i = 0; i < mesh_limits::MAX_NODES; ++i)
+    this->reset_peer_identity_state_(i);
+  if (this->station_netif_ != nullptr) {
+    if (this->station_netif_->input == station_input_)
+      this->station_netif_->input = this->original_station_input_;
+    if (this->station_netif_->output == station_output_)
+      this->station_netif_->output = this->original_station_output_;
+  }
+  this->original_station_input_ = nullptr;
+  this->original_station_output_ = nullptr;
+  xQueueReset(this->arp_queue_);
+  xQueueReset(this->probe_request_queue_);
+  xQueueReset(this->probe_result_queue_);
+#endif
+#ifdef MESH_IPV6
+#ifndef MESH_IP_CLIENT_ONLY
+  if (this->station_netif_ != nullptr && this->station_netif_->output_ip6 == station_output_ipv6_)
+    this->station_netif_->output_ip6 = this->original_station_output_ipv6_;
+#endif
+  this->original_station_output_ipv6_ = nullptr;
+  this->ipv6_initialized_ = false;
+  this->ipv6_previous_local_ = {};
+  for (auto &prefix : this->ipv6_prefixes_) {
+    prefix.revision.fetch_add(1);
+    prefix.words[0].store(0);
+    prefix.words[1].store(0);
+    prefix.started.store(0);
+    prefix.lifetime.store(0);
+    prefix.revision.fetch_add(1);
+  }
+  this->ipv6_native_ready_.store(false);
+  this->ipv6_native_link_.store(false);
+  this->ipv6_path_ready_.store(false);
+#endif
+  portENTER_CRITICAL(&this->tx_lock_);
+  this->tx_flows_.reset();
+  portEXIT_CRITICAL(&this->tx_lock_);
+  this->rx_pending_ = false;
+  xQueueReset(this->rx_queue_);
+  this->station_netif_ = selected;
+  this->previous_station_connected_ = false;
+  this->applied_native_uplink_.store(requested);
+  this->applied_native_uplink_revision_.store(revision);
+#ifndef MESH_IP_CLIENT_ONLY
+  this->driver_tx_busy_.store(false);
+#endif
+  return revision == this->native_uplink_revision_.load();
+}
+#endif
+
+void MeshIpNetif::work_() {
+#ifdef MESH_HAS_ETHERNET
+  if (!this->apply_native_uplink_())
+    return;
+#endif
+  const uint32_t generation = this->gateway_generation_.load();
+  if (this->applied_generation_.load() != generation && !this->apply_gateway_change_(generation))
+    return;  // A later worker update retries after an in-flight driver exits.
+  // A busy driver can defer one member's publication while unrelated traffic
+  // and the established local endpoint continue through this service pass.
+  this->apply_pending_identities_();
+#ifndef MESH_HAS_ETHERNET
+  if (this->station_netif_ == nullptr) {
+    esp_netif_t *station = esp_netif_get_handle_from_ifkey("WIFI_STA_DEF");
+    if (station != nullptr)
+      this->station_netif_ = static_cast<struct netif *>(esp_netif_get_netif_impl(station));
+    // A cold mesh-only node deliberately has no ESPHome STA interface yet.
+    // The gateway requires one, but the raw client interface does not.
+    if (this->station_netif_ == nullptr && this->node_id_ == this->gateway_id_)
+      return;
+  }
+#endif
+#ifndef MESH_IP_CLIENT_ONLY
+  const bool gateway_service =
+      this->gateway_enabled_.load() &&
+      (this->gateway_candidates_ != 0 ? this->candidate_(this->node_id_) : this->node_id_ == this->gateway_id_);
+  if (this->station_netif_ != nullptr && gateway_service) {
+    // IDF STOP/START reuses this netif but netif_add/wlanif_init reset input
+    // and output. Repair both hooks on the TCP/IP task after every restart,
+    // preserving the current native handler and never chaining to ourselves.
+    if (this->station_netif_->input != nullptr && this->station_netif_->input != station_input_) {
+      this->original_station_input_ = this->station_netif_->input;
+      this->station_netif_->input = station_input_;
+    }
+    if (this->station_netif_->output != nullptr && this->station_netif_->output != station_output_) {
+      this->original_station_output_ = this->station_netif_->output;
+      this->station_netif_->output = station_output_;
+    }
+#ifdef MESH_IPV6
+    if (this->station_netif_->output_ip6 != nullptr && this->station_netif_->output_ip6 != station_output_ipv6_) {
+      this->original_station_output_ipv6_ = this->station_netif_->output_ip6;
+      this->station_netif_->output_ip6 = station_output_ipv6_;
+    }
+#endif
+  } else if (this->station_netif_ != nullptr) {
+    // A former gateway must leave the native STA path fully intact. Do not
+    // overwrite handlers that ESP-IDF independently replaced during restart.
+    if (this->station_netif_->input == station_input_ && this->original_station_input_ != nullptr)
+      this->station_netif_->input = this->original_station_input_;
+    if (this->station_netif_->output == station_output_ && this->original_station_output_ != nullptr)
+      this->station_netif_->output = this->original_station_output_;
+#ifdef MESH_IPV6
+    if (this->station_netif_->output_ip6 == station_output_ipv6_ && this->original_station_output_ipv6_ != nullptr)
+      this->station_netif_->output_ip6 = this->original_station_output_ipv6_;
+#endif
+  }
+#endif
+#if defined(MESH_IPV6) && defined(MESH_IP_CLIENT_ONLY)
+  if (this->station_netif_ != nullptr)
+    this->original_station_output_ipv6_ = this->station_netif_->output_ip6;
+#endif
+  const uint32_t address = this->address_.load();
+  if (!this->virtual_added_) {
+    ip4_addr_t ip{}, mask{}, gateway{};
+    // ESP-IDF globally observes lwIP address changes and interprets netif->state
+    // as esp_netif_t* when LWIP_ESP_NETIF_DATA is disabled. This raw L3 interface
+    // has no esp-netif owner: keep state null, which those observers explicitly
+    // recognize as unmanaged. Our singleton identifies the output interface.
+    if (netif_add(&this->virtual_netif_, &ip, &mask, &gateway, nullptr, netif_init_, tcpip_input) == nullptr)
+      return;
+    this->virtual_added_ = true;
+  }
+  if (address != 0 && netif_ip4_addr(&this->virtual_netif_)->addr != address) {
+    ip4_addr_t ip{address}, mask{0xffffffffU}, gateway{};
+    netif_set_addr(&this->virtual_netif_, &ip, &mask, &gateway);
+    netif_set_up(&this->virtual_netif_);
+    netif_set_link_up(&this->virtual_netif_);
+  } else if (address == 0 && netif_ip4_addr(&this->virtual_netif_)->addr != 0) {
+    ip4_addr_t zero{};
+#ifdef MESH_IPV6
+    // IPv4 lease withdrawal must not tear down a live or bootstrapping IPv6
+    // interface: netif_set_down() also discards its neighbor/router state.
+    if (!this->ipv6_initialized_ || this->ipv6_station_link_()) {
+#endif
+      if (netif_default == &this->virtual_netif_)
+        netif_set_default(this->station_netif_);
+      netif_set_link_down(&this->virtual_netif_);
+      netif_set_down(&this->virtual_netif_);
+#ifdef MESH_IPV6
+    }
+#endif
+    netif_set_addr(&this->virtual_netif_, &zero, &zero, &zero);
+  }
+  const bool connected = this->station_netif_ != nullptr && this->station_connected_.load() &&
+                         netif_is_up(this->station_netif_) && netif_is_link_up(this->station_netif_) &&
+                         netif_ip4_addr(this->station_netif_)->addr == address && address != 0;
+  const bool reachable = connected || (this->role_current_() && this->mesh_path_validated_.load() &&
+                                       this->mesh_reachable_.load() && this->node_id_ != this->gateway_id_);
+  this->available_.store(address != 0 && reachable);
+  this->fallback_active_.store(address != 0 && !connected && reachable);
+  this->ready_.store(address != 0);
+  if (connected && netif_default == &this->virtual_netif_)
+    netif_set_default(this->station_netif_);
+  if (address != 0 && this->node_id_ != this->gateway_id_) {
+    if (!connected && reachable)
+      netif_set_default(&this->virtual_netif_);
+    else if (connected && netif_default == &this->virtual_netif_)
+      netif_set_default(this->station_netif_);
+    if (connected) {
+      const uint32_t now = now_ms();
+      if (!this->previous_station_connected_) {
+        this->station_announcement_start_ = now;
+        this->last_station_announcement_ = now;
+        etharp_gratuitous(this->station_netif_);
+      } else if (uint32_t(now - this->station_announcement_start_) <= 3000 &&
+                 uint32_t(now - this->last_station_announcement_) >= 1000) {
+        // A gateway may still have the preceding fallback heartbeat for a
+        // short time. Repeat after it stops proxying so direct MAC ownership
+        // wins even when its final announcement raced our initial one.
+        this->last_station_announcement_ = now;
+        etharp_gratuitous(this->station_netif_);
+      }
+    }
+  }
+  this->previous_station_connected_ = connected;
+#ifdef MESH_IPV6
+  this->work_ipv6_();
+#endif
+#ifndef MESH_IP_CLIENT_ONLY
+  if (this->gateway_active_())
+    this->work_probes_(connected);
+  if (this->gateway_active_() && connected) {
+    for (Peer &peer : this->peers_) {
+      const uint32_t seen = peer.seen.load();
+      const uint32_t now = now_ms();
+      const bool fallback = peer.fallback.load() && uint32_t(now - seen) < PEER_LEASE_MS &&
+                            this->peer_for_ip_(peer.ip.load(), true) == &peer - this->peers_ + 1;
+      if (fallback && (!peer.announced || uint32_t(now - peer.last_announcement) >= 1000)) {
+        this->announce_(peer.ip.load());
+        peer.last_announcement = now;
+      }
+      peer.announced = fallback;
+    }
+  }
+  ArpRequest arp;
+  while (xQueueReceive(this->arp_queue_, &arp, 0) == pdTRUE) {
+    if (connected && this->peer_for_ip_(arp.claimed_ip, true) != 0)
+      this->arp_reply_(arp);
+  }
+#endif
+  IpPacket &incoming = this->tcpip_rx_packet_;
+#ifndef MESH_IP_CLIENT_ONLY
+  IpFlowQueue::Key blocked_flows[RX_CAPACITY + 1]{};
+  size_t blocked_count = 0;
+#endif
+  // Bound a service pass even when a congested flow is rotated for another
+  // flow to proceed. Datagram ordering across the tunnel is not guaranteed.
+  for (size_t budget = 0; budget < RX_CAPACITY + 1; ++budget) {
+    if (!this->rx_pending_) {
+      if (xQueueReceive(this->rx_queue_, &incoming, 0) != pdTRUE)
+        break;
+      this->rx_pending_ = true;
+    }
+    if (!this->transport_current_() || incoming.generation != this->gateway_generation_.load() ||
+        !this->peer_epoch_current_(incoming.destination, incoming.peer_epoch)) {
+      this->rx_pending_ = false;
+      continue;
+    }
+#ifndef MESH_IP_CLIENT_ONLY
+    const auto incoming_flow = IpFlowQueue::classify(incoming);
+    bool blocked = false;
+    for (size_t i = 0; i < blocked_count; ++i)
+      blocked |= blocked_flows[i] == incoming_flow;
+    if (blocked) {
+      if (xQueueSend(this->rx_queue_, &incoming, 0) != pdTRUE)
+        break;
+      this->rx_pending_ = false;
+      continue;
+    }
+#endif
+#ifdef MESH_IPV6
+    if (incoming.length >= 40 && (incoming.data[0] >> 4) == 6) {
+      bool flow_blocked = false;
+      if (!this->process_ipv6_(incoming, flow_blocked)) {
+#ifndef MESH_IP_CLIENT_ONLY
+        if (flow_blocked) {
+          blocked_flows[blocked_count++] = incoming_flow;
+          if (xQueueSend(this->rx_queue_, &incoming, 0) != pdTRUE)
+            break;
+          this->rx_pending_ = false;
+          continue;
+        }
+#endif
+        break;
+      }
+      this->rx_pending_ = false;
+      continue;
+    }
+#endif
+#ifndef MESH_IP_CLIENT_ONLY
+    if (incoming.gateway_ingress &&
+        (!this->gateway_active_() ||
+         (!this->valid_dhcp_request_(incoming.destination, incoming.data, incoming.length) &&
+          !this->gateway_source_valid_(incoming.destination, read_address(incoming.data + 12))))) {
+      this->rx_pending_ = false;
+      continue;
+    }
+#endif
+    if (!incoming.gateway_ingress && read_address(incoming.data + 16) != address) {
+      this->rx_pending_ = false;
+      continue;
+    }
+#ifndef MESH_IP_CLIENT_ONLY
+    // Forwarding to another mesh endpoint never enters lwIP. Keep the accepted
+    // datagram in our RX storage until the bounded TX queue takes its copy;
+    // allocating an unused pbuf here wastes heap and can stall mesh forwarding.
+    if (incoming.gateway_ingress && read_address(incoming.data + 16) != address &&
+        !this->valid_dhcp_request_(incoming.destination, incoming.data, incoming.length)) {
+      const uint8_t mesh_destination = this->peer_for_ip_(read_address(incoming.data + 16), true);
+      if (mesh_destination != 0) {
+        if (!this->enqueue_(mesh_destination, incoming.data, incoming.length, false, incoming.destination,
+                            incoming.peer_epoch)) {
+          this->rx_retries_.fetch_add(1);
+          blocked_flows[blocked_count++] = incoming_flow;
+          if (xQueueSend(this->rx_queue_, &incoming, 0) != pdTRUE)
+            break;
+          this->rx_pending_ = false;
+          continue;
+        }
+        this->mesh_rx_.fetch_add(1);
+        this->rx_pending_ = false;
+        continue;
+      }
+    }
+#endif
+    struct pbuf *packet = pbuf_alloc(PBUF_LINK, incoming.length, PBUF_RAM);
+    if (packet == nullptr) {
+      // Keep the already accepted datagram in the existing scratch. The mesh
+      // worker's periodic update retries without spinning the TCP/IP task.
+      this->rx_retries_.fetch_add(1);
+      break;
+    }
+    pbuf_take(packet, incoming.data, incoming.length);
+#ifndef MESH_IP_CLIENT_ONLY
+    if (incoming.gateway_ingress) {
+      ip4_addr_t destination{read_address(incoming.data + 16)};
+      err_t result = ERR_RTE;
+      if (this->valid_dhcp_request_(incoming.destination, incoming.data, incoming.length)) {
+        if (connected && this->track_dhcp_request_(incoming.destination, incoming.data, incoming.length))
+          result = etharp_output(this->station_netif_, packet, &destination);
+      } else if (destination.addr == address) {
+        this->rx_pending_ = false;
+        if (ip4_input(packet, &this->virtual_netif_) == ERR_OK)
+          this->mesh_rx_.fetch_add(1);
+        continue;  // ip4_input owns the pbuf, including on error.
+      } else {
+        if (connected)
+          result = etharp_output(this->station_netif_, packet, &destination);
+      }
+      pbuf_free(packet);
+      if (result == ERR_MEM) {
+        this->rx_retries_.fetch_add(1);
+        // LAN backpressure belongs to this flow, unlike failure to allocate
+        // any pbuf. Give other flows the same bounded opportunity as mesh TX.
+        blocked_flows[blocked_count++] = incoming_flow;
+        if (xQueueSend(this->rx_queue_, &incoming, 0) != pdTRUE)
+          break;
+        this->rx_pending_ = false;
+        continue;
+      }
+      this->rx_pending_ = false;
+      if (result == ERR_OK) {
+        this->mesh_rx_.fetch_add(1);
+        this->lan_tx_.fetch_add(1);
+      } else
+        this->queue_drops_.fetch_add(1);
+    } else
+#endif
+    {
+      this->rx_pending_ = false;
+      if (ip4_input(packet, &this->virtual_netif_) == ERR_OK)
+        this->mesh_rx_.fetch_add(1);
+      // ip4_input consumes the pbuf regardless of protocol acceptance.
+    }
+  }
+}
+
+MeshIpNetif::Counters MeshIpNetif::counters() const {
+  return {this->mesh_tx_.load(),           this->mesh_rx_.load(),   this->queue_drops_.load(),
+          this->invalid_packets_.load(),   this->proxy_arp_.load(), this->lan_tx_.load(),
+          this->flow_backpressure_.load(), this->rx_retries_.load()};
+}
