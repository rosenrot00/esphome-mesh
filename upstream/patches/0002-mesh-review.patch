+TEST(MeshIpDelivery, ResetIngressOwnerStopsForwardedArqWithoutAbortingLocalSameDestination) {
+  Network network;
+  const auto forwarded = bytes(1500), local = bytes(40, 9);
+  ASSERT_TRUE(!network.a.delivery.begin(2, forwarded.data(), forwarded.size(), 1, 0, 17));
+  ASSERT_TRUE(!network.a.delivery.begin(2, forwarded.data(), forwarded.size(), 1, 0, 1));
+  ASSERT_TRUE(network.a.delivery.pending_count() == 0 && network.a.delivery.counters().submitted == 0);
+  network.drop = [](const Message &message) { return !message.ack && packet_id(message.payload) == 1; };
+  ASSERT_TRUE(network.a.delivery.begin(2, forwarded.data(), forwarded.size(), 1, 0, 3));
+  ASSERT_TRUE(network.a.delivery.begin(2, local.data(), local.size(), 2, 0));
+  network.step(0);
+  const auto old_sends = std::count_if(network.history.begin(), network.history.end(), [](const Message &message) {
+    return !message.ack && packet_id(message.payload) == 1;
+  });
+  ASSERT_TRUE(old_sends > 0 && network.a.delivery.pending_count() == 2);
+  network.a.delivery.reset_peer(17);
+  ASSERT_TRUE(network.a.delivery.pending_count() == 2);
+  network.a.delivery.reset_peer(3);
+  ASSERT_TRUE(network.a.delivery.pending_count() == 1);
+  network.run(5);
+  const auto final_old_sends =
+      std::count_if(network.history.begin(), network.history.end(),
+                    [](const Message &message) { return !message.ack && packet_id(message.payload) == 1; });
+  ASSERT_TRUE(final_old_sends == old_sends && network.b.delivered == std::vector<Bytes>{local});
+  ASSERT_TRUE(network.a.delivery.counters().acknowledged == 1 && network.a.delivery.pending_count() == 0);
+  ASSERT_TRUE(network.a.delivery.counters().fragment_retries == 0);
+  ASSERT_TRUE(
+      network.a.delivery.begin(2, local.data(), local.size(), 3, 1600));  // Reused slot resets owner to local/default0.
+  network.a.delivery.reset_peer(3);
+  ASSERT_TRUE(network.a.delivery.pending_count() == 1);
+  network.a.delivery.reset_peer(2);
+  ASSERT_TRUE(network.a.delivery.pending_count() == 0);  // Destination revocation still applies.
+}
