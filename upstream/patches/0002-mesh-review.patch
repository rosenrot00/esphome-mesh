+  ASSERT_TRUE(!discovery_chunk(bytes.data(), bytes.size(), 0, 0, output.data(), output.size(), size));
+  DiscoveryRegistry registry;
+  ASSERT_TRUE(registry.authorize(3, MAC));
+  auto packet = chunks(encode(metadata()))[0];
+  packet[14] = 1;
+  ASSERT_TRUE(!registry.receive(3, packet.data(), packet.size(), 100));
