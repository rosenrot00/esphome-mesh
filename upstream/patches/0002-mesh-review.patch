+TEST(MeshMembership, WireRoundtripAndBoundaries) {
+  for (auto type : {MessageType::CLAIM, MessageType::CHALLENGE, MessageType::PROOF}) {
+    Message original;
+    original.type = type;
+    original.claim = claim(7, 16, 0x87654321, kGatewayCapable | kPinnedId | kNativeUplink);
+    original.requester = mac(4);
+    original.challenge = 0x123456789ABCDEF0ULL;
+    original.hops = 3;
+    const auto bytes = wire(original);
+    ASSERT_TRUE(bytes.size() == (type == MessageType::CLAIM ? kClaimWireSize : kProofWireSize));
+    ASSERT_TRUE(bytes[0] == 'M' && bytes[1] == 'A' && bytes[2] == 4);
+    ASSERT_TRUE(bytes[3] == 0x20 + static_cast<uint8_t>(type) && bytes[4] == 3);
+    ASSERT_TRUE(bytes[29] == 0x21 && bytes[32] == 0x87);
+    Message decoded;
+    ASSERT_TRUE(decode_message(bytes.data(), bytes.size(), decoded));
+    ASSERT_TRUE(decoded.type == type && decoded.claim.mac == original.claim.mac);
+    ASSERT_TRUE(decoded.claim.boot == original.claim.boot && decoded.claim.node_id == 16);
+    ASSERT_TRUE(decoded.claim.flags == original.claim.flags && decoded.claim.sequence == 0x87654321);
+    if (type != MessageType::CLAIM)
+      ASSERT_TRUE(decoded.requester == original.requester && decoded.challenge == original.challenge);
+    auto encoded = wire(decoded);
+    ASSERT_TRUE(encoded == bytes);
+    size_t written = 100;
+    uint8_t short_output[kMaxWireSize];
+    ASSERT_TRUE(!encode_message(original, short_output, bytes.size() - 1, written) && written == 0);
+  }
+  Message unassigned = announcement(claim(4, 0));
+  ASSERT_TRUE(wire(unassigned).size() == kClaimWireSize);
+}
