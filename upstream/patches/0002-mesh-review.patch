+TEST(MeshIpPacket, LossDeadlineAndClockWrap) {
+  const auto parts = fragments(packet(2 * kFragmentDataSize + 12));
+  for (const uint32_t start : {100U, UINT32_MAX - 1000U}) {
+    Reassembler r;
+    CompletedPacket complete;
+    ASSERT_TRUE(receive(r, parts[0], start, complete) == ReceiveResult::INCOMPLETE);
+    ASSERT_TRUE(receive(r, parts[2], start + 1, complete) == ReceiveResult::INCOMPLETE);
+    ASSERT_TRUE(receive(r, parts[0], start + 1999U, complete) == ReceiveResult::DUPLICATE);
+    ASSERT_TRUE(r.pending_packets() == 1);
+    r.expire(start + 2000U);
+    ASSERT_TRUE(r.pending_packets() == 0 && r.counters().expired_packets == 1);
+    // A late final fragment starts a fresh incomplete assembly, never a delivery.
+    ASSERT_TRUE(receive(r, parts[1], start + 2000U, complete) == ReceiveResult::INCOMPLETE);
+    ASSERT_TRUE(complete.data == nullptr && r.counters().completed_packets == 0);
+  }
