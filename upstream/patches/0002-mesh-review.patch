+  ASSERT_TRUE((frame.payload[0] == 7 && frame.payload[1] == 8 && frame.payload[2] == 9));
+  h.pump(110);
+  ASSERT_TRUE((h.count_deliveries(1, FrameType::CONTROL, 401) == 1));
+
+  Frame incoming{};
+  incoming.type = FrameType::PROBE;
+  incoming.source = 1;
+  incoming.destination = 2;
+  incoming.sequence = 402;
+  incoming.payload_length = 3;
+  incoming.payload[0] = 10;
+  incoming.payload[1] = 11;
+  incoming.payload[2] = 12;
+  h.node(2).receive(1, incoming, 120);
+  ASSERT_TRUE((incoming.type == FrameType::PROBE && incoming.source == 1 && incoming.destination == 2));
+  ASSERT_TRUE((incoming.sequence == 402 && incoming.payload_length == 3 && incoming.payload[2] == 12));
+  h.pump(120);
+  ASSERT_TRUE((h.count_deliveries(1, FrameType::PROBE_REPLY, 402) == 1));
+}
