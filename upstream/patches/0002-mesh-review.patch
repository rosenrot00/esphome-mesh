+  for (size_t mtu = kMinimumPayloadMtu; mtu <= mesh_core::kMaxPayload; ++mtu) {
+    const PacketProfile profile{mtu, 30000};
+    ASSERT_TRUE(receiver.set_profile(profile));
+    const size_t stride = mtu - kFragmentHeaderSize;
+    const size_t lengths[]{1, stride, stride + 1, kMtu};
+    for (const size_t length : lengths) {
+      const auto bytes = packet(length, ++id);
+      auto parts = fragments(bytes, id, profile);
+      ASSERT_TRUE(parts.size() == (length + stride - 1) / stride);
+      for (const auto &part : parts) {
+        ASSERT_TRUE(part.size() <= mtu);
+        ASSERT_TRUE(part[2] == 3 && part[3] == 0);
+        ASSERT_TRUE((size_t(part[16]) | (size_t(part[17]) << 8)) == stride);
+      }
+      std::shuffle(parts.begin(), parts.end(), rng);
+      CompletedPacket complete;
+      for (size_t i = 0; i < parts.size(); ++i) {
+        ASSERT_TRUE(receive(receiver, parts[i], 100, complete) ==
+                    (i + 1 == parts.size() ? ReceiveResult::COMPLETE : ReceiveResult::INCOMPLETE));
+      }
+      assert_complete(complete, bytes, id);
+    }
+  }
+  ASSERT_TRUE(kMinimumPayloadMtu == 42);
+  ASSERT_TRUE(fragments(packet(kMtu), 1, PacketProfile{42, 2000}).size() == 63);
+  ASSERT_TRUE(fragments(packet(kMtu), 1, PacketProfile{43, 2000}).size() == 60);
+}
