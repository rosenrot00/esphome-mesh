+TEST(MeshIpDelivery, ReplayLookaheadDoesNotBlockUnrelatedDestinations) {
+  Network network;
+  const auto old_packet = bytes(1500, 81), short_packet = bytes(40, 93);
+  unsigned lost = 0, submitted_short = 0;
+  network.drop = [&](const Message &message) {
+    return !message.ack && packet_id(message.payload) == 100 && message.payload[10] == 0 && lost++ < 4;
+  };
+  ASSERT_TRUE(network.a.delivery.begin(2, old_packet.data(), old_packet.size(), 100, 0));
+  for (uint32_t now = 0; now < 500; ++now) {
+    if (submitted_short < 80 && network.a.delivery.can_begin()) {
+      ASSERT_TRUE(network.a.delivery.begin(3, short_packet.data(), short_packet.size(), 200 + submitted_short, now));
+      ++submitted_short;
+    }
+    network.step(now);
+  }
+  ASSERT_TRUE(submitted_short == 80 && network.c.delivered.size() == 80 && network.b.delivered.empty());
+  ASSERT_TRUE(network.a.delivery.counters().window_stalls == 0);
+  network.run(500, 1000);
+  ASSERT_TRUE(network.b.delivered == std::vector<Bytes>{old_packet});
+  ASSERT_TRUE(network.a.delivery.counters().acknowledged == 81);
+}
