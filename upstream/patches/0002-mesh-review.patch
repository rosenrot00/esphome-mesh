+        invalid.payload_length = 1;
+      if (kind == 1)
+        invalid.destination = 0;
+      if (kind == 2)
+        invalid.source = 0;
+      if (kind == 3)
+        invalid.destination = invalid.source;
+      if (kind == 4)
+        invalid.ttl = 0;
