diff --git a/esphome/components/mesh/mesh_limits.h b/esphome/components/mesh/mesh_limits.h
new file mode 100644
index 000000000..2122a0679
--- /dev/null
+++ b/esphome/components/mesh/mesh_limits.h
@@ -0,0 +1,47 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+
+// Whole-network compile-time endpoint capacity. Bit masks and replay serial
+// windows deliberately retain their protocol width; this bounds ID tables.
+#ifndef MESH_MAX_NODES
+#define MESH_MAX_NODES 16  // NOLINT: Codegen-controlled conditional/array capacity shared across translation units.
+#endif
+namespace mesh_limits {
+constexpr uint8_t MAX_NODES = MESH_MAX_NODES;
+static_assert(MAX_NODES == 4 || MAX_NODES == 8 || MAX_NODES == 16, "max_nodes supports 4, 8 or 16 endpoints");
+constexpr size_t MAX_PEERS = MAX_NODES - 1;
+constexpr uint16_t ID_MASK = static_cast<uint16_t>((1UL << MAX_NODES) - 1);
+constexpr bool valid_node(uint8_t id) { return id >= 1 && id <= MAX_NODES; }
+// Shared data-frame profile; no runtime/YAML mode or mixed-budget network.
+#ifndef MESH_V2_FRAME_BUDGET
+#define MESH_V2_FRAME_BUDGET \
+  512  // NOLINT: Codegen-controlled conditional/array capacity shared across translation units.
+#endif
+constexpr size_t NATIVE_FRAME_BUDGET = MESH_V2_FRAME_BUDGET;
+static_assert(NATIVE_FRAME_BUDGET == 512 || NATIVE_FRAME_BUDGET == 1470,
+              "Native ESP-NOW v2 frames support 512 or 1470 bytes");
+constexpr uint16_t PROTOCOL_PAYLOAD_BUDGET = NATIVE_FRAME_BUDGET - 39;
+#ifndef MESH_V2_RADIO_RX_CAPACITY
+#if MESH_V2_FRAME_BUDGET == 512
+#define MESH_V2_RADIO_RX_CAPACITY \
+  16  // NOLINT: Codegen-controlled conditional/array capacity shared across translation units.
+#else
+#define MESH_V2_RADIO_RX_CAPACITY \
+  8  // NOLINT: Codegen-controlled conditional/array capacity shared across translation units.
+#endif
+#endif
+#ifndef MESH_V2_RADIO_TX_CAPACITY
+#if MESH_MAX_NODES > 8
+#define MESH_V2_RADIO_TX_CAPACITY \
+  48  // NOLINT: Codegen-controlled conditional/array capacity shared across translation units.
+#else
+#define MESH_V2_RADIO_TX_CAPACITY \
+  24  // NOLINT: Codegen-controlled conditional/array capacity shared across translation units.
+#endif
+#endif
+constexpr size_t RADIO_RX_CAPACITY = MESH_V2_RADIO_RX_CAPACITY;
+constexpr size_t RADIO_TX_CAPACITY = MESH_V2_RADIO_TX_CAPACITY;
+static_assert(RADIO_RX_CAPACITY >= 8, "Native v2 retains at least eight receive slots");
+static_assert(RADIO_TX_CAPACITY >= 3 * MAX_PEERS, "Every peer needs DATA, CONTROL and ADVERTISEMENT capacity");
+}  // namespace mesh_limits
diff --git a/esphome/components/mesh/mesh_management.h b/esphome/components/mesh/mesh_management.h
new file mode 100644
index 000000000..ff540e97e
--- /dev/null
+++ b/esphome/components/mesh/mesh_management.h
@@ -0,0 +1,98 @@
+#pragma once
+
+#include "mesh_limits.h"
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+namespace mesh_transport {
+
+// Stable mesh identity, not an SDK address. A backend maps it to its native
+// addressing scheme. The current identity protocol uses six-byte identities.
+using PeerAddress = std::array<uint8_t, 6>;
+using PeerLinkKey = std::array<uint8_t, 16>;
+constexpr size_t MAX_MANAGEMENT_SIZE = 128;
+constexpr PeerAddress MANAGEMENT_FLOOD{{255, 255, 255, 255, 255, 255}};
+
+struct ManagementPacket {
+  PeerAddress source{};
+  uint16_t length{0};
+  uint8_t data[MAX_MANAGEMENT_SIZE]{};
+};
+
+// The adapter owns these static-lifetime KDF labels. Distinct link security
+// schemes must use distinct labels; membership authentication is independent.
+struct LinkKeyContext {
+  const char *network{nullptr};
+  const char *session{nullptr};
+};
+
+struct ManagementTransport {
+  void *context{nullptr};
+  size_t wire_mtu{0};
+  LinkKeyContext key_context{};
+  bool (*ready)(const void *){nullptr};
+  bool (*send)(void *, const PeerAddress &, const uint8_t *, size_t, uint32_t){nullptr};
+  bool (*receive)(void *, ManagementPacket &){nullptr};
+  bool (*configure_key)(void *, const PeerLinkKey &){nullptr};
+  bool (*install_peer)(void *, uint8_t, const PeerAddress &, const PeerLinkKey &){nullptr};
+  bool (*remove_peer)(void *, uint8_t){nullptr};
+  bool (*peer_address)(const void *, uint8_t, PeerAddress &){nullptr};
+};
+
+// Serialized control-plane boundary. Acceptance means a full bounded copy,
+// never delivery. Frames remain untrusted until authentication has verified
+// their sender, boot and compatibility. No SDK, allocator, IP or RTOS types.
+class ManagementChannel {
+ public:
+  bool bind(const ManagementTransport &transport, size_t required_wire_size) {
+    if (this->bound_ || required_wire_size == 0 || required_wire_size > MAX_MANAGEMENT_SIZE ||
+        transport.wire_mtu < required_wire_size || transport.key_context.network == nullptr ||
+        transport.key_context.session == nullptr || transport.key_context.network[0] == '\0' ||
+        transport.key_context.session[0] == '\0' || transport.ready == nullptr || transport.send == nullptr ||
+        transport.receive == nullptr || transport.configure_key == nullptr || transport.install_peer == nullptr ||
+        transport.remove_peer == nullptr || transport.peer_address == nullptr)
+      return false;
+    this->transport_ = transport;
+    this->bound_ = true;
+    return true;
+  }
+  bool ready() const { return this->bound_ && this->transport_.ready(this->transport_.context); }
+  const LinkKeyContext &key_context() const { return this->transport_.key_context; }
+  bool configure_key(const PeerLinkKey &key) {
+    return this->bound_ && this->transport_.configure_key(this->transport_.context, key);
+  }
+  bool send(const PeerAddress &destination, const uint8_t *data, size_t length, uint32_t now) {
+    return this->ready() && data != nullptr && length != 0 && length <= MAX_MANAGEMENT_SIZE &&
+           length <= this->transport_.wire_mtu &&
+           this->transport_.send(this->transport_.context, destination, data, length, now);
+  }
+  bool receive(ManagementPacket &packet) {
+    if (!this->ready() || !this->transport_.receive(this->transport_.context, packet))
+      return false;
+    uint8_t nonzero = 0;
+    for (uint8_t byte : packet.source)
+      nonzero |= byte;
+    return nonzero != 0 && (packet.source[0] & 1U) == 0 && packet.length != 0 && packet.length <= MAX_MANAGEMENT_SIZE &&
+           packet.length <= this->transport_.wire_mtu;
+  }
+  bool install_peer(uint8_t node, const PeerAddress &address, const PeerLinkKey &key) {
+    return this->bound_ && node >= 1 && node <= mesh_limits::MAX_NODES &&
+           this->transport_.install_peer(this->transport_.context, node, address, key);
+  }
+  bool remove_peer(uint8_t node) {
+    return this->bound_ && node >= 1 && node <= mesh_limits::MAX_NODES &&
+           this->transport_.remove_peer(this->transport_.context, node);
+  }
+  bool peer_address(uint8_t node, PeerAddress &address) const {
+    return this->bound_ && node >= 1 && node <= mesh_limits::MAX_NODES &&
+           this->transport_.peer_address(this->transport_.context, node, address);
+  }
+
+ protected:
+  ManagementTransport transport_{};
+  bool bound_{false};
+};
+
+}  // namespace mesh_transport
diff --git a/esphome/components/mesh/mesh_membership.cpp b/esphome/components/mesh/mesh_membership.cpp
new file mode 100644
index 000000000..2bd616bb5
--- /dev/null
+++ b/esphome/components/mesh/mesh_membership.cpp
@@ -0,0 +1,570 @@
+#include "mesh_membership.h"
+
+#include <algorithm>
+#include <cstring>
+
+namespace mesh_membership {
+namespace {
+
+constexpr uint8_t kWireVersion = 4;
+constexpr uint8_t kTypeBase = 0x20;
+constexpr size_t kHopsOffset = 4;
+
+bool nonzero(const uint8_t *value, size_t length) {
+  uint8_t aggregate = 0;
+  for (size_t i = 0; i < length; ++i)
+    aggregate |= value[i];
+  return aggregate != 0;
+}
+
+bool newer(uint32_t candidate, uint32_t previous) { return static_cast<int32_t>(candidate - previous) > 0; }
+
+bool same_session(const Claim &first, const Claim &second) {
+  return first.mac == second.mac && first.boot == second.boot;
+}
+
+bool same_owner(const Claim &first, const Claim &second) {
+  return same_session(first, second) && first.node_id == second.node_id &&
+         mesh_protocol::same(first.protocol, second.protocol);
+}
+
+bool preferred(const Claim &candidate, const Claim &previous) {
+  const bool candidate_pinned = (candidate.flags & kPinnedId) != 0;
+  const bool previous_pinned = (previous.flags & kPinnedId) != 0;
+  if (candidate_pinned != previous_pinned)
+    return candidate_pinned;
+  return std::lexicographical_compare(candidate.mac.begin(), candidate.mac.end(), previous.mac.begin(),
+                                      previous.mac.end());
+}
+
+bool valid_interval(uint32_t value) { return value != 0 && value < 0x80000000U; }
+
+void write32(uint8_t *output, uint32_t value) {
+  for (size_t i = 0; i < 4; ++i)
+    output[i] = static_cast<uint8_t>(value >> (i * 8));
+}
+
+void write64(uint8_t *output, uint64_t value) {
+  for (size_t i = 0; i < 8; ++i)
+    output[i] = static_cast<uint8_t>(value >> (i * 8));
+}
+
+uint32_t read32(const uint8_t *input) {
+  uint32_t value = 0;
+  for (size_t i = 0; i < 4; ++i)
+    value |= static_cast<uint32_t>(input[i]) << (i * 8);
+  return value;
+}
+
+uint64_t read64(const uint8_t *input) {
+  uint64_t value = 0;
+  for (size_t i = 0; i < 8; ++i)
+    value |= static_cast<uint64_t>(input[i]) << (i * 8);
+  return value;
+}
+
+NodeId mac_preference(const Mac &mac) {
+  uint32_t hash = 2166136261U;
+  for (uint8_t byte : mac)
+    hash = (hash ^ byte) * 16777619U;
+  return static_cast<NodeId>(hash % kMaxNodes + 1);
+}
+
+// This fingerprint only bounds flood work. Admission never depends on hash
+// collision resistance: ownership still requires the complete claim and a
+// fresh nonce proof, and hop count bounds forwarding even after eviction.
+uint64_t fingerprint(const uint8_t *input, size_t length) {
+  uint64_t hash = 14695981039346656037ULL;
+  for (size_t i = 0; i < length; ++i) {
+    if (i != kHopsOffset)
+      hash = (hash ^ input[i]) * 1099511628211ULL;
+  }
+  return hash;
+}
+
+}  // namespace
+
+bool valid_mac(const Mac &mac) { return (mac[0] & 1U) == 0 && nonzero(mac.data(), mac.size()); }
+
+bool valid_claim(const Claim &claim) {
+  return mesh_protocol::valid(claim.protocol) && valid_mac(claim.mac) &&
+         nonzero(claim.boot.data(), claim.boot.size()) && claim.node_id <= kMaxNodes &&
+         claim.node_id <= claim.protocol.max_nodes && (claim.flags & ~kKnownFlags) == 0 &&
+         ((claim.flags & kNativeUplink) == 0 || (claim.flags & kGatewayCapable) != 0);
+}
+
+bool encode_message(const Message &message, uint8_t *output, size_t capacity, size_t &written) {
+  written = 0;
+  if (output == nullptr || !valid_claim(message.claim) || message.hops == 0 || message.hops > kMaxFloodHops)
+    return false;
+  size_t length = kClaimWireSize;
+  if (message.type != MessageType::CLAIM) {
+    if ((message.type != MessageType::CHALLENGE && message.type != MessageType::PROOF) ||
+        !valid_mac(message.requester) || message.challenge == 0)
+      return false;
+    length = kProofWireSize;
+  }
+  if (capacity < length)
+    return false;
+  output[0] = 'M';
+  output[1] = 'A';
+  output[2] = kWireVersion;
+  output[3] = kTypeBase + static_cast<uint8_t>(message.type);
+  output[4] = message.hops;
+  output[5] = message.claim.node_id;
+  output[6] = message.claim.flags;
+  std::copy(message.claim.mac.begin(), message.claim.mac.end(), output + 7);
+  std::copy(message.claim.boot.begin(), message.claim.boot.end(), output + 13);
+  write32(output + 29, message.claim.sequence);
+  if (!mesh_protocol::encode(message.claim.protocol, output + 33, mesh_protocol::PROFILE_WIRE_SIZE))
+    return false;
+  if (message.type != MessageType::CLAIM) {
+    std::copy(message.requester.begin(), message.requester.end(), output + kClaimWireSize);
+    write64(output + kClaimWireSize + 6, message.challenge);
+  }
+  written = length;
+  return true;
+}
+
+bool decode_message(const uint8_t *input, size_t length, Message &message) {
+  if (input == nullptr || length < kClaimWireSize || input[0] != 'M' || input[1] != 'A' || input[2] != kWireVersion ||
+      input[3] <= kTypeBase || input[3] > kTypeBase + static_cast<uint8_t>(MessageType::PROOF))
+    return false;
+  Message decoded;
+  decoded.type = static_cast<MessageType>(input[3] - kTypeBase);
+  const size_t expected = decoded.type == MessageType::CLAIM ? kClaimWireSize : kProofWireSize;
+  if (length != expected || input[4] == 0 || input[4] > kMaxFloodHops)
+    return false;
+  decoded.hops = input[4];
+  decoded.claim.node_id = input[5];
+  decoded.claim.flags = input[6];
+  std::copy_n(input + 7, decoded.claim.mac.size(), decoded.claim.mac.begin());
+  std::copy_n(input + 13, decoded.claim.boot.size(), decoded.claim.boot.begin());
+  decoded.claim.sequence = read32(input + 29);
+  if (!mesh_protocol::decode(input + 33, mesh_protocol::PROFILE_WIRE_SIZE, decoded.claim.protocol))
+    return false;
+  if (!valid_claim(decoded.claim))
+    return false;
+  if (decoded.type != MessageType::CLAIM) {
+    std::copy_n(input + kClaimWireSize, decoded.requester.size(), decoded.requester.begin());
+    decoded.challenge = read64(input + kClaimWireSize + 6);
+    if (!valid_mac(decoded.requester) || decoded.challenge == 0)
+      return false;
+  }
+  message = decoded;
+  return true;
+}
+
+bool Membership::begin(const Mac &mac, const BootNonce &boot, NodeId preferred_id, NodeId pinned_id, uint8_t flags,
+                       uint32_t now, const mesh_protocol::Profile &protocol) {
+  if (initialized_ || protocol.max_nodes != mesh_limits::MAX_NODES || !mesh_protocol::valid(protocol) ||
+      !valid_mac(mac) || !nonzero(boot.data(), boot.size()) || preferred_id > kMaxNodes || pinned_id > kMaxNodes ||
+      (flags & ~kKnownFlags) != 0 || ((flags & kNativeUplink) != 0 && (flags & kGatewayCapable) == 0) ||
+      (pinned_id != 0 && (allowed_ids_ & local_allowed_ids_ & (1U << (pinned_id - 1))) == 0))
+    return false;
+  pinned_id_ = pinned_id;
+  preferred_id_ = preferred_id != 0 ? preferred_id : mac_preference(mac);
+  local_.protocol = protocol;
+  local_.mac = mac;
+  local_.boot = boot;
+  local_.flags = static_cast<uint8_t>((flags & ~kPinnedId) | (pinned_id != 0 ? kPinnedId : 0));
+  local_.node_id = free_id_();
+  local_.sequence = 1;
+  initialized_ = true;
+  change_slot_(local_.node_id, &local_, now);
+  return true;
+}
+
+bool Membership::set_allowed_ids(uint16_t mask) {
+  if (initialized_ || (mask & ~mesh_limits::ID_MASK) != 0)
+    return false;
+  allowed_ids_ = mask;
+  return true;
+}
+
+bool Membership::set_local_allowed_ids(uint16_t mask) {
+  if (initialized_ || (mask & ~mesh_limits::ID_MASK) != 0)
+    return false;
+  local_allowed_ids_ = mask;
+  return true;
+}
+
+bool Membership::set_timing(const Timing &timing) {
+  if (!valid_interval(timing.announce_ms) || !valid_interval(timing.member_lease_ms) ||
+      !valid_interval(timing.proof_refresh_ms) || !valid_interval(timing.challenge_retry_ms) ||
+      !valid_interval(timing.challenge_timeout_ms) || !valid_interval(timing.flood_dedup_ms) ||
+      timing.member_lease_ms <= timing.announce_ms || timing.challenge_timeout_ms <= timing.challenge_retry_ms ||
+      timing.flood_dedup_ms >= timing.challenge_retry_ms || timing.proof_refresh_ms >= timing.member_lease_ms ||
+      timing.challenge_timeout_ms >= timing.member_lease_ms - timing.proof_refresh_ms)
+    return false;
+  timing_ = timing;
+  return true;
+}
+
+const Claim *Membership::find(NodeId node_id) const {
+  if (node_id == 0 || node_id > kMaxNodes || !members_[node_id - 1].used)
+    return nullptr;
+  return &members_[node_id - 1].claim;
+}
+
+const Claim *Membership::find(const Mac &mac) const {
+  for (const Member &member : members_)
+    if (member.used && member.claim.mac == mac)
+      return &member.claim;
+  return nullptr;
+}
+
+uint16_t Membership::member_mask() const {
+  uint16_t mask = 0;
+  for (size_t i = 0; i < kMaxNodes; ++i)
+    if (members_[i].used)
+      mask |= static_cast<uint16_t>(1U << i);
+  return mask;
+}
+
+uint16_t Membership::gateway_mask(bool require_native_uplink) const {
+  uint16_t mask = 0;
+  for (size_t i = 0; i < kMaxNodes; ++i) {
+    const Member &member = members_[i];
+    if (member.used && (member.claim.flags & kGatewayCapable) != 0 &&
+        (!require_native_uplink || (member.claim.flags & kNativeUplink) != 0))
+      mask |= static_cast<uint16_t>(1U << i);
+  }
+  return mask;
+}
+
+bool Membership::send_(const Message &message) {
+  uint8_t wire[kMaxWireSize];
+  size_t written = 0;
+  if (!encode_message(message, wire, sizeof(wire), written) || callbacks_.send == nullptr ||
+      !callbacks_.send(callbacks_.context, wire, written)) {
+    ++counters_.send_rejected;
+    return false;
+  }
+  return true;
+}
+
+void Membership::change_slot_(NodeId slot, const Claim *claim, uint32_t now, bool proved) {
+  if (slot == 0 || slot > kMaxNodes)
+    return;
+  Member &member = members_[slot - 1];
+  SlotChange change;
+  change.node_id = slot;
+  change.had_previous = member.used;
+  if (member.used)
+    change.previous = member.claim;
+  change.has_current = claim != nullptr;
+  if (claim != nullptr)
+    change.current = *claim;
+  const bool identity_change =
+      member.used != (claim != nullptr) || (member.used && claim != nullptr && !same_owner(member.claim, *claim));
+  if (claim != nullptr) {
+    member.used = true;
+    member.claim = *claim;
+    if (proved || identity_change)
+      member.last_proved = now;
+  } else {
+    member = Member{};
+  }
+  if (identity_change) {
+    ++counters_.owner_changes;
+    if (callbacks_.slot_changed != nullptr)
+      callbacks_.slot_changed(callbacks_.context, change);
+  }
+}
+
+NodeId Membership::free_id_() const {
+  if (pinned_id_ != 0)
+    return (allowed_ids_ & local_allowed_ids_ & (1U << (pinned_id_ - 1))) != 0 && find(pinned_id_) == nullptr
+               ? pinned_id_
+               : 0;
+  for (size_t step = 0; step < kMaxNodes; ++step) {
+    const NodeId id = static_cast<NodeId>((preferred_id_ - 1 + step) % kMaxNodes + 1);
+    if ((allowed_ids_ & local_allowed_ids_ & (1U << (id - 1))) != 0 && find(id) == nullptr)
+      return id;
+  }
+  return 0;
+}
+
+void Membership::move_local_(LocalChange reason, uint32_t now) {
+  const NodeId previous = local_.node_id;
+  if (previous != 0) {
+    const Claim *owner = find(previous);
+    if (owner != nullptr && same_session(*owner, local_))
+      change_slot_(previous, nullptr, now);
+  }
+  local_.node_id = reason == LocalChange::PINNED_COLLISION ? 0 : free_id_();
+  ++local_.sequence;
+  announce_pending_ = true;
+  if (local_.node_id != 0)
+    change_slot_(local_.node_id, &local_, now);
+  else if (previous != 0)
+    ++counters_.capacity_exhausted;
+  if (previous != local_.node_id && callbacks_.local_changed != nullptr)
+    callbacks_.local_changed(callbacks_.context, previous, local_.node_id, reason);
+}
+
+bool Membership::commit_(const Claim &claim, uint32_t now) {
+  if (!mesh_protocol::compatible(local_.protocol, claim.protocol)) {
+    ++counters_.incompatible;
+    return false;
+  }
+  if (claim.node_id == 0 || claim.mac == local_.mac || (allowed_ids_ & (1U << (claim.node_id - 1))) == 0)
+    return false;
+  const Claim *previous_identity = find(claim.mac);
+  if (previous_identity != nullptr && same_session(*previous_identity, claim) &&
+      !newer(claim.sequence, previous_identity->sequence)) {
+    if (claim.node_id != previous_identity->node_id) {
+      ++counters_.replay;
+      return false;
+    }
+    // A new, authenticated direct handshake also counts as proof of life;
+    // it cannot roll flags or sequence back to stale handshake metadata.
+    members_[claim.node_id - 1].last_proved = now;
+    return true;
+  }
+  const Claim *current = find(claim.node_id);
+  if (current != nullptr && current->mac != claim.mac && !preferred(claim, *current))
+    return false;
+  const NodeId previous_slot = previous_identity != nullptr ? previous_identity->node_id : 0;
+  const bool local_loses = current != nullptr && same_session(*current, local_);
+  // A verified reboot or compact-ID move retires every outstanding challenge
+  // for that MAC. A delayed proof of its previous session/slot cannot undo it.
+  for (Pending &pending : pending_)
+    if (pending.used && pending.claim.mac == claim.mac)
+      pending = Pending{};
+  if (previous_slot != 0 && previous_slot != claim.node_id)
+    change_slot_(previous_slot, nullptr, now);
+  change_slot_(claim.node_id, &claim, now);
+  if (local_loses) {
+    ++counters_.local_collisions;
+    move_local_(pinned_id_ != 0 ? LocalChange::PINNED_COLLISION : LocalChange::COLLISION, now);
+  }
+  return true;
+}
+
+bool Membership::observe_verified(const Claim &claim, uint32_t now) {
+  if (initialized_ && !mesh_protocol::compatible(local_.protocol, claim.protocol)) {
+    ++counters_.incompatible;
+    return false;
+  }
+  if (!initialized_ || !valid_claim(claim) || claim.node_id == 0 || claim.mac == local_.mac) {
+    ++counters_.invalid;
+    return false;
+  }
+  expire_(now);
+  // A fresh direct handshake may carry sequence 0 rather than a membership
+  // counter. Preserve a later proven record for this same session and slot.
+  Claim verified = claim;
+  const Claim *previous = find(claim.mac);
+  if (previous != nullptr && same_owner(*previous, claim) && !newer(claim.sequence, previous->sequence))
+    verified = *previous;
+  return commit_(verified, now);
+}
+
+void Membership::send_challenge_(Pending &pending, uint32_t now) {
+  Message message;
+  message.type = MessageType::CHALLENGE;
+  message.claim = pending.claim;
+  message.requester = local_.mac;
+  message.challenge = pending.challenge;
+  if (send_(message)) {
+    pending.sent = true;
+    pending.last_sent = now;
+  }
+}
+
+bool Membership::start_challenge_(const Claim &claim, uint32_t now) {
+  if (claim.node_id == 0 || callbacks_.random_challenge == nullptr || (allowed_ids_ & (1U << (claim.node_id - 1))) == 0)
+    return false;
+  const Claim *current = find(claim.node_id);
+  if (current != nullptr && current->mac != claim.mac && !preferred(claim, *current))
+    return false;
+  Pending *available = nullptr;
+  for (Pending &pending : pending_) {
+    if (!pending.used) {
+      if (available == nullptr)
+        available = &pending;
+      continue;
+    }
+    if (same_session(pending.claim, claim) && pending.claim.node_id == claim.node_id) {
+      if (newer(claim.sequence, pending.claim.sequence))
+        pending.claim = claim;
+      return true;
+    }
+  }
+  if (available == nullptr) {
+    ++counters_.pending_full;
+    return false;
+  }
+  const uint64_t challenge = callbacks_.random_challenge(callbacks_.context);
+  if (challenge == 0)
+    return false;
+  *available = Pending{};
+  available->used = true;
+  available->claim = claim;
+  available->minimum_sequence = claim.sequence;
+  available->challenge = challenge;
+  available->started = now;
+  ++counters_.challenges_started;
+  send_challenge_(*available, now);
+  return true;
+}
+
+bool Membership::flood_seen_(const uint8_t *input, size_t length, uint32_t now) {
+  const uint64_t value = fingerprint(input, length);
+  for (FloodSeen &seen : seen_) {
+    if (seen.used && now - seen.last_seen >= timing_.flood_dedup_ms)
+      seen.used = false;
+    if (seen.used && seen.fingerprint == value)
+      return true;
+  }
+  seen_[seen_cursor_] = {value, now, true};
+  seen_cursor_ = (seen_cursor_ + 1) % kFloodCapacity;
+  return false;
+}
+
+void Membership::receive_claim_(const Claim &claim, uint32_t now) {
+  if (claim.mac == local_.mac) {
+    // Reflections are normal; another boot using our stable identity is not
+    // permitted to replace the running local identity.
+    if (claim.boot != local_.boot)
+      ++counters_.invalid;
+    return;
+  }
+  const Claim *previous = find(claim.mac);
+  if (previous != nullptr && same_session(*previous, claim)) {
+    if (!newer(claim.sequence, previous->sequence)) {
+      ++counters_.replay;
+      return;
+    }
+    if (claim.node_id == previous->node_id) {
+      // A group-authenticated monotonic counter updates metadata, but is not
+      // a fresh proof of life: previously unseen buffered claims can replay.
+      change_slot_(claim.node_id, &claim, now, false);
+      return;
+    }
+    if (claim.node_id == 0) {
+      change_slot_(previous->node_id, nullptr, now);
+      return;
+    }
+  }
+  start_challenge_(claim, now);
+}
+
+void Membership::receive_challenge_(const Message &message) {
+  if (message.claim.mac != local_.mac || message.claim.boot != local_.boot || message.claim.node_id != local_.node_id ||
+      local_.node_id == 0 ||
+      (message.claim.sequence != local_.sequence && !newer(local_.sequence, message.claim.sequence)))
+    return;
+  Message proof = message;
+  proof.type = MessageType::PROOF;
+  proof.hops = kMaxFloodHops;
+  proof.claim = local_;
+  send_(proof);
+}
+
+void Membership::receive_proof_(const Message &message, uint32_t now) {
+  if (message.requester != local_.mac)
+    return;
+  for (Pending &pending : pending_) {
+    if (!pending.used || pending.challenge != message.challenge || !same_owner(pending.claim, message.claim) ||
+        (pending.minimum_sequence != message.claim.sequence &&
+         !newer(message.claim.sequence, pending.minimum_sequence)))
+      continue;
+    pending.used = false;  // A nonce is accepted at most once.
+    ++counters_.proofs_accepted;
+    commit_(message.claim, now);
+    return;
+  }
+  ++counters_.replay;
+}
+
+bool Membership::receive(const uint8_t *input, size_t length, uint32_t now) {
+  Message message;
+  if (!initialized_ || !decode_message(input, length, message)) {
+    ++counters_.invalid;
+    return false;
+  }
+  if (!mesh_protocol::compatible(local_.protocol, message.claim.protocol)) {
+    ++counters_.incompatible;
+    return false;
+  }
+  expire_(now);
+  if (flood_seen_(input, length, now)) {
+    ++counters_.duplicate;
+    return true;
+  }
+  switch (message.type) {
+    case MessageType::CLAIM:
+      receive_claim_(message.claim, now);
+      break;
+    case MessageType::CHALLENGE:
+      receive_challenge_(message);
+      break;
+    case MessageType::PROOF:
+      receive_proof_(message, now);
+      break;
+  }
+  if (message.hops > 1) {
+    --message.hops;
+    send_(message);
+  }
+  return true;
+}
+
+void Membership::expire_(uint32_t now) {
+  for (NodeId id = 1; id <= kMaxNodes; ++id) {
+    const Member &member = members_[id - 1];
+    if (member.used && !same_session(member.claim, local_) && now - member.last_proved >= timing_.member_lease_ms)
+      change_slot_(id, nullptr, now);
+  }
+  for (Pending &pending : pending_)
+    if (pending.used && now - pending.started >= timing_.challenge_timeout_ms)
+      pending = Pending{};
+  if (local_.node_id == 0 && free_id_() != 0)
+    move_local_(LocalChange::CAPACITY_AVAILABLE, now);
+}
+
+void Membership::tick(uint32_t now) {
+  if (!initialized_)
+    return;
+  expire_(now);
+  for (const Member &member : members_)
+    if (member.used && !same_session(member.claim, local_) && now - member.last_proved >= timing_.proof_refresh_ms)
+      start_challenge_(member.claim, now);
+  for (Pending &pending : pending_)
+    if (pending.used && (!pending.sent || now - pending.last_sent >= timing_.challenge_retry_ms))
+      send_challenge_(pending, now);
+  if (!announced_ || announce_pending_ || now - last_announce_ >= timing_.announce_ms) {
+    Message announcement;
+    announcement.claim = local_;
+    ++announcement.claim.sequence;
+    if (send_(announcement)) {
+      local_ = announcement.claim;
+      if (local_.node_id != 0)
+        change_slot_(local_.node_id, &local_, now);
+      last_announce_ = now;
+      announced_ = true;
+      announce_pending_ = false;
+    }
+  }
+}
+
+void Membership::set_flags(uint8_t flags) {
+  if (!initialized_ || (flags & ~kKnownFlags) != 0 || ((flags & kNativeUplink) != 0 && (flags & kGatewayCapable) == 0))
+    return;
+  flags = static_cast<uint8_t>((flags & ~kPinnedId) | (pinned_id_ != 0 ? kPinnedId : 0));
+  if (flags == local_.flags)
+    return;
+  local_.flags = flags;
+  ++local_.sequence;
+  announce_pending_ = true;
+  if (local_.node_id != 0) {
+    Member &member = members_[local_.node_id - 1];
+    if (member.used && same_session(member.claim, local_))
+      member.claim = local_;
+  }
+}
+
+}  // namespace mesh_membership
diff --git a/esphome/components/mesh/mesh_membership.h b/esphome/components/mesh/mesh_membership.h
new file mode 100644
index 000000000..1c26f41ff
--- /dev/null
+++ b/esphome/components/mesh/mesh_membership.h
@@ -0,0 +1,202 @@
+#pragma once
+
+#include "mesh_limits.h"
+
+#include "mesh_protocol.h"
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+// Identity and admission are independent of the routing core's compact IDs.
+// This module contains no cryptography: the platform authenticates the outer
+// management message and its immediate peer before calling receive(). All
+// holders of the mesh credential are one trust group, not separate principals.
+namespace mesh_membership {
+
+using Mac = std::array<uint8_t, 6>;
+using BootNonce = std::array<uint8_t, 16>;
+using NodeId = uint8_t;
+constexpr NodeId kMaxNodes = mesh_limits::MAX_NODES;
+constexpr uint8_t kMaxFloodHops = 8;
+constexpr uint8_t kGatewayCapable = 1U << 0;
+constexpr uint8_t kPinnedId = 1U << 1;
+constexpr uint8_t kNativeUplink = 1U << 2;
+constexpr uint8_t kKnownFlags = kGatewayCapable | kPinnedId | kNativeUplink;
+constexpr size_t kClaimWireSize = 33 + mesh_protocol::PROFILE_WIRE_SIZE;
+constexpr size_t kProofWireSize = 47 + mesh_protocol::PROFILE_WIRE_SIZE;
+constexpr size_t kMaxWireSize = kProofWireSize;
+
+struct Claim {
+  Mac mac{};
+  BootNonce boot{};
+  NodeId node_id{0};
+  uint8_t flags{0};
+  uint32_t sequence{0};
+  mesh_protocol::Profile protocol{};
+};
+
+enum class MessageType : uint8_t { CLAIM = 1, CHALLENGE = 2, PROOF = 3 };
+struct Message {
+  MessageType type{MessageType::CLAIM};
+  uint8_t hops{kMaxFloodHops};
+  Claim claim{};
+  Mac requester{};
+  uint64_t challenge{0};
+};
+
+struct Timing {
+  uint32_t announce_ms{1000};
+  uint32_t member_lease_ms{12000};
+  uint32_t proof_refresh_ms{5000};
+  uint32_t challenge_retry_ms{750};
+  uint32_t challenge_timeout_ms{4000};
+  uint32_t flood_dedup_ms{500};
+};
+
+enum class LocalChange : uint8_t {
+  COLLISION = 1,
+  PINNED_COLLISION = 2,
+  CAPACITY_AVAILABLE = 3,
+};
+
+struct SlotChange {
+  NodeId node_id{0};
+  bool had_previous{false};
+  Claim previous{};
+  bool has_current{false};
+  Claim current{};
+};
+
+struct Counters {
+  uint32_t invalid{0};
+  uint32_t incompatible{0};
+  uint32_t duplicate{0};
+  uint32_t replay{0};
+  uint32_t challenges_started{0};
+  uint32_t proofs_accepted{0};
+  uint32_t owner_changes{0};
+  uint32_t local_collisions{0};
+  uint32_t pending_full{0};
+  uint32_t capacity_exhausted{0};
+  uint32_t send_rejected{0};
+};
+
+// Each send is one identity-addressed management flood, separate from the
+// core's ID routing. It must copy atomically; false permits later retry. The
+// outer adapter signs it with the group-management key and fans out only to
+// authenticated immediate peers. Forwarded packets retain their signed body
+// except for the decremented hops; the adapter signs the new outer message.
+// Callbacks may record work but must not synchronously re-enter this registry.
+struct Callbacks {
+  void *context{nullptr};
+  bool (*send)(void *, const uint8_t *, size_t){nullptr};
+  // Supply an unpredictable, nonzero nonce for every new challenge. Never use
+  // a constant/counter seeded identically across boots. Null disables remote
+  // claims, but observe_verified() still accepts fresh direct-peer proofs.
+  uint64_t (*random_challenge)(void *){nullptr};
+  // On every slot identity/session change, discard old Core/IP/DHCP/discovery
+  // ownership before allowing the new owner to use that compact ID. Metadata
+  // refreshes for the same owner do not call slot_changed.
+  void (*slot_changed)(void *, const SlotChange &){nullptr};
+  void (*local_changed)(void *, NodeId, NodeId, LocalChange){nullptr};
+};
+
+bool valid_mac(const Mac &mac);
+bool valid_claim(const Claim &claim);
+bool encode_message(const Message &message, uint8_t *output, size_t capacity, size_t &written);
+bool decode_message(const uint8_t *input, size_t length, Message &message);
+
+class Membership {
+ public:
+  // preferred_id is an optional persisted auto ID; pinned_id is an optional
+  // administrator constraint. Both are 0 or 1..16. An unassigned local node
+  // uses ID 0 only in management; it must not start a Core/IP endpoint.
+  bool begin(const Mac &mac, const BootNonce &boot, NodeId preferred_id = 0, NodeId pinned_id = 0,
+             uint8_t flags = kGatewayCapable, uint32_t now = 0, const mesh_protocol::Profile &protocol = {});
+  void set_callbacks(const Callbacks &callbacks) { callbacks_ = callbacks; }
+  // Optional manual compact-ID restriction. Call before begin(); the default
+  // permits all 16 slots. Zero permits management only, with no local slot.
+  bool set_allowed_ids(uint16_t mask);
+  // Separately reserve slots for other MAC identities. This constrains only
+  // our allocator; authenticated remote owners still use allowed_ids.
+  bool set_local_allowed_ids(uint16_t mask);
+  bool set_timing(const Timing &timing);
+  const Timing &timing() const { return timing_; }
+  void tick(uint32_t now);
+  // Authenticated physical neighbor handshake has proven this exact MAC,
+  // boot and slot freshly. A HELLO/unencrypted discovery is not this proof.
+  // sequence 0 may seed a freshly authenticated peer; a repeat cannot roll
+  // back a later authenticated membership announcement's sequence/flags.
+  bool observe_verified(const Claim &claim, uint32_t now);
+  // The caller verifies group HMAC and current immediate-peer session first.
+  // CLAIM alone never changes a different identity/session's live slot. A
+  // fresh local nonce proof is required, even for relayed group-auth packets.
+  // Metadata announcements never extend the hard proof lease. Direct fresh
+  // authentication or periodic identity nonce proofs renew it; buffering
+  // previously unseen sequence numbers cannot keep an offline owner alive.
+  bool receive(const uint8_t *input, size_t length, uint32_t now);
+  void set_flags(uint8_t flags);
+  void request_announce() { announce_pending_ = true; }
+
+  const Claim &local_claim() const { return local_; }
+  NodeId local_id() const { return local_.node_id; }
+  bool initialized() const { return initialized_; }
+  bool capacity_waiting() const { return initialized_ && local_.node_id == 0; }
+  const Claim *find(NodeId node_id) const;
+  const Claim *find(const Mac &mac) const;
+  uint16_t member_mask() const;
+  uint16_t gateway_mask(bool require_native_uplink = false) const;
+  const Counters &counters() const { return counters_; }
+
+ private:
+  struct Member {
+    bool used{false};
+    Claim claim{};
+    uint32_t last_proved{0};
+  };
+  struct Pending {
+    bool used{false};
+    Claim claim{};
+    uint64_t challenge{0};
+    uint32_t started{0}, last_sent{0};
+    uint32_t minimum_sequence{0};
+    bool sent{false};
+  };
+  struct FloodSeen {
+    uint64_t fingerprint{0};
+    uint32_t last_seen{0};
+    bool used{false};
+  };
+  static constexpr size_t kPendingCapacity = kMaxNodes;
+  static constexpr size_t kFloodCapacity = 64;
+
+  bool send_(const Message &message);
+  bool commit_(const Claim &claim, uint32_t now);
+  bool start_challenge_(const Claim &claim, uint32_t now);
+  void send_challenge_(Pending &pending, uint32_t now);
+  void expire_(uint32_t now);
+  void change_slot_(NodeId slot, const Claim *claim, uint32_t now, bool proved = true);
+  void move_local_(LocalChange reason, uint32_t now);
+  NodeId free_id_() const;
+  bool flood_seen_(const uint8_t *input, size_t length, uint32_t now);
+  void receive_claim_(const Claim &claim, uint32_t now);
+  void receive_challenge_(const Message &message);
+  void receive_proof_(const Message &message, uint32_t now);
+
+  Claim local_{};
+  NodeId pinned_id_{0}, preferred_id_{0};
+  uint16_t allowed_ids_{mesh_limits::ID_MASK};
+  uint16_t local_allowed_ids_{mesh_limits::ID_MASK};
+  bool initialized_{false}, announce_pending_{true}, announced_{false};
+  uint32_t last_announce_{0};
+  Callbacks callbacks_{};
+  Timing timing_{};
+  Member members_[kMaxNodes]{};
+  Pending pending_[kPendingCapacity]{};
+  FloodSeen seen_[kFloodCapacity]{};
+  size_t seen_cursor_{0};
+  Counters counters_{};
+};
+
+}  // namespace mesh_membership
diff --git a/esphome/components/mesh/mesh_native_recovery.h b/esphome/components/mesh/mesh_native_recovery.h
new file mode 100644
index 000000000..93938120b
--- /dev/null
+++ b/esphome/components/mesh/mesh_native_recovery.h
@@ -0,0 +1,114 @@
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace mesh_radio {
+
+// The literals are owned by generated code; credentials stay in stock Wi-Fi.
+struct NativeWifiNetwork {
+  const char *ssid{nullptr};
+  std::array<uint8_t, 6> bssid{};
+  uint8_t channel{0};
+  bool has_bssid{false};
+  bool hidden{false};
+  bool requires_auth{false};
+
+  bool matches(const uint8_t *scan_ssid, size_t ssid_length, const uint8_t *scan_bssid, uint8_t scan_channel,
+               bool authenticated) const {
+    if (this->ssid == nullptr)
+      return false;
+    // Keep the same selection rules as WiFiScanResult::matches. Hidden
+    // candidates are tried by stock Wi-Fi with its original credentials.
+    if (this->hidden) {
+      if (ssid_length != 0)
+        return false;
+    } else {
+      const size_t configured_length = std::strlen(this->ssid);
+      if (configured_length != 0 &&
+          (configured_length != ssid_length || std::memcmp(this->ssid, scan_ssid, ssid_length) != 0))
+        return false;
+    }
+    return (!this->has_bssid || std::memcmp(this->bssid.data(), scan_bssid, this->bssid.size()) == 0) &&
+           (this->channel == 0 || this->channel == scan_channel) && this->requires_auth == authenticated;
+  }
+};
+
+// Scan metadata only. The network literal and credentials have separate owners.
+struct NativeWifiCandidate {
+  size_t network_index{0};
+  std::array<uint8_t, 6> bssid{};
+  uint8_t channel{0};
+  int8_t rssi{0};
+  bool authenticated{false};
+  bool hidden{false};
+
+  bool valid(size_t network_count) const {
+    return this->network_index < network_count && this->channel >= 1 && this->channel <= 14 &&
+           this->bssid != std::array<uint8_t, 6>{} && (this->bssid[0] & 1) == 0;
+  }
+};
+
+// Each short channel visit releases its TX reservation after restoring home.
+// Unsigned elapsed arithmetic also covers millis() wraparound.
+class NativeRecovery {
+ public:
+  static constexpr uint32_t ROUND_MS = 60000;
+  static constexpr uint32_t STEP_MS = 1000;
+
+  void set_country(uint8_t first, uint8_t count) {
+    if (first < 1 || first > 14 || count == 0 || unsigned(first) + count > 15) {
+      this->first_ = 1;
+      this->last_ = 11;
+    } else {
+      this->first_ = first;
+      this->last_ = first + count - 1;
+    }
+    this->cancel();
+  }
+
+  bool due(uint32_t now, uint32_t last_round) const {
+    return this->active_ ? now - this->last_step_ >= STEP_MS : now - last_round >= ROUND_MS;
+  }
+
+  uint8_t next(uint32_t now, uint8_t home, uint32_t &last_round) {
+    if (!this->due(now, last_round))
+      return 0;
+    if (!this->active_) {
+      this->active_ = true;
+      this->visited_ = 0;
+      last_round = now;
+      if (home >= this->first_ && home <= this->last_)
+        return home;
+    }
+    for (uint8_t channel = this->first_; channel <= this->last_; ++channel)
+      if ((this->visited_ & (1U << (channel - 1))) == 0)
+        return channel;
+    return 0;
+  }
+
+  void complete(uint32_t now, uint8_t channel) {
+    this->visited_ |= uint16_t(1U << (channel - 1));
+    this->last_step_ = now;
+    uint16_t legal = 0;
+    for (uint8_t value = this->first_; value <= this->last_; ++value)
+      legal |= uint16_t(1U << (value - 1));
+    if ((this->visited_ & legal) == legal)
+      this->active_ = false;
+  }
+
+  void cancel() {
+    this->active_ = false;
+    this->visited_ = 0;
+  }
+
+ protected:
+  uint32_t last_step_{0};
+  uint16_t visited_{0};
+  uint8_t first_{1}, last_{11};
+  bool active_{false};
+};
+
+}  // namespace mesh_radio
