+"""Real mesh validation supplies normal CLI targets, including the warm cache."""
+
+from pathlib import Path
+from tempfile import TemporaryDirectory
+import unittest
+from unittest.mock import patch
+
+import yaml
+
+from esphome import __main__ as cli
+from esphome.compiled_config import load_compiled_config, save_compiled_config
+from esphome.config import read_config
+from esphome.core import CORE
+from esphome.storage_json import StorageJSON, storage_path
+from esphome.types import ConfigType
+
+
+class MeshNetworkProviderTests(unittest.TestCase):
+    def setUp(self) -> None:
+        CORE.reset()
+        self.directory = TemporaryDirectory(prefix="mesh-provider-")
+        self.addCleanup(self.directory.cleanup)
+        self.path = Path(self.directory.name) / "mesh.yaml"
+
+    def tearDown(self) -> None:
+        CORE.reset()
+
+    def validated(self, wifi: ConfigType | None = None) -> ConfigType:
+        config: ConfigType = {
+            "esphome": {"name": "mesh-provider-fixture"},
+            "esp32": {
+                "board": "esp32-s3-devkitc-1",
+                "framework": {"type": "esp-idf", "version": "5.5.5"},
+            },
+            "mesh": {"key": "00" * 32},
+            "logger": {},
+            "api": {},
+            "ota": [{"platform": "esphome"}],
+        }
+        if wifi is not None:
+            config["wifi"] = wifi
+        self.path.write_text(yaml.safe_dump(config, sort_keys=False), encoding="utf-8")
+        CORE.config_path = self.path
+        validated = read_config({})
+        self.assertIsNotNone(validated)
+        CORE.config = validated
+        return validated
+
+    def assert_targets(self, expected: str) -> None:
+        self.assertTrue(CORE.has_networking)
+        self.assertEqual(CORE.address, expected)
+        for purpose in (cli.Purpose.UPLOADING, cli.Purpose.LOGGING):
+            with self.subTest(purpose=purpose):
+                self.assertEqual(
+                    cli.choose_upload_log_host("OTA", None, purpose), [expected]
+                )
+
+    def test_cold_mesh_uses_ordinary_hostname_for_uploads_and_logs(self) -> None:
+        self.validated()
+        self.assertNotIn("wifi", CORE.config)
+        self.assertNotIn("ethernet", CORE.config)
+        self.assert_targets("mesh-provider-fixture.local")
+
+    def test_warm_cache_keeps_mesh_provider_without_revalidation(self) -> None:
+        config = self.validated()
+        StorageJSON.from_esphome_core(CORE, None, claim_build=False).save(
+            storage_path()
+        )
+        save_compiled_config(config)
+        CORE.reset()
+        CORE.config_path = self.path
+        with patch(
+            "esphome.components.mesh.validate_boot_mode",
+            side_effect=AssertionError("Warm cache must not rerun mesh validation"),
+        ):
+            loaded = load_compiled_config(self.path)
+            self.assertIsNotNone(loaded)
+            CORE.config = loaded
+        self.assert_targets("mesh-provider-fixture.local")
+
+    def test_native_use_address_retains_precedence(self) -> None:
+        self.validated({"ssid": "fixture", "use_address": "native.example"})
+        self.assert_targets("native.example")
+
+    def test_codegen_contains_each_network_without_mesh_password_storage(self) -> None:
+        config = self.validated(
+            {
+                "networks": [
+                    {"ssid": "first", "password": "synthetic-password"},
+                    {"ssid": "second", "bssid": "02:00:00:00:00:02", "channel": 11},
+                ]
+            }
+        )
+        cli.generate_cpp_contents(config)
+        calls = [
+            line
+            for line in CORE.cpp_main_section.splitlines()
+            if "set_native_wifi_network(" in line
+        ]
+        self.assertEqual(len(calls), 2)
+        self.assertIn('"first"', calls[0])
+        self.assertIn('"second"', calls[1])
+        self.assertNotIn("synthetic-password", "\n".join(calls))
