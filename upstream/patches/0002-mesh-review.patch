+uint32_t MeshComponent::rx_drop_count() const {
+  MeshGuard guard(this->mutex_);
+  return this->rx_drops_.load() +
+         (this->runtime_ ? this->runtime_->transport_counters().receive_drops + this->runtime_->counters().policy_drops
+                         : 0);
