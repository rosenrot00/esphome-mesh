+struct Network {
+  struct Packet {
+    size_t sender;
+    std::vector<uint8_t> bytes;
+  };
+  struct Node {
+    Network *network{nullptr};
+    size_t index{0};
+    Membership member;
+    uint64_t nonce{0};
+  };
+  std::vector<Node> nodes;
+  std::vector<std::vector<bool>> edges;
+  std::deque<Packet> packets;
+  uint32_t now{0};
+  size_t delivered{0};
+  explicit Network(size_t count) : nodes(count), edges(count, std::vector<bool>(count, false)) {
+    for (size_t i = 0; i < count; ++i) {
+      Node &node = nodes[i];
+      node.network = this;
+      node.index = i;
+      node.nonce = (i + 1) << 48;
+      node.member.set_callbacks(
+          {&node,
+           [](void *context, const uint8_t *bytes, size_t length) {
+             const auto &self = *static_cast<Node *>(context);
+             self.network->packets.push_back({self.index, std::vector<uint8_t>(bytes, bytes + length)});
+             return true;
+           },
+           [](void *context) { return ++static_cast<Node *>(context)->nonce; }, nullptr, nullptr});
+    }
+  }
+  void begin(size_t index, uint8_t number, NodeId preferred = 1, NodeId pinned = 0) {
+    assert(nodes[index].member.begin(mac(number), boot(number), preferred, pinned, kGatewayCapable, now));
+  }
+  void link(size_t first, size_t second, bool connected = true) {
+    edges[first][second] = edges[second][first] = connected;
+  }
+  void drain() {
+    size_t budget = 20000;
+    while (!packets.empty()) {
+      assert(budget-- != 0);
+      Packet packet = packets.front();
+      packets.pop_front();
+      for (size_t recipient = 0; recipient < nodes.size(); ++recipient) {
+        if (!edges[packet.sender][recipient])
+          continue;
+        assert(nodes[recipient].member.receive(packet.bytes.data(), packet.bytes.size(), now));
+        ++delivered;
+      }
+    }
+  }
+  void run(uint32_t duration) {
+    const uint32_t finish = now + duration;
+    do {
+      for (Node &node : nodes)
+        node.member.tick(now);
+      drain();
+      now += 100;
+    } while (static_cast<int32_t>(finish - now) >= 0);
+  }
+  void assert_converged(size_t expected_members) const {
+    uint16_t ids = 0;
+    for (const Node &node : nodes) {
+      const NodeId id = node.member.local_id();
+      if (id == 0)
+        continue;
+      assert((ids & (1U << (id - 1))) == 0);
+      ids |= 1U << (id - 1);
+    }
+    for (const Node &node : nodes) {
+      assert(node.member.member_mask() == ids);
+      size_t count = 0;
+      for (NodeId id = 1; id <= 16; ++id) {
+        const Claim *record = node.member.find(id);
+        if (record != nullptr) {
+          ++count;
+          auto actual = std::find_if(nodes.begin(), nodes.end(), [&](const Node &candidate) {
+            return candidate.member.local_claim().mac == record->mac;
+          });
+          assert(actual != nodes.end() && actual->member.local_id() == id);
+        }
+      }
+      assert(count == expected_members);
+    }
+  }
+};
+
+TEST(MeshMembership, ThreeHopCollisionConvergenceAndJoinStability) {
+  Network network(4);
+  network.begin(0, 10);
+  network.begin(1, 20);
+  network.begin(2, 30);
+  network.link(0, 1);
+  network.link(1, 2);
+  network.run(5000);
+  ASSERT_TRUE(network.nodes[0].member.local_id() == 1);
+  ASSERT_TRUE(network.nodes[1].member.local_id() == 2);
+  ASSERT_TRUE(network.nodes[2].member.local_id() == 3);
+  const NodeId previous[] = {1, 2, 3};
+  network.begin(3, 40, 8);
+  network.link(2, 3);
+  network.run(5000);
+  network.assert_converged(4);
+  for (size_t i = 0; i < 3; ++i)
+    ASSERT_TRUE(network.nodes[i].member.local_id() == previous[i]);
+  ASSERT_TRUE(network.nodes[3].member.local_id() == 8);
+  ASSERT_TRUE(network.delivered < 2000);  // Hop/dedup work stays bounded in a line.
+}
