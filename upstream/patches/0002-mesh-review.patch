+TEST(MeshIpDelivery, ResetAndStaleTokensCannotRecycleAFillingOriginal) {
+  Network network;
+  PacketDelivery::TxReservation old, current, extra;
+  ASSERT_TRUE((network.a.delivery.reserve(old)));
+  auto *writer = network.a.delivery.reserved_data(old);
+  network.a.delivery.reset(false);
+  ASSERT_TRUE((network.a.delivery.reserved_data(old) == nullptr));
+  ASSERT_TRUE((network.a.delivery.reserve(current)));
+  ASSERT_TRUE((network.a.delivery.reserved_data(current) != writer));
+  ASSERT_TRUE((!network.a.delivery.reserve(extra)));
+  writer[1499] = 123;  // An invalidated writer still exclusively owns its storage.
+  ASSERT_TRUE((!network.a.delivery.commit(old, 2, 1500, 1, 0)));
+  ASSERT_TRUE((network.a.delivery.reserve(extra)));
+  network.a.delivery.cancel(old);  // Cannot release the slot's new reservation.
+  ASSERT_TRUE((network.a.delivery.reserved_data(extra) != nullptr && !network.a.delivery.can_begin()));
+  ASSERT_TRUE((!network.a.delivery.commit(extra, 1, 1500, 1, 0)));  // Invalid destination consumes only its token.
+  ASSERT_TRUE((network.a.delivery.can_begin()));
+  ASSERT_TRUE((network.a.delivery.configure(1, {}, network.a.callbacks())));
+  ASSERT_TRUE((network.a.delivery.reserved_data(current) == nullptr));
+  ASSERT_TRUE((!network.a.delivery.commit(current, 2, 1, 1, 0)));
+  ASSERT_TRUE((network.a.delivery.reserve(current)));
+  network.a.delivery.reset_peer(3);
+  ASSERT_TRUE((network.a.delivery.reserved_data(current) == nullptr));
+  network.a.delivery.cancel(current);
+  ASSERT_TRUE((network.a.delivery.reserve(current)));
+  auto *target = network.a.delivery.reserved_data(current);
+  target[0] = 42;
+  ASSERT_TRUE((network.a.delivery.commit(current, 2, 1, 1, 5)));
+  ASSERT_TRUE((network.a.delivery.reserve(extra)));
+  network.a.delivery.reserved_data(extra)[0] = 43;
+  ASSERT_TRUE((!network.a.delivery.commit(extra, 3, 1, 1, 5)));  // Duplicate active packet ID is rejected.
+  network.run(5);
+  ASSERT_TRUE((network.b.delivered == std::vector<Bytes>{Bytes{42}} && network.c.delivered.empty()));
+}
