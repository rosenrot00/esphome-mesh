+TEST(MeshMembership, FullMeshCapacityConvergesWithoutAliases) {
+  Network network(17);
+  for (size_t i = 0; i < network.nodes.size(); ++i) {
+    network.begin(i, static_cast<uint8_t>(i + 1), 1);
+    // A star exercises identity-routed gossip without assuming route IDs.
+    if (i != 0)
+      network.link(0, i);
+  }
+  network.run(20000);
+  network.assert_converged(16);
+  ASSERT_TRUE(network.nodes.back().member.local_id() == 0);
+  ASSERT_TRUE(network.nodes[0].member.local_id() == 1);
+}
