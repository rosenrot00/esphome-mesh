+  Reassembler replay;
+  CompletedPacket complete;
+  const auto one = fragments(packet(1), 9);
+  const uint32_t start = UINT32_MAX - 1000U;
+  ASSERT_TRUE(receive(replay, one[0], start, complete) == ReceiveResult::COMPLETE);
+  ASSERT_TRUE(receive(replay, one[0], start + 1999U, complete) == ReceiveResult::DUPLICATE);
+  ASSERT_TRUE(receive(replay, one[0], start + 2000U, complete) == ReceiveResult::COMPLETE);
+}
