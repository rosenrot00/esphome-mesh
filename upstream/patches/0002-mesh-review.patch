@@ -0,0 +1,70 @@
+#include <gtest/gtest.h>
+
+#include "esphome/components/mesh/mesh_native_recovery.h"
+#include "esphome/components/mesh/mesh_radio_ownership.h"
+
+namespace esphome::mesh::testing {
+
+TEST(NativeWifiCandidate, DefaultHasNoUsableTarget) {
+  const mesh_radio::NativeWifiCandidate candidate;
+  EXPECT_FALSE(candidate.valid(1));
+}
+
+TEST(NativeWifiCandidate, RequiresCurrentNetworkAndLegalMeshChannel) {
+  mesh_radio::NativeWifiCandidate candidate{1, {2, 4, 6, 8, 10, 12}, 6, -55, true, false};
+  EXPECT_TRUE(candidate.valid(2));
+  EXPECT_FALSE(candidate.valid(1));
+  EXPECT_FALSE(candidate.valid(0));
+  candidate.channel = 14;
+  EXPECT_TRUE(candidate.valid(2));
+  candidate.channel = 15;
+  EXPECT_FALSE(candidate.valid(2));
+  candidate.channel = 0;
+  EXPECT_FALSE(candidate.valid(2));
+}
+
+TEST(NativeWifiCandidate, RequiresNonzeroUnicastAddress) {
+  mesh_radio::NativeWifiCandidate candidate{0, {2, 4, 6, 8, 10, 12}, 6, -55, false, false};
+  EXPECT_TRUE(candidate.valid(1));
+  candidate.bssid[0] = 3;
+  EXPECT_FALSE(candidate.valid(1));
+  candidate.bssid = {};
+  EXPECT_FALSE(candidate.valid(1));
+}
+
+TEST(NativeWifiCandidate, NetworkMatchingPreservesHiddenAndAuthenticationRules) {
+  const uint8_t name[]{'a', 'p'}, empty[]{0};
+  const uint8_t address[]{2, 4, 6, 8, 10, 12};
+  mesh_radio::NativeWifiNetwork network{"ap", {2, 4, 6, 8, 10, 12}, 6, true, false, true};
+  EXPECT_TRUE(network.matches(name, 2, address, 6, true));
+  EXPECT_FALSE(network.matches(name, 2, address, 6, false));
+  EXPECT_FALSE(network.matches(name, 2, address, 11, true));
+  network.hidden = true;
+  EXPECT_FALSE(network.matches(name, 2, address, 6, true));
+  EXPECT_TRUE(network.matches(empty, 0, address, 6, true));
+}
+
+TEST(NativeWifiRecovery, KeepsStockAuthenticationRetryWindow) {
+  for (const uint32_t start : {1000U, UINT32_MAX - 2000U}) {
+    mesh_radio::RadioOwnership owner;
+    owner.start_native_acquisition(start, true);
+    for (const bool route : {false, true}) {
+      // Stock connected after 28.256 seconds; discovering the AP saves only its scan.
+      EXPECT_FALSE(owner.fallback_due(start + 28256U, route, false));
+      EXPECT_FALSE(owner.fallback_due(start + 59999U, route, true));
+      EXPECT_TRUE(owner.fallback_due(start + 60000U, route, true));
+    }
+    owner.observe_native(start + 28256U, true);
+    EXPECT_FALSE(owner.fallback_due(start + 60000U, true, false));
+  }
+}
+
+TEST(NativeWifiRecovery, FailedRetriesCannotExtendBoundedOwnership) {
+  mesh_radio::RadioOwnership owner;
+  owner.start_native_acquisition(1000, true);
+  for (uint32_t now = 8000; now < 61000; now += 7000)
+    owner.observe_native(now, false);
+  EXPECT_TRUE(owner.fallback_due(61000, false, false));
+}
+
+}  // namespace esphome::mesh::testing
