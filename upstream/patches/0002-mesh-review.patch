+  ASSERT_TRUE(proof.challenge != 0 && proof.requester == fixture.member.local_claim().mac);
+  proof.type = MessageType::PROOF;
+  ++proof.challenge;
+  ASSERT_TRUE(deliver(fixture.member, proof, 10) && fixture.member.find(2) == nullptr);
+  --proof.challenge;
+  proof.claim.boot = boot(99);
+  ASSERT_TRUE(deliver(fixture.member, proof, 20) && fixture.member.find(2) == nullptr);
+  proof.claim = remote;
+  proof.claim.node_id = 3;
