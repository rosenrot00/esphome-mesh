diff --git a/esphome/components/mesh/mesh_protocol.h b/esphome/components/mesh/mesh_protocol.h
new file mode 100644
index 000000000..93ce47273
--- /dev/null
+++ b/esphome/components/mesh/mesh_protocol.h
@@ -0,0 +1,93 @@
+#pragma once
+
+#include "mesh_limits.h"
+
+#include <cstddef>
+#include <cstdint>
+
+namespace mesh_protocol {
+
+constexpr size_t PROFILE_WIRE_SIZE = 9;
+constexpr uint8_t STATIC_FRAME_VERSION = 5;
+constexpr uint8_t SESSION_FRAME_VERSION = 6;
+constexpr uint16_t IP_PACKET_ACK = 1U << 0;
+constexpr uint16_t ENDPOINT_SESSION_PROOF = 1U << 1;
+constexpr uint16_t VARIABLE_FRAGMENT_SIZE = 1U << 2;
+constexpr uint16_t WIDE_FRAME_LENGTH = 1U << 3;
+constexpr uint16_t WIDE_FRAGMENT_STRIDE = 1U << 4;
+constexpr uint16_t IPV6_PROXY = 1U << 5;
+constexpr uint16_t MANUAL_BOOT_SESSION = 1U << 6;
+#ifdef MESH_IPV6
+constexpr uint16_t REQUIRED_IPV6 = IPV6_PROXY;
+#else
+constexpr uint16_t REQUIRED_IPV6 = 0;
+#endif
+
+// A protocol contract, not a firmware release number. Optional future features
+// remain compatible; a required feature must be implemented at both ends.
+// This revision uses one common payload budget throughout the mesh.
+struct Profile {
+  uint8_t frame_version{SESSION_FRAME_VERSION};
+  uint8_t endpoint_revision{1};
+  uint16_t payload_budget{mesh_limits::PROTOCOL_PAYLOAD_BUDGET};
+  uint8_t max_nodes{mesh_limits::MAX_NODES};
+  uint16_t provided{IP_PACKET_ACK | ENDPOINT_SESSION_PROOF | VARIABLE_FRAGMENT_SIZE | WIDE_FRAME_LENGTH |
+                    WIDE_FRAGMENT_STRIDE | REQUIRED_IPV6};
+  uint16_t required{IP_PACKET_ACK | ENDPOINT_SESSION_PROOF | WIDE_FRAME_LENGTH | WIDE_FRAGMENT_STRIDE | REQUIRED_IPV6};
+};
+// Manual peers have no automatic admission exchange. Their separate bootstrap
+// proves this exact protocol contract before admitting session-scoped traffic.
+constexpr Profile manual_profile() {
+  Profile profile;
+  profile.provided |= MANUAL_BOOT_SESSION;
+  profile.required |= MANUAL_BOOT_SESSION;
+  return profile;
+}
+constexpr bool valid(const Profile &profile) {
+  return profile.frame_version != 0 && profile.endpoint_revision != 0 &&
+         (profile.max_nodes == 4 || profile.max_nodes == 8 || profile.max_nodes == 16) &&
+         profile.payload_budget >= 43 && profile.payload_budget <= mesh_limits::PROTOCOL_PAYLOAD_BUDGET &&
+         (profile.required & ~profile.provided) == 0;
+}
+constexpr bool same(const Profile &first, const Profile &second) {
+  return first.frame_version == second.frame_version && first.endpoint_revision == second.endpoint_revision &&
+         first.payload_budget == second.payload_budget && first.max_nodes == second.max_nodes &&
+         first.provided == second.provided && first.required == second.required;
+}
+constexpr bool compatible(const Profile &local, const Profile &remote) {
+  return valid(local) && valid(remote) && local.frame_version == remote.frame_version &&
+         local.endpoint_revision == remote.endpoint_revision && local.payload_budget == remote.payload_budget &&
+         local.max_nodes == remote.max_nodes && (local.required & ~remote.provided) == 0 &&
+         (remote.required & ~local.provided) == 0;
+}
+inline bool encode(const Profile &profile, uint8_t *output, size_t capacity) {
+  if (!valid(profile) || output == nullptr || capacity < PROFILE_WIRE_SIZE)
+    return false;
+  output[0] = profile.frame_version;
+  output[1] = profile.endpoint_revision;
+  output[2] = static_cast<uint8_t>(profile.payload_budget);
+  output[3] = static_cast<uint8_t>(profile.payload_budget >> 8);
+  output[4] = profile.max_nodes;
+  const uint16_t fields[]{profile.provided, profile.required};
+  for (size_t i = 0; i < 2; ++i) {
+    output[5 + i * 2] = static_cast<uint8_t>(fields[i]);
+    output[6 + i * 2] = static_cast<uint8_t>(fields[i] >> 8);
+  }
+  return true;
+}
+inline bool decode(const uint8_t *input, size_t length, Profile &profile) {
+  if (input == nullptr || length != PROFILE_WIRE_SIZE)
+    return false;
+  Profile candidate{input[0],
+                    input[1],
+                    static_cast<uint16_t>(input[2] | (uint16_t(input[3]) << 8)),
+                    input[4],
+                    static_cast<uint16_t>(input[5] | (uint16_t(input[6]) << 8)),
+                    static_cast<uint16_t>(input[7] | (uint16_t(input[8]) << 8))};
+  if (!valid(candidate))
+    return false;
+  profile = candidate;
+  return true;
+}
+
+}  // namespace mesh_protocol
diff --git a/esphome/components/mesh/mesh_radio_channel.h b/esphome/components/mesh/mesh_radio_channel.h
new file mode 100644
index 000000000..a0cb64bfe
--- /dev/null
+++ b/esphome/components/mesh/mesh_radio_channel.h
@@ -0,0 +1,93 @@
+#pragma once
+
+#include "mesh_limits.h"
+
+#include <cstdint>
+
+namespace mesh_radio {
+
+struct RadioSearchState {
+  bool mesh_owned{false};
+  bool wifi_disabled{false};
+  bool associated{false};
+  bool quiet{false};
+  bool scanning{false};
+  bool route_connected{false};
+  uint8_t route_root{0};
+  uint8_t gateway{0};
+};
+
+// Acquisition changes the channel only after the authenticated mesh route has
+// expired. A usable route pins the radio; associated Wi-Fi always owns its PHY.
+class ChannelSearch {
+ public:
+  static constexpr uint32_t DWELL_MS = 1000;
+  static constexpr uint32_t RETRY_MS = 250;
+
+  static bool eligible(const RadioSearchState &state) {
+    const bool usable_route = state.route_connected && (state.gateway == 0 || state.route_root == state.gateway);
+    return state.gateway != 0 && state.mesh_owned && state.wifi_disabled && !state.associated && !state.quiet &&
+           !state.scanning && !usable_route;
+  }
+
+  void set_country(uint8_t first, uint8_t count) {
+    if (first < 1 || first > 14 || count == 0 || unsigned(first) + count > 15) {
+      first_ = 1;
+      last_ = 11;
+    } else {
+      first_ = first;
+      last_ = first + count - 1;
+    }
+  }
+
+  uint8_t candidate(uint32_t now, uint8_t current, const RadioSearchState &state) {
+    if (!eligible(state)) {
+      searching_ = false;
+      pending_ = 0;
+      return 0;
+    }
+    if (!searching_ || current != current_) {
+      searching_ = true;
+      current_ = current;
+      since_ = now;
+      pending_ = 0;
+      retrying_ = false;
+      return 0;
+    }
+    if (pending_ != 0)
+      return !retrying_ || now - last_attempt_ >= RETRY_MS ? pending_ : 0;
+    if (now - since_ < DWELL_MS)
+      return 0;
+    const uint8_t next = current < first_ || current >= last_ ? first_ : current + 1;
+    // A country permitting one channel has nothing to search.
+    if (next == current) {
+      since_ = now;
+      return 0;
+    }
+    pending_ = next;
+    return pending_;
+  }
+
+  void complete(uint32_t now, uint8_t channel, bool success) {
+    if (pending_ == 0 || channel != pending_)
+      return;
+    if (success) {
+      current_ = channel;
+      since_ = now;
+      pending_ = 0;
+      retrying_ = false;
+    } else {
+      last_attempt_ = now;
+      retrying_ = true;
+    }
+  }
+
+  bool searching() const { return searching_; }
+
+ protected:
+  uint8_t first_{1}, last_{11}, current_{0}, pending_{0};
+  uint32_t since_{0}, last_attempt_{0};
+  bool searching_{false}, retrying_{false};
+};
+
+}  // namespace mesh_radio
diff --git a/esphome/components/mesh/mesh_radio_frame.h b/esphome/components/mesh/mesh_radio_frame.h
new file mode 100644
index 000000000..2e5ccc460
--- /dev/null
+++ b/esphome/components/mesh/mesh_radio_frame.h
@@ -0,0 +1,46 @@
+#pragma once
+
+#include "mesh_limits.h"
+
+#include "mesh_core.h"
+
+namespace mesh_radio {
+
+// RX metadata describes the receiver's tuning, so an adjacent-channel packet
+// cannot prove the sender uses that same channel. Carry the sender's actual PHY
+// inside the encrypted unicast, while keeping the portable core wire unchanged.
+constexpr size_t ADVERTISEMENT_RADIO_TRAILER_SIZE = 4;
+
+inline bool encode_radio_frame(const ::mesh_core::Frame &frame, uint8_t channel, uint8_t *output, size_t capacity,
+                               size_t &written) {
+  written = 0;
+  const bool advertisement = frame.type == ::mesh_core::FrameType::ADVERTISEMENT;
+  if (advertisement && (channel < 1 || channel > 14 ||
+                        capacity < ::mesh_core::wire_header_size(frame) + ADVERTISEMENT_RADIO_TRAILER_SIZE))
+    return false;
+  if (!::mesh_core::encode_frame(frame, output, capacity, written))
+    return false;
+  if (advertisement) {
+    output[written++] = 'R';
+    output[written++] = 'C';
+    output[written++] = 1;
+    output[written++] = channel;
+  }
+  return true;
+}
+
+inline bool decode_radio_frame(const uint8_t *input, size_t length, uint8_t local_channel, ::mesh_core::Frame &frame) {
+  if (input == nullptr || length < ::mesh_core::kWireHeaderSize)
+    return false;
+  if (input[3] == static_cast<uint8_t>(::mesh_core::FrameType::ADVERTISEMENT)) {
+    const size_t offset = ::mesh_core::wire_header_size_for_version(input[2]);
+    if (offset == 0 || length != offset + ADVERTISEMENT_RADIO_TRAILER_SIZE || local_channel < 1 || local_channel > 14 ||
+        input[offset] != 'R' || input[offset + 1] != 'C' || input[offset + 2] != 1 ||
+        input[offset + 3] != local_channel)
+      return false;
+    length = offset;  // The core still validates a zero-payload advertisement.
+  }
+  return ::mesh_core::decode_frame(input, length, frame);
+}
+
+}  // namespace mesh_radio
diff --git a/esphome/components/mesh/mesh_radio_ownership.h b/esphome/components/mesh/mesh_radio_ownership.h
new file mode 100644
index 000000000..51dcd23c9
--- /dev/null
+++ b/esphome/components/mesh/mesh_radio_ownership.h
@@ -0,0 +1,92 @@
+#pragma once
+
+#include "mesh_limits.h"
+
+#include <cstdint>
+
+namespace mesh_radio {
+
+struct RadioTxState {
+  bool mesh_owned{false};
+  bool associated{false};
+  bool native_connected{false};
+  bool native_roaming{false};
+  bool scan_reserved{false};
+  bool channel_hop_pending{false};
+};
+
+// Native association/scanning and connectionless mesh share one PHY. Native
+// acquisition owns it exclusively until connected or explicitly handed over.
+// This budget bounds our ownership phase, not ESPHome's internal retry cycle.
+class RadioOwnership {
+ public:
+  static constexpr uint32_t NATIVE_ACQUISITION_MS = 60000;
+  // An AP hint avoids scanning, but authentication and DHCP still need the
+  // normal acquisition window. A shorter deadline can repeatedly abort retries.
+  static constexpr uint32_t NATIVE_RECOVERY_MS = NATIVE_ACQUISITION_MS;
+  static constexpr uint32_t PARENT_CHANNEL_MAX_AGE_MS = 2000;
+
+  static bool lifecycle_allowed(const RadioTxState &state) {
+    // A connected background scan keeps the existing SDK/peer state alive.
+    // Initial acquisition and disconnected reassociation still own the PHY.
+    return state.mesh_owned || (state.associated && state.native_connected);
+  }
+
+  static bool transmit_allowed(const RadioTxState &state) {
+    return !state.scan_reserved && !state.channel_hop_pending && (state.mesh_owned || !state.native_roaming) &&
+           lifecycle_allowed(state);
+  }
+
+  void start_native_acquisition(uint32_t now, bool returning_from_mesh = false) {
+    acquisition_started_ = now;
+    acquisition_budget_ = returning_from_mesh ? NATIVE_RECOVERY_MS : NATIVE_ACQUISITION_MS;
+    native_connected_ = false;
+    fast_handover_ = false;
+  }
+
+  void observe_native(uint32_t now, bool connected) {
+    if (connected) {
+      native_connected_ = true;
+      return;
+    }
+    if (native_connected_) {
+      acquisition_started_ = now;
+      acquisition_budget_ = NATIVE_ACQUISITION_MS;
+      native_connected_ = false;
+      fast_handover_ = true;
+    }
+  }
+
+  bool fallback_due(uint32_t now, bool remote_route, bool roaming) const {
+    if (native_connected_)
+      return false;
+    const uint32_t age = now - acquisition_started_;
+    // Short managed roams retain native priority. RECONNECTING can remain set
+    // indefinitely when an AP disappears, so only the fast path is deferred;
+    // the bounded acquisition deadline must still release the radio.
+    return (fast_handover_ && remote_route && !roaming) || (age < 0x80000000U && age >= acquisition_budget_);
+  }
+
+  // Only call after full wire/auth/policy checks and Core has selected this
+  // immediate sender as parent. A driver's transient scan channel is no hint.
+  void observe_parent_channel(uint32_t now, uint8_t sender, uint8_t parent, uint8_t channel) {
+    if (sender == 0 || sender != parent || channel < 1 || channel > 14)
+      return;
+    parent_channel_ = channel;
+    parent_channel_seen_ = now;
+  }
+
+  uint8_t preferred_mesh_channel(uint32_t now, uint8_t fallback) const {
+    const uint32_t age = now - parent_channel_seen_;
+    if (parent_channel_ != 0 && age < PARENT_CHANNEL_MAX_AGE_MS)
+      return parent_channel_;
+    return fallback >= 1 && fallback <= 14 ? fallback : 1;
+  }
+
+ protected:
+  uint32_t acquisition_started_{0}, parent_channel_seen_{0}, acquisition_budget_{NATIVE_ACQUISITION_MS};
+  uint8_t parent_channel_{0};
+  bool native_connected_{false}, fast_handover_{false};
+};
+
+}  // namespace mesh_radio
diff --git a/esphome/components/mesh/mesh_radio_rate.h b/esphome/components/mesh/mesh_radio_rate.h
new file mode 100644
index 000000000..553d4ad70
--- /dev/null
+++ b/esphome/components/mesh/mesh_radio_rate.h
@@ -0,0 +1,89 @@
+#pragma once
+
+#include "mesh_limits.h"
+
+#include <cstdint>
+
+namespace mesh_radio {
+
+enum class LinkRate : uint8_t { UNKNOWN, BASE, FAST };
+
+// Directional link probing, independent of the driver and the mesh protocol.
+// Only completed unicast MAC results are samples. Admission errors, idle time
+// and RSSI do not demonstrate that a faster modulation can deliver traffic.
+class LinkProbe {
+ public:
+  static constexpr uint8_t CLEAN_SUCCESSES = 32;
+  static constexpr uint32_t CLEAN_FAST_MS = 60000;
+  static constexpr uint16_t CONFIG_RETRY_MS = 500;
+
+  void reset() { *this = LinkProbe{}; }
+  LinkRate configured() const { return configured_; }
+  bool configuration_due(uint32_t now) const {
+    return !configuration_waiting_ || elapsed_(now, configuration_at_, CONFIG_RETRY_MS);
+  }
+  LinkRate requested(uint32_t now) const {
+    if (configured_ == LinkRate::UNKNOWN || restore_base_)
+      return LinkRate::BASE;
+    if (configured_ == LinkRate::BASE && clean_ >= CLEAN_SUCCESSES &&
+        (!holdoff_ || elapsed_(now, holdoff_at_, holdoff_ms_())))
+      return LinkRate::FAST;
+    return configured_;
+  }
+  void applied(LinkRate rate, uint32_t now) {
+    configured_ = rate;
+    restore_base_ = configuration_waiting_ = false;
+    clean_ = 0;
+    if (rate == LinkRate::FAST)
+      fast_since_ = now;
+  }
+  void configuration_failed(LinkRate requested, uint32_t now) {
+    if (requested == LinkRate::FAST)
+      failed_probe_(now);
+    configured_ = LinkRate::UNKNOWN;
+    restore_base_ = configuration_waiting_ = true;
+    configuration_at_ = now;
+    clean_ = 0;
+  }
+  // Returns true only when this failure requires a fast-to-base transition.
+  bool failed(uint32_t now) {
+    clean_ = 0;
+    if (configured_ != LinkRate::FAST)
+      return false;
+    failed_probe_(now);
+    restore_base_ = true;
+    return true;
+  }
+  void succeeded(uint32_t now) {
+    if (configured_ == LinkRate::UNKNOWN || restore_base_)
+      return;
+    if (clean_ < CLEAN_SUCCESSES)
+      clean_++;
+    // A single successful probe never erases repeated failed-probe history.
+    if (configured_ == LinkRate::FAST && clean_ >= CLEAN_SUCCESSES && elapsed_(now, fast_since_, CLEAN_FAST_MS))
+      failed_probes_ = 0;
+  }
+
+ private:
+  static bool elapsed_(uint32_t now, uint32_t then, uint32_t delay) {
+    const uint32_t age = now - then;
+    return age < 0x80000000U && age >= delay;
+  }
+  uint32_t holdoff_ms_() const {
+    if (failed_probes_ == 0)
+      return 0;
+    return failed_probes_ >= 5 ? 60000U : 5000U << (failed_probes_ - 1);
+  }
+  void failed_probe_(uint32_t now) {
+    if (failed_probes_ < 5)
+      failed_probes_++;
+    holdoff_at_ = now;
+    holdoff_ = true;
+  }
+  LinkRate configured_{LinkRate::UNKNOWN};
+  uint8_t clean_{0}, failed_probes_{0};
+  bool restore_base_{false}, holdoff_{false}, configuration_waiting_{false};
+  uint32_t fast_since_{0}, holdoff_at_{0}, configuration_at_{0};
+};
+
+}  // namespace mesh_radio
diff --git a/esphome/components/mesh/mesh_runtime.cpp b/esphome/components/mesh/mesh_runtime.cpp
new file mode 100644
index 000000000..14b5498c2
--- /dev/null
+++ b/esphome/components/mesh/mesh_runtime.cpp
@@ -0,0 +1,99 @@
+#include "mesh_runtime.h"
+
+namespace mesh_core {
+
+MeshRuntime::MeshRuntime(NodeId node_id) : core_(node_id) {
+  core_.set_callbacks({this, nullptr, deliver_, route_changed_});
+}
+
+bool MeshRuntime::bind(const mesh_transport::Transport &transport, const TimingProfile &timing,
+                       const Observers &observers, size_t control_payload_budget) {
+  if (configured_ || !mesh_transport::valid_transport(transport, true) || !valid_timing_profile(timing) ||
+      !mesh_transport::supports_control_budget(transport.interface.capabilities, control_payload_budget))
+    return false;
+  if (!core_.set_transport(transport) || !core_.set_timing_profile(timing))
+    return false;
+  transport_ = transport;
+  observers_ = observers;
+  configured_ = true;
+  return true;
+}
+
+bool MeshRuntime::start() {
+  return configured_ && (transport_.start == nullptr || transport_.start(transport_.context));
+}
+
+void MeshRuntime::stop() {
+  if (configured_ && transport_.stop != nullptr)
+    transport_.stop(transport_.context);
+}
+
+void MeshRuntime::set_wake_callback(void *context, mesh_transport::WakeCallback callback) {
+  if (configured_ && transport_.set_wake_callback != nullptr)
+    transport_.set_wake_callback(transport_.context, context, callback);
+}
+
+size_t MeshRuntime::poll(uint32_t now_ms, size_t budget) {
+  if (!configured_)
+    return 0;
+  size_t processed = 0;
+  for (; processed < budget; ++processed) {
+    mesh_transport::ReceiveMetadata metadata;
+    Frame frame;
+    if (!mesh_transport::poll_receive_checked(transport_, metadata, frame))
+      break;
+    if (observers_.accept != nullptr && !observers_.accept(observers_.context, metadata, frame)) {
+      ++counters_.policy_drops;
+      continue;
+    }
+    core_.receive(metadata, frame, now_ms);
+    ++counters_.accepted_input;
+    if (observers_.received != nullptr)
+      observers_.received(observers_.context, now_ms);
+  }
+  return processed;
+}
+
+void MeshRuntime::tick(uint32_t now_ms) {
+  if (configured_)
+    core_.tick(now_ms);
+}
+
+void MeshRuntime::process(uint32_t now_ms, bool allow_start) {
+  if (configured_ && transport_.process != nullptr)
+    transport_.process(transport_.context, now_ms, allow_start);
+}
+
+void MeshRuntime::cancel_pending(bool keep_inflight) {
+  if (configured_ && transport_.cancel_pending != nullptr)
+    transport_.cancel_pending(transport_.context, keep_inflight);
+}
+
+void MeshRuntime::discard_receive() {
+  if (configured_ && transport_.discard_receive != nullptr)
+    transport_.discard_receive(transport_.context);
+}
+
+mesh_transport::QueueState MeshRuntime::queue_state() const {
+  return configured_ && transport_.queue_state != nullptr ? transport_.queue_state(transport_.context)
+                                                          : mesh_transport::QueueState{};
+}
+
+mesh_transport::TransportCounters MeshRuntime::transport_counters() const {
+  return configured_ && transport_.counters != nullptr ? transport_.counters(transport_.context)
+                                                       : mesh_transport::TransportCounters{};
+}
+
+void MeshRuntime::deliver_(void *context, const Frame &frame) {
+  auto *self = static_cast<MeshRuntime *>(context);
+  if (self->observers_.deliver != nullptr)
+    self->observers_.deliver(self->observers_.context, frame);
+}
+
+void MeshRuntime::route_changed_(void *context, const RouteSnapshot &route) {
+  auto *self = static_cast<MeshRuntime *>(context);
+  if (self->observers_.route_changed != nullptr)
+    self->observers_.route_changed(self->observers_.context, route);
+}
+
+}  // namespace mesh_core
diff --git a/esphome/components/mesh/mesh_runtime.h b/esphome/components/mesh/mesh_runtime.h
new file mode 100644
index 000000000..7b789bffc
--- /dev/null
+++ b/esphome/components/mesh/mesh_runtime.h
@@ -0,0 +1,61 @@
+#pragma once
+
+#include "mesh_limits.h"
+
+#include "mesh_core.h"
+
+#include <cstddef>
+#include <cstdint>
+
+namespace mesh_core {
+
+// Serialized portable coordinator. A platform supplies the adapter and clock;
+// it owns scheduling, locking, native uplinks and IP services. The runtime
+// pumps decoded input and routing without knowing any radio SDK or RTOS.
+class MeshRuntime {
+ public:
+  struct Observers {
+    void *context{nullptr};
+    bool (*accept)(void *, const mesh_transport::ReceiveMetadata &, const Frame &){nullptr};
+    void (*deliver)(void *, const Frame &){nullptr};
+    void (*route_changed)(void *, const RouteSnapshot &){nullptr};
+    void (*received)(void *, uint32_t now_ms){nullptr};
+  };
+  struct Counters {
+    uint32_t accepted_input{0};
+    uint32_t policy_drops{0};
+  };
+
+  explicit MeshRuntime(NodeId node_id);
+  // Bind once, before use. A failed bind leaves the runtime unconfigured.
+  // The endpoint budget applies to unfragmented control messages. A transport
+  // too small for them must implement a control adaptation before binding.
+  bool bind(const mesh_transport::Transport &transport, const TimingProfile &timing, const Observers &observers,
+            size_t control_payload_budget = 0);
+  bool start();
+  void stop();
+  void set_wake_callback(void *context, mesh_transport::WakeCallback callback);
+  size_t poll(uint32_t now_ms, size_t budget);
+  void tick(uint32_t now_ms);
+  void process(uint32_t now_ms, bool allow_start = true);
+  void cancel_pending(bool keep_inflight = true);
+  void discard_receive();
+  mesh_transport::QueueState queue_state() const;
+  mesh_transport::TransportCounters transport_counters() const;
+  MeshCore &core() { return core_; }
+  const MeshCore &core() const { return core_; }
+  const Counters &counters() const { return counters_; }
+  bool configured() const { return configured_; }
+  const mesh_transport::InterfaceDescriptor &interface() const { return transport_.interface; }
+
+ private:
+  static void deliver_(void *context, const Frame &frame);
+  static void route_changed_(void *context, const RouteSnapshot &route);
+  MeshCore core_;
+  mesh_transport::Transport transport_{};
+  Observers observers_{};
+  Counters counters_{};
+  bool configured_{false};
+};
+
+}  // namespace mesh_core
diff --git a/esphome/components/mesh/mesh_session.cpp b/esphome/components/mesh/mesh_session.cpp
new file mode 100644
index 000000000..57ab9d990
--- /dev/null
+++ b/esphome/components/mesh/mesh_session.cpp
@@ -0,0 +1,151 @@
+#include "mesh_session.h"
+
+namespace mesh_session {
+namespace {
+bool live(uint32_t now, uint32_t started) { return uint32_t(now - started) < PROOF_LIFETIME_MS; }
+}  // namespace
+
+bool ManualBootSessionRegistry::configure(uint8_t own_node, uint64_t own_boot, uint16_t allowed_nodes) {
+  if (own_node_ != 0 || !mesh_limits::valid_node(own_node) || own_boot == 0 ||
+      (allowed_nodes & ~mesh_limits::ID_MASK) != 0 || (allowed_nodes & (1U << (own_node - 1))) == 0)
+    return false;
+  own_node_ = own_node;
+  own_boot_ = own_boot;
+  allowed_nodes_ = allowed_nodes;
+  return true;
+}
+bool ManualBootSessionRegistry::offer_(Peer &peer, uint64_t boot, uint32_t now, uint64_t nonce) {
+  if (boot == peer.proved || (peer.challenge != 0 && live(now, peer.started)))
+    return false;
+  // The first value is unpredictable; thereafter uniqueness lasts for this
+  // entire requester boot, including retries after timeout and old HELLOs.
+  // There is no wrap fallback that could revive a recorded proof.
+  if (peer.last_nonce == UINT64_MAX)
+    return false;
+  if (peer.last_nonce != 0)
+    nonce = peer.last_nonce + 1;
+  else if (nonce == 0 || nonce == UINT64_MAX)
+    return false;
+  peer.candidate = boot;
+  peer.challenge = peer.last_nonce = nonce;
+  peer.started = now;
+  peer.last_sent = 0;
+  peer.challenge_sent = false;
+  return true;
+}
+ManualBootSessionRegistry::Result ManualBootSessionRegistry::receive(uint8_t source, uint8_t destination,
+                                                                     const Message &message, uint32_t now,
+                                                                     uint64_t random_nonce) {
+  if (own_node_ == 0 || source == own_node_ || !valid(message, source, destination) ||
+      (allowed_nodes_ & (1U << (source - 1))) == 0 || (destination != 0 && destination != own_node_))
+    return Result::REJECTED;
+  auto &peer = peers_[source - 1];
+  if (message.kind == Kind::HELLO) {
+    offer_(peer, message.source_boot, now, random_nonce);
+    return Result::ACCEPTED;
+  }
+  if (message.kind == Kind::CHALLENGE) {
+    if (peer.reply_nonce == 0 || !live(now, peer.reply_started)) {
+      peer.reply_boot = message.source_boot;
+      peer.reply_nonce = message.nonce;
+      peer.reply_started = now;
+    }
+    offer_(peer, message.source_boot, now, random_nonce);
+    return Result::ACCEPTED;
+  }
+  if (message.destination_boot != own_boot_)
+    return Result::REJECTED;
+  if (peer.challenge == 0 || !peer.challenge_sent || !live(now, peer.started) || peer.challenge != message.nonce)
+    return Result::REJECTED;
+  peer.challenge = 0;
+  peer.challenge_sent = false;
+  peer.candidate = message.source_boot;
+  if (peer.proved == message.source_boot)
+    return Result::ACCEPTED;
+  peer.proved = message.source_boot;
+  peer.ready = false;
+  return Result::CHANGED;
+}
+bool ManualBootSessionRegistry::next_outgoing(uint32_t now, Outgoing &outgoing) {
+  if (own_node_ == 0)
+    return false;
+  bool all_ready = true;
+  for (size_t i = 0; i < mesh_limits::MAX_NODES; ++i) {
+    const uint8_t index = static_cast<uint8_t>((cursor_ + i) % mesh_limits::MAX_NODES);
+    auto &peer = peers_[index];
+    if (index + 1 == own_node_ || (allowed_nodes_ & (1U << index)) == 0)
+      continue;
+    all_ready &= peer.ready;
+    if (peer.reply_nonce != 0 && !live(now, peer.reply_started))
+      peer.reply_nonce = 0;
+    if (peer.challenge != 0 && !live(now, peer.started)) {
+      peer.challenge = 0;
+      peer.challenge_sent = false;
+      // Lost one-way replies must recover even if the other node has already
+      // proved every peer and stopped HELLO. Query its present session again.
+      offer_(peer, peer.candidate, now, 0);
+    }
+    Message message;
+    message.source_boot = own_boot_;
+    if (peer.reply_nonce != 0 && live(now, peer.reply_started)) {
+      message.kind = Kind::RESPONSE;
+      message.destination_boot = peer.reply_boot;
+      message.nonce = peer.reply_nonce;
+    } else if (peer.challenge != 0 && live(now, peer.started) &&
+               (!peer.challenge_sent || uint32_t(now - peer.last_sent) >= RETRY_INTERVAL_MS)) {
+      message.kind = Kind::CHALLENGE;
+      message.nonce = peer.challenge;
+    } else
+      continue;
+    outgoing.destination = index + 1;
+    outgoing.message = message;
+    cursor_ = (index + 1) % mesh_limits::MAX_NODES;
+    return true;
+  }
+  if (!all_ready && (!hello_sent_ || uint32_t(now - last_hello_) >= HELLO_INTERVAL_MS)) {
+    outgoing = {};
+    outgoing.message.source_boot = own_boot_;
+    return true;
+  }
+  return false;
+}
+bool ManualBootSessionRegistry::sent(const Outgoing &outgoing, uint32_t now) {
+  if (!valid(outgoing.message, own_node_, outgoing.destination) || outgoing.message.source_boot != own_boot_)
+    return false;
+  if (outgoing.message.kind == Kind::HELLO) {
+    last_hello_ = now;
+    hello_sent_ = true;
+    return true;
+  }
+  auto &peer = peers_[outgoing.destination - 1];
+  if (outgoing.message.kind == Kind::RESPONSE) {
+    if (outgoing.message.nonce != peer.reply_nonce || outgoing.message.destination_boot != peer.reply_boot ||
+        !live(now, peer.reply_started))
+      return false;
+    peer.reply_nonce = 0;
+    return true;
+  }
+  if (outgoing.message.nonce != peer.challenge || !live(now, peer.started))
+    return false;
+  peer.challenge_sent = true;
+  peer.last_sent = now;
+  return true;
+}
+uint64_t ManualBootSessionRegistry::proved_boot(uint8_t node) const {
+  if (!mesh_limits::valid_node(node) || (allowed_nodes_ & (1U << (node - 1))) == 0)
+    return 0;
+  return node == own_node_ ? own_boot_ : peers_[node - 1].proved;
+}
+uint64_t ManualBootSessionRegistry::session(uint8_t node) const {
+  if (!mesh_limits::valid_node(node) || (allowed_nodes_ & (1U << (node - 1))) == 0)
+    return 0;
+  return node == own_node_ ? own_boot_ : peers_[node - 1].ready ? peers_[node - 1].proved : 0;
+}
+bool ManualBootSessionRegistry::activate(uint8_t node, uint64_t proved) {
+  if (!mesh_limits::valid_node(node) || node == own_node_ || proved == 0 || peers_[node - 1].proved != proved)
+    return false;
+  peers_[node - 1].ready = true;
+  return true;
+}
+
+}  // namespace mesh_session
diff --git a/esphome/components/mesh/mesh_session.h b/esphome/components/mesh/mesh_session.h
new file mode 100644
index 000000000..781416a22
--- /dev/null
+++ b/esphome/components/mesh/mesh_session.h
@@ -0,0 +1,104 @@
+#pragma once
+
+#include "mesh_protocol.h"
+
+#include <cstddef>
+#include <cstdint>
+
+namespace mesh_session {
+
+constexpr size_t WIRE_SIZE = 35;
+constexpr uint32_t PROOF_LIFETIME_MS = 2000;
+constexpr uint32_t RETRY_INTERVAL_MS = 500;
+constexpr uint32_t HELLO_INTERVAL_MS = 1000;
+enum class Kind : uint8_t { HELLO = 1, CHALLENGE = 2, RESPONSE = 3 };
+struct Message {
+  // HELLO is broadcast. CHALLENGE queries a fixed node ID's current boot and
+  // canonically has destination_boot=0. RESPONSE binds that requester's boot
+  // and nonce to the responder's current nonzero boot; no HELLO is authority.
+  Kind kind{Kind::HELLO};
+  mesh_protocol::Profile profile{mesh_protocol::manual_profile()};
+  uint64_t source_boot{0}, destination_boot{0}, nonce{0};
+};
+inline bool valid(const Message &message, uint8_t source, uint8_t destination) {
+  if (!mesh_limits::valid_node(source) || message.source_boot == 0 ||
+      (message.profile.required & mesh_protocol::MANUAL_BOOT_SESSION) == 0 || !mesh_protocol::valid(message.profile) ||
+      !mesh_protocol::same(mesh_protocol::manual_profile(), message.profile))
+    return false;
+  if (message.kind == Kind::HELLO)
+    return destination == 0 && message.destination_boot == 0 && message.nonce == 0;
+  return mesh_limits::valid_node(destination) && source != destination && message.nonce != 0 &&
+         (message.kind == Kind::CHALLENGE ? message.destination_boot == 0
+                                          : message.kind == Kind::RESPONSE && message.destination_boot != 0);
+}
+inline bool encode(const Message &message, uint8_t source, uint8_t destination, uint8_t *output, size_t capacity,
+                   size_t &written) {
+  written = 0;
+  if (output == nullptr || capacity < WIRE_SIZE || !valid(message, source, destination))
+    return false;
+  output[0] = 1;
+  output[1] = static_cast<uint8_t>(message.kind);
+  if (!mesh_protocol::encode(message.profile, output + 2, mesh_protocol::PROFILE_WIRE_SIZE))
+    return false;
+  const uint64_t fields[]{message.source_boot, message.destination_boot, message.nonce};
+  for (size_t field = 0; field < 3; ++field)
+    for (size_t byte = 0; byte < 8; ++byte)
+      output[11 + field * 8 + byte] = static_cast<uint8_t>(fields[field] >> (8 * byte));
+  written = WIRE_SIZE;
+  return true;
+}
+inline bool decode(const uint8_t *data, size_t length, uint8_t source, uint8_t destination, Message &message) {
+  if (data == nullptr || length != WIRE_SIZE || data[0] != 1)
+    return false;
+  Message candidate;
+  candidate.kind = static_cast<Kind>(data[1]);
+  if (!mesh_protocol::decode(data + 2, mesh_protocol::PROFILE_WIRE_SIZE, candidate.profile))
+    return false;
+  uint64_t *fields[]{&candidate.source_boot, &candidate.destination_boot, &candidate.nonce};
+  for (size_t field = 0; field < 3; ++field)
+    for (size_t byte = 0; byte < 8; ++byte)
+      *fields[field] |= uint64_t(data[11 + field * 8 + byte]) << (8 * byte);
+  if (!valid(candidate, source, destination))
+    return false;
+  message = candidate;
+  return true;
+}
+
+// The carrier authenticates configured encrypted forwarders. All members of a
+// manual mesh therefore retain its existing trusted-forwarder boundary. HELLO
+// only offers a candidate: a one-use challenge sent by this boot must be
+// answered before a candidate can replace the current session. Serialized.
+// random_nonce seeds a peer's first challenge; its uint64 sequence then only
+// advances, never wraps. Delayed replies cannot revive after RNG nonce reuse.
+class ManualBootSessionRegistry {
+ public:
+  struct Outgoing {
+    uint8_t destination{0};
+    Message message{};
+  };
+  enum class Result : uint8_t { REJECTED, ACCEPTED, CHANGED };
+  bool configure(uint8_t own_node, uint64_t own_boot, uint16_t allowed_nodes = mesh_limits::ID_MASK);
+  Result receive(uint8_t source, uint8_t destination, const Message &message, uint32_t now, uint64_t random_nonce);
+  bool next_outgoing(uint32_t now, Outgoing &outgoing);
+  bool sent(const Outgoing &outgoing, uint32_t now);
+  uint64_t session(uint8_t node) const;
+  uint64_t proved_boot(uint8_t node) const;
+  bool activate(uint8_t node, uint64_t proved_boot);
+
+ private:
+  struct Peer {
+    uint64_t proved{0}, candidate{0}, challenge{0}, last_nonce{0};
+    uint64_t reply_boot{0}, reply_nonce{0};
+    uint32_t started{0}, last_sent{0}, reply_started{0};
+    bool challenge_sent{false}, ready{false};
+  };
+  bool offer_(Peer &peer, uint64_t boot, uint32_t now, uint64_t nonce);
+  uint8_t own_node_{0}, cursor_{0};
+  uint16_t allowed_nodes_{0};
+  uint64_t own_boot_{0};
+  uint32_t last_hello_{0};
+  bool hello_sent_{false};
+  Peer peers_[mesh_limits::MAX_NODES]{};
+};
+
+}  // namespace mesh_session
diff --git a/esphome/components/mesh/mesh_transport.h b/esphome/components/mesh/mesh_transport.h
new file mode 100644
index 000000000..e46d45534
--- /dev/null
+++ b/esphome/components/mesh/mesh_transport.h
@@ -0,0 +1,150 @@
+#pragma once
+
+#include "mesh_limits.h"
+
+#include <cstddef>
+#include <cstdint>
+
+namespace mesh_core {
+struct Frame;
+}
+
+namespace mesh_transport {
+
+using InterfaceId = uint8_t;
+using WakeCallback = void (*)(void *);
+constexpr InterfaceId kNoInterface = 0;
+constexpr InterfaceId kDefaultInterface = 1;
+
+// Limits of this mesh wire protocol, independent of any radio's native MTU.
+// A transport with larger frames does not silently enlarge protocol buffers.
+constexpr size_t kProtocolHeaderSize = 15;
+constexpr size_t kProtocolSessionHeaderSize = kProtocolHeaderSize + 3 * sizeof(uint64_t);
+constexpr size_t kProtocolPayloadLimit = mesh_limits::PROTOCOL_PAYLOAD_BUDGET;
+constexpr size_t kProtocolControlPayloadLimit = 160;
+static_assert(kProtocolSessionHeaderSize + kProtocolPayloadLimit == mesh_limits::NATIVE_FRAME_BUDGET,
+              "Native frame budget must include the complete session header");
+constexpr size_t kProtocolFrameLimit = kProtocolSessionHeaderSize + kProtocolPayloadLimit;
+
+struct LinkCapabilities {
+  // Maximum mesh payload accepted by this adapter, excluding the mesh
+  // header and its own framing. Larger DATA frames use native ESP-NOW v2;
+  // other links remain bounded by their own capability.
+  size_t payload_mtu{kProtocolPayloadLimit};
+  // True declares a link guarantee, not successful delivery of a queued send.
+  // False means that the portable core cannot rely on that guarantee.
+  bool reliable_unicast{false};
+  bool native_broadcast{false};
+  bool reliable_broadcast{false};
+  bool security_provided{false};  // Authenticated encryption on this link only.
+  // Optional planning hints: zero is unspecified, not unlimited or zero cost.
+  // They do not enable rate control, duty-cycle compliance, or new route metrics.
+  uint32_t sustainable_bitrate_bps{0};
+  uint16_t airtime_budget_permille{0};
+  // Optional adapter-defined channel numbers; no Wi-Fi numbering is assumed.
+  bool channel_selection_supported{false};
+  uint16_t first_channel{0};
+  uint16_t last_channel{0};
+};
+
+constexpr bool valid_link_capabilities(const LinkCapabilities &link) {
+  return link.payload_mtu != 0 && link.airtime_budget_permille <= 1000 &&
+         (!link.reliable_broadcast || link.native_broadcast) &&
+         (link.channel_selection_supported ? link.last_channel >= link.first_channel
+                                           : link.first_channel == 0 && link.last_channel == 0);
+}
+
+constexpr bool validates_frame_budget(const LinkCapabilities &link, size_t payload_length) {
+  return valid_link_capabilities(link) && payload_length <= kProtocolPayloadLimit && payload_length <= link.payload_mtu;
+}
+
+// Derive an adapter's payload MTU from its complete frame budget. Subtraction
+// avoids overflow even for untrusted/exaggerated capabilities. Zero cannot
+// carry nonempty mesh control/data and is rejected by set_link_capabilities().
+constexpr size_t payload_mtu_for_frame_budget(size_t frame_mtu, size_t adapter_overhead = 0,
+                                              size_t header_size = kProtocolHeaderSize) {
+  if ((header_size != kProtocolHeaderSize && header_size != kProtocolSessionHeaderSize) || frame_mtu < header_size ||
+      adapter_overhead > frame_mtu - header_size)
+    return 0;
+  const size_t payload_mtu = frame_mtu - header_size - adapter_overhead;
+  return payload_mtu < kProtocolPayloadLimit ? payload_mtu : kProtocolPayloadLimit;
+}
+
+constexpr bool validates_frame_budget(const LinkCapabilities &link, size_t payload_length, size_t frame_mtu,
+                                      size_t adapter_overhead = 0, size_t header_size = kProtocolHeaderSize) {
+  return validates_frame_budget(link, payload_length) &&
+         (header_size == kProtocolHeaderSize || header_size == kProtocolSessionHeaderSize) &&
+         frame_mtu >= header_size && adapter_overhead <= frame_mtu - header_size &&
+         payload_length <= frame_mtu - header_size - adapter_overhead;
+}
+
+// IP endpoint controls are not fragmented by the IP packet fragmenter. Reject
+// a transport too small for the whole endpoint protocol before activating it.
+constexpr size_t kEndpointControlPayloadBudget = 43;
+constexpr bool supports_control_budget(const LinkCapabilities &link,
+                                       size_t required_payload = kEndpointControlPayloadBudget) {
+  return validates_frame_budget(link, required_payload);
+}
+
+struct InterfaceDescriptor {
+  InterfaceId id{kDefaultInterface};
+  LinkCapabilities capabilities{};
+};
+constexpr bool valid_interface(const InterfaceDescriptor &interface) {
+  return interface.id != kNoInterface && valid_link_capabilities(interface.capabilities);
+}
+
+// Adapter-local reception metadata. The adapter authenticates/configures the
+// immediate peer; the portable core still validates its ID and frame fields.
+// Channel is informational and has no assumed Wi-Fi units or route metric.
+struct ReceiveMetadata {
+  InterfaceId interface_id{kDefaultInterface};
+  uint8_t immediate_sender{0};
+  uint16_t channel{0};
+};
+struct QueueState {
+  size_t pending{0};
+  size_t capacity{0};
+  bool inflight{false};
+};
+struct TransportCounters {
+  uint32_t accepted{0};
+  uint32_t rejected{0};
+  uint32_t sent{0};
+  uint32_t failed{0};
+  uint32_t received{0};
+  uint32_t receive_drops{0};
+  uint32_t transmit_drops{0};  // Adapter drops, including admission/expiry/callback failures.
+};
+
+// One active interface per runtime/core. No allocation, inheritance or SDK
+// types: a platform adapter exports this function table and keeps its state.
+// All calls are serialized by the runtime. Adapter callbacks must not re-enter
+// it. enqueue returns true only for complete local queue admission, including
+// all configured peers when next_hop==0; false retains no copy from that call.
+// This is NOT an over-the-air delivery ACK. poll_receive consumes at most one
+// decoded frame and can discard bounded invalid adapter records internally.
+struct Transport {
+  void *context{nullptr};
+  InterfaceDescriptor interface {};
+  bool (*enqueue)(void *, InterfaceId, uint8_t next_hop, const mesh_core::Frame &, uint32_t now_ms){nullptr};
+  bool (*poll_receive)(void *, ReceiveMetadata &, mesh_core::Frame &){nullptr};
+  void (*process)(void *, uint32_t now_ms, bool allow_start){nullptr};
+  bool (*start)(void *){nullptr};
+  void (*stop)(void *){nullptr};
+  void (*cancel_pending)(void *, bool keep_inflight){nullptr};
+  void (*discard_receive)(void *){nullptr};
+  QueueState (*queue_state)(const void *){nullptr};
+  TransportCounters (*counters)(const void *){nullptr};
+  // Optional nonblocking scheduling hint. May run on a driver's callback task;
+  // never re-enter the runtime. Context outlives in-progress notifications.
+  void (*set_wake_callback)(void *, void *wake_context, WakeCallback){nullptr};
+};
+
+// Lifecycle/service/statistics hooks are optional. An active transport needs
+// enqueue; a runtime that pumps input additionally requires poll_receive.
+bool valid_transport(const Transport &transport, bool require_receive = false);
+bool enqueue_checked(const Transport &transport, uint8_t next_hop, const mesh_core::Frame &frame, uint32_t now_ms);
+bool poll_receive_checked(const Transport &transport, ReceiveMetadata &metadata, mesh_core::Frame &frame);
+
+}  // namespace mesh_transport
