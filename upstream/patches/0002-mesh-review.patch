+struct BackendHarness {
+  bool accepting{true};
+  bool has_rx{false};
+  uint32_t last_now{0};
+  mesh_transport::InterfaceId last_interface{0};
+  NodeId last_hop{0};
+  unsigned offers{0};
+  std::vector<Frame> queued;
+  mesh_transport::ReceiveMetadata rx_metadata{7, 1, 123};
+  Frame rx{advertisement(1, 1, 0, node_bit(1))};
+  static bool enqueue(void *context, mesh_transport::InterfaceId interface, uint8_t hop, const Frame &frame,
+                      uint32_t now) {
+    auto &self = *static_cast<BackendHarness *>(context);
+    ++self.offers;
+    self.last_now = now;
+    self.last_interface = interface;
+    self.last_hop = hop;
+    if (!self.accepting)
+      return false;
+    self.queued.push_back(frame);
+    return true;
+  }
+  static bool receive(void *context, mesh_transport::ReceiveMetadata &metadata, Frame &frame) {
+    auto &self = *static_cast<BackendHarness *>(context);
+    if (!self.has_rx)
+      return false;
+    self.has_rx = false;
+    metadata = self.rx_metadata;
+    frame = self.rx;
+    return true;
+  }
+  mesh_transport::Transport transport(size_t mtu = 160) {
+    mesh_transport::Transport result;
+    result.context = this;
+    result.interface.id = 7;
+    result.interface.capabilities.payload_mtu = mtu;
+    result.enqueue = enqueue;
+    result.poll_receive = receive;
+    return result;
+  }
+};
