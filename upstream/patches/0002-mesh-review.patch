+TEST(MeshDiscovery, StockMetadataRoundtrip) {
+  auto original = metadata();
+  auto bytes = encode(original);
+  DiscoveryDescriptor decoded;
+  ASSERT_TRUE(decode_discovery(bytes.data(), bytes.size(), decoded));
+  ASSERT_TRUE(decoded.hostname() == original.hostname() && decoded.api_port == 6053 && decoded.http_port == 80);
+  ASSERT_TRUE(decoded.txt_count() == original.txt_count());
+  for (size_t i = 0; i < original.txt_count(); i++) {
+    ASSERT_TRUE(decoded.txt(i).key == original.txt(i).key);
+    ASSERT_TRUE(decoded.txt(i).value == original.txt(i).value);
+  }
+  ASSERT_TRUE(chunks(bytes).size() == 2);
+}
+TEST(MeshDiscovery, AuthorizationAndNoIpAssumption) {
+  DiscoveryRegistry registry;
+  auto packets = chunks(encode(metadata()));
+  ASSERT_TRUE(!receive(registry, 3, packets, 100));
+  ASSERT_TRUE(!registry.authorize(0, MAC) && !registry.authorize(17, MAC));
+  uint8_t invalid[6]{1};
+  ASSERT_TRUE(!registry.authorize(3, invalid));
+  ASSERT_TRUE(registry.authorize(3, MAC));
+  ASSERT_TRUE(receive(registry, 3, packets, 100));
+  ASSERT_TRUE(registry.current(3, 0, 100) == nullptr);
+  ASSERT_TRUE(registry.current(3, ADDRESS + 1, 100) == nullptr);
+  ASSERT_TRUE(registry.current(3, ADDRESS, 100));
+  ASSERT_TRUE(registry.current(2, ADDRESS, 100) == nullptr);
+  ASSERT_TRUE(registry.current(0, ADDRESS, 100) == nullptr);
+}
