+using mesh_session::Kind;
+using mesh_session::ManualBootSessionRegistry;
+using mesh_session::Message;
+using mesh_core::Frame;
+using mesh_core::FrameType;
+using Bytes = std::vector<uint8_t>;
+
+Message hello(uint64_t boot) {
+  Message message;
+  message.source_boot = boot;
+  return message;
+}
+Message response(const ManualBootSessionRegistry::Outgoing &challenge, uint64_t boot) {
+  Message result;
+  result.kind = Kind::RESPONSE;
+  result.source_boot = boot;
+  result.destination_boot = challenge.message.source_boot;
+  result.nonce = challenge.message.nonce;
+  return result;
+}
+ManualBootSessionRegistry::Outgoing challenge_for(ManualBootSessionRegistry &registry, uint32_t now) {
+  ManualBootSessionRegistry::Outgoing out;
+  for (unsigned i = 0; i < 4; ++i) {
+    assert(registry.next_outgoing(now, out));
+    if (out.message.kind == Kind::CHALLENGE)
+      return out;
+    assert(registry.sent(out, now));
+  }
+  assert(false);
+  return {};
+}
+TEST(MeshManualSession, CodecIsCanonical) {
+  for (Kind kind : {Kind::HELLO, Kind::CHALLENGE, Kind::RESPONSE}) {
+    Message message = hello(0x0807060504030201ULL);
+    message.kind = kind;
+    uint8_t destination = kind == Kind::HELLO ? 0 : 2;
+    if (destination)
+      message.nonce = 123;
+    if (kind == Kind::RESPONSE)
+      message.destination_boot = 0x1817161514131211ULL;
+    std::array<uint8_t, mesh_session::WIRE_SIZE + 1> bytes{};
+    bytes.back() = 0xA5;
+    size_t written = 99;
+    ASSERT_TRUE(mesh_session::encode(message, 1, destination, bytes.data(), bytes.size(), written));
+    ASSERT_TRUE(written == mesh_session::WIRE_SIZE && bytes.back() == 0xA5);
+    Message decoded;
+    ASSERT_TRUE(mesh_session::decode(bytes.data(), written, 1, destination, decoded));
+    ASSERT_TRUE(decoded.kind == kind && decoded.source_boot == message.source_boot &&
+                decoded.destination_boot == message.destination_boot && decoded.nonce == message.nonce);
+    for (size_t length = 0; length <= bytes.size(); ++length) {
+      if (length == written)
+        continue;
+      decoded.source_boot = 999;
+      ASSERT_TRUE(!mesh_session::decode(bytes.data(), length, 1, destination, decoded) && decoded.source_boot == 999);
+    }
+    auto invalid = message;
+    invalid.profile.required &= ~mesh_protocol::MANUAL_BOOT_SESSION;
+    ASSERT_TRUE(!mesh_session::encode(invalid, 1, destination, bytes.data(), bytes.size(), written));
+    invalid = message;
+    invalid.profile = {};
+    ASSERT_TRUE(!mesh_session::valid(invalid, 1, destination));
+    invalid = message;
+    invalid.source_boot = 0;
+    ASSERT_TRUE(!mesh_session::valid(invalid, 1, destination));
+    invalid = message;
+    invalid.destination_boot = kind == Kind::RESPONSE ? 0 : 1;
+    ASSERT_TRUE(!mesh_session::valid(invalid, 1, destination));
+    invalid = message;
+    invalid.nonce = destination ? 0 : 1;
+    ASSERT_TRUE(!mesh_session::valid(invalid, 1, destination));
+    ASSERT_TRUE(!mesh_session::valid(message, 0, destination));
+    if (destination)
+      ASSERT_TRUE(!mesh_session::valid(message, 2, destination));
+  }
+  Message message = hello(1);
+  message.profile.max_nodes = mesh_limits::MAX_NODES == 16 ? 8 : 16;
+  ASSERT_TRUE(!mesh_session::valid(message, 1, 0));
+}
+TEST(MeshManualSession, ProofRequiresSentFreshNonceAndBothBoots) {
+  ManualBootSessionRegistry registry;
+  ASSERT_TRUE(registry.configure(1, 100));
+  ASSERT_TRUE(!registry.configure(1, 101));
+  ASSERT_TRUE(registry.receive(2, 0, hello(200), 10, 1000) == ManualBootSessionRegistry::Result::ACCEPTED);
+  const auto request = challenge_for(registry, 10);
+  auto reply = response(request, 200);
+  ASSERT_TRUE(registry.receive(2, 1, reply, 11, 2000) == ManualBootSessionRegistry::Result::REJECTED);
+  ASSERT_TRUE(registry.session(2) == 0 && registry.proved_boot(2) == 0);
+  ASSERT_TRUE(registry.sent(request, 12));
+  auto wrong = reply;
+  ++wrong.nonce;
+  ASSERT_TRUE(registry.receive(2, 1, wrong, 13, 2001) == ManualBootSessionRegistry::Result::REJECTED);
+  wrong = reply;
+  ++wrong.destination_boot;
+  ASSERT_TRUE(registry.receive(2, 1, wrong, 13, 2002) == ManualBootSessionRegistry::Result::REJECTED);
+  wrong = reply;
+  wrong.source_boot = 0;
+  ASSERT_TRUE(registry.receive(2, 1, wrong, 13, 2003) == ManualBootSessionRegistry::Result::REJECTED);
+  ASSERT_TRUE(registry.receive(3, 1, reply, 13, 2003) == ManualBootSessionRegistry::Result::REJECTED);
+  ASSERT_TRUE(registry.receive(2, 1, reply, 14, 2004) == ManualBootSessionRegistry::Result::CHANGED);
+  ASSERT_TRUE(registry.proved_boot(2) == 200 && registry.session(2) == 0);
+  ASSERT_TRUE(!registry.activate(2, 201) && registry.activate(2, 200));
+  ASSERT_TRUE(registry.receive(2, 1, reply, 15, 2005) == ManualBootSessionRegistry::Result::REJECTED);
+  // Neither a new unchallenged offer nor expiration revokes the healthy owner.
+  registry.receive(2, 0, hello(201), 16, 1001);
+  ASSERT_TRUE(registry.session(2) == 200);
+  const auto replacement = challenge_for(registry, 16);
+  ASSERT_TRUE(registry.sent(replacement, 17));
+  ASSERT_TRUE(registry.receive(2, 1, response(replacement, 201), 2016, 2006) ==
+              ManualBootSessionRegistry::Result::REJECTED);
+  ASSERT_TRUE(registry.session(2) == 200);
+  registry.receive(2, 0, hello(201), 2020, 1001);  // RNG nonce reuse stays closed.
+  ASSERT_TRUE(registry.receive(2, 1, response(replacement, 201), 2021, 2007) ==
+              ManualBootSessionRegistry::Result::REJECTED);
+  registry.receive(2, 0, hello(201), 2022, 1002);
+  const auto fresh = challenge_for(registry, 2022);
+  ASSERT_TRUE(registry.sent(fresh, 2022));
+  ASSERT_TRUE(registry.receive(2, 1, response(fresh, 201), 2023, 2008) == ManualBootSessionRegistry::Result::CHANGED);
+  ASSERT_TRUE(registry.session(2) == 0 && registry.activate(2, 201));
+  ASSERT_TRUE(registry.receive(2, 1, reply, 2024, 2009) == ManualBootSessionRegistry::Result::REJECTED);
+  ManualBootSessionRegistry rebooted;
+  ASSERT_TRUE(rebooted.configure(1, 101));
+  ASSERT_TRUE(rebooted.receive(2, 1, response(fresh, 201), 2025, 2010) == ManualBootSessionRegistry::Result::REJECTED);
+}
+
+struct Network;
+struct Node {
+  Network *network;
+  uint8_t id;
+  uint64_t boot;
+  mesh_core::MeshCore core;
+  ManualBootSessionRegistry registry;
+  mesh_ip::PacketDelivery delivery;
+  uint16_t serial{0};
+  uint32_t resets[mesh_limits::MAX_NODES]{};
+  std::vector<Bytes> delivered;
+  Node(Network &network, uint8_t id, uint64_t boot);
+  void tick();
+};
+struct Network {
+  struct Packet {
+    uint8_t from, to;
+    Frame frame;
+  };
+  std::unique_ptr<Node> nodes[3];
+  bool links[3][3]{};
+  bool direct[3]{true, false, false};
+  bool alive[3]{true, true, true};
+  uint32_t now{0};
+  uint64_t random{10000};
+  std::deque<Packet> queue;
+  std::vector<Packet> history;
+  std::function<bool(const Packet &)> drop;
+  unsigned forwarded{0};
+  Network(bool triangle = false) {
+    for (uint8_t id = 1; id <= 3; ++id)
+      nodes[id - 1] = std::make_unique<Node>(*this, id, 100 + id);
+    links[0][1] = links[1][0] = links[1][2] = links[2][1] = true;
+    if (triangle)
+      links[0][2] = links[2][0] = true;
+  }
+  void reboot(uint8_t id, uint64_t boot) { nodes[id - 1] = std::make_unique<Node>(*this, id, boot); }
+  void pump() {
+    unsigned budget = 0;
+    while (!queue.empty()) {
+      assert(++budget < 1000);  // TTL/dedup keeps a physical loop bounded.
+      const Packet packet = queue.front();
+      queue.pop_front();
+      history.push_back(packet);
+      if (drop && drop(packet))
+        continue;
+      if (alive[packet.to - 1])
+        nodes[packet.to - 1]->core.receive(packet.from, packet.frame, now);
+    }
+  }
+  void run(unsigned milliseconds = 1500) {
+    for (unsigned elapsed = 0; elapsed < milliseconds; elapsed += 10) {
+      now += 10;
+      for (auto &node : nodes)
+        if (alive[node->id - 1])
+          node->tick();
+      pump();
+    }
+  }
+  void require_sessions() const {
+    for (const auto &node : nodes)
+      for (const auto &peer : nodes)
+        assert(node->registry.session(peer->id) == peer->boot);
+  }
+};
+Node::Node(Network &network, uint8_t id, uint64_t boot) : network(&network), id(id), boot(boot), core(id) {
+  assert(registry.configure(id, boot, 7));
+  core.set_callbacks(
+      {this,
+       [](void *context, uint8_t hop, const Frame &frame) {
+         auto &self = *static_cast<Node *>(context);
+         for (uint8_t peer = 1; peer <= 3; ++peer)
+           if (self.network->links[self.id - 1][peer - 1] && (hop == 0 || hop == peer))
+             self.network->queue.push_back({self.id, peer, frame});
+         return true;
+       },
+       [](void *context, const Frame &frame) {
+         auto &self = *static_cast<Node *>(context);
+         if (frame.type == FrameType::BOOT_SESSION) {
+           Message message;
+           assert(mesh_session::decode(frame.payload, frame.payload_length, frame.source, frame.destination, message));
+           if (self.registry.receive(frame.source, frame.destination, message, self.network->now,
+                                     ++self.network->random) == ManualBootSessionRegistry::Result::CHANGED) {
+             self.delivery.reset_peer(frame.source);
+             ++self.resets[frame.source - 1];
+             assert(self.registry.activate(frame.source, message.source_boot));
+           }
+         } else if (frame.type == FrameType::DATA) {
+           self.delivery.receive_fragment(frame.source, self.id, frame.payload, frame.payload_length,
+                                          self.network->now);
+         } else if (frame.type == FrameType::CONTROL &&
+                    mesh_ip::PacketDelivery::is_ack(frame.payload, frame.payload_length)) {
+           self.delivery.accept_ack(frame.source, frame.payload, frame.payload_length, self.network->now);
+         }
+       },
+       nullptr});
+  assert(core.set_session_resolver(
+      this, [](void *context, uint8_t peer) { return static_cast<Node *>(context)->registry.session(peer); }));
+  assert(core.set_bootstrap_allowed(true));
+  assert(delivery.configure(id, {},
+                            {this,
+                             [](void *context, uint8_t target, const uint8_t *payload, size_t length) {
+                               auto &self = *static_cast<Node *>(context);
+                               return self.core.send_data(target, ++self.serial, payload, length, self.network->now);
+                             },
+                             [](void *context, uint8_t target, const uint8_t *payload, size_t length) {
+                               auto &self = *static_cast<Node *>(context);
+                               return self.core.send_control(target, ++self.serial, payload, length, self.network->now);
+                             },
+                             [](void *context, uint8_t, const uint8_t *payload, size_t length) {
+                               static_cast<Node *>(context)->delivered.emplace_back(payload, payload + length);
+                               return true;
+                             }}));
+}
+void Node::tick() {
+  for (unsigned budget = 0; budget < 2; ++budget) {
+    ManualBootSessionRegistry::Outgoing out;
+    if (!registry.next_outgoing(network->now, out))
+      break;
+    uint8_t wire[mesh_session::WIRE_SIZE];
+    size_t length;
+    assert(mesh_session::encode(out.message, id, out.destination, wire, sizeof(wire), length));
+    assert(core.send_bootstrap(out.destination, ++serial, wire, length, network->now));
+    assert(registry.sent(out, network->now));
+  }
+  core.set_direct_uplink(network->direct[id - 1], network->now);
+  core.tick(network->now);
+  delivery.tick(network->now);
+}
+void reboot_replay_and_unrelated_peer(bool triangle) {
+  Network network(triangle);
+  network.run();
+  network.require_sessions();
+  auto &gateway = *network.nodes[0];
+  auto &client = *network.nodes[2];
+  assert(client.core.route().root == 1);
+  const Bytes packet(80, 42);
+  assert(client.delivery.begin(1, packet.data(), packet.size(), 0x60000000, network.now));
+  network.run(500);
+  assert(gateway.delivered.size() == 1);
+  Frame old_data;
+  for (const auto &p : network.history)
+    if (p.frame.type == FrameType::DATA && p.frame.source == 3)
+      old_data = p.frame;
+  auto &other = *network.nodes[1];
+  assert(other.delivery.begin(1, packet.data(), packet.size(), 0x40000000, network.now));
+  network.run(500);
+  assert(gateway.delivered.size() == 2);
+  const unsigned other_resets = gateway.resets[1];
+  network.reboot(3, 203);
+  network.run();
+  network.require_sessions();
+  assert(gateway.resets[1] == other_resets);  // No global replay reset.
+  auto &new_client = *network.nodes[2];
+  assert(new_client.delivery.begin(1, packet.data(), packet.size(), 0x20000001, network.now));
+  network.run(500);
+  assert(gateway.delivered.size() == 3);
+  gateway.core.receive(2, old_data, network.now);
+  network.run(50);
+  assert(gateway.delivered.size() == 3);
+  assert(other.delivery.begin(1, packet.data(), packet.size(), 0x40000000, network.now));
+  network.run(500);
+  assert(gateway.delivered.size() == 3);  // Other replay window retained.
+  network.reboot(1, 301);
+  network.run();
+  network.require_sessions();
+  assert(network.nodes[2]->delivery.begin(1, packet.data(), packet.size(), 0x20000002, network.now));
+  network.run(500);
+  assert(network.nodes[0]->delivered.size() == 1);
+  // Relay reboot cannot deadlock on the very sessions/routes it must bootstrap.
+  network.reboot(2, 402);
+  network.run();
+  network.require_sessions();
+  assert(network.nodes[2]->core.route().root == 1);
+  assert(network.nodes[2]->delivery.begin(1, packet.data(), packet.size(), 0x20000003, network.now));
+  network.run(500);
+  assert(network.nodes[0]->delivered.size() == 2);
+}
+TEST(MeshManualSession, BootstrapPolicyAndBootDedup) {
+  Frame frame;
+  frame.type = FrameType::BOOT_SESSION;
+  frame.source = 2;
+  frame.sequence = 1;
+  size_t length;
+  ASSERT_TRUE(mesh_session::encode(hello(102), 2, 0, frame.payload, sizeof(frame.payload), length));
+  frame.payload_length = length;
+  mesh_core::MeshCore automatic(1);
+  ASSERT_TRUE(automatic.set_session_resolver(nullptr, [](void *, uint8_t node) { return uint64_t(100 + node); }));
+  automatic.receive(2, frame, 0);
+  automatic.receive(2, frame, 1);
+  ASSERT_TRUE(automatic.counters().invalid_drops == 2 && automatic.counters().duplicate_drops == 0);
+  ASSERT_TRUE(automatic.counters().delivered == 0 && automatic.counters().forwarded == 0);
+  Network network(true);
+  network.run();
+  const auto count = network.nodes[0]->core.counters().forwarded;
+  frame.sequence = 65000;
+  ASSERT_TRUE(mesh_session::encode(hello(1002), 2, 0, frame.payload, sizeof(frame.payload), length));
+  network.nodes[0]->core.receive(2, frame, network.now);
+  network.pump();
+  ASSERT_TRUE(network.nodes[0]->core.counters().forwarded == count + 1);
+  ASSERT_TRUE(mesh_session::encode(hello(1003), 2, 0, frame.payload, sizeof(frame.payload), length));
+  network.nodes[0]->core.receive(2, frame, network.now);
+  network.pump();
+  ASSERT_TRUE(network.nodes[0]->core.counters().forwarded == count + 2);
+  std::array<uint8_t, mesh_core::kMaxWireSize> bytes{};
+  size_t written;
+  ASSERT_TRUE(mesh_core::encode_frame(frame, bytes.data(), bytes.size(), written));
+  ASSERT_TRUE(bytes[2] == mesh_protocol::STATIC_FRAME_VERSION);
+  for (size_t size = 0; size < written; ++size) {
+    Frame decoded;
+    ASSERT_TRUE(!mesh_core::decode_frame(bytes.data(), size, decoded));
+  }
+  frame.source_session = 1003;
+  ASSERT_TRUE(!mesh_core::validate_frame(frame));
+}
