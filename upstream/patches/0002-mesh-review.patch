+    core.tick(2100);
+    ASSERT_TRUE(core.route().parent == 2 && core.route().root == 2 && core.route().rank == 1);
+    ASSERT_TRUE(changes.size() == 2 && changes.back().parent == 2);
+    const RouteSnapshot failover = core.route();
+    core.receive(1, advertisement(1, 1, 0, node_bit(1), 2), 2110);
+    core.tick(2120);
+    // Returning A has a lower ID but no shorter path: no switch or callback.
+    ASSERT_TRUE(core.route().parent == failover.parent && core.route().root == failover.root &&
+                core.route().rank == failover.rank && core.route().path_bits == failover.path_bits);
