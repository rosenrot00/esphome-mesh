+  ASSERT_TRUE(h.packets.size() == 1 && h.packets[0].to == 2);
+  const Frame origin = h.packets[0].frame;
+  h.packets.clear();
+  h.node(2).receive(1, origin, 120);
+  ASSERT_TRUE(h.packets.size() == 1 && h.packets[0].to == 3);
+  const Frame transit = h.packets[0].frame;
+  h.packets.clear();
+  ASSERT_TRUE(transit.source_session == origin.source_session &&
+              transit.destination_session == origin.destination_session &&
+              transit.root_session == origin.root_session && transit.ttl + 1 == origin.ttl);
+  for (unsigned replacement = 0; replacement < 2; ++replacement) {
+    ++sessions.tags[3];  // Different MAC, then same MAC/new boot: both have new opaque epochs.
+    const auto invalid = h.node(3).counters().invalid_drops;
+    h.node(3).receive(2, transit, 130 + replacement);
+    ASSERT_TRUE(h.node(3).counters().invalid_drops == invalid + 1 && h.deliveries.empty());
+  }
+  Frame current = sessions.scope(transit);
+  h.node(3).receive(2, current, 140);
+  ASSERT_TRUE(h.count_deliveries(3, FrameType::DATA, 911) == 1);
+  ++sessions.tags[1];
+  const auto invalid = h.node(3).counters().invalid_drops;
+  h.node(3).receive(2, current, 150);
+  ASSERT_TRUE(h.node(3).counters().invalid_drops == invalid + 1);
+  current = sessions.scope(current);
+  h.node(3).receive(2, current, 151);
+  ASSERT_TRUE(h.count_deliveries(3, FrameType::DATA, 911) == 2);  // Same sequence, new source session.
+  const auto forwarded = h.node(2).counters().forwarded;
+  h.node(2).receive(1, origin, 160);
+  ASSERT_TRUE(h.node(2).counters().forwarded == forwarded && h.packets.empty());
+}
