+TEST(MeshIpPacket, FragmenterAdvancesOnlyAfterRealCoreQueueAcceptance) {
+  const auto original = packet(kMtu, 9191);
+  Fragmenter fragmenter;
+  ASSERT_TRUE(fragmenter.begin(original.data(), original.size(), 9191));
+  mesh_core::MeshCore sender(3), receiver(1);
+  struct Context {
+    std::vector<mesh_core::Frame> queue;
+    Reassembler reassembler;
+    Bytes delivered;
+    unsigned accepted{0}, rejected{0}, packets{0};
+  } context;
+  mesh_core::Callbacks callbacks{};
+  callbacks.context = &context;
+  callbacks.send = [](void *opaque, NodeId hop, const mesh_core::Frame &frame) {
+    auto &ctx = *static_cast<Context *>(opaque);
+    assert(hop == 1);
+    if (!ctx.queue.empty()) {
+      ++ctx.rejected;
+      return false;  // One-slot adapter queue, no partial copy on failure.
+    }
+    ctx.queue.push_back(frame);
+    ++ctx.accepted;
+    return true;
+  };
+  sender.set_callbacks(callbacks);
+  mesh_core::Frame advert;
+  advert.type = mesh_core::FrameType::ADVERTISEMENT;
+  advert.source = advert.root = 1;
+  advert.rank = 0;
+  advert.path_bits = 1;
+  advert.sequence = 1;
+  sender.receive(1, advert, 0);
+  callbacks.send = nullptr;
+  callbacks.deliver = [](void *opaque, const mesh_core::Frame &frame) {
+    auto &ctx = *static_cast<Context *>(opaque);
+    CompletedPacket complete;
+    const auto result =
+        ctx.reassembler.receive(frame.source, frame.destination, frame.payload, frame.payload_length, 0, complete);
+    if (result == ReceiveResult::COMPLETE) {
+      ctx.delivered.assign(complete.data, complete.data + complete.length);
+      ++ctx.packets;
+    } else {
+      ASSERT_TRUE(result == ReceiveResult::INCOMPLETE);
+    }
+  };
+  receiver.set_callbacks(callbacks);
+  uint16_t next_sequence = 100;
+  auto offer_fragment = [&]() {
+    std::array<uint8_t, mesh_core::kMaxPayload> data{};
+    size_t length = 0;
+    assert(fragmenter.peek(data.data(), data.size(), length));
+    if (!sender.send_data(1, next_sequence, data.data(), length, 0))
+      return false;
+    ++next_sequence;
+    return fragmenter.advance();
+  };
+  const uint8_t occupying_control = 1;
+  ASSERT_TRUE(sender.send_control(1, 99, &occupying_control, 1, 0));
+  ASSERT_TRUE(!offer_fragment());
+  ASSERT_TRUE(fragmenter.fragment_index() == 0 && fragmenter.active());
+  context.queue.clear();  // The unrelated control frame finishes.
+  for (uint8_t index = 0; index < kMaxFragments; ++index) {
+    ASSERT_TRUE(fragmenter.fragment_index() == index);
+    ASSERT_TRUE(offer_fragment());
+    ASSERT_TRUE(context.queue.size() == 1);
+    const auto accepted_frame = context.queue.front();
+    ASSERT_TRUE(accepted_frame.payload[10] == index && accepted_frame.sequence == 100 + index);
+    if (fragmenter.active()) {
+      const auto waiting_index = fragmenter.fragment_index();
+      std::array<uint8_t, mesh_core::kMaxPayload> before{}, after{};
+      size_t before_length = 0, after_length = 0;
+      ASSERT_TRUE(fragmenter.peek(before.data(), before.size(), before_length));
+      ASSERT_TRUE(!offer_fragment());
+      ASSERT_TRUE(fragmenter.fragment_index() == waiting_index);
+      ASSERT_TRUE(fragmenter.peek(after.data(), after.size(), after_length));
+      ASSERT_TRUE(before_length == after_length && before == after);
+      ASSERT_TRUE(context.queue.size() == 1 && context.queue.front().sequence == accepted_frame.sequence);
+    }
+    context.queue.clear();
+    uint8_t wire[mesh_core::kMaxWireSize];
+    size_t length = 0;
+    ASSERT_TRUE(mesh_core::encode_frame(accepted_frame, wire, sizeof(wire), length));
+    mesh_core::Frame decoded;
+    ASSERT_TRUE(mesh_core::decode_frame(wire, length, decoded));
+    receiver.receive(3, decoded, 0);
+  }
+  ASSERT_TRUE(!fragmenter.active() && context.packets == 1 && context.delivered == original);
+  ASSERT_TRUE(context.accepted == kMaxFragments + 1 && context.rejected == kMaxFragments);
+  ASSERT_TRUE(next_sequence == 100 + kMaxFragments);
+}
