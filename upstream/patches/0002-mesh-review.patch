+struct MemoryBackend {
+  struct Received {
+    ReceiveMetadata metadata;
+    Frame frame;
+  };
+  InterfaceId id{7};
+  size_t mtu{160};
+  bool accepting{true}, started{false};
+  unsigned starts{0}, stops{0}, processes{0}, cancels{0}, clears{0};
+  std::deque<Received> input;
+  std::vector<Frame> output;
+  bool allow{true};
+  Transport descriptor() {
+    Transport transport;
+    transport.context = this;
+    transport.interface.id = id;
+    transport.interface.capabilities.payload_mtu = mtu;
+    transport.enqueue = [](void *context, InterfaceId interface, uint8_t, const Frame &frame, uint32_t) {
+      auto &self = *static_cast<MemoryBackend *>(context);
+      assert(interface == self.id);
+      if (!self.accepting)
+        return false;
+      self.output.push_back(frame);
+      return true;
+    };
+    transport.poll_receive = [](void *context, ReceiveMetadata &metadata, Frame &frame) {
+      auto &self = *static_cast<MemoryBackend *>(context);
+      if (self.input.empty())
+        return false;
+      metadata = self.input.front().metadata;
+      frame = self.input.front().frame;
+      self.input.pop_front();
+      return true;
+    };
+    transport.start = [](void *context) {
+      auto &self = *static_cast<MemoryBackend *>(context);
+      ++self.starts;
+      self.started = true;
+      return true;
+    };
+    transport.stop = [](void *context) {
+      auto &self = *static_cast<MemoryBackend *>(context);
+      ++self.stops;
+      self.started = false;
+    };
+    transport.process = [](void *context, uint32_t, bool allow_start) {
+      auto &self = *static_cast<MemoryBackend *>(context);
+      ++self.processes;
+      self.allow = allow_start;
+    };
+    transport.cancel_pending = [](void *context, bool keep_inflight) {
+      auto &self = *static_cast<MemoryBackend *>(context);
+      self.cancels += keep_inflight ? 1 : 2;
+      self.output.clear();
+    };
+    transport.discard_receive = [](void *context) {
+      auto &self = *static_cast<MemoryBackend *>(context);
+      ++self.clears;
+      self.input.clear();
+    };
+    transport.queue_state = [](const void *context) {
+      const auto &self = *static_cast<const MemoryBackend *>(context);
+      return QueueState{self.output.size(), 48, false};
+    };
+    transport.counters = [](const void *context) {
+      const auto &self = *static_cast<const MemoryBackend *>(context);
+      TransportCounters counters;
+      counters.accepted = static_cast<uint32_t>(self.output.size());
+      return counters;
+    };
+    return transport;
+  }
+};
+
+Frame advertisement(uint16_t sequence = 1) {
+  Frame frame;
+  frame.type = FrameType::ADVERTISEMENT;
+  frame.source = frame.root = 1;
+  frame.rank = 0;
+  frame.path_bits = 1;
+  frame.sequence = sequence;
+  return frame;
+}
+struct Observer {
+  unsigned delivered{0}, changed{0}, received{0};
+  bool accepting{true};
+  MeshRuntime::Observers callbacks() {
+    return {this,
+            [](void *context, const ReceiveMetadata &, const Frame &) {
+              return static_cast<Observer *>(context)->accepting;
+            },
+            [](void *context, const Frame &) { ++static_cast<Observer *>(context)->delivered; },
+            [](void *context, const RouteSnapshot &) { ++static_cast<Observer *>(context)->changed; },
+            [](void *context, uint32_t) { ++static_cast<Observer *>(context)->received; }};
+  }
+};
