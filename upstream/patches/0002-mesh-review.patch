+TEST(MeshIpPacket, VariableProfilesInvalidConfigurationAndWireMetadata) {
+  Fragmenter fragmenter;
+  Reassembler receiver;
+  const PacketProfile good{43, 7000};
+  mesh_transport::LinkCapabilities native_large;
+  native_large.payload_mtu = 1000;
+  const auto capped = packet_profile_for_link(native_large, 30000);
+  ASSERT_TRUE(valid_packet_profile(capped) && capped.payload_mtu == std::min(size_t(1000), mesh_core::kMaxPayload) &&
+              capped.reassembly_timeout_ms == 30000);
+  ASSERT_TRUE(fragmenter.set_profile(good) && receiver.set_profile(good));
+  const PacketProfile bad[]{
+      {0, 2000}, {kMinimumPayloadMtu - 1, 2000}, {mesh_core::kMaxPayload + 1, 2000}, {43, 0}, {43, 0x80000000U}};
+  for (const auto &profile : bad) {
+    ASSERT_TRUE(!valid_packet_profile(profile));
+    ASSERT_TRUE(!fragmenter.set_profile(profile) && !receiver.set_profile(profile));
+    ASSERT_TRUE(fragmenter.profile().payload_mtu == 43 && receiver.profile().reassembly_timeout_ms == 7000);
+  }
+  const auto bytes = packet(100);
+  const auto parts = fragments(bytes, 42, good);
+  CompletedPacket complete;
+  for (unsigned mode = 0; mode < 8; ++mode) {
+    auto part = parts.front();
+    if (mode == 0)
+      part[2] = 2;
+    if (mode == 1)
+      part[16] = 0;
+    if (mode == 2)
+      part[3] = 23;
+    if (mode == 3)
+      part[3] = 144;
+    if (mode == 4)
+      part[11] = 65;
+    if (mode == 5)
+      part[10] = 64;
+    if (mode == 6)
+      part.push_back(0);
+    if (mode == 7) {
+      part[2] = 1;
+      part[3] = 27;
+    }
+    ASSERT_TRUE(receive(receiver, part, 100, complete) == ReceiveResult::INVALID);
+    ASSERT_TRUE(receiver.pending_packets() == 0 && complete.data == nullptr);
+  }
+  // Even a short last fragment must not advertise an unsupported stride.
+  const auto short_big_stride = fragments(packet(1), 43).front();
+  ASSERT_TRUE(short_big_stride.size() == kFragmentHeaderSize + 1);
+  ASSERT_TRUE(receive(receiver, short_big_stride, 100, complete) == ReceiveResult::INVALID);
+}
+
+TEST(MeshIpPacket, WideAndSmallV3PacketsCoexistWithoutAmbiguousOffsets) {
+  Reassembler receiver;
+  const auto legacy = packet(kFragmentDataSize + 1);
+  const auto small = packet(400, 2);
+  const auto v1 = fragments(legacy, 100);
+  const auto v2 = fragments(small, 101, PacketProfile{43, 2000});
+  CompletedPacket complete;
+  ASSERT_TRUE(receive(receiver, v1[0], 100, complete) == ReceiveResult::INCOMPLETE);
+  ASSERT_TRUE(receive(receiver, v2[0], 100, complete) == ReceiveResult::INCOMPLETE);
+  for (size_t i = 1; i < v1.size(); ++i)
+    ASSERT_TRUE(receive(receiver, v1[i], 100, complete) ==
+                (i + 1 == v1.size() ? ReceiveResult::COMPLETE : ReceiveResult::INCOMPLETE));
+  assert_complete(complete, legacy, 100);
+  for (size_t i = 1; i < v2.size(); ++i)
+    ASSERT_TRUE(receive(receiver, v2[i], 100, complete) ==
+                (i + 1 == v2.size() ? ReceiveResult::COMPLETE : ReceiveResult::INCOMPLETE));
+  assert_complete(complete, small, 101);
+
+  // Same packet ID/checksum/count but two strides must not mix in one slot.
+  const auto tiny = packet(20);
+  const auto canonical = fragments(tiny, 102, PacketProfile{43, 2000}).front();
+  auto alternate = canonical;
+  alternate[16] = 28;
+  // Use a two-fragment packet for an in-flight conflict with equal count.
+  const auto pair = fragments(packet(49), 103, PacketProfile{43, 2000});
+  ASSERT_TRUE(receive(receiver, pair[0], 101, complete) == ReceiveResult::INCOMPLETE);
+  auto conflict = pair[0];
+  conflict[16] = 26;
+  conflict.push_back(0);
+  ASSERT_TRUE(receive(receiver, conflict, 101, complete) == ReceiveResult::INVALID);
+  ASSERT_TRUE(receive(receiver, pair[1], 102, complete) == ReceiveResult::COMPLETE);
+  assert_complete(complete, packet(49), 103);
+  ASSERT_TRUE(receive(receiver, canonical, 103, complete) == ReceiveResult::COMPLETE);
+  ASSERT_TRUE(receive(receiver, alternate, 104, complete) == ReceiveResult::DUPLICATE);
+}
+
+TEST(MeshIpPacket, PacketProfileChangesAreTransactionalAndDeadlineWraps) {
+  const PacketProfile profile{43, 30000};
+  const auto bytes = packet(100);
+  const auto parts = fragments(bytes, 1, profile);
+  Fragmenter fragmenter;
+  Reassembler receiver;
+  ASSERT_TRUE(fragmenter.set_profile(profile) && receiver.set_profile(profile));
+  ASSERT_TRUE(fragmenter.begin(bytes.data(), bytes.size(), 1));
+  ASSERT_TRUE(!fragmenter.set_profile(PacketProfile{}));
+  ASSERT_TRUE(fragmenter.profile().payload_mtu == 43);
+  const uint32_t start = UINT32_MAX - 100;
+  CompletedPacket complete;
+  ASSERT_TRUE(receive(receiver, parts[0], start, complete) == ReceiveResult::INCOMPLETE);
+  ASSERT_TRUE(!receiver.set_profile(PacketProfile{}));
+  ASSERT_TRUE(receive(receiver, parts[0], start + 29999, complete) == ReceiveResult::DUPLICATE);
+  ASSERT_TRUE(receiver.pending_packets() == 1);
+  receiver.expire(start + 30000);
+  ASSERT_TRUE(receiver.pending_packets() == 0 && receiver.counters().expired_packets == 1);
+  ASSERT_TRUE(receiver.set_profile(PacketProfile{}));
+  fragmenter.reset();
+  ASSERT_TRUE(fragmenter.set_profile(PacketProfile{}));
+  ASSERT_TRUE(fragmenter.begin(bytes.data(), bytes.size(), 2));
+  uint8_t buffer[160];
+  size_t written;
+  ASSERT_TRUE(fragmenter.peek(buffer, sizeof(buffer), written) && buffer[2] == 3 && buffer[3] == 0);
+}
+
+TEST(MeshIpPacket, SmallMtuPeekBackpressurePreservesCanonicalFragment) {
+  const auto bytes = packet(kMtu);
+  Fragmenter fragmenter;
+  ASSERT_TRUE(fragmenter.set_profile(PacketProfile{43, 2000}));
+  ASSERT_TRUE(fragmenter.begin(bytes.data(), bytes.size(), 7));
+  ASSERT_TRUE(fragmenter.fragment_count() == 60);
+  uint8_t first[43], repeated[43];
+  size_t first_length, repeated_length;
+  ASSERT_TRUE(!fragmenter.peek(first, 42, first_length) && first_length == 0);
+  ASSERT_TRUE(fragmenter.peek(first, 43, first_length) && first_length == 43);
+  for (unsigned retry = 0; retry < 10; ++retry) {
+    ASSERT_TRUE(fragmenter.peek(repeated, 43, repeated_length));
+    ASSERT_TRUE(repeated_length == first_length && std::memcmp(first, repeated, first_length) == 0);
+    ASSERT_TRUE(fragmenter.fragment_index() == 0);
+  }
+  Reassembler receiver;
+  CompletedPacket complete;
+  ASSERT_TRUE(receiver.set_profile(PacketProfile{43, 2000}));
+  unsigned count = 0;
+  while (fragmenter.active()) {
+    ASSERT_TRUE(fragmenter.peek(first, 43, first_length));
+    const auto result = receiver.receive(3, 1, first, first_length, 100, complete);
+    ++count;
+    ASSERT_TRUE(result == (count == 60 ? ReceiveResult::COMPLETE : ReceiveResult::INCOMPLETE));
+    ASSERT_TRUE(fragmenter.advance());
+  }
+  assert_complete(complete, bytes, 7);
+}
