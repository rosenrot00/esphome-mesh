+      ASSERT_TRUE(network.a.delivery.begin(2, short_packet.data(), short_packet.size(), 101 + submitted_short, now));
+      ++submitted_short;
+    }
+    network.step(now);
+  }
+  ASSERT_TRUE(submitted_short == 80 && lost == 5);
+  ASSERT_TRUE(std::count(network.b.delivered.begin(), network.b.delivered.end(), old_packet) == 1);
+  ASSERT_TRUE(std::count(network.b.delivered.begin(), network.b.delivered.end(), short_packet) == 80);
+  ASSERT_TRUE(network.a.delivery.counters().acknowledged == 81);
+  ASSERT_TRUE(network.a.delivery.counters().retry_exhausted == 0 && network.a.delivery.counters().tx_expired == 0);
+  ASSERT_TRUE(network.a.delivery.counters().window_stalls == 1);
+}
