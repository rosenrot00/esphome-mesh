+bool MeshCore::set_link_capabilities(const mesh_transport::LinkCapabilities &link) {
+  if (transport_enqueue_ != nullptr || !mesh_transport::valid_link_capabilities(link))
+    return false;
+  link_ = link;
+  return true;
+}
