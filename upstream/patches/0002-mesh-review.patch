+TEST(MeshEndpoint, FreshnessBudgetIsBoundedAndConservative) {
+  ASSERT_TRUE(ChallengeRegistry::freshness_budget(0, 0) == 0);
+  ASSERT_TRUE(ChallengeRegistry::freshness_budget(0, 1999) == 0);
+  ASSERT_TRUE(ChallengeRegistry::freshness_budget(1, 0) == 1000);
+  ASSERT_TRUE(ChallengeRegistry::freshness_budget(1, 999) == 1);
+  ASSERT_TRUE(ChallengeRegistry::freshness_budget(1, 1000) == 0);
+  ASSERT_TRUE(ChallengeRegistry::freshness_budget(1, 1999) == 0);
+  ASSERT_TRUE(ChallengeRegistry::freshness_budget(4, 1999) == 2001);
+  ASSERT_TRUE(ChallengeRegistry::freshness_budget(5, 1999) == 3001);
+  ASSERT_TRUE(ChallengeRegistry::freshness_budget(100, 1999) == 3001);
+  ASSERT_TRUE(ChallengeRegistry::freshness_budget(UINT32_MAX, 0) == 5000);
+  ASSERT_TRUE(ChallengeRegistry::freshness_budget(UINT32_MAX, 1999) == 3001);
+  ASSERT_TRUE(ChallengeRegistry::freshness_budget(UINT32_MAX, UINT32_MAX) == 0);
+  ChallengeRegistry registry;
+  uint32_t age = 0;
+  ASSERT_TRUE(registry.begin(3, 3, 100));
+  ASSERT_TRUE(registry.consume(3, 3, 1500, age));
+  // A response delayed past a one-second remaining lease grants no ownership,
+  // even though its one-use challenge itself was still valid.
+  ASSERT_TRUE(ChallengeRegistry::freshness_budget(1, age) == 0);
