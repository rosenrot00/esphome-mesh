+Mac mac(uint8_t number) { return {0x02, 0x00, 0x00, 0x00, 0x00, number}; }
+BootNonce boot(uint8_t number) {
+  BootNonce value{};
+  value[0] = number;
+  value[15] = static_cast<uint8_t>(number ^ 0xA5);
+  return value;
+}
+Claim claim(uint8_t number, NodeId id, uint32_t sequence = 1, uint8_t flags = kGatewayCapable, uint8_t session = 0) {
+  return {mac(number), boot(session != 0 ? session : number), id, flags, sequence};
+}
+std::vector<uint8_t> wire(const Message &message) {
+  std::vector<uint8_t> output(kMaxWireSize);
+  size_t written = 0;
+  assert(encode_message(message, output.data(), output.size(), written));
+  output.resize(written);
+  return output;
+}
+Message announcement(const Claim &value, uint8_t hops = kMaxFloodHops) {
+  Message message;
+  message.claim = value;
+  message.hops = hops;
+  return message;
+}
+bool deliver(Membership &membership, const Message &message, uint32_t now) {
+  const auto bytes = wire(message);
+  return membership.receive(bytes.data(), bytes.size(), now);
+}
+
+struct Fixture {
+  Membership member;
+  std::vector<Message> sent;
+  std::vector<SlotChange> slots;
+  struct LocalEvent {
+    NodeId previous, current;
+    LocalChange reason;
+  };
+  std::vector<LocalEvent> local_events;
+  uint64_t nonce{0};
+  bool accepting{true};
+
+  explicit Fixture(uint8_t number = 10, NodeId preferred = 1, NodeId pinned = 0, uint16_t allowed = 0xFFFF,
+                   uint8_t flags = kGatewayCapable, uint32_t now = 0) {
+    nonce = static_cast<uint64_t>(number) << 48;
+    member.set_callbacks(
+        {this,
+         [](void *context, const uint8_t *bytes, size_t length) {
+           auto &self = *static_cast<Fixture *>(context);
+           if (!self.accepting)
+             return false;
+           Message message;
+           assert(decode_message(bytes, length, message));
+           self.sent.push_back(message);
+           return true;
+         },
+         [](void *context) { return ++static_cast<Fixture *>(context)->nonce; },
+         [](void *context, const SlotChange &change) { static_cast<Fixture *>(context)->slots.push_back(change); },
+         [](void *context, NodeId previous, NodeId current, LocalChange reason) {
+           static_cast<Fixture *>(context)->local_events.push_back({previous, current, reason});
+         }});
+    assert(member.set_allowed_ids(allowed));
+    assert(member.begin(mac(number), boot(number), preferred, pinned, flags, now));
+  }
+  Message last_challenge(const Mac &target) const {
+    for (auto it = sent.rbegin(); it != sent.rend(); ++it)
+      if (it->type == MessageType::CHALLENGE && it->claim.mac == target)
+        return *it;
+    assert(false);
+    return {};
+  }
+  void prove(const Claim &value, uint32_t now) {
+    Message proof = last_challenge(value.mac);
+    proof.type = MessageType::PROOF;
+    proof.claim = value;
+    assert(deliver(member, proof, now));
+  }
+};
