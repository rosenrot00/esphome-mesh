+  const auto before = registry.revision(3);
+  ASSERT_TRUE(descriptor.set_txt_value(2, "deadbeef"));
+  ASSERT_TRUE(receive(registry, 3, chunks(encode(descriptor), ADDRESS + 1), 200));
+  ASSERT_TRUE(!registry.current(3, ADDRESS, 200));
+  ASSERT_TRUE(registry.current(3, ADDRESS + 1, 200)->txt(2).value == "deadbeef");
