+TEST(MeshCore, ProbePayloadBoundsAndWireValidation) {
+  Harness h;
+  h.link(1, 2);
+  h.node(1).set_direct_uplink(true, 0);
+  h.run(0, 100);
+  const uint8_t byte = 0xA5;
+  const size_t original_packets = h.packets.size();
+  ASSERT_TRUE(!h.node(2).send_probe_payload(1, 1, nullptr, 1, 110));
+  ASSERT_TRUE(!h.node(2).send_probe_payload(1, 2, &byte, 161, 110));
+  ASSERT_TRUE(h.node(2).counters().invalid_drops == 2);
+  ASSERT_TRUE(h.packets.size() == original_packets);
+  ASSERT_TRUE(h.node(2).send_probe_payload(1, 3, nullptr, 0, 110));
+  h.pump(110);
+  ASSERT_TRUE(h.count_deliveries(2, FrameType::PROBE_REPLY, 3) == 1);
+
+  Frame frame{};
+  frame.source = 1;
+  frame.destination = 2;
+  frame.payload_length = 160;
+  for (size_t i = 0; i < 160; ++i)
+    frame.payload[i] = static_cast<uint8_t>(255U - i);
+  uint8_t bytes[kMaxWireSize + 1]{};
+  Frame decoded{};
+  for (const auto type : {FrameType::PROBE, FrameType::PROBE_REPLY}) {
+    frame.type = type;
+    size_t length = 0;
+    ASSERT_TRUE(encode_frame(frame, bytes, sizeof(bytes), length));
+    ASSERT_TRUE(length == 175);
+    ASSERT_TRUE(decode_frame(bytes, length, decoded));
+    ASSERT_TRUE(decoded.type == type && decoded.payload_length == 160);
+    for (size_t i = 0; i < 160; ++i)
+      ASSERT_TRUE(decoded.payload[i] == frame.payload[i]);
+    for (size_t truncated = 0; truncated < length; ++truncated)
+      ASSERT_TRUE(!decode_frame(bytes, truncated, decoded));
+    ASSERT_TRUE(!decode_frame(bytes, length + 1, decoded));
+    bytes[13] = uint8_t(kMaxPayload + 1);
+    bytes[14] = uint8_t((kMaxPayload + 1) >> 8);
+    ASSERT_TRUE(!decode_frame(bytes, length, decoded));
+    frame.payload_length = 161;
+    ASSERT_TRUE(!encode_frame(frame, bytes, sizeof(bytes), length));
+    ASSERT_TRUE(length == 0);
+    const auto delivered_before = h.deliveries.size();
+    h.node(2).receive(1, frame, 120);
+    ASSERT_TRUE(h.deliveries.size() == delivered_before);
+    frame.payload_length = 160;
+  }
+  ASSERT_TRUE(h.node(2).counters().invalid_drops == 4);
+}
