+  ASSERT_TRUE(network.nodes[0].member.local_id() == 1 && network.nodes[2].member.local_id() == 1);
+  ASSERT_TRUE(network.nodes[1].member.local_id() == 2 && network.nodes[3].member.local_id() == 2);
+  network.link(1, 2);
+  network.run(10000);
+  network.assert_converged(4);
+  ASSERT_TRUE(network.nodes[0].member.local_id() == 1 && network.nodes[1].member.local_id() == 2);
+  ASSERT_TRUE(network.nodes[2].member.local_id() != 1 && network.nodes[3].member.local_id() != 2);
+}
