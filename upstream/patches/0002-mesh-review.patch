@@ -0,0 +1,141 @@
+"""Validate runtime WiFi intent through real Mesh codegen and cached CLI targets."""
+
+from pathlib import Path
+from unittest.mock import patch
+
+import pytest
+import yaml
+
+from esphome import __main__ as cli
+from esphome.compiled_config import load_compiled_config, save_compiled_config
+from esphome.config import read_config
+from esphome.core import CORE
+from esphome.storage_json import StorageJSON, storage_path
+from esphome.types import ConfigType
+
+
+def validated_config(
+    tmp_path: Path,
+    *,
+    wifi_present: bool = True,
+    enable_on_boot: bool = True,
+    mesh_options: ConfigType | None = None,
+    use_address: str | None = None,
+) -> tuple[ConfigType | None, Path]:
+    config: ConfigType = {
+        "esphome": {"name": "mesh-intent-fixture"},
+        "esp32": {
+            "board": "esp32-s3-devkitc-1",
+            "framework": {"type": "esp-idf", "version": "5.5.5"},
+        },
+        "mesh": {"key": "00" * 32, **(mesh_options or {})},
+        "api": {},
+        "logger": {},
+        "ota": [{"platform": "esphome"}],
+    }
+    if wifi_present:
+        config["wifi"] = {
+            "ssid": "synthetic-intent-wlan",
+            "password": "synthetic-intent-password",
+            "enable_on_boot": enable_on_boot,
+        }
+        if use_address is not None:
+            config["wifi"]["use_address"] = use_address
+    path = tmp_path / "mesh.yaml"
+    path.write_text(yaml.safe_dump(config, sort_keys=False), encoding="utf-8")
+    CORE.config_path = path
+    validated = read_config({})
+    if validated is not None:
+        CORE.config = validated
+    return validated, path
+
+
+@pytest.mark.parametrize(
+    ("wifi_present", "enable_on_boot", "gateway", "gateway_expected"),
+    [
+        (True, True, True, True),
+        (True, False, True, True),
+        (False, False, True, False),
+        (True, False, False, False),
+    ],
+)
+def test_gateway_capability_follows_native_presence_and_explicit_role(
+    tmp_path: Path,
+    wifi_present: bool,
+    enable_on_boot: bool,
+    gateway: bool,
+    gateway_expected: bool,
+) -> None:
+    config, _ = validated_config(
+        tmp_path,
+        wifi_present=wifi_present,
+        enable_on_boot=enable_on_boot,
+        mesh_options={"gateway": gateway},
+    )
+    assert config is not None
+    cli.generate_cpp_contents(config)
+    cpp = CORE.cpp_main_section
+    assert ("set_gateway_enabled(true)" in cpp) == gateway_expected
+    assert ("set_gateway_enabled(false)" in cpp) != gateway_expected
+    assert not any(define.name == "MESH_NATIVE_WIFI_ON_BOOT" for define in CORE.defines)
+    assert not any("MESH_NATIVE_WIFI_ON_BOOT" in flag for flag in CORE.build_flags)
+    calls = [line for line in cpp.splitlines() if "set_native_wifi_network(" in line]
+    assert len(calls) == int(wifi_present)
+    assert "synthetic-intent-password" not in "\n".join(calls)
+
+
+@pytest.mark.parametrize("gateway_option", [{"ip_gateway": 3}, {"ip_gateways": [3]}])
+def test_disabled_boot_retains_future_local_gateway_capability(
+    tmp_path: Path, gateway_option: ConfigType
+) -> None:
+    config, _ = validated_config(
+        tmp_path,
+        enable_on_boot=False,
+        mesh_options={"node_id": 3, **gateway_option},
+    )
+    assert config is not None
+    cli.generate_cpp_contents(config)
+    assert "set_gateway_enabled(true)" in CORE.cpp_main_section
+
+
+@pytest.mark.parametrize("gateway_option", [{"ip_gateway": 3}, {"ip_gateways": [3]}])
+def test_absent_native_wifi_rejects_only_self_gateway(
+    tmp_path: Path, gateway_option: ConfigType
+) -> None:
+    config, _ = validated_config(
+        tmp_path,
+        wifi_present=False,
+        enable_on_boot=False,
+        mesh_options={"node_id": 3, **gateway_option},
+    )
+    assert config is None
+
+
+@pytest.mark.parametrize("use_address", [None, "native.example"])
+def test_disabled_boot_keeps_default_cli_targets_and_warm_cache(
+    tmp_path: Path, use_address: str | None
+) -> None:
+    config, path = validated_config(
+        tmp_path, enable_on_boot=False, use_address=use_address
+    )
+    assert config is not None
+    expected = use_address or "mesh-intent-fixture.local"
+    assert CORE.has_networking
+    assert CORE.address == expected
+    for purpose in (cli.Purpose.UPLOADING, cli.Purpose.LOGGING):
+        assert cli.choose_upload_log_host("OTA", None, purpose) == [expected]
+    StorageJSON.from_esphome_core(CORE, None, claim_build=False).save(storage_path())
+    save_compiled_config(config)
+    CORE.reset()
+    CORE.config_path = path
+    with patch(
+        "esphome.components.mesh.validate_boot_mode",
+        side_effect=AssertionError("Warm cache must not rerun Mesh validation"),
+    ):
+        loaded = load_compiled_config(path)
+        assert loaded is not None
+        CORE.config = loaded
+    assert CORE.has_networking
