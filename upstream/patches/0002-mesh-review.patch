+"""Validate local Discovery assembly limits through the real config pipeline."""
+
+from pathlib import Path
+
+import pytest
+import yaml
+
+from esphome.config import read_config
+from esphome.core import CORE
+
+
+@pytest.mark.parametrize(
+    ("options", "nodes", "slots"),
+    [
+        ({}, 8, 8),
+        ({"max_nodes": 4, "discovery_assembly_slots": 1}, 4, 1),
+        ({"max_nodes": 8, "discovery_assembly_slots": 4}, 8, 4),
+        ({"max_nodes": 16}, 16, 16),
+    ],
+)
+def test_discovery_assembly_capacity_defaults_and_local_override(
+    tmp_path: Path, options: dict[str, int], nodes: int, slots: int
+) -> None:
+    config = {
+        "esphome": {"name": "mesh-pool-fixture"},
+        "esp32": {
+            "board": "esp32-s3-devkitc-1",
+            "framework": {"type": "esp-idf", "version": "5.5.5"},
+        },
+        "mesh": {"key": "00" * 32, **options},
+        "api": {},
+        "logger": {},
+    }
+    path = tmp_path / "mesh.yaml"
+    path.write_text(yaml.safe_dump(config), encoding="utf-8")
+    CORE.reset()
+    try:
+        CORE.config_path = path
+        validated = read_config({})
+        assert validated is not None
+        assert validated["mesh"]["max_nodes"] == nodes
+        assert validated["mesh"]["discovery_assembly_slots"] == slots
+    finally:
+        CORE.reset()
+
+
+@pytest.mark.parametrize("slots", [0, 5, 17])
+def test_discovery_assembly_capacity_rejects_invalid_bounds(
+    tmp_path: Path, slots: int
+) -> None:
+    config = {
+        "esphome": {"name": "mesh-pool-fixture"},
+        "esp32": {
+            "board": "esp32-s3-devkitc-1",
+            "framework": {"type": "esp-idf", "version": "5.5.5"},
+        },
+        "mesh": {"key": "00" * 32, "max_nodes": 4, "discovery_assembly_slots": slots},
+        "logger": {},
+    }
+    path = tmp_path / "mesh.yaml"
+    path.write_text(yaml.safe_dump(config), encoding="utf-8")
+    CORE.reset()
+    try:
+        CORE.config_path = path
+        assert read_config({}) is None
+    finally:
+        CORE.reset()
