+TEST(MeshCore, RouteRetentionRevalidatesParentAndRootSessions) {
+  for (const bool stable : {false, true}) {
+    for (const NodeId replaced : {NodeId(1), NodeId(3)}) {
+      for (const bool withdrawn : {false, true}) {
+        Sessions sessions;
+        MeshCore core(4);
+        ASSERT_TRUE(core.set_session_resolver(&sessions, Sessions::resolve));
+        core.set_route_stability(stable);
+        const Frame previous = sessions.scope(advertisement(3, 1, 1, node_bit(1) | node_bit(3), 2));
+        core.receive(3, sessions.scope(advertisement(3, 1, 1, node_bit(1) | node_bit(3))), 100);
+        core.receive(2, sessions.scope(advertisement(2, 5, 1, node_bit(5) | node_bit(2))), 110);
+        ASSERT_TRUE(core.route().parent == 3);
+        if (withdrawn)
+          sessions.tags[replaced] = 0;
+        else
+          ++sessions.tags[replaced];
+        core.tick(120);
+        ASSERT_TRUE(core.route().parent == 2 && core.route().root == 5);
+        const auto invalid = core.counters().invalid_drops;
+        core.receive(3, previous, 130);
+        ASSERT_TRUE(core.counters().invalid_drops == invalid + 1 && core.route().parent == 2);
+        if (!withdrawn) {
+          // A current-session reannouncement cannot take back an equal path.
+          core.receive(3, sessions.scope(advertisement(3, 1, 1, node_bit(1) | node_bit(3))), 140);
+          ASSERT_TRUE(core.route().parent == 2 && core.route().root == 5);
+        }
+      }
+    }
+  }
+}
