+struct CoreNetwork;
+struct CoreEndpoint {
+  NodeId id;
+  mesh_core::MeshCore core;
+  PacketDelivery delivery;
+  CoreNetwork *network;
+  uint16_t sequence{100};
+  unsigned received{0};
+  CoreEndpoint(NodeId id, CoreNetwork *network) : id(id), core(id), network(network) {}
+};
+struct CoreNetwork {
+  struct Wire {
+    NodeId source, hop;
+    mesh_core::Frame frame;
+  };
+  CoreEndpoint a{1, this}, b{2, this}, c{3, this};
+  std::deque<Wire> wire;
+  uint32_t now{0}, release_at{0};
+  unsigned relay_rejections{0};
+  CoreNetwork(bool sessions) {
+    for (auto *endpoint : {&a, &b, &c}) {
+      endpoint->core.set_callbacks({endpoint,
+                                    [](void *p, NodeId hop, const mesh_core::Frame &frame) {
+                                      auto &self = *static_cast<CoreEndpoint *>(p);
+                                      if (self.id == 2 && frame.type == mesh_core::FrameType::DATA &&
+                                          self.network->now < self.network->release_at) {
+                                        ++self.network->relay_rejections;
+                                        return false;
+                                      }
+                                      self.network->wire.push_back({self.id, hop, frame});
+                                      return true;
+                                    },
+                                    [](void *p, const mesh_core::Frame &frame) {
+                                      auto &self = *static_cast<CoreEndpoint *>(p);
+                                      if (frame.type == mesh_core::FrameType::DATA)
+                                        self.delivery.receive_fragment(frame.source, frame.destination, frame.payload,
+                                                                       frame.payload_length, self.network->now);
+                                      else if (frame.type == mesh_core::FrameType::CONTROL)
+                                        self.delivery.accept_ack(frame.source, frame.payload, frame.payload_length,
+                                                                 self.network->now);
+                                    },
+                                    nullptr});
+      if (sessions)
+        assert(endpoint->core.set_session_resolver(nullptr, [](void *, NodeId id) { return uint64_t(10 + id); }));
+      assert(endpoint->delivery.configure(
+          endpoint->id, {},
+          {endpoint,
+           [](void *p, NodeId destination, const uint8_t *payload, size_t length) {
+             auto &self = *static_cast<CoreEndpoint *>(p);
+             return self.core.send_data(destination, ++self.sequence, payload, length, self.network->now);
+           },
+           [](void *p, NodeId destination, const uint8_t *payload, size_t length) {
+             auto &self = *static_cast<CoreEndpoint *>(p);
+             return self.core.send_control(destination, ++self.sequence, payload, length, self.network->now);
+           },
+           [](void *p, NodeId, const uint8_t *, size_t) {
+             ++static_cast<CoreEndpoint *>(p)->received;
+             return true;
+           }}));
+    }
+    a.core.set_direct_uplink(true, 0);
+  }
+  void step(uint32_t clock) {
+    now = clock;
+    for (auto *endpoint : {&a, &b, &c}) {
+      endpoint->core.tick(now);
+      endpoint->delivery.tick(now);
+    }
+    unsigned guard = 0;
+    while (!wire.empty()) {
+      assert(++guard < 1000);
+      const auto item = wire.front();
+      wire.pop_front();
+      for (auto *target : {&a, &b, &c}) {
+        const bool edge = (item.source == 2 && target->id != 2) || (item.source != 2 && target->id == 2);
+        if (edge && (item.hop == 0 || item.hop == target->id))
+          target->core.receive(item.source, item.frame, now);
+      }
+    }
+  }
+};
+
+TEST(MeshIpDelivery, ActualCoreRelayBackpressureRecoversWithFreshSequencesInV1AndV2) {
+  for (bool sessions : {false, true}) {
+    CoreNetwork network(sessions);
+    for (uint32_t now = 0; now <= 1000; now += 5)
+      network.step(now);
+    ASSERT_TRUE(network.c.core.route().root == 1 && network.c.core.route().parent == 2);
+    network.release_at = 1510;
+    const auto packet = bytes(1500);
+    ASSERT_TRUE(network.c.delivery.begin(1, packet.data(), packet.size(), 7, 1005));
+    for (uint32_t now = 1005; now < 2600; now += 5)
+      network.step(now);
+    ASSERT_TRUE(network.relay_rejections > 0 && network.a.received == 1);
+    ASSERT_TRUE(network.c.delivery.counters().fragment_retries > 0 && network.c.delivery.counters().acknowledged == 1);
+    ASSERT_TRUE(network.c.delivery.pending_count() == 0);
+  }
+}
+
+TEST(MeshIpDelivery, CumulativeAcksReduceWireCountAndCommitWithoutDelay) {
+  const auto packet = bytes(1500);
+  // Keep the original partial final batch as well as the new native budget.
+  for (size_t mtu : {size_t(160), size_t(mesh_core::kMaxPayload)}) {
+    const size_t count = (packet.size() + mtu - kFragmentHeaderSize - 1) / (mtu - kFragmentHeaderSize);
+    for (bool batched : {false, true}) {
+      DeliveryProfile profile;
+      profile.packet.payload_mtu = mtu;
+      if (!batched) {
+        profile.max_ack_delay_ms = 0;
+        profile.ack_batch_size = 1;
+      }
+      Network network(profile);
+      for (uint8_t index = 0; index < count; ++index) {
+        const auto part = fragment(packet, 123, index, profile.packet);
+        network.b.delivery.receive_fragment(1, 2, part.data(), part.size(), index);
+        network.b.delivery.tick(index);
+      }
+      ASSERT_TRUE(network.b.delivered == std::vector<Bytes>{packet});
+      ASSERT_TRUE(network.b.delivery.counters().acks_sent == (batched ? (count + 3) / 4 : count));
+      ASSERT_TRUE(network.pending.back().ack && network.pending.back().payload[3] == 1);
+      const uint64_t mask = (UINT64_C(1) << count) - 1;
+      ASSERT_TRUE(network.pending.back().payload[16] == uint8_t(mask) &&
+                  network.pending.back().payload[17] == uint8_t(mask >> 8));
+      // Final ACK is queued on this commit tick, including a partial final batch.
+    }
+  }
+}
+
+TEST(MeshIpDelivery, DelayedAckDeadlineWrapsWithoutFutureFlushOrExtension) {
+  const auto packet = bytes(1500);
+  DeliveryProfile profile;
+  profile.packet.payload_mtu = 160;
+  const uint32_t start = UINT32_MAX - 5;
+  auto part = fragment(packet, 123, 0, profile.packet);
+  {
+    Network future(profile);
+    future.b.delivery.receive_fragment(1, 2, part.data(), part.size(), start);
+    future.b.delivery.tick(start - 1);  // Isolate ACK's guard from Reassembler's monotonic-clock contract.
+    ASSERT_TRUE(future.pending.empty());
+  }
+  Network network(profile);
+  network.b.delivery.receive_fragment(1, 2, part.data(), part.size(), start);
+  network.b.delivery.tick(start);
+  ASSERT_TRUE(network.pending.empty());
+  part = fragment(packet, 123, 1, profile.packet);
+  network.b.delivery.receive_fragment(1, 2, part.data(), part.size(), start + 5);
+  network.b.delivery.tick(start + 9);
+  ASSERT_TRUE(network.pending.empty());
+  network.b.delivery.tick(start + 10);
+  ASSERT_TRUE(network.pending.size() == 1 && network.pending.front().payload[16] == 3);
+  ASSERT_TRUE(network.pending.front().payload[3] == 0);
+  part = fragment(packet, 123, 2, profile.packet);
+  network.b.delivery.receive_fragment(1, 2, part.data(), part.size(), start + 11);
+  network.b.delivery.tick(start + 11);
+  part = fragment(packet, 123, 3, profile.packet);
+  network.b.delivery.receive_fragment(1, 2, part.data(), part.size(), start + 12);
+  network.b.delivery.tick(start + 12);
+  ASSERT_TRUE(network.pending.size() == 1);  // Cumulative four bits contain only two new fragments since the ACK.
+  network.b.delivery.tick(start + 20);
+  ASSERT_TRUE(network.pending.size() == 1);
+  network.b.delivery.tick(start + 21);  // Next deadline is measured from the first new fragment, at11.
+  ASSERT_TRUE(network.pending.size() == 2 && network.pending.back().payload[16] == 15);
+  ASSERT_TRUE(network.pending.back().payload[3] == 0);
+}
+
+TEST(MeshIpDelivery, InterleavedPartialDatagramsFlushIndependentlyWithoutBatchHeadBlock) {
+  const auto packet = bytes(1500);
+  for (bool same_source : {false, true}) {
+    Network network;
+    for (uint8_t index = 0; index < 3; ++index) {
+      for (uint8_t slot = 0; slot < 2; ++slot) {
+        const NodeId source = slot == 0 || same_source ? 1 : 3;
+        const auto part = fragment(packet, 101 + slot, index);
+        const uint32_t now = index * 2 + slot;
+        network.b.delivery.receive_fragment(source, 2, part.data(), part.size(), now);
+        network.b.delivery.tick(now);
+      }
+    }
+    ASSERT_TRUE(network.pending.empty());  // 3+3 unique fragments, neither reaches4.
+    network.b.delivery.tick(10);
+    ASSERT_TRUE(network.pending.size() == 1 && network.pending[0].destination == 1 &&
+                packet_id(network.pending[0].payload) == 101);
+    network.b.delivery.tick(11);
+    ASSERT_TRUE(network.pending.size() == 2 && network.pending[1].destination == (same_source ? 1 : 3) &&
+                packet_id(network.pending[1].payload) == 102);
+    for (const auto &message : network.pending)
+      ASSERT_TRUE(message.ack && message.payload[16] == 7 && message.payload[3] == 0);
+  }
+}
