+  ASSERT_TRUE(discovery_chunk(data.data(), data.size(), ADDRESS, 0, explicit_budget.data(), explicit_budget.size(),
+                              explicit_size, 160));
+  ASSERT_TRUE(implicit_size == 160 && explicit_size == implicit_size && implicit == explicit_budget);
+  Bytes expected(160);
+  expected[0] = 1;
+  expected[1] = 7;
