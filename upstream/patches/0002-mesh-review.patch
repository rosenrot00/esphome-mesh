+void root_zones(Harness &h) {
+  // A -- relay(A) -- relay(B) -- B -- relay(B) -- client(B).
+  // Neither gateway can find the other merely by following its own root.
+  h.link(1, 4);
+  h.link(4, 5);
+  h.link(5, 2);
+  h.link(2, 3);
+  h.link(3, 6);
+  h.node(1).set_direct_uplink(true, 0);
+  h.node(2).set_direct_uplink(true, 0);
+  h.run(0, 100);
+  assert(h.node(4).route().root == 1 && h.node(5).route().root == 2);
+  assert(h.node(1).route().direct && h.node(2).route().direct);
+}
+
+size_t requests_from(const Harness &h, NodeId source, NodeId destination) {
+  size_t count = 0;
+  for (const auto &offer : h.offers)
+    count += offer.from == source && offer.frame.source == source && offer.frame.destination == destination &&
+             offer.frame.type == FrameType::ROUTE_REQUEST;
+  return count;
+}
+
+TEST(MeshCore, DiscoveryCrossesForeignRootZonesWithoutChangingUplink) {
+  Harness h;
+  root_zones(h);
+  const uint8_t command = 7;
+  ASSERT_TRUE(!h.node(2).send_control(1, 800, &command, 1, 110));
+  ASSERT_TRUE(requests_from(h, 2, 1) == 1);
+  h.pump(110);
+  ASSERT_TRUE(h.deliveries.empty());  // Internal requests and replies stay inside the core.
+  ASSERT_TRUE(h.node(2).route().direct && h.node(2).route().root == 2);
+  ASSERT_TRUE(h.node(2).send_control(1, 800, &command, 1, 120));
+  h.pump(120);
+  ASSERT_TRUE(h.count_deliveries(1, FrameType::CONTROL, 800) == 1);
+  ASSERT_TRUE(h.node(1).send_control(2, 801, &command, 1, 130));
+  h.pump(130);
+  ASSERT_TRUE(h.count_deliveries(2, FrameType::CONTROL, 801) == 1);
+  // Every reply hop learned the destination, not only the requester.
