+TEST(MeshIpDelivery, LostCumulativeAndFinalAcksRecoverWithoutDuplicateDelivery) {
+  // More than one send window is needed to expose a progress ACK before commit.
+  DeliveryProfile profile;
+  profile.packet.payload_mtu = 160;
+  Network network(profile);
+  bool lost_progress = false, lost_final = false;
+  network.drop = [&](const Message &message) {
+    if (!message.ack)
+      return false;
+    if (message.payload[3] == 0 && !lost_progress) {
+      lost_progress = true;
+      return true;
+    }
+    if (message.payload[3] == 1 && !lost_final) {
+      lost_final = true;
+      return true;
+    }
+    return false;
+  };
+  const auto packet = bytes(1500);
+  ASSERT_TRUE(network.a.delivery.begin(2, packet.data(), packet.size(), 1, 0));
+  network.run();
+  ASSERT_TRUE(lost_progress && lost_final && network.b.delivered == std::vector<Bytes>{packet});
+  ASSERT_TRUE(network.a.delivery.counters().acknowledged == 1 && network.a.delivery.counters().fragment_retries > 0);
+  ASSERT_TRUE(network.a.delivery.counters().retry_exhausted == 0 && network.a.delivery.counters().tx_expired == 0);
+}
