index 000000000..1a6aeb5c7
--- /dev/null
+++ b/tests/components/mesh/test_ip_ipv6_discovery.cpp
@@ -0,0 +1,123 @@
+#include <gtest/gtest.h>
+
+// Keep assertions in non-void harness helpers active in every build mode.
+#ifdef NDEBUG
+#undef NDEBUG
+#endif
+#include "esphome/components/mesh/mesh_ip_discovery.h"
+
+#include <algorithm>
+#include <cassert>
+#include <iostream>
+#include <random>
+#include <vector>
+
+namespace esphome::mesh::testing::ip_ipv6_discovery {
+
+using namespace mesh_ip;
+using Bytes = std::vector<uint8_t>;
+static constexpr uint8_t MAC[6]{0x02, 0x12, 0x34, 0x56, 0x78, 0x9a};
+static Ipv6Address address(uint8_t tail = 1) {
+  Ipv6Address ip{};
+  ip.bytes[0] = 0x20;
+  ip.bytes[1] = 1;
+  ip.bytes[15] = tail;
+  return ip;
+}
+static Bytes metadata() {
+  DiscoveryDescriptor descriptor{"mesh-c",
+                                 6053,
+                                 80,
+                                 {{"mac", "02123456789a"},
+                                  {"version", "2026.9.1"},
+                                  {"config_hash", "1234abcd"},
+                                  {"api_encryption", "Noise_NNpsk0_25519_ChaChaPoly_SHA256"}}};
+  Bytes bytes(DISCOVERY_DESCRIPTOR_MAX);
+  size_t written;
+  assert(encode_discovery(descriptor, bytes.data(), bytes.size(), written));
+  bytes.resize(written);
+  return bytes;
+}
+static std::vector<Bytes> chunks(const Ipv6Address &ip, size_t budget = DISCOVERY_FRAME_MAX) {
+  const auto data = metadata();
+  std::vector<Bytes> packets;
+  for (size_t offset = 0; offset < data.size(); offset += budget - DISCOVERY_IPV6_HEADER_SIZE) {
+    Bytes packet(DISCOVERY_FRAME_MAX);
+    size_t written;
+    assert(discovery_chunk(data.data(), data.size(), ip, offset, packet.data(), packet.size(), written, budget));
+    packet.resize(written);
+    packets.push_back(packet);
+  }
+  return packets;
+}
+TEST(MeshIpv6Discovery, BoundIdentityAndReorder) {
+  DiscoveryRegistry registry;
+  auto packets = chunks(address());
+  ASSERT_TRUE(!registry.receive(3, packets[0].data(), packets[0].size(), 100));
+  ASSERT_TRUE(registry.authorize(3, MAC));
+  std::reverse(packets.begin(), packets.end());
+  for (const auto &packet : packets)
+    ASSERT_TRUE(registry.receive(3, packet.data(), packet.size(), 100));
+  ASSERT_TRUE(registry.current(3, address(), 100));
+  ASSERT_TRUE(!registry.current(3, address(2), 100) && !registry.current(3, uint32_t(1), 100));
+  ASSERT_TRUE(registry.refresh(3, address(), 200));
+  ASSERT_TRUE(!registry.refresh(3, address(2), 200) && !registry.refresh(3, uint32_t(1), 200));
+  registry.revoke(3);
+  ASSERT_TRUE(!registry.current(3, address(), 200));
+}
+TEST(MeshIpv6Discovery, BudgetAndFamilyGaps) {
+  for (size_t budget : {52U, 80U, 144U, 160U}) {
+    DiscoveryRegistry registry;
+    ASSERT_TRUE(registry.authorize(3, MAC));
+    for (const auto &packet : chunks(address(), budget))
+      ASSERT_TRUE(registry.receive(3, packet.data(), packet.size(), 1));
+    ASSERT_TRUE(registry.current(3, address(), 1));
+  }
+  auto data = metadata();
+  uint8_t packet[160];
+  size_t written;
+  ASSERT_TRUE(!discovery_chunk(data.data(), data.size(), address(), 0, packet, sizeof(packet), written, 51));
+  ASSERT_TRUE(!discovery_chunk(data.data(), data.size(), Ipv6Address{}, 0, packet, sizeof(packet), written));
+  auto multicast = address();
+  multicast.bytes[0] = 255;
+  ASSERT_TRUE(!discovery_chunk(data.data(), data.size(), multicast, 0, packet, sizeof(packet), written));
+  DiscoveryRegistry registry;
+  ASSERT_TRUE(registry.authorize(3, MAC));
+  for (const auto &p : chunks(address()))
+    ASSERT_TRUE(registry.receive(3, p.data(), p.size(), 1));
+  ASSERT_TRUE(!registry.current(3, address(), DISCOVERY_LIFETIME_MS + 1));
+  ASSERT_TRUE(!registry.refresh(3, address(), DISCOVERY_LIFETIME_MS + 1));
+  for (const auto &p : chunks(address(2)))
+    ASSERT_TRUE(registry.receive(3, p.data(), p.size(), 20000));
+  ASSERT_TRUE(!registry.current(3, address(), 20000) && registry.current(3, address(2), 20000));
+}
+TEST(MeshIpv6Discovery, MalformedAndConflictingChunks) {
+  auto packet = chunks(address())[0];
+  for (size_t field : {0U, 1U, 26U, 27U}) {
+    DiscoveryRegistry registry;
+    ASSERT_TRUE(registry.authorize(3, MAC));
+    auto bad = packet;
+    bad[field] = field == 26 ? 0 : 255;
+    ASSERT_TRUE(!registry.receive(3, bad.data(), bad.size(), 1));
+  }
+  DiscoveryRegistry registry;
+  ASSERT_TRUE(registry.authorize(3, MAC));
+  auto packets = chunks(address(), 80);
+  ASSERT_TRUE(registry.receive(3, packets[0].data(), packets[0].size(), 1));
+  auto conflict = packets[0];
+  conflict.back() ^= 1;
+  ASSERT_TRUE(!registry.receive(3, conflict.data(), conflict.size(), 2));
+  for (size_t i = 1; i < packets.size(); ++i)
+    ASSERT_TRUE(registry.receive(3, packets[i].data(), packets[i].size(), 3));
+  ASSERT_TRUE(registry.current(3, address(), 3));
+  std::mt19937 rng(0x6aaa);
+  for (size_t i = 0; i < 4000; ++i) {
+    DiscoveryRegistry fuzz;
+    ASSERT_TRUE(fuzz.authorize(3, MAC));
+    auto changed = packet;
+    changed[rng() % changed.size()] ^= uint8_t(1U << (rng() % 8));
+    fuzz.receive(3, changed.data(), changed.size(), 1);
+  }
+}
+
+}  // namespace esphome::mesh::testing::ip_ipv6_discovery
diff --git a/tests/components/mesh/test_ip_packet.cpp b/tests/components/mesh/test_ip_packet.cpp
new file mode 100644
index 000000000..e9f87191b
--- /dev/null
+++ b/tests/components/mesh/test_ip_packet.cpp
@@ -0,0 +1,850 @@
+#include <gtest/gtest.h>
+
+// Keep assertions in non-void harness helpers active in every build mode.
+#ifdef NDEBUG
+#undef NDEBUG
+#endif
+#include "esphome/components/mesh/mesh_ip_packet.h"
+#include "esphome/components/mesh/mesh_ip_handover.h"
+
+#include <algorithm>
+#include <array>
+#include <cassert>
+#include <cstdint>
+#include <cstring>
+#include <iostream>
+#include <limits>
+#include <random>
+#include <vector>
+
+namespace esphome::mesh::testing::ip_packet {
+
+using namespace mesh_ip;
+
+namespace {
+
+using Bytes = std::vector<uint8_t>;
+using Fragments = std::vector<Bytes>;
+
+Bytes packet(size_t length, uint32_t seed = 1) {
+  Bytes bytes(length);
+  for (auto &byte : bytes) {
+    seed = seed * 1664525U + 1013904223U;
+    byte = static_cast<uint8_t>(seed >> 24);
+  }
+  return bytes;
+}
+
+Fragments fragments(const Bytes &bytes, uint32_t id = 10, const PacketProfile &profile = PacketProfile{}) {
+  Fragmenter fragmenter;
+  assert(fragmenter.set_profile(profile));
+  assert(fragmenter.begin(bytes.data(), bytes.size(), id));
+  Fragments output;
+  while (fragmenter.active()) {
+    std::array<uint8_t, mesh_core::kMaxPayload> buffer{};
+    size_t written = 999;
+    assert(fragmenter.peek(buffer.data(), buffer.size(), written));
+    output.emplace_back(buffer.begin(), buffer.begin() + written);
+    assert(fragmenter.advance());
+  }
+  assert(!fragmenter.advance());
+  return output;
+}
+
+ReceiveResult receive(Reassembler &r, const Bytes &fragment, uint32_t now, CompletedPacket &completed,
+                      NodeId source = 3, NodeId destination = 1) {
+  return r.receive(source, destination, fragment.data(), fragment.size(), now, completed);
+}
+
+void assert_complete(const CompletedPacket &completed, const Bytes &expected, uint32_t id = 10, NodeId source = 3,
+                     NodeId destination = 1) {
+  assert(completed.data != nullptr);
+  assert(completed.length == expected.size());
+  assert(std::memcmp(completed.data, expected.data(), expected.size()) == 0);
+  assert(completed.source == source);
+  assert(completed.destination == destination);
+  assert(completed.packet_id == id);
+}
+
+TEST(MeshIpPacket, CrcKnownVector) {
+  const uint8_t vector[]{'1', '2', '3', '4', '5', '6', '7', '8', '9'};
+  ASSERT_TRUE(packet_crc32(vector, sizeof(vector)) == 0xcbf43926U);
+  ASSERT_TRUE(packet_crc32(nullptr, 0) == 0);
+}
+
+TEST(MeshIpPacket, FragmenterBackpressureAndOwnership) {
+  auto bytes = packet(kMtu);
+  const auto original = bytes;
+  Fragmenter f;
+  ASSERT_TRUE(!f.begin(nullptr, 1, 1));
+  ASSERT_TRUE(!f.begin(bytes.data(), 0, 1));
+  ASSERT_TRUE(!f.begin(bytes.data(), kMtu + 1, 1));
+  ASSERT_TRUE(!f.active());
+  ASSERT_TRUE(f.begin(bytes.data(), bytes.size(), UINT32_MAX));
+  ASSERT_TRUE(!f.begin(bytes.data(), 1, 5));
+  std::fill(bytes.begin(), bytes.end(), 0);
+  ASSERT_TRUE(f.packet_id() == UINT32_MAX);
+  ASSERT_TRUE(f.packet_length() == kMtu);
+  ASSERT_TRUE(f.fragment_count() == kMaxFragments);
+  ASSERT_TRUE(kMaxFragments == (kMtu + kFragmentDataSize - 1) / kFragmentDataSize);
+
+  std::array<uint8_t, mesh_core::kMaxPayload> first{};
+  std::array<uint8_t, mesh_core::kMaxPayload> retry{};
+  size_t length = 99;
+  ASSERT_TRUE(!f.peek(nullptr, first.size(), length));
+  ASSERT_TRUE(length == 0 && f.fragment_index() == 0);
+  ASSERT_TRUE(!f.peek(first.data(), first.size() - 1, length));
+  ASSERT_TRUE(length == 0 && f.fragment_index() == 0);
+  ASSERT_TRUE(f.peek(first.data(), first.size(), length));
+  ASSERT_TRUE(length == first.size());
+  ASSERT_TRUE(first[0] == 'M' && first[1] == 'I' && first[2] == 3 && first[3] == 0);
+  ASSERT_TRUE(first[4] == 255 && first[5] == 255 && first[6] == 255 && first[7] == 255);
+  ASSERT_TRUE(first[8] == (kMtu & 255) && first[9] == (kMtu >> 8));
+  ASSERT_TRUE(first[10] == 0 && first[11] == kMaxFragments);
+  ASSERT_TRUE(std::equal(first.begin() + kFragmentHeaderSize, first.end(), original.begin()));
+  size_t repeated_length = 0;
+  ASSERT_TRUE(f.peek(retry.data(), retry.size(), repeated_length));
+  ASSERT_TRUE(length == repeated_length && first == retry);
+  for (uint8_t index = 0; index < kMaxFragments; ++index) {
+    ASSERT_TRUE(f.fragment_index() == index);
+    ASSERT_TRUE(f.peek(first.data(), first.size(), length));
+    ASSERT_TRUE(first[10] == index);
+    ASSERT_TRUE(length == kFragmentHeaderSize + std::min(kFragmentDataSize, kMtu - index * kFragmentDataSize));
+    ASSERT_TRUE(f.advance());
+  }
+  ASSERT_TRUE(!f.active());
+  ASSERT_TRUE(!f.peek(first.data(), first.size(), length) && length == 0);
+  ASSERT_TRUE(f.begin(original.data(), 1, 0));  // Packet IDs wrap through zero.
+  f.reset();
+  ASSERT_TRUE(!f.active() && f.fragment_count() == 0 && f.packet_length() == 0);
+}
+
+TEST(MeshIpPacket, AllLengthsReorderAndRoundtrip) {
+  Reassembler r;
+  std::mt19937 rng(0x721946U);
+  for (size_t size = 1; size <= kMtu; ++size) {
+    const auto bytes = packet(size, static_cast<uint32_t>(size));
+    auto parts = fragments(bytes, static_cast<uint32_t>(size));
+    ASSERT_TRUE(parts.size() == (size + kFragmentDataSize - 1) / kFragmentDataSize);
+    std::shuffle(parts.begin(), parts.end(), rng);
+    CompletedPacket complete;
+    for (size_t i = 0; i < parts.size(); ++i) {
+      const auto result = receive(r, parts[i], 100, complete);
+      ASSERT_TRUE(result == (i + 1 == parts.size() ? ReceiveResult::COMPLETE : ReceiveResult::INCOMPLETE));
+      if (result != ReceiveResult::COMPLETE)
+        ASSERT_TRUE(complete.data == nullptr && complete.length == 0);
+    }
+    assert_complete(complete, bytes, static_cast<uint32_t>(size));
+    ASSERT_TRUE(r.pending_packets() == 0);
+  }
+  ASSERT_TRUE(r.counters().completed_packets == kMtu);
+  ASSERT_TRUE(r.counters().capacity_drops == 0);
+}
+
+TEST(MeshIpPacket, DuplicateConflictAndReplay) {
+  Reassembler r;
+  const auto bytes = packet(2 * kFragmentDataSize + 12);
+  auto parts = fragments(bytes);
+  CompletedPacket complete;
+  ASSERT_TRUE(receive(r, parts[0], 100, complete) == ReceiveResult::INCOMPLETE);
+  ASSERT_TRUE(receive(r, parts[0], 101, complete) == ReceiveResult::DUPLICATE);
+  auto bad = parts[0];
+  bad.back() ^= 1;
+  ASSERT_TRUE(receive(r, bad, 102, complete) == ReceiveResult::INVALID);
+  ASSERT_TRUE(r.pending_packets() == 1);
+  bad = parts[0];
+  bad[12] ^= 1;
+  ASSERT_TRUE(receive(r, bad, 103, complete) == ReceiveResult::INVALID);
+  bad = parts[0];
+  ++bad[8];  // Still a canonical 3-fragment packet, but conflicting metadata.
+  ASSERT_TRUE(receive(r, bad, 104, complete) == ReceiveResult::INVALID);
+  ASSERT_TRUE(receive(r, parts[2], 105, complete) == ReceiveResult::INCOMPLETE);
+  ASSERT_TRUE(receive(r, parts[1], 106, complete) == ReceiveResult::COMPLETE);
+  assert_complete(complete, bytes);
+  for (const auto &part : parts) {
+    ASSERT_TRUE(receive(r, part, 107, complete) == ReceiveResult::DUPLICATE);
+    ASSERT_TRUE(complete.data == nullptr && complete.length == 0);
+  }
+  bad = parts[0];
+  bad[12] ^= 1;
+  ASSERT_TRUE(receive(r, bad, 108, complete) == ReceiveResult::INVALID);
+  ASSERT_TRUE(r.counters().completed_packets == 1);
+  ASSERT_TRUE(r.pending_packets() == 0);
+  // A new epoch may reuse an ID after the explicitly bounded replay lifetime.
+  r.expire(2106);
+  for (size_t i = 0; i < parts.size(); ++i)
+    ASSERT_TRUE(receive(r, parts[i], 2106, complete) ==
+                (i + 1 == parts.size() ? ReceiveResult::COMPLETE : ReceiveResult::INCOMPLETE));
+}
+
+TEST(MeshIpPacket, CorruptionNeverDeliversAndRetrySucceeds) {
+  Reassembler r;
+  const auto bytes = packet(kMtu);
+  auto parts = fragments(bytes);
+  const auto original = parts;
+  parts[parts.size() / 2][kFragmentHeaderSize + 3] ^= 0x80;
+  CompletedPacket complete;
+  for (size_t i = 0; i < parts.size(); ++i)
+    ASSERT_TRUE(receive(r, parts[i], 0, complete) ==
+                (i + 1 == parts.size() ? ReceiveResult::INVALID : ReceiveResult::INCOMPLETE));
+  ASSERT_TRUE(complete.data == nullptr && complete.length == 0);
