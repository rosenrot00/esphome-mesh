+using namespace mesh_ip;
+using Bytes = std::vector<uint8_t>;
+
+Bytes bytes(size_t length, uint8_t seed = 1) {
+  Bytes result(length);
+  for (size_t i = 0; i < length; ++i)
+    result[i] = uint8_t(i * 37 + seed);
+  return result;
+}
+uint32_t packet_id(const Bytes &payload) {
+  return uint32_t(payload[4]) | uint32_t(payload[5]) << 8 | uint32_t(payload[6]) << 16 | uint32_t(payload[7]) << 24;
+}
+struct Message {
+  NodeId source, destination;
+  bool ack;
+  Bytes payload;
+};
+struct Network;
+struct Endpoint {
+  Network *network;
+  NodeId id;
+  PacketDelivery delivery;
+  std::vector<Bytes> delivered;
+  bool admit{true}, deliver{true}, admit_ack{true};
+  Endpoint(Network *network, NodeId id) : network(network), id(id) {}
+  DeliveryCallbacks callbacks();
+};
+struct Network {
+  Endpoint a{this, 1}, b{this, 2}, c{this, 3};
+  std::deque<Message> pending;
+  std::vector<Message> history;
+  std::function<bool(const Message &)> drop;
+  bool reverse{false}, duplicate{false};
+  Network(const DeliveryProfile &profile = {}) {
+    for (auto *endpoint : {&a, &b, &c})
+      assert(endpoint->delivery.configure(endpoint->id, profile, endpoint->callbacks()));
+  }
+  void route(uint32_t now) {
+    size_t budget = pending.size();
+    while (budget--) {
+      Message message = reverse ? pending.back() : pending.front();
+      if (reverse)
+        pending.pop_back();
+      else
+        pending.pop_front();
+      history.push_back(message);
+      if (drop && drop(message))
+        continue;
+      auto &target = message.destination == 1 ? a : message.destination == 2 ? b : c;
+      for (unsigned copy = 0; copy < (duplicate ? 2U : 1U); ++copy) {
+        if (message.ack)
+          target.delivery.accept_ack(message.source, message.payload.data(), message.payload.size(), now);
+        else
+          target.delivery.receive_fragment(message.source, message.destination, message.payload.data(),
+                                           message.payload.size(), now);
+      }
+    }
+  }
+  void step(uint32_t now) {
+    for (auto *endpoint : {&a, &b, &c})
+      endpoint->delivery.tick(now);
+    route(now);
+  }
+  void run(uint32_t start = 0, uint32_t length = 1500) {
+    for (uint32_t elapsed = 0; elapsed < length; elapsed += 5)
+      step(start + elapsed);
+  }
+};
+DeliveryCallbacks Endpoint::callbacks() {
+  return {this,
+          [](void *context, NodeId destination, const uint8_t *payload, size_t length) {
+            auto &self = *static_cast<Endpoint *>(context);
+            if (!self.admit)
+              return false;
+            self.network->pending.push_back({self.id, destination, false, Bytes(payload, payload + length)});
+            return true;
+          },
+          [](void *context, NodeId destination, const uint8_t *payload, size_t length) {
+            auto &self = *static_cast<Endpoint *>(context);
+            if (!self.admit_ack)
+              return false;
+            self.network->pending.push_back({self.id, destination, true, Bytes(payload, payload + length)});
+            return true;
+          },
+          [](void *context, NodeId, const uint8_t *payload, size_t length) {
+            auto &self = *static_cast<Endpoint *>(context);
+            if (!self.deliver)
+              return false;
+            self.delivered.emplace_back(payload, payload + length);
+            return true;
+          }};
+}
+Bytes fragment(const Bytes &packet, uint32_t id, uint8_t index = 0, const PacketProfile &profile = {}) {
+  Fragmenter sender;
+  assert(sender.set_profile(profile));
+  assert(sender.begin(packet.data(), packet.size(), id));
+  std::array<uint8_t, mesh_core::kMaxPayload> output{};
+  size_t length;
+  assert(sender.peek_at(index, output.data(), output.size(), length));
+  return Bytes(output.begin(), output.begin() + length);
+}
